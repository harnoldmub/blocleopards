  function generateChallengeShareLink(): string {
    const pseudo = (challengePlayerName?.value || "").trim();
    const origin = window.location.origin || "https://blocleopards.com";
    const path = window.location.pathname.includes("basket") ? window.location.pathname : "/jeux/basket";
