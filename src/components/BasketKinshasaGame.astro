  function setupCurrentSpot() {
    const tier = getActiveTier();
    if (tier.id > state.maxUnlockedTier) {
      state.maxUnlockedTier = tier.id;
      localStorage.setItem("kin_basket_max_tier", String(state.maxUnlockedTier));
    }

    const spot = SPOTS[state.spotIndex % SPOTS.length];
    ballMesh.position.set(spot.x, 1.95, spot.z);
    ballMesh.rotation.set(0, 0, 0);

    // Placer la caméra juste derrière le tireur, orientée vers l'arceau
    const dirToHoop = new THREE.Vector3(0 - spot.x, 0, HOOP.rimZ - spot.z).normalize();
    camera.position.set(spot.x - dirToHoop.x * 1.85, 2.25, spot.z - dirToHoop.z * 1.85);
    camera.lookAt(0, HOOP.rimY - 0.1, HOOP.rimZ);

    // Défenseur contestataire aux niveaux 3+
    if (tier.hasDefender) {
      defenderGroup.visible = true;
      defenderGroup.position.set(spot.x + dirToHoop.x * 1.55, 0, spot.z + dirToHoop.z * 1.55);
      defenderGroup.lookAt(spot.x, 0, spot.z);
    } else {
      defenderGroup.visible = false;
    }

    if (powerMeterWrap) powerMeterWrap.classList.add("opacity-0");
    if (powerMeterFill) powerMeterFill.style.height = "0%";
    aimInstruction?.classList.remove("opacity-0");

    state.phase = "aiming";
    updateHud();
  }

  /* -------------------------------------------------------------------------- */
  /*  JAUGE DE TIR IRRÉVERSIBLE                                                 */
  /* -------------------------------------------------------------------------- */
  let chargeActive = false;
  let chargeStartY = 0;
  let chargePeakPushY = 0;
  let lockedPowerPct = 0;

  const ballPhys = {
    active: false,
    vx: 0,
    vy: 0,
    vz: 0,
    isMake: false,
    isSwish: false,
    isBankMake: false,
    hitBackboard: false,
    hitRim: false,
    scoredTriggered: false,
    bounces: 0,
    elapsed: 0
  };

  function updateChargeGauge(dt: number) {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;
    const h = window.innerHeight;
    const pushPower = Math.max(0, (chargePeakPushY / (h * 0.34)) * 100);
    lockedPowerPct = Math.max(lockedPowerPct + dt * 62, pushPower);

    const displayPct = Math.min(Math.round(lockedPowerPct), 105);
    if (powerMeterFill) powerMeterFill.style.height = `${Math.min(displayPct, 100)}%`;
    if (powerMeterPct) {
      powerMeterPct.textContent = `${displayPct}%`;
    }

    // Élévation du ballon dans les mains du joueur pendant le jump-shot
    const spot = SPOTS[state.spotIndex % SPOTS.length];
    ballMesh.position.y = 1.95 + Math.min(0.45, (lockedPowerPct / 100) * 0.45);
    ballMesh.position.x = spot.x;
    ballMesh.position.z = spot.z;

    if (lockedPowerPct >= 104) {
      releaseJumpShot();
    }
  }

  function releaseJumpShot() {
    if (!chargeActive) return;
    chargeActive = false;
    state.phase = "flying";

    setTimeout(() => powerMeterWrap?.classList.add("opacity-0"), 350);

    const tier = getActiveTier();
    const spot = SPOTS[state.spotIndex % SPOTS.length];
    // Puissance idéale = 81%
    const idealPower = 81;
    const err = lockedPowerPct - idealPower;
    const absErr = Math.abs(err);

    ballPhys.active = true;
    ballPhys.elapsed = 0;
    ballPhys.hitBackboard = false;
    ballPhys.hitRim = false;
    ballPhys.scoredTriggered = false;
    ballPhys.bounces = 0;

    // Déterminer le résultat physique selon la précision de la jauge irréversible
    ballPhys.isSwish = absErr <= tier.tolerancePct * 0.55;
    ballPhys.isBankMake = !ballPhys.isSwish && absErr <= tier.tolerancePct;
    ballPhys.isMake = ballPhys.isSwish || ballPhys.isBankMake;

    // Calcul balistique exact vers la cible (centre de l'arceau, planche ou rebord)
    const startX = ballMesh.position.x;
    const startY = ballMesh.position.y;
    const startZ = ballMesh.position.z;

    let targetX = 0;
    let targetY = HOOP.rimY + 0.04;
    let targetZ = HOOP.rimZ;

    if (ballPhys.isBankMake) {
      // Rentré avec la planche !
      targetZ = HOOP.boardZ + BALL_R + 0.04;
      targetY = HOOP.rimY + 0.34;
    } else if (!ballPhys.isMake) {
      // Trop court (arceau avant) ou trop long (planche/arceau arrière)
      targetZ = err < 0 ? HOOP.rimZ + HOOP.rimR : HOOP.boardZ + BALL_R + 0.04;
      targetX = (Math.random() - 0.5) * 0.28;
    }

    const flightDuration = 0.88 + Math.hypot(spot.x, spot.z) * 0.045;
    const g = 9.81;
    ballPhys.vx = (targetX - startX) / flightDuration;
    ballPhys.vz = (targetZ - startZ) / flightDuration;
    ballPhys.vy = (targetY - startY + 0.5 * g * flightDuration * flightDuration) / flightDuration;
  }

  canvas.addEventListener("pointerdown", (e) => {
    if (state.phase !== "aiming" || state.paused) return;
    initAudio();
    state.phase = "charging";
    chargeActive = true;
    chargeStartY = e.clientY;
    chargePeakPushY = 0;
    lockedPowerPct = 18;
    aimInstruction?.classList.add("opacity-0");
    powerMeterWrap?.classList.remove("opacity-0");
  });

  window.addEventListener("pointermove", (e) => {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;
    const pushY = Math.max(0, chargeStartY - e.clientY);
    if (pushY > chargePeakPushY) chargePeakPushY = pushY;
  });

  window.addEventListener("pointerup", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) releaseJumpShot();
  });
  window.addEventListener("pointercancel", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) releaseJumpShot();
  });

  /* -------------------------------------------------------------------------- */
  /*  PHYSIQUE DU BALLON DE BASKET (PLANCHE, ARCEAU, FILET, REBOND SOL)         */
  /* -------------------------------------------------------------------------- */
  function updateBasketballPhysics(dt: number) {
    const tier = getActiveTier();
    if (tier.hasDefender && defenderGroup.visible) {
      if (state.phase === "charging" || (state.phase === "flying" && ballPhys.elapsed < 0.35)) {
        defenderGroup.position.y = Math.min(tier.defenderJumpH, defenderGroup.position.y + dt * 3.2);
      } else {
        defenderGroup.position.y = Math.max(0, defenderGroup.position.y - dt * 2.5);
      }
    }

    if (!ballPhys.active) return;
    ballPhys.elapsed += dt;

    const SUBSTEPS = 5;
    const subDt = dt / SUBSTEPS;

    for (let s = 0; s < SUBSTEPS; s++) {
      ballPhys.vy -= 9.81 * subDt;
      ballMesh.position.x += ballPhys.vx * subDt;
      ballMesh.position.y += ballPhys.vy * subDt;
      ballMesh.position.z += ballPhys.vz * subDt;

      // Backspin réaliste du ballon de basket
      ballMesh.rotation.x -= 9.5 * subDt;

      // 1. Choc avec la planche en plexiglas (Z = 0)
      if (
        !ballPhys.hitBackboard &&
        ballMesh.position.z <= HOOP.boardZ + BALL_R + 0.04 &&
        ballMesh.position.z >= HOOP.boardZ - 0.2 &&
        Math.abs(ballMesh.position.x) < 0.9 &&
        ballMesh.position.y > 2.75 &&
        ballMesh.position.y < 3.95
      ) {
        ballPhys.hitBackboard = true;
        playBackboardHitAudio();
        ballMesh.position.z = HOOP.boardZ + BALL_R + 0.04;

        if (ballPhys.isBankMake) {
          // Redirige proprement le ballon de la planche vers le centre de l'arceau !
          ballPhys.vz = (HOOP.rimZ - ballMesh.position.z) * 3.8;
          ballPhys.vx = -ballMesh.position.x * 3.5;
          ballPhys.vy = -1.2;
        } else {
          ballPhys.vz = Math.abs(ballPhys.vz) * 0.48;
          ballPhys.vx += (Math.random() - 0.5) * 2.2;
        }
      }

      // 2. Passage au niveau de l'arceau (Y ≈ 3.05m)
      if (!ballPhys.scoredTriggered && ballPhys.vy < 0 && Math.abs(ballMesh.position.y - HOOP.rimY) < 0.09) {
        if (ballPhys.isMake) {
          ballPhys.scoredTriggered = true;
          // Guider la balle à travers le filet
          ballMesh.position.x = 0;
          ballMesh.position.z = HOOP.rimZ;
          ballPhys.vx = 0;
          ballPhys.vz = 0;
          ballPhys.vy = -3.8;
          triggerHoopNetSwish();
          playSwishAudio();
          onShotResolved(
            true,
            ballPhys.isSwish ? "SWISH NET ! 🔥" : "AVEC LA PLANCHE ! 🏀",
            ballPhys.isSwish ? "Panier sans toucher l'arceau · Direction le spot suivant !" : "Belle utilisation du panneau à Limete !"
          );
        } else if (!ballPhys.hitRim) {
          ballPhys.hitRim = true;
          playRimClangAudio();
          ballPhys.vy = Math.abs(ballPhys.vy) * 0.46;
          ballPhys.vz = 2.4 + Math.random() * 1.5;
          ballPhys.vx = (Math.random() - 0.5) * 3.2;
          onShotResolved(false, "REBOND SUR L'ARCEAU !", "Ajuste le dosage de ta jauge sur la prochaine série.");
        }
      }

      // 3. Rebond au sol (bitume de Limete)
      if (ballMesh.position.y < BALL_R) {
        ballMesh.position.y = BALL_R;
        if (Math.abs(ballPhys.vy) > 0.8) {
          playCourtBounceAudio(Math.min(1, Math.abs(ballPhys.vy) / 6));
        }
        ballPhys.vy = Math.abs(ballPhys.vy) * 0.62;
        ballPhys.vx *= 0.78;
        ballPhys.vz *= 0.78;
        ballPhys.bounces++;
      }
    }
  }

  function onShotResolved(made: boolean, title: string, subtitle: string) {
    state.phase = "result";
    const prevTierId = getActiveTier().id;

    if (made) {
      state.streak++;
      state.spotIndex = (state.spotIndex + 1) % SPOTS.length;
      if (state.streak > state.bestStreak) {
        state.bestStreak = state.streak;
        localStorage.setItem("kin_basket_best", String(state.bestStreak));
      }
    }

    const newTier = getActiveTier();
    const leveledUp = made && newTier.id > prevTierId;
    updateHud();

    if (shotToast && toastTitle && toastSubtitle && toastEmoji) {
      toastEmoji.textContent = leveledUp ? "🔥🆙" : made ? "🏀" : "❌";
      toastTitle.textContent = leveledUp ? `PANIER ! NIVEAU ${newTier.id} (${newTier.name.toUpperCase()})` : title;
      toastTitle.className = made
        ? "font-display text-lg uppercase tracking-wider text-or leading-none"
        : "font-display text-lg uppercase tracking-wider text-red-400 leading-none";
      toastSubtitle.textContent = leveledUp ? newTier.desc : subtitle;
      shotToast.classList.remove("opacity-0", "-translate-y-4");
    }

    if (made) {
      setTimeout(() => {
        shotToast?.classList.add("opacity-0", "-translate-y-4");
        ballPhys.active = false;
        setupCurrentSpot();
      }, 1550);
    } else {
      setTimeout(() => {
        shotToast?.classList.add("opacity-0", "-translate-y-4");
        ballPhys.active = false;
        state.phase = "gameover";
        if (goTitle) goTitle.textContent = title;
        if (goDesc) goDesc.textContent = subtitle;
        if (goStatStreak) goStatStreak.textContent = String(state.streak);
        if (goStatLevel) goStatLevel.textContent = `Niv. ${prevTierId}`;
        if (goStatRecord) goStatRecord.textContent = String(state.bestStreak);
        gameoverModal?.classList.remove("hidden");
        gameoverModal?.classList.add("flex");
        renderLevelsModal();
      }, 1450);
    }
  }

  function restartGame(tierIdx = 0) {
    state.paused = false;
    if (iconPause) iconPause.textContent = "⏸";
    state.baseTierIndex = tierIdx;
    state.streak = TIERS[tierIdx]?.minMade || 0;
    state.spotIndex = state.streak % SPOTS.length;
    gameoverModal?.classList.add("hidden");
    gameoverModal?.classList.remove("flex");
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");
    setupCurrentSpot();
    renderLevelsModal();
  }

  /* -------------------------------------------------------------------------- */
  /*  PAUSE & MODALES                                                           */
  /* -------------------------------------------------------------------------- */
  function setPaused(p: boolean) {
    if (state.phase === "gameover") return;
    state.paused = p;
    if (iconPause) iconPause.textContent = state.paused ? "▶" : "⏸";
    if (state.paused) {
      updateHud();
      pauseModal?.classList.remove("hidden");
      pauseModal?.classList.add("flex");
    } else {
      pauseModal?.classList.add("hidden");
      pauseModal?.classList.remove("flex");
      prevTime = performance.now();
    }
  }

  btnPause?.addEventListener("click", () => setPaused(!state.paused));
  btnPauseResume?.addEventListener("click", () => setPaused(false));
  btnPauseRestart?.addEventListener("click", () => restartGame(0));

  window.addEventListener("keydown", (e) => {
    if (e.code === "Space" || e.key === "p" || e.key === "P" || e.key === "Escape") {
      e.preventDefault();
      setPaused(!state.paused);
    }
  });

  function renderLevelsModal() {
    if (!levelsGrid) return;
    levelsGrid.innerHTML = "";
    const activeTier = getActiveTier();
    TIERS.forEach((t, idx) => {
      const unlocked = t.id <= state.maxUnlockedTier;
      const isCurrent = t.id === activeTier.id;
      const card = document.createElement("button");
      card.type = "button";
      card.disabled = !unlocked;
      card.className = `flex flex-col justify-between rounded-2xl border p-3.5 text-left transition-all ${
        isCurrent
          ? "border-or bg-or/15 shadow-lg"
          : unlocked
            ? "border-white/15 bg-black/40 hover:border-white/35"
            : "border-white/5 bg-black/20 opacity-45 cursor-not-allowed"
      }`;
      card.innerHTML = `
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="rounded ${isCurrent ? "bg-or text-slate-950" : "bg-white/10 text-or"} px-2 py-0.5 font-display text-xs uppercase font-black">
              Niveau ${t.id}
            </span>
            <span class="text-[0.68rem] font-bold ${unlocked ? "text-emerald-400" : "text-slate-500"}">
              ${unlocked ? (isCurrent ? "● En cours" : "✓ Débloqué") : `🔒 Dès ${t.minMade} paniers`}
            </span>
          </div>
          <h4 class="mt-1.5 font-display text-lg uppercase text-white">${t.name}</h4>
          <p class="mt-0.5 text-xs text-slate-300">${t.desc}</p>
        </div>
      `;
      if (unlocked) card.addEventListener("click", () => restartGame(idx));
      levelsGrid.appendChild(card);
    });
  }

  btnOpenLevels?.addEventListener("click", () => {
    state.paused = true;
    renderLevelsModal();
    levelsModalOverlay?.classList.remove("hidden");
    levelsModalOverlay?.classList.add("flex");
  });
  btnCloseLevels?.addEventListener("click", () => {
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    state.paused = false;
    prevTime = performance.now();
  });
  btnResumeFromLevels?.addEventListener("click", () => {
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    state.paused = false;
    prevTime = performance.now();
  });
  btnGoLevels?.addEventListener("click", () => {
    gameoverModal?.classList.add("hidden");
    gameoverModal?.classList.remove("flex");
    renderLevelsModal();
    levelsModalOverlay?.classList.remove("hidden");
    levelsModalOverlay?.classList.add("flex");
  });
  btnGoRetry?.addEventListener("click", () => restartGame(0));

  btnOpenMenu?.addEventListener("click", () => {
    state.paused = true;
    gameMenuOverlay?.classList.remove("hidden");
    gameMenuOverlay?.classList.add("flex");
  });
  btnCloseMenu?.addEventListener("click", () => {
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");
    state.paused = false;
    prevTime = performance.now();
  });
  btnResumeGame?.addEventListener("click", () => {
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");
    state.paused = false;
    prevTime = performance.now();
  });
  btnMenuRestart?.addEventListener("click", () => restartGame(0));

  btnSetDay?.addEventListener("click", () => applyLightingMode(false));
  btnSetNight?.addEventListener("click", () => applyLightingMode(true));

  function toggleAudio() {
    initAudio();
    state.audioEnabled = !state.audioEnabled;
    if (iconSound) iconSound.textContent = state.audioEnabled ? "🔊" : "🔇";
    if (btnMenuAudioToggle) {
      btnMenuAudioToggle.textContent = state.audioEnabled ? "🔊 Son Activé" : "🔇 Son Coupé";
    }
  }
  btnSound?.addEventListener("click", toggleAudio);
  btnMenuAudioToggle?.addEventListener("click", toggleAudio);

  let prevTime = performance.now();
  function animate() {
    requestAnimationFrame(animate);
    const now = performance.now();
    const dt = Math.min((now - prevTime) / 1000, 0.05);
    prevTime = now;

    if (state.paused) {
      renderer.render(scene, camera);
      return;
    }

    updateHoopNet(dt);
    if (state.phase === "charging") updateChargeGauge(dt);
    else if (state.phase === "flying" || state.phase === "result") updateBasketballPhysics(dt);

    renderer.render(scene, camera);
  }

  window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  applyLightingMode(false);
  setupCurrentSpot();
  renderLevelsModal();
  animate();
</script>

