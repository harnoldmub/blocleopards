  /* -------------------------------------------------------------------------- */
  /*  BOUCLE DE RENDU 3D                                                        */
  /* -------------------------------------------------------------------------- */
  let prevTime = performance.now();
  function animate() {
    requestAnimationFrame(animate);
    const now = performance.now();
    const dt = Math.min((now - prevTime) / 1000, 0.05);
    prevTime = now;

    if (state.paused) {
      renderer.render(scene, camera);
      return;
    }

    updateNetMesh(dt);

    // Ombre de contact au sol
    const h = Math.max(0, ballMesh.position.y - BALL_R);
    ballContactShadow.position.set(ballMesh.position.x, 0.012, ballMesh.position.z);
    const sScale = 1 + h * 0.4;
    ballContactShadow.scale.set(sScale, sScale, 1);
    (ballContactShadow.material as THREE.MeshBasicMaterial).opacity = Math.max(0.08, 0.65 * Math.exp(-h * 0.9));

    // Décompte du chrono global du niveau (Timer immersif sous haute pression)
    if (state.phase !== "gameover" && !state.paused) {
      state.levelTimeRemaining -= dt;
      const tRem = Math.max(0, state.levelTimeRemaining);

      if (hudLevelTimer) hudLevelTimer.textContent = `${tRem.toFixed(1)}s`;
      if (hudShotclock) hudShotclock.textContent = `${tRem.toFixed(1)}`;

      if (hudLevelTimerBar) {
        const total = getActiveTier().levelTimerSec;
        const pct = Math.max(0, Math.min(100, (tRem / total) * 100));
        hudLevelTimerBar.style.width = `${pct}%`;
        if (tRem <= 4.0 || pct < 25) {
          hudLevelTimerBar.className = "h-full bg-red-500 animate-pulse";
          hudLevelTimerPill?.classList.remove("border-emerald-500", "border-amber-400");
          hudLevelTimerPill?.classList.add("border-red-500", "animate-pulse");
        } else if (pct < 55) {
          hudLevelTimerBar.className = "h-full bg-amber-400";
          hudLevelTimerPill?.classList.remove("border-emerald-500", "border-red-500", "animate-pulse");
          hudLevelTimerPill?.classList.add("border-amber-400");
        } else {
          hudLevelTimerBar.className = "h-full bg-emerald-400";
          hudLevelTimerPill?.classList.remove("border-red-500", "border-amber-400", "animate-pulse");
          hudLevelTimerPill?.classList.add("border-emerald-500");
        }
      }

      if (state.levelTimeRemaining <= 0) {
        state.levelTimeRemaining = 0;
        playRimClangAudio();
        endSeries(true); // Expiré par le timer du niveau !
      }
    }

    if (state.phase === "charging") {
      updateChargeGauge(dt);
    } else if (state.phase === "flying" || state.phase === "result") {
      updateBasketballPhysics(dt);
    }

    renderer.render(scene, camera);
  }

  window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    resizeSwipeCanvas();
    if (state.phase === "aiming") applyPlayableFraming();
  });

  // Lecture des paramètres de défi en ligne (si un ami a partagé son lien)
  let initialTier = 0;
  try {
    const urlParams = new URLSearchParams(window.location.search);
    const challenger = urlParams.get("defie_par");
    const challengedLevel = Number(urlParams.get("niveau") || 0);
    const challengedScore = urlParams.get("score");
    if (challengedLevel > 0 && challengedLevel <= TIERS.length) {
      initialTier = challengedLevel - 1;
    }
    if (challenger && shotToast && toastTitle && toastSubtitle && toastEmoji) {
      setTimeout(() => {
        toastEmoji.textContent = "⚔️";
        toastTitle.textContent = `DÉFI REÇU DE ${challenger.toUpperCase()} !`;
        const scoreTxt = challengedScore !== null ? `Score à battre : ${challengedScore} panier${Number(challengedScore) > 1 ? "s" : ""}` : "Viens claquer des swishs !";
        toastSubtitle.textContent = `Niveau ${initialTier + 1} (${TIERS[initialTier].name}) · ${scoreTxt}`;
        shotToast.classList.remove("opacity-0", "-translate-y-4");
        setTimeout(() => shotToast.classList.add("opacity-0", "-translate-y-4"), 4500);
      }, 1200);
    }
  } catch {}

  scene.background = new THREE.Color("#050914");
  startSeries(initialTier);
  renderPlaylistUi();
  renderLevelsModal();
  animate();
</script>
