---
/**
 * BasketKinshasaGame.astro
 * Expérience 3D plein écran : « Shoot à la Sirène — Terrain de la 7ᵉ Rue Limete, Kinshasa »
 * - Reproduction 3D du terrain urbain relooké de Limete 7ᵉ Rue (revêtement peint bleu/jaune/rouge,
 *   clôtures grillagées, immeubles de Limete, palmiers, lampadaires urbains, panneaux partenaires & Bloc Léopards)
 * - 7 positions de tir autour de l'arc (Lancer franc, 45° Gauche, 45° Droite, Tête de raquette, Corner G, Corner D, Logo Buzzer)
 * - Physique réaliste du ballon de basket (gravité, backspin, rebond au sol, choc sur la planche plexiglas,
 *   arceau métallique + filet de panier déformable avec distinction sonore Swish / Planche / Arceau / Sol)
 * - Jauge de puissance irréversible (ne redescend jamais, tir engagé dès l'appui)
 * - Niveau évolutif à mesure que le joueur enchaîne les paniers + Défenseur contestataire aux niveaux supérieurs
 * - Bouton Pause (⏸) + Séparation stricte entre la modale Niveaux et le Menu Général
 */
---

<div class="relative h-[100dvh] w-screen overflow-hidden bg-[#070b16] font-body select-none" id="basket-root">
  <!-- CANVAS WEBGL 3D PLEIN ÉCRAN -->
  <canvas id="basket-canvas" class="block h-full w-full touch-none cursor-crosshair"></canvas>

  <!-- ================= HUD BROADCAST COMPACT ================= -->
  <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-start justify-between p-2.5 sm:p-4">
    
    <!-- GAUCHE : SCOREBUG FIBA / KINSHASA & POSITION -->
    <div class="flex flex-col gap-1.5">
      <div class="pointer-events-auto flex items-center overflow-hidden rounded-xl border border-white/15 bg-[#070d1f]/90 shadow-2xl backdrop-blur-md">
        <!-- Logo Bloc Léopards -->
        <div class="flex items-center justify-center bg-white/95 px-2 py-1.5">
          <img src="/brand/logo.png" alt="Bloc Léopards" class="h-6 w-auto object-contain" />
        </div>
        <!-- Horloge Buzzer 24s -->
        <div class="bg-feu px-2 py-1.5 text-center font-display text-xs font-black tracking-wider text-white">
          <span id="hud-shotclock">02.4</span>s
        </div>
        <!-- Série de Paniers -->
        <div class="flex items-center gap-2 px-2.5 py-1">
          <div class="flex items-center gap-1.5">
            <img src="/flags/cd.svg" alt="RDC" class="h-3.5 w-5 rounded-[2px] object-cover" onerror="this.style.display='none'" />
            <span class="font-display text-sm tracking-wider text-white sm:text-base">KIN</span>
          </div>
          <div class="flex items-center gap-1 rounded bg-black/65 px-2 py-0.5 font-display text-lg font-black tracking-wider text-or">
            <span id="hud-streak">0</span>
            <span class="text-[0.55rem] font-sans font-bold uppercase tracking-wider text-slate-400">PTS</span>
          </div>
        </div>
        <!-- Record -->
        <div class="border-l border-white/10 px-2.5 py-1 text-right">
          <span class="block text-[0.48rem] font-bold uppercase tracking-wider text-slate-400 leading-none">Record</span>
          <span id="hud-record" class="font-display text-xs font-black text-emerald-400">0 🏆</span>
        </div>
      </div>

      <!-- Mini barre Niveau + Spot de tir (eyebrow réduit) -->
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          id="btn-open-levels"
          class="pointer-events-auto flex items-center gap-1.5 rounded-md border border-or/40 bg-[#070d1f]/85 px-2 py-0.5 backdrop-blur-md transition-all hover:border-or active:scale-95"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-or animate-pulse"></span>
          <span id="hud-level-badge" class="font-display text-[0.65rem] uppercase tracking-wider text-or">NIV. 1 · LANCER FRANC</span>
        </button>

        <div class="flex items-center gap-1 rounded-md border border-white/10 bg-[#070d1f]/85 px-2 py-0.5 text-[0.65rem] font-bold text-sky-300 backdrop-blur-md">
          <span>📍</span>
          <span id="hud-spot-label">Spot 1/7 · 4.6m</span>
        </div>
      </div>
    </div>

    <!-- DROITE : PAUSE + SON + MENU -->
    <div class="pointer-events-auto flex items-center gap-1.5">
      <button
        type="button"
        id="btn-pause"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/15 bg-[#070d1f]/88 text-xs font-bold text-white shadow-lg backdrop-blur-md transition-all hover:bg-slate-800 active:scale-95"
        aria-label="Mettre en pause"
      >
        <span id="icon-pause">⏸</span>
      </button>

      <button
        type="button"
        id="btn-sound"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/15 bg-[#070d1f]/88 text-sm text-white shadow-lg backdrop-blur-md transition-all hover:bg-slate-800 active:scale-95"
        aria-label="Activer ou couper le son"
      >
        <span id="icon-sound">🔊</span>
      </button>

      <button
        type="button"
        id="btn-open-menu"
        class="flex h-9 items-center gap-1.5 rounded-xl border border-white/20 bg-congo px-3 text-[0.7rem] font-black uppercase tracking-wider text-white shadow-lg shadow-congo/30 transition-all hover:bg-congo-bright active:scale-95"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <span>Menu</span>
      </button>
    </div>
  </div>

  <!-- ================= JAUGE DE TIR IRRÉVERSIBLE (DROITE) ================= -->
  <div id="power-meter-wrap" class="pointer-events-none absolute right-3.5 top-1/2 z-20 -translate-y-1/2 flex flex-col items-center gap-1 opacity-0 transition-opacity duration-100">
    <span class="rounded bg-red-600/95 px-1.5 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-white shadow">LONG</span>
    <div class="relative h-48 w-4 overflow-hidden rounded-full border-2 border-white/35 bg-slate-950/90 p-0.5 shadow-2xl backdrop-blur-md">
      <!-- Zone Swish idéale (74% - 88%) -->
      <div class="absolute inset-x-0 top-[12%] h-[16%] border-y-2 border-emerald-400 bg-emerald-500/30"></div>
      <!-- Zone trop forte (>88%) -->
      <div class="absolute inset-x-0 top-0 h-[12%] bg-red-600/60"></div>
      <div id="power-meter-fill" class="absolute inset-x-0.5 bottom-0.5 rounded-full bg-gradient-to-t from-sky-400 via-emerald-400 to-red-500" style="height: 0%"></div>
    </div>
    <span id="power-meter-pct" class="rounded bg-black/90 px-1.5 py-0.5 font-display text-xs tracking-wider text-or shadow">0%</span>
  </div>

  <!-- ================= INDICATION DISCRÈTE EN BAS ================= -->
  <div id="aim-instruction" class="pointer-events-none absolute inset-x-0 bottom-4 z-20 flex flex-col items-center justify-center px-3 transition-opacity duration-300">
    <div class="flex items-center gap-2 rounded-full border border-white/15 bg-[#070d1f]/85 px-3.5 py-1 text-[0.7rem] font-semibold text-slate-200 shadow-xl backdrop-blur-md text-center">
      <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-or"></span>
      <span>Maintiens pour armer ton shoot · Relâche dans la zone verte (irréversible)</span>
    </div>
  </div>

  <!-- ================= BANDEAU RÉSULTAT DU TIR ================= -->
  <div id="shot-toast" class="pointer-events-none absolute inset-x-0 top-16 z-30 flex justify-center opacity-0 transition-all duration-200 -translate-y-4 px-3">
    <div class="flex items-center gap-2.5 rounded-2xl border border-white/20 bg-[#070d1f]/95 px-4 py-2 shadow-2xl backdrop-blur-xl">
      <span id="toast-emoji" class="text-xl">🏀</span>
      <div>
        <h3 id="toast-title" class="font-display text-lg uppercase tracking-wider text-or leading-none">SWISH !</h3>
        <p id="toast-subtitle" class="mt-0.5 text-[0.68rem] font-semibold text-slate-300">Panier net à la sirène</p>
      </div>
    </div>
  </div>

  <!-- ================= ÉCRAN DE PAUSE ================= -->
  <div id="pause-modal" class="pointer-events-none fixed inset-0 z-40 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-md">
    <div class="pointer-events-auto w-full max-w-xs overflow-hidden rounded-3xl border border-white/20 bg-[#070f22] p-5 text-center shadow-2xl">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-white/95 p-1.5 shadow">
        <img src="/brand/logo.png" alt="Bloc Léopards" class="h-full w-auto object-contain" />
      </div>
      <span class="mt-2.5 block text-[0.55rem] font-bold uppercase tracking-widest text-or">Temps Mort</span>
      <h2 class="mt-0.5 font-display text-2xl uppercase tracking-wide text-white">PAUSE BASKET</h2>
      <p class="mt-1 text-[0.7rem] text-slate-400">
        Série en cours : <strong id="pause-streak-val" class="text-or">0</strong> panier(s)
      </p>

      <div class="mt-4 flex flex-col gap-2">
        <button
          type="button"
          id="btn-pause-resume"
          class="w-full rounded-xl bg-or py-2.5 text-xs font-black uppercase tracking-wider text-slate-950 shadow-lg hover:bg-yellow-300 active:scale-95 transition-transform"
        >
          ▶ Reprendre le match
        </button>
        <button
          type="button"
          id="btn-pause-restart"
          class="w-full rounded-xl border border-white/15 bg-white/10 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/20"
        >
          🔄 Recommencer à 0
        </button>
        <a
          href="/penalty"
          class="w-full rounded-xl border border-or/30 bg-congo/40 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-congo"
        >
          ⚽ Mode Foot · Penalty aux Martyrs
        </a>
      </div>
    </div>
  </div>

  <!-- ================= ÉCRAN FIN DE SÉRIE (PREMIER RATÉ) ================= -->
  <div id="gameover-modal" class="pointer-events-none fixed inset-0 z-40 hidden items-center justify-center bg-black/75 p-4 backdrop-blur-md">
    <div class="pointer-events-auto w-full max-w-sm overflow-hidden rounded-3xl border border-white/20 bg-[#081126] p-5 text-center shadow-2xl">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-red-500/20 text-2xl border border-red-500/40">
        🏀
      </div>
      <span class="mt-2 block text-[0.55rem] font-bold uppercase tracking-widest text-red-400">Buzzer Beater Manqué</span>
      <h2 id="go-title" class="mt-0.5 font-display text-2xl uppercase tracking-wide text-white">REBOND SUR L'ARCEAU !</h2>
      <p id="go-desc" class="mt-1 text-xs text-slate-300">
        Ta série à Limete 7ᵉ Rue s'arrête ici.
      </p>

      <div class="mt-4 grid grid-cols-3 gap-2 rounded-2xl border border-white/10 bg-black/40 p-2.5">
        <div>
          <span class="block text-[0.55rem] font-bold uppercase tracking-wider text-slate-400">Série</span>
          <span id="go-stat-streak" class="font-display text-xl text-or">0</span>
        </div>
        <div class="border-x border-white/10">
          <span class="block text-[0.55rem] font-bold uppercase tracking-wider text-slate-400">Niveau</span>
          <span id="go-stat-level" class="font-display text-xl text-white">Niv. 1</span>
        </div>
        <div>
          <span class="block text-[0.55rem] font-bold uppercase tracking-wider text-slate-400">Record</span>
          <span id="go-stat-record" class="font-display text-xl text-emerald-400">0</span>
        </div>
      </div>

      <div class="mt-4 flex gap-2">
        <button
          type="button"
          id="btn-go-levels"
          class="rounded-xl border border-white/15 bg-white/10 px-3.5 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/20"
        >
          🏆 Niveaux
        </button>
        <button
          type="button"
          id="btn-go-retry"
          class="flex-1 rounded-xl bg-or px-4 py-2.5 text-xs font-black uppercase tracking-wider text-slate-950 shadow-lg shadow-or/25 hover:bg-yellow-300 active:scale-95 transition-transform"
        >
          🔄 Rejouer
        </button>
      </div>
    </div>
  </div>

  <!-- ================= MODALE DÉDIÉE AUX NIVEAUX ================= -->
  <div id="levels-modal-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-3 sm:p-6 backdrop-blur-lg">
    <div class="relative flex max-h-[88dvh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl border border-or/30 bg-[#070f22] shadow-2xl">
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-3.5 bg-[#050a18]">
        <div>
          <span class="text-[0.55rem] font-bold uppercase tracking-widest text-or">Progression Streetball Kinshasa</span>
          <h2 class="font-display text-lg uppercase tracking-wider text-white leading-none">
            🏆 Paliers & Spots de Tir (Limete 7ᵉ Rue)
          </h2>
        </div>
        <button
          type="button"
          id="btn-close-levels"
          class="flex h-8 w-8 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-slate-300 hover:bg-white/15 hover:text-white"
        >
          ✕
        </button>
      </div>

      <div class="flex-1 overflow-y-auto p-4 space-y-3">
        <div class="flex items-center justify-between rounded-xl border border-white/10 bg-black/30 px-3.5 py-2 text-xs text-slate-300">
          <span>Chaque panier réussi te déplace vers la prochaine position et fait évoluer le niveau :</span>
          <span class="font-bold text-or">Record : <strong id="levels-best-streak">0</strong> paniers</span>
        </div>
        <div id="levels-grid" class="grid gap-2.5 sm:grid-cols-2"></div>
      </div>

      <div class="flex items-center justify-end border-t border-white/10 bg-[#050a18] px-5 py-2.5">
        <button type="button" id="btn-resume-from-levels" class="rounded-xl bg-or px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-950 hover:bg-yellow-300">
          Retour au terrain
        </button>
      </div>
    </div>
  </div>

  <!-- ================= MENU GÉNÉRAL ================= -->
  <div id="game-menu-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-3 sm:p-6 backdrop-blur-lg">
    <div class="relative flex max-h-[88dvh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl border border-white/15 bg-[#070f22] shadow-2xl">
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-3.5 bg-[#050a18]">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-white p-1">
            <img src="/brand/logo.png" alt="Bloc Léopards" class="h-full w-auto object-contain" />
          </div>
          <div>
            <span class="text-[0.55rem] font-bold uppercase tracking-widest text-or">Terrain de la 7ᵉ Rue · Limete, Kinshasa</span>
            <h2 class="font-display text-lg uppercase tracking-wider text-white leading-none">
              Menu · Shoot à la Sirène
            </h2>
          </div>
        </div>
        <button
          type="button"
          id="btn-close-menu"
          class="flex h-8 w-8 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-slate-300 hover:bg-white/15 hover:text-white"
        >
          ✕
        </button>
      </div>

      <div class="flex-1 overflow-y-auto p-4 space-y-3.5">
        <div class="grid gap-3.5 sm:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-black/30 p-3.5">
            <span class="text-[0.58rem] font-bold uppercase tracking-wider text-or">Lumière de Kinshasa</span>
            <h4 class="mt-0.5 font-display text-base uppercase text-white">Golden Hour / Projecteurs</h4>
            <p class="mt-1 text-xs text-slate-400">
              Joue sous le soleil de fin d'après-midi à Limete ou sous les projecteurs urbains nocturnes.
            </p>
            <div class="mt-3 flex gap-2">
              <button type="button" id="btn-set-day" class="flex-1 rounded-xl border border-white/15 bg-white/5 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/15">
                ☀️ Golden Hour
              </button>
              <button type="button" id="btn-set-night" class="flex-1 rounded-xl border border-or/40 bg-congo py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-congo-bright">
                🌙 Nuit Urbaine
              </button>
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-black/30 p-3.5">
            <span class="text-[0.58rem] font-bold uppercase tracking-wider text-or">Signatures Sonores</span>
            <h4 class="mt-0.5 font-display text-base uppercase text-white">Swish, Planche, Arceau & Sol</h4>
            <p class="mt-1 text-xs text-slate-400">
              Chaque contact (rebond bitume, planche plexiglas, arceau acier, filet net) produit son propre son.
            </p>
            <button type="button" id="btn-menu-audio-toggle" class="mt-3 w-full rounded-xl border border-emerald-500/40 bg-emerald-500/20 py-2 text-xs font-bold uppercase tracking-wider text-emerald-300">
              🔊 Son Activé
            </button>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-black/30 p-3.5">
          <h4 class="font-display text-sm uppercase tracking-wider text-white">Changer de Discipline</h4>
          <div class="mt-2.5 flex flex-wrap gap-2">
            <a href="/penalty" class="rounded-xl border border-or/40 bg-congo px-4 py-2 text-xs font-black uppercase tracking-wider text-white hover:bg-congo-bright">
              ⚽ Basculer sur Penalty aux Martyrs
            </a>
            <button type="button" id="btn-menu-restart" class="rounded-xl border border-white/15 bg-white/10 px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/20">
              🔄 Recommencer à 0
            </button>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between border-t border-white/10 bg-[#050a18] px-5 py-2.5">
        <span class="text-[0.65rem] text-slate-400">Raccourci Pause : touche <strong>Espace</strong> ou <strong>P</strong></span>
        <button type="button" id="btn-resume-game" class="rounded-xl bg-or px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-950 hover:bg-yellow-300">
          Reprendre
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import * as THREE from "three";

  /* -------------------------------------------------------------------------- */
  /*  POSITIONS DE TIR AUTOUR DU TERRAIN DE LIMETE 7ᵉ RUE                       */
  /* -------------------------------------------------------------------------- */
  interface CourtSpot {
    name: string;
    x: number;
    z: number;
    distLabel: string;
  }

  // Panier situé en (0, 3.05, 0)
  const SPOTS: CourtSpot[] = [
    { name: "Lancer Franc", x: 0, z: 4.6, distLabel: "4.6m" },
    { name: "Aile Gauche 45°", x: -4.2, z: 4.5, distLabel: "6.1m" },
    { name: "Aile Droite 45°", x: 4.2, z: 4.5, distLabel: "6.1m" },
    { name: "Tête de Raquette 3pts", x: 0, z: 6.75, distLabel: "6.75m" },
    { name: "Corner Gauche", x: -5.6, z: 2.2, distLabel: "6.0m" },
    { name: "Corner Droit", x: 5.6, z: 2.2, distLabel: "6.0m" },
    { name: "Logo Buzzer Limete", x: 0, z: 8.2, distLabel: "8.2m" }
  ];

  interface BasketTier {
    id: number;
    minMade: number;
    name: string;
    desc: string;
    tolerancePct: number; // Largeur de la fenêtre de réussite
    hasDefender: boolean;
    defenderJumpH: number;
  }

  const TIERS: BasketTier[] = [
    {
      id: 1,
      minMade: 0,
      name: "Shootaround 7ᵉ Rue",
      desc: "Tirs ouverts sans défenseur pour régler ta mécanique de bras.",
      tolerancePct: 9.0,
      hasDefender: false,
      defenderJumpH: 0
    },
    {
      id: 2,
      minMade: 1,
      name: "Quartier Limete",
      desc: "Rotation sur les ailes et à 3 points · Tolérance resserrée.",
      tolerancePct: 7.5,
      hasDefender: false,
      defenderJumpH: 0
    },
    {
      id: 3,
      minMade: 2,
      name: "Contestation Défensive",
      desc: "Un défenseur monte au contre devant toi : arme une cloche haute !",
      tolerancePct: 6.8,
      hasDefender: true,
      defenderJumpH: 0.45
    },
    {
      id: 4,
      minMade: 4,
      name: "Money Time Kinshasa",
      desc: "Défenseur athlétique en extension + tirs longue distance.",
      tolerancePct: 5.8,
      hasDefender: true,
      defenderJumpH: 0.72
    },
    {
      id: 5,
      minMade: 6,
      name: "Légende Buzzer Beater",
      desc: "Précision chirurgicale exigée pour faire swisher le filet à la sirène !",
      tolerancePct: 4.8,
      hasDefender: true,
      defenderJumpH: 0.92
    }
  ];

  const state = {
    phase: "aiming" as "aiming" | "charging" | "flying" | "result" | "gameover",
    paused: false,
    streak: 0,
    spotIndex: 0,
    baseTierIndex: 0,
    maxUnlockedTier: Number(localStorage.getItem("kin_basket_max_tier") || 1),
    bestStreak: Number(localStorage.getItem("kin_basket_best") || 0),
    isNight: false,
    audioEnabled: true
  };

  function getActiveTier(): BasketTier {
    let tier = TIERS[state.baseTierIndex] || TIERS[0];
    for (const t of TIERS) {
      if (state.streak >= t.minMade && t.id > tier.id) tier = t;
    }
    return tier;
  }

  /* -------------------------------------------------------------------------- */
  /*  DOM                                                                       */
  /* -------------------------------------------------------------------------- */
  const canvas = document.getElementById("basket-canvas") as HTMLCanvasElement;
  const hudStreak = document.getElementById("hud-streak");
  const hudRecord = document.getElementById("hud-record");
  const hudLevelBadge = document.getElementById("hud-level-badge");
  const hudSpotLabel = document.getElementById("hud-spot-label");
  const powerMeterWrap = document.getElementById("power-meter-wrap");
  const powerMeterFill = document.getElementById("power-meter-fill");
  const powerMeterPct = document.getElementById("power-meter-pct");
  const aimInstruction = document.getElementById("aim-instruction");

  const shotToast = document.getElementById("shot-toast");
  const toastEmoji = document.getElementById("toast-emoji");
  const toastTitle = document.getElementById("toast-title");
  const toastSubtitle = document.getElementById("toast-subtitle");

  const btnPause = document.getElementById("btn-pause");
  const iconPause = document.getElementById("icon-pause");
  const pauseModal = document.getElementById("pause-modal");
  const pauseStreakVal = document.getElementById("pause-streak-val");
  const btnPauseResume = document.getElementById("btn-pause-resume");
