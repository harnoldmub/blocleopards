    { name: "R.D. CONGO", src: "/logo-rdc.png" },
    { name: "EQUITY BCDC", src: "/media/partenaires/Logo_EquityBCDC.png" },
    { name: "SONAS", src: "/media/partenaires/LOGO SONAS.png" },
    { name: "MFS GROUPE", src: "/media/partenaires/MFS GROUPE.png" },
    { name: "FONAREV", src: "/media/partenaires/logo-fonarev.webp" },
