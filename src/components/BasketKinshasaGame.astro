  function createCourtsideAdTexture() {
    const cv = document.createElement("canvas");
    cv.width = 2048;
    cv.height = 256;
    const ctx = cv.getContext("2d")!;
    const tex = new THREE.CanvasTexture(cv);
    tex.colorSpace = THREE.SRGBColorSpace;
    const slotW = cv.width / PARTNER_ADS.length;

    ctx.fillStyle = "#060d1f";
    ctx.fillRect(0, 0, cv.width, cv.height);
    PARTNER_ADS.forEach((ad, i) => {
      const x0 = i * slotW;
      ctx.fillStyle = "#facc15";
      ctx.fillRect(x0, 0, slotW, 10);
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(x0 + 12, 18, slotW - 24, cv.height - 32);
      const img = new Image();
      img.crossOrigin = "anonymous";
      img.onload = () => {
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(x0 + 12, 18, slotW - 24, cv.height - 32);
        const scale = Math.min((slotW - 50) / img.width, (cv.height - 48) / img.height);
        const w = img.width * scale;
        const h = img.height * scale;
        ctx.drawImage(img, x0 + (slotW - w) / 2, 18 + (cv.height - 32 - h) / 2, w, h);
        tex.needsUpdate = true;
      };
      img.src = ad.src;
    });
    tex.needsUpdate = true;
    return tex;
  }

  const courtsideAd = new THREE.Mesh(
