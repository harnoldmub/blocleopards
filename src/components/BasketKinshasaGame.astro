  // Arceau orange
  const rimMat = new THREE.MeshStandardMaterial({ color: 0xea580c, metalness: 0.7, roughness: 0.25 });
  const rimMesh = new THREE.Mesh(new THREE.TorusGeometry(HOOP.rimR, 0.016, 14, 32), rimMat);
  rimMesh.rotation.x = Math.PI / 2;
  rimMesh.position.set(0, HOOP.rimY, HOOP.rimZ);
  hoopGroup.add(rimMesh);

  // Filet tressé
  const netGeo = new THREE.CylinderGeometry(HOOP.rimR, HOOP.rimR * 0.62, 0.44, 20, 8, true);
  const netOrigPos = new Float32Array((netGeo.attributes.position as THREE.BufferAttribute).array);
  const netMesh = new THREE.Mesh(
    netGeo,
    new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true, transparent: true, opacity: 0.85 })
  );
  netMesh.position.set(0, HOOP.rimY - 0.22, HOOP.rimZ);
  hoopGroup.add(netMesh);

  scene.add(hoopGroup);

  let netSwishTimer = 0;
  function triggerNetSwish() {
    netSwishTimer = 1.0;
  }
  function updateNetMesh(dt: number) {
    if (netSwishTimer <= 0) return;
    netSwishTimer = Math.max(0, netSwishTimer - dt * 2.8);
    const posAttr = netGeo.attributes.position as THREE.BufferAttribute;
    for (let i = 0; i < posAttr.count; i++) {
      const ox = netOrigPos[i * 3];
      const oy = netOrigPos[i * 3 + 1];
      const oz = netOrigPos[i * 3 + 2];
      const bottomFactor = (0.22 - oy) / 0.44;
      const flare = 1 + Math.sin(netSwishTimer * Math.PI * 3) * 0.38 * bottomFactor;
      posAttr.setXYZ(i, ox * flare, oy, oz * flare);
    }
    posAttr.needsUpdate = true;
  }

  /* -------------------------------------------------------------------------- */
  /*  BALLON DE BASKET 3D (PAS DE PERSONNE DEVANT LA CAMÉRA)                   */
  /* -------------------------------------------------------------------------- */
  const BALL_R = 0.122;
  function createBasketballTexture() {
    const cv = document.createElement("canvas");
    cv.width = 512;
    cv.height = 256;
    const ctx = cv.getContext("2d")!;
    ctx.fillStyle = "#d9531e";
    ctx.fillRect(0, 0, 512, 256);
    ctx.strokeStyle = "#111827";
    ctx.lineWidth = 7;
    ctx.beginPath();
    ctx.moveTo(0, 128); ctx.lineTo(512, 128);
    ctx.moveTo(256, 0); ctx.lineTo(256, 256);
    ctx.stroke();
    const tex = new THREE.CanvasTexture(cv);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

  const ballMesh = new THREE.Mesh(
