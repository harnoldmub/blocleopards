  /* -------------------------------------------------------------------------- */
  /*  CADRAGE & GESTION DE LA SÉANCE DE 5 TIRS                                  */
  /* -------------------------------------------------------------------------- */
  function applyPlayableFraming() {
    const spot = SPOTS_5[state.shotIndex % SPOTS_5.length];
    const dirToHoop = new THREE.Vector3(0 - spot.x, 0, HOOP.rimZ - spot.z).normalize();
    const aspect = window.innerWidth / Math.max(1, window.innerHeight);
    const isPortrait = aspect < 0.95;

    // En vue 1ère personne : le ballon est positionné devant la caméra à hauteur de tir (1.65m)
    const distCam = isPortrait ? 1.45 : 1.35;
    camera.position.set(spot.x - dirToHoop.x * distCam, 1.82, spot.z - dirToHoop.z * distCam);
    camera.lookAt(0, HOOP.rimY + 0.15, HOOP.rimZ);

    ballMesh.position.set(spot.x, 1.55, spot.z);
    ballMesh.rotation.set(0, 0, 0);
  }

  function updateHud() {
    const tier = getActiveTier();
    const spot = SPOTS_5[state.shotIndex % SPOTS_5.length];

    if (hudScoreMade) hudScoreMade.textContent = String(state.goalsInSeries);
    if (hudLevelBadge) hudLevelBadge.textContent = `NIV. ${tier.id} · ${tier.name.toUpperCase()}`;
    if (hudSpotLabel) hudSpotLabel.textContent = `Tir ${state.shotIndex + 1}/5 · ${spot.name} (${spot.distLabel})`;
    if (levelsBestStreak) levelsBestStreak.textContent = `${state.bestScore}/5`;
    if (pauseStreakVal) pauseStreakVal.textContent = `${state.goalsInSeries}/5`;

    hudKickDots.forEach((dot, idx) => {
      dot.className = "dot-shot inline-block h-2 w-2 rounded-full border border-white/40 transition-all";
      if (idx < state.shotsHistory.length) {
        dot.classList.add(state.shotsHistory[idx] ? "bg-emerald-400" : "bg-red-500");
      } else if (idx === state.shotIndex) {
        dot.classList.add("bg-or", "animate-pulse");
      } else {
        dot.classList.add("bg-slate-700");
      }
    });
  }

  function setupNextShot() {
    if (state.shotIndex >= 5) {
      endSeries();
      return;
    }

    state.phase = "aiming";
    ballPhys.active = false;
    ballPhys.scoredTriggered = false;
    ballPhys.hitBackboard = false;
    ballPhys.hitRim = false;

    applyPlayableFraming();
    updateHud();

    swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
    if (powerMeterWrap) powerMeterWrap.classList.add("opacity-0");
    if (powerMeterFill) powerMeterFill.style.height = "0%";
  }

  function startSeries(tierIdx = 0) {
    state.currentTierIndex = THREE.MathUtils.clamp(tierIdx, 0, TIERS.length - 1);
    state.shotIndex = 0;
    state.shotsHistory = [];
    state.goalsInSeries = 0;
    state.paused = false;

    gameoverModal?.classList.add("hidden");
    gameoverModal?.classList.remove("flex");
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");

    setupNextShot();
  }

  function endSeries() {
    state.phase = "gameover";
    const tier = getActiveTier();

    if (state.goalsInSeries > state.bestScore) {
      state.bestScore = state.goalsInSeries;
      localStorage.setItem("kin_basket_best_score", String(state.bestScore));
    }

    const passed = state.goalsInSeries >= 3;
    if (passed && tier.id === state.maxUnlockedTier && state.maxUnlockedTier < TIERS.length) {
      state.maxUnlockedTier++;
      localStorage.setItem("kin_basket_max_tier", String(state.maxUnlockedTier));
    }

    if (goTitle) goTitle.textContent = passed ? "VICTOIRE À LIMETE ! 🔥" : "SÉANCE TERMINÉE";
    if (goDesc) {
      goDesc.textContent = passed
        ? `Magnifique performance ! ${state.goalsInSeries}/5 tirs rentrés. Niveau suivant débloqué !`
        : `Tu as inscrit ${state.goalsInSeries}/5 tirs. Entraîne-toi pour valider au moins 3/5 !`;
    }
    if (goStatStreak) goStatStreak.textContent = `${state.goalsInSeries}/5`;
    if (goStatLevel) goStatLevel.textContent = `Niv. ${tier.id}`;
    if (goStatRecord) goStatRecord.textContent = `${state.bestScore}/5 🏆`;

    gameoverModal?.classList.remove("hidden");
    gameoverModal?.classList.add("flex");
    renderLevelsModal();
  }

  /* -------------------------------------------------------------------------- */
  /*  SWIPE & JAUGE IRRÉVERSIBLE (NE JAMAIS ARRIVER AU MAX)                     */
  /* -------------------------------------------------------------------------- */
  let chargeActive = false;
  let swipePoints: { x: number; y: number }[] = [];
  let lockedPowerPct = 0;

  const ballPhys = {
    active: false,
    vx: 0,
    vy: 0,
    vz: 0,
    isMake: false,
    isSwish: false,
    isBankMake: false,
    hitBackboard: false,
    hitRim: false,
    scoredTriggered: false,
    elapsed: 0
  };

  function updateChargeGauge(dt: number) {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;

    lockedPowerPct = Math.min(100, lockedPowerPct + dt * 56);
    const displayPct = Math.round(lockedPowerPct);

    if (powerMeterFill) powerMeterFill.style.height = `${displayPct}%`;
    const isOverload = lockedPowerPct >= 92;
    const isPerfect = lockedPowerPct >= 72 && lockedPowerPct < 92;

    if (powerMeterPct) {
      powerMeterPct.textContent = isOverload ? "MAX !" : `${displayPct}%`;
      powerMeterPct.className = isOverload
        ? "rounded bg-red-600 px-2 py-0.5 font-display text-xs tracking-wider text-white shadow animate-pulse font-black"
        : isPerfect
          ? "rounded bg-emerald-500 px-2 py-0.5 font-display text-xs tracking-wider text-slate-950 font-black shadow"
          : "rounded bg-[#060d1f] px-2 py-0.5 font-display text-xs tracking-wider text-or shadow font-bold";
    }

    if (powerMeterZoneBadge) {
      if (isOverload) {
        powerMeterZoneBadge.textContent = "TROP FORT (RATÉ) !";
        powerMeterZoneBadge.className = "rounded bg-red-600 px-2 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-white shadow";
      } else if (isPerfect) {
        powerMeterZoneBadge.textContent = "ZONE PARFAITE ✨";
        powerMeterZoneBadge.className = "rounded bg-emerald-400 px-2 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-slate-950 shadow";
      } else if (lockedPowerPct >= 50) {
        powerMeterZoneBadge.textContent = "CORRECT";
        powerMeterZoneBadge.className = "rounded bg-amber-400 px-2 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-slate-950 shadow";
      } else {
        powerMeterZoneBadge.textContent = "TROP COURT";
        powerMeterZoneBadge.className = "rounded bg-sky-500 px-2 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-white shadow";
      }
    }

    // Le ballon monte légèrement dans la phase d'armé du shoot
    const spot = SPOTS_5[state.shotIndex % SPOTS_5.length];
    ballMesh.position.y = 1.55 + Math.min(0.35, (lockedPowerPct / 100) * 0.35);

    drawSwipeTrail();

    // Si la jauge atteint 100% (MAX), le tir part tout seul obligatoirement raté !
    if (lockedPowerPct >= 100) {
      commitShotRelease();
    }
  }

  function drawSwipeTrail() {
    swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
    if (swipePoints.length < 2) return;

    swipeCtx.save();
    swipeCtx.lineCap = "round";
    swipeCtx.lineJoin = "round";

    const isOverload = lockedPowerPct >= 92;
    const isPerfect = lockedPowerPct >= 72 && lockedPowerPct < 92;
    const color = isOverload ? "#ef4444" : isPerfect ? "#34d399" : "#facc15";

    swipeCtx.strokeStyle = color;
    swipeCtx.lineWidth = 6;
    swipeCtx.beginPath();
    swipeCtx.moveTo(swipePoints[0].x, swipePoints[0].y);
    for (let i = 1; i < swipePoints.length; i++) {
      swipeCtx.lineTo(swipePoints[i].x, swipePoints[i].y);
    }
    swipeCtx.stroke();
    swipeCtx.restore();
  }

  function commitShotRelease() {
    if (!chargeActive) return;
    chargeActive = false;
    state.phase = "flying";

    setTimeout(() => {
      swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
      powerMeterWrap?.classList.add("opacity-0");
    }, 280);

    const tier = getActiveTier();
    const spot = SPOTS_5[state.shotIndex % SPOTS_5.length];
    const isOverload = lockedPowerPct >= 92;
    const isPerfect = lockedPowerPct >= 72 && lockedPowerPct < 92;

    ballPhys.active = true;
    ballPhys.elapsed = 0;
    ballPhys.hitBackboard = false;
    ballPhys.hitRim = false;
    ballPhys.scoredTriggered = false;

    // Détermination stricte du résultat selon le respect de la jauge :
    // - Si MAX (>=92%) : OBLIGATOIREMENT RATÉ (trop fort sur le panneau ou arrière de l'arceau)
    // - Si Parfait (72-91%) : SWISH OU PLANCHE MAGNIFIQUE !
    if (isOverload) {
      ballPhys.isMake = false;
      ballPhys.isSwish = false;
      ballPhys.isBankMake = false;
    } else if (isPerfect) {
      ballPhys.isMake = true;
      ballPhys.isSwish = Math.abs(lockedPowerPct - 81) <= tier.tolerancePct * 0.6;
      ballPhys.isBankMake = !ballPhys.isSwish;
    } else {
      // Trop faible / moyen
      ballPhys.isMake = false;
      ballPhys.isSwish = false;
      ballPhys.isBankMake = false;
    }

    const startX = ballMesh.position.x;
    const startY = ballMesh.position.y;
    const startZ = ballMesh.position.z;

    let targetX = 0;
    let targetY = HOOP.rimY + 0.05;
    let targetZ = HOOP.rimZ;

    if (ballPhys.isBankMake) {
      targetZ = HOOP.boardZ + BALL_R + 0.04;
      targetY = HOOP.rimY + 0.36;
    } else if (!ballPhys.isMake) {
      if (isOverload) {
        // Trop fort : tape le haut du panneau plexiglas
        targetZ = HOOP.boardZ + BALL_R + 0.04;
        targetY = HOOP.boardY + 0.35;
        targetX = (Math.random() - 0.5) * 0.35;
      } else {
        // Trop court : tape l'avant de l'arceau
        targetZ = HOOP.rimZ + HOOP.rimR + 0.06;
        targetY = HOOP.rimY - 0.04;
      }
    }

    const flightDuration = 0.90 + Math.hypot(spot.x, spot.z) * 0.04;
    const g = 9.81;
    ballPhys.vx = (targetX - startX) / flightDuration;
    ballPhys.vz = (targetZ - startZ) / flightDuration;
    ballPhys.vy = (targetY - startY + 0.5 * g * flightDuration * flightDuration) / flightDuration;
  }

  canvas.addEventListener("pointerdown", (e) => {
    initAudio();
    if (state.phase !== "aiming" || state.paused) return;
    state.phase = "charging";
    chargeActive = true;
    swipePoints = [{ x: e.clientX, y: e.clientY }];
    lockedPowerPct = 20;

    powerMeterWrap?.classList.remove("opacity-0");
  });

  window.addEventListener("pointermove", (e) => {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;
    const last = swipePoints[swipePoints.length - 1];
    if (last) {
      const d = Math.hypot(e.clientX - last.x, e.clientY - last.y);
      if (d > 4) {
        swipePoints.push({ x: e.clientX, y: e.clientY });
        if (lockedPowerPct < 80) {
          lockedPowerPct = Math.min(80, lockedPowerPct + d * 0.06);
        }
      }
    }
  });

  window.addEventListener("pointerup", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) commitShotRelease();
  });
  window.addEventListener("pointercancel", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) commitShotRelease();
  });

  /* -------------------------------------------------------------------------- */
  /*  PHYSIQUE & COLLISIONS DU BALLON                                           */
  /* -------------------------------------------------------------------------- */
  function updateBasketballPhysics(dt: number) {
    if (!ballPhys.active) return;
    ballPhys.elapsed += dt;

    const SUBSTEPS = 6;
    const subDt = dt / SUBSTEPS;

    for (let s = 0; s < SUBSTEPS; s++) {
      ballPhys.vy -= 9.81 * subDt;
      ballMesh.position.x += ballPhys.vx * subDt;
      ballMesh.position.y += ballPhys.vy * subDt;
      ballMesh.position.z += ballPhys.vz * subDt;

      // Backspin naturel
      ballMesh.rotation.x -= 10.5 * subDt;

      // 1. Choc avec la planche plexiglas (Z = 0)
      if (
        !ballPhys.hitBackboard &&
        ballMesh.position.z <= HOOP.boardZ + BALL_R + 0.04 &&
        ballMesh.position.z >= HOOP.boardZ - 0.2 &&
        Math.abs(ballMesh.position.x) < 0.9 &&
        ballMesh.position.y > 2.75 &&
        ballMesh.position.y < 3.95
      ) {
        ballPhys.hitBackboard = true;
        playBackboardHitAudio();
        ballMesh.position.z = HOOP.boardZ + BALL_R + 0.04;

        if (ballPhys.isBankMake) {
          // Rebond précis vers le centre de l'arceau
          ballPhys.vz = (HOOP.rimZ - ballMesh.position.z) * 3.8;
          ballPhys.vx = -ballMesh.position.x * 3.5;
          ballPhys.vy = -1.2;
        } else {
          ballPhys.vz = Math.abs(ballPhys.vz) * 0.52;
          ballPhys.vx += (Math.random() - 0.5) * 2.4;
        }
      }

      // 2. Passage au niveau de l'arceau (Y ≈ 3.05m)
      if (!ballPhys.scoredTriggered && ballPhys.vy < 0 && Math.abs(ballMesh.position.y - HOOP.rimY) < 0.09) {
        if (ballPhys.isMake) {
          ballPhys.scoredTriggered = true;
          ballMesh.position.x = 0;
          ballMesh.position.z = HOOP.rimZ;
          ballPhys.vx = 0;
          ballPhys.vz = 0;
          ballPhys.vy = -3.6;
          triggerNetSwish();
          playSwishAudio();
          onShotResolved(true, ballPhys.isSwish ? "SWISH NET ! 🔥" : "AVEC LA PLANCHE ! 🏀");
        } else if (!ballPhys.hitRim) {
          ballPhys.hitRim = true;
          playRimClangAudio();
          ballPhys.vy = Math.abs(ballPhys.vy) * 0.48;
          ballPhys.vz = 2.4 + Math.random() * 1.5;
          ballPhys.vx = (Math.random() - 0.5) * 3.0;
          onShotResolved(false, lockedPowerPct >= 92 ? "TROP FORT (JAUGE AU MAX) !" : "REBOND SUR L'ARCEAU !");
        }
      }

      // 3. Rebond au sol bitume
      if (ballMesh.position.y < BALL_R) {
        ballMesh.position.y = BALL_R;
        if (Math.abs(ballPhys.vy) > 0.8) {
          playCourtBounceAudio(Math.min(1, Math.abs(ballPhys.vy) / 6));
        }
        ballPhys.vy = Math.abs(ballPhys.vy) * 0.62;
        ballPhys.vx *= 0.78;
        ballPhys.vz *= 0.78;
      }
    }
  }

  function onShotResolved(made: boolean, title: string) {
    state.phase = "result";
    state.shotsHistory.push(made);
    if (made) state.goalsInSeries++;

    updateHud();

    if (shotToast && toastTitle && toastSubtitle && toastEmoji) {
      toastEmoji.textContent = made ? "🏀" : "❌";
      toastTitle.textContent = title;
      toastTitle.className = made
        ? "font-display text-lg uppercase tracking-wider text-or leading-none font-black"
        : "font-display text-lg uppercase tracking-wider text-red-500 leading-none font-black";
      toastSubtitle.textContent = made
        ? `Tir ${state.shotIndex + 1}/5 réussi · En route vers le prochain spot !`
        : `Tir ${state.shotIndex + 1}/5 manqué · Ajuste ton dosage !`;
      shotToast.classList.remove("opacity-0", "-translate-y-4");
    }

    setTimeout(() => {
      shotToast?.classList.add("opacity-0", "-translate-y-4");
      state.shotIndex++;
      setupNextShot();
    }, 1500);
  }

  /* -------------------------------------------------------------------------- */
  /*  MODALES & MENU                                                            */
  /* -------------------------------------------------------------------------- */
  function renderLevelsModal() {
    if (!levelsGrid) return;
    levelsGrid.innerHTML = "";
    TIERS.forEach((t, idx) => {
      const unlocked = t.id <= state.maxUnlockedTier;
      const isCurrent = idx === state.currentTierIndex;
      const card = document.createElement("button");
      card.type = "button";
      card.disabled = !unlocked;
      card.className = `flex flex-col justify-between rounded-2xl border-2 p-3.5 text-left transition-all ${
        isCurrent
          ? "border-or bg-[#162a14] shadow-lg"
          : unlocked
            ? "border-[#1e3a6e] bg-[#040917] hover:border-sky-400 hover:bg-[#09142e]"
            : "border-[#0f1f3d] bg-[#030712] opacity-45 cursor-not-allowed"
      }`;
      card.innerHTML = `
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="rounded ${isCurrent ? "bg-or text-slate-950 font-black" : "bg-[#0c1b3a] text-or"} px-2 py-0.5 font-display text-xs uppercase">
              Niveau ${t.id}
            </span>
            <span class="text-[0.68rem] font-bold ${unlocked ? "text-emerald-400" : "text-slate-500"}">
              ${unlocked ? (isCurrent ? "● En cours" : "✓ Débloqué") : "🔒 Verrouillé"}
            </span>
          </div>
          <h4 class="mt-1.5 font-display text-lg uppercase text-white">${t.name}</h4>
          <p class="mt-0.5 text-xs text-slate-300">${t.desc}</p>
        </div>
      `;
      if (unlocked) card.addEventListener("click", () => startSeries(idx));
      levelsGrid.appendChild(card);
    });
  }

  function renderPlaylistUi() {
    if (!menuPlaylistList) return;
    menuPlaylistList.innerHTML = "";
    PLAYLIST.forEach((p, idx) => {
      const active = idx === currentTrackIdx;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = `flex items-center justify-between rounded-xl border p-2.5 text-left transition-all ${
        active
          ? "border-or bg-[#1c1a0e] text-or font-bold"
          : "border-[#1e3a6e] bg-[#060d1f] text-slate-300 hover:bg-[#0c1b3a] hover:text-white"
      }`;
      btn.innerHTML = `
        <span class="text-xs truncate">${active ? "▶ " : ""}${p.title}</span>
        <span class="text-[0.62rem] font-bold text-slate-400">Piste ${idx + 1}</span>
      `;
      btn.addEventListener("click", () => setTrack(idx));
      menuPlaylistList.appendChild(btn);
    });
  }

  btnOpenLevels?.addEventListener("click", () => {
    state.paused = true;
    renderLevelsModal();
    levelsModalOverlay?.classList.remove("hidden");
    levelsModalOverlay?.classList.add("flex");
  });
  btnCloseLevels?.addEventListener("click", () => {
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    state.paused = false;
  });
  btnResumeFromLevels?.addEventListener("click", () => {
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    state.paused = false;
  });
  btnGoLevels?.addEventListener("click", () => {
    gameoverModal?.classList.add("hidden");
    gameoverModal?.classList.remove("flex");
    renderLevelsModal();
    levelsModalOverlay?.classList.remove("hidden");
    levelsModalOverlay?.classList.add("flex");
  });
  btnGoRetry?.addEventListener("click", () => startSeries(state.currentTierIndex));

  btnOpenMenu?.addEventListener("click", () => {
    state.paused = true;
    renderPlaylistUi();
    gameMenuOverlay?.classList.remove("hidden");
    gameMenuOverlay?.classList.add("flex");
  });
  btnCloseMenu?.addEventListener("click", () => {
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");
    state.paused = false;
  });
  btnResumeGame?.addEventListener("click", () => {
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");
    state.paused = false;
  });

  btnSetDay?.addEventListener("click", () => {
    state.isNight = false;
    scene.background = new THREE.Color("#fb923c");
    hemiLight.intensity = 0.9;
    sunLight.intensity = 1.9;
  });
  btnSetNight?.addEventListener("click", () => {
    state.isNight = true;
    scene.background = new THREE.Color("#050914");
    hemiLight.intensity = 0.45;
    sunLight.intensity = 1.35;
  });

  btnPause?.addEventListener("click", () => {
    state.paused = !state.paused;
    if (iconPause) iconPause.textContent = state.paused ? "▶" : "⏸";
    pauseModal?.classList.toggle("hidden", !state.paused);
    pauseModal?.classList.toggle("flex", state.paused);
  });
  btnPauseResume?.addEventListener("click", () => {
    state.paused = false;
    if (iconPause) iconPause.textContent = "⏸";
    pauseModal?.classList.add("hidden");
    pauseModal?.classList.remove("flex");
  });
  btnPauseRestart?.addEventListener("click", () => startSeries(state.currentTierIndex));

  function toggleAudio() {
    initAudio();
    state.audioEnabled = !state.audioEnabled;
    if (state.audioEnabled) bgMusic.play().catch(() => {});
    else bgMusic.pause();
    if (iconSound) iconSound.textContent = state.audioEnabled ? "🔊" : "🔇";
    if (btnMenuAudioToggle) {
      btnMenuAudioToggle.textContent = state.audioEnabled ? "🔊 Son Activé" : "🔇 Son Coupé";
    }
  }
  btnSound?.addEventListener("click", toggleAudio);
  btnMenuAudioToggle?.addEventListener("click", toggleAudio);

  /* -------------------------------------------------------------------------- */
  /*  BOUCLE DE RENDU 3D                                                        */
  /* -------------------------------------------------------------------------- */
  let prevTime = performance.now();
  function animate() {
    requestAnimationFrame(animate);
    const now = performance.now();
    const dt = Math.min((now - prevTime) / 1000, 0.05);
    prevTime = now;

    if (state.paused) {
      renderer.render(scene, camera);
      return;
    }

    updateNetMesh(dt);

    // Ombre de contact au sol
    const h = Math.max(0, ballMesh.position.y - BALL_R);
    ballContactShadow.position.set(ballMesh.position.x, 0.012, ballMesh.position.z);
    const sScale = 1 + h * 0.4;
    ballContactShadow.scale.set(sScale, sScale, 1);
    (ballContactShadow.material as THREE.MeshBasicMaterial).opacity = Math.max(0.08, 0.65 * Math.exp(-h * 0.9));

    if (state.phase === "charging") {
      updateChargeGauge(dt);
    } else if (state.phase === "flying" || state.phase === "result") {
      updateBasketballPhysics(dt);
    }

    renderer.render(scene, camera);
  }

  window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    resizeSwipeCanvas();
    if (state.phase === "aiming") applyPlayableFraming();
  });

  scene.background = new THREE.Color("#050914");
  startSeries(0);
  renderPlaylistUi();
  renderLevelsModal();
  animate();
</script>
