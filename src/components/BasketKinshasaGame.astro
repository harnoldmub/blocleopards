  function getShotTargetWindow(tier: BasketTier, spot: CourtSpot) {
    const dist = Math.hypot(spot.x, spot.z);
    // Distance entre 4.4m (lancer franc) et 10.2m (milieu de terrain)
    const distFactor = Math.min(1, Math.max(0, (dist - 4.4) / (10.2 - 4.4)));
    // Plus la distance augmente, plus le sweet spot monte (de 68% à 84%)
    const sweetCenter = 68 + distFactor * 16;
    const tolerance = tier.tolerancePct;
    const minMake = Math.max(25, sweetCenter - tolerance);
    const maxMake = Math.min(92, sweetCenter + tolerance);
    // Zone du swish net : coeur à ±30% de la tolérance
    const swishHalf = Math.max(1.6, tolerance * 0.32);
    const minSwish = sweetCenter - swishHalf;
    const maxSwish = sweetCenter + swishHalf;

    return {
      dist,
      sweetCenter,
      tolerance,
      minMake,
      maxMake,
      minSwish,
      maxSwish
    };
  }

