  // Ombre de contact au sol sous le ballon
  const shadowCanvas = document.createElement("canvas");
  shadowCanvas.width = 128;
  shadowCanvas.height = 128;
  const sCtx = shadowCanvas.getContext("2d")!;
  const sGrad = sCtx.createRadialGradient(64, 64, 0, 64, 64, 60);
  sGrad.addColorStop(0, "rgba(0, 0, 0, 0.72)");
  sGrad.addColorStop(0.5, "rgba(0, 0, 0, 0.35)");
  sGrad.addColorStop(1, "rgba(0, 0, 0, 0)");
  sCtx.fillStyle = sGrad;
  sCtx.fillRect(0, 0, 128, 128);
  const ballShadowTex = new THREE.CanvasTexture(shadowCanvas);

  const ballContactShadow = new THREE.Mesh(
    new THREE.PlaneGeometry(0.38, 0.38),
    new THREE.MeshBasicMaterial({ map: ballShadowTex, transparent: true, depthWrite: false })
  );
  ballContactShadow.rotation.x = -Math.PI / 2;
  scene.add(ballContactShadow);

  /* -------------------------------------------------------------------------- */
  /*  CADRAGE & GESTION DU MODE ARCADE (TIRS ILLIMITÉS SOUS CHRONO)             */
  /* -------------------------------------------------------------------------- */
  function getCurrentSpot(): CourtSpot {
    const tier = getActiveTier();
    const spots = tier.spots && tier.spots.length > 0 ? tier.spots : SPOTS_STANDARD;
    return spots[state.spotIndex % spots.length];
  }

  function applyPlayableFraming() {
    const spot = getCurrentSpot();
    const dirToHoop = new THREE.Vector3(0 - spot.x, 0, HOOP.rimZ - spot.z).normalize();
    const aspect = window.innerWidth / Math.max(1, window.innerHeight);
    const isPortrait = aspect < 0.95;

    // En vue 1ère personne : le ballon est positionné devant la caméra à hauteur de tir (1.65m)
    const distCam = isPortrait ? 1.45 : 1.35;
    camera.position.set(spot.x - dirToHoop.x * distCam, 1.82, spot.z - dirToHoop.z * distCam);
    camera.lookAt(0, HOOP.rimY + 0.15, HOOP.rimZ);

    ballMesh.position.set(spot.x, 1.55, spot.z);
    ballMesh.rotation.set(0, 0, 0);
  }

  function updateHud() {
    const tier = getActiveTier();
    const spot = getCurrentSpot();

    if (hudScoreMade) hudScoreMade.textContent = String(state.goalsInSeries);
    if (hudTargetGoals) hudTargetGoals.textContent = String(tier.targetGoals);
    if (hudShotsAttempted) hudShotsAttempted.textContent = String(state.shotsAttempted);
    if (hudLevelBadge) hudLevelBadge.textContent = `NIV. ${tier.id} · ${tier.name.toUpperCase()}`;
    if (hudSpotLabel) hudSpotLabel.textContent = `${spot.name} (${spot.distLabel})`;
    if (hudShotclock) hudShotclock.textContent = Math.max(0, state.levelTimeRemaining).toFixed(1);
    if (hudWindVal) {
      hudWindVal.textContent = state.currentWindKmh === 0
        ? "Vent : 0 km/h"
        : `${state.currentWindKmh > 0 ? "Vent Droit ➔" : "Vent Gauche ⬅"} ${Math.abs(state.currentWindKmh)} km/h`;
    }
    if (levelsBestStreak) levelsBestStreak.textContent = `${state.bestScore} pts`;
    if (pauseStreakVal) pauseStreakVal.textContent = `${state.goalsInSeries} pts (Obj: ${tier.targetGoals})`;
  }

  function setupNextShot() {
    if (state.levelTimeRemaining <= 0) {
      endSeries(true);
      return;
    }

    const tier = getActiveTier();
    // Tirage du vent selon le niveau
    if (tier.windMaxKmh > 0) {
      const dir = Math.random() < 0.5 ? -1 : 1;
      state.currentWindKmh = Math.round(dir * (tier.windMaxKmh * 0.45 + Math.random() * tier.windMaxKmh * 0.55));
    } else {
      state.currentWindKmh = 0;
    }

    state.phase = "aiming";
    ballPhys.active = false;
    ballPhys.scoredTriggered = false;
    ballPhys.hitBackboard = false;
    ballPhys.hitRim = false;

    applyPlayableFraming();
    updateHud();

    const targetWin = getShotTargetWindow(tier, getCurrentSpot());
    if (powerMeterTargetZone) {
      powerMeterTargetZone.style.bottom = `${targetWin.minMake}%`;
      powerMeterTargetZone.style.height = `${Math.max(4, targetWin.maxMake - targetWin.minMake)}%`;
    }

    swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
    if (powerMeterWrap) powerMeterWrap.classList.add("opacity-0");
    if (powerMeterFill) powerMeterFill.style.height = "0%";
  }

  function startSeries(tierIdx = 0) {
    state.currentTierIndex = THREE.MathUtils.clamp(tierIdx, 0, TIERS.length - 1);
    state.spotIndex = 0;
    state.shotsAttempted = 0;
    state.goalsInSeries = 0;
    state.paused = false;

    const tier = getActiveTier();
    state.levelTimeRemaining = tier.levelTimerSec;
    state.levelTotalTime = tier.levelTimerSec;
    if (hudLevelTimer) hudLevelTimer.textContent = `${tier.levelTimerSec.toFixed(1)}s`;
    if (hudShotclock) hudShotclock.textContent = `${tier.levelTimerSec.toFixed(1)}`;
    if (hudLevelTimerBar) hudLevelTimerBar.style.width = "100%";
    if (hudLevelTimerPill) {
      hudLevelTimerPill.className = "flex items-center gap-1.5 rounded-2xl border-2 border-emerald-500 bg-[#060d1f] px-3 sm:px-4 py-1 shadow-2xl transition-all";
    }

    gameoverModal?.classList.add("hidden");
    gameoverModal?.classList.remove("flex");
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");

    setupNextShot();
  }

  function endSeries(timeExpired = true) {
    state.phase = "gameover";
    const tier = getActiveTier();

    if (state.goalsInSeries > state.bestScore) {
      state.bestScore = state.goalsInSeries;
      localStorage.setItem("kin_basket_best_score", String(state.bestScore));
    }

    const passed = state.goalsInSeries >= tier.targetGoals;
    if (passed && tier.id === state.maxUnlockedTier && state.maxUnlockedTier < TIERS.length) {
      state.maxUnlockedTier++;
      localStorage.setItem("kin_basket_max_tier", String(state.maxUnlockedTier));
    }

    const hasNextTier = state.currentTierIndex + 1 < TIERS.length;

    if (goTitle) {
      if (passed) {
        goTitle.textContent = "VICTOIRE À LIMETE ! 🔥";
      } else {
        goTitle.textContent = "TEMPS ÉCOULÉ ! ⏱️";
      }
    }
    if (goDesc) {
      if (passed) {
        goDesc.textContent = `Superbe chrono ! Tu as inscrit ${state.goalsInSeries} paniers sur ${state.shotsAttempted} tirs tentés en ${tier.levelTimerSec}s (objectif ${tier.targetGoals} atteint). ${hasNextTier ? `Niveau ${tier.id + 1} débloqué !` : "Tu as conquis tous les niveaux du playground !"}`;
      } else {
        goDesc.textContent = `Buzzer final (${tier.levelTimerSec}s) ! Tu as marqué ${state.goalsInSeries} paniers sur ${state.shotsAttempted} tirs tentés. Il fallait ${tier.targetGoals} paniers pour valider le Niveau ${tier.id}. Retente ta chance pour faire mieux !`;
      }
    }
    if (goStatStreak) goStatStreak.textContent = `${state.goalsInSeries} pts`;
    if (goStatLevel) goStatLevel.textContent = `Niv. ${tier.id}`;
    if (goStatRecord) goStatRecord.textContent = `${state.bestScore} pts 🏆`;

    if (btnGoNextLevel) {
      if (passed && hasNextTier) {
        const nextTier = TIERS[state.currentTierIndex + 1];
        if (btnGoNextLabel) {
          btnGoNextLabel.textContent = `Passer au Niveau ${nextTier.id} (${nextTier.name})`;
        }
        btnGoNextLevel.classList.remove("hidden");
        btnGoNextLevel.classList.add("flex");
        btnGoRetry?.classList.remove("bg-or", "text-slate-950");
        btnGoRetry?.classList.add("bg-[#0c1b3a]", "text-slate-200", "border", "border-[#1e3a6e]");
      } else {
        btnGoNextLevel.classList.add("hidden");
        btnGoNextLevel.classList.remove("flex");
        btnGoRetry?.classList.remove("bg-[#0c1b3a]", "text-slate-200", "border", "border-[#1e3a6e]");
        btnGoRetry?.classList.add("bg-or", "text-slate-950");
      }
    }

    gameoverModal?.classList.remove("hidden");
    gameoverModal?.classList.add("flex");
    renderLevelsModal();
  }

  /* -------------------------------------------------------------------------- */
  /*  SWIPE & JAUGE IRRÉVERSIBLE (NE JAMAIS ARRIVER AU MAX)                     */
  /* -------------------------------------------------------------------------- */
  let chargeActive = false;
  let swipePoints: { x: number; y: number }[] = [];
  let lockedPowerPct = 0;

  const ballPhys = {
    active: false,
    vx: 0,
    vy: 0,
    vz: 0,
    isMake: false,
    isSwish: false,
    isBankMake: false,
    hitBackboard: false,
    hitRim: false,
    scoredTriggered: false,
    missedReason: "",
    elapsed: 0
  };

  function updateChargeGauge(dt: number) {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;

    const tier = getActiveTier();
    const spot = getCurrentSpot();
    const targetWin = getShotTargetWindow(tier, spot);

    lockedPowerPct = Math.min(100, lockedPowerPct + dt * tier.gaugeSpeed);
    const displayPct = Math.round(lockedPowerPct);

    if (powerMeterFill) powerMeterFill.style.height = `${displayPct}%`;
    const isOverload = lockedPowerPct >= 92;
    const isMakeRange = lockedPowerPct >= targetWin.minMake && lockedPowerPct <= targetWin.maxMake;
    const isSwishRange = lockedPowerPct >= targetWin.minSwish && lockedPowerPct <= targetWin.maxSwish;

    if (powerMeterPct) {
      powerMeterPct.textContent = isOverload ? "MAX !" : `${displayPct}%`;
      powerMeterPct.className = isOverload
        ? "rounded bg-red-600 px-2 py-0.5 font-display text-xs tracking-wider text-white shadow animate-pulse font-black"
        : isSwishRange
          ? "rounded bg-emerald-500 px-2 py-0.5 font-display text-xs tracking-wider text-slate-950 font-black shadow animate-pulse"
          : isMakeRange
            ? "rounded bg-or px-2 py-0.5 font-display text-xs tracking-wider text-slate-950 font-black shadow"
            : "rounded bg-[#060d1f] px-2 py-0.5 font-display text-xs tracking-wider text-sky-300 shadow font-bold";
    }

    if (powerMeterZoneBadge) {
      if (isOverload) {
        powerMeterZoneBadge.textContent = "TROP FORT (RATÉ) !";
        powerMeterZoneBadge.className = "rounded bg-red-600 px-2 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-white shadow";
      } else if (isSwishRange) {
        powerMeterZoneBadge.textContent = "SWISH NET ! 🔥";
        powerMeterZoneBadge.className = "rounded bg-emerald-400 px-2 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-slate-950 shadow";
      } else if (isMakeRange) {
        powerMeterZoneBadge.textContent = "ZONE PANIER 🏀";
        powerMeterZoneBadge.className = "rounded bg-amber-400 px-2 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-slate-950 shadow";
      } else if (lockedPowerPct < targetWin.minMake) {
        powerMeterZoneBadge.textContent = "TROP COURT";
        powerMeterZoneBadge.className = "rounded bg-sky-500 px-2 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-white shadow";
      } else {
        powerMeterZoneBadge.textContent = "TROP FORT";
        powerMeterZoneBadge.className = "rounded bg-rose-500 px-2 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-white shadow";
      }
    }

    // Le ballon monte légèrement dans la phase d'armé du shoot
    ballMesh.position.y = 1.55 + Math.min(0.35, (lockedPowerPct / 100) * 0.35);

    drawSwipeTrail();

    // Si la jauge atteint 100% (MAX), le tir part tout seul obligatoirement raté !
    if (lockedPowerPct >= 100) {
      commitShotRelease();
    }
  }

  function drawSwipeTrail() {
    swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
    if (swipePoints.length < 2) return;

    swipeCtx.save();
    swipeCtx.lineCap = "round";
    swipeCtx.lineJoin = "round";

    const tier = getActiveTier();
    const spot = getCurrentSpot();
    const targetWin = getShotTargetWindow(tier, spot);

    const isOverload = lockedPowerPct >= 92;
    const isSwishRange = lockedPowerPct >= targetWin.minSwish && lockedPowerPct <= targetWin.maxSwish;
    const isMakeRange = lockedPowerPct >= targetWin.minMake && lockedPowerPct <= targetWin.maxMake;
    const color = isOverload ? "#ef4444" : isSwishRange ? "#34d399" : isMakeRange ? "#facc15" : "#38bdf8";

    swipeCtx.strokeStyle = color;
    swipeCtx.lineWidth = 6;
    swipeCtx.beginPath();
    swipeCtx.moveTo(swipePoints[0].x, swipePoints[0].y);
    for (let i = 1; i < swipePoints.length; i++) {
      swipeCtx.lineTo(swipePoints[i].x, swipePoints[i].y);
    }
    swipeCtx.stroke();
    swipeCtx.restore();
  }

  function commitShotRelease() {
    if (!chargeActive) return;
    chargeActive = false;
    state.phase = "flying";

    setTimeout(() => {
      swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
      powerMeterWrap?.classList.add("opacity-0");
    }, 280);

    const tier = getActiveTier();
    const spot = getCurrentSpot();
    const targetWin = getShotTargetWindow(tier, spot);

    const isOverload = lockedPowerPct >= 92;
    let isMakeRange = lockedPowerPct >= targetWin.minMake && lockedPowerPct <= targetWin.maxMake;
    const isSwishRange = lockedPowerPct >= targetWin.minSwish && lockedPowerPct <= targetWin.maxSwish;

    let missedReason = "";
    if (isOverload) {
      missedReason = "TROP FORT (JAUGE AU MAX) !";
    } else if (lockedPowerPct < targetWin.minMake) {
      missedReason = "TIR TROP COURT !";
    } else if (lockedPowerPct > targetWin.maxMake) {
      missedReason = "TIR TROP FORT !";
    }

    // Effet du vent sur les tirs limites (niveaux 3 à 8) :
    // Si on n'est pas dans le swish parfait et que le vent souffle, il dévie la balle
    if (isMakeRange && !isSwishRange && Math.abs(state.currentWindKmh) >= 12) {
      const distFromCenter = Math.abs(lockedPowerPct - targetWin.sweetCenter);
      if (distFromCenter > targetWin.tolerance * 0.65) {
        isMakeRange = false;
        missedReason = `DÉVIÉ PAR LE VENT (${state.currentWindKmh > 0 ? "+" : ""}${state.currentWindKmh} km/h) ! 💨`;
      }
    }

    ballPhys.active = true;
    ballPhys.elapsed = 0;
    ballPhys.hitBackboard = false;
    ballPhys.hitRim = false;
    ballPhys.scoredTriggered = false;
    ballPhys.missedReason = missedReason;

    if (isOverload) {
      // Trop violent / max : échec
      ballPhys.isMake = false;
      ballPhys.isSwish = false;
      ballPhys.isBankMake = false;
    } else if (isMakeRange) {
      ballPhys.isMake = true;
      ballPhys.isSwish = isSwishRange;
      // Panier avec planche si tir excentré ou léger surdosage
      ballPhys.isBankMake = !isSwishRange && (Math.abs(spot.x) > 2.0 || lockedPowerPct > targetWin.sweetCenter);
    } else {
      ballPhys.isMake = false;
      ballPhys.isSwish = false;
      ballPhys.isBankMake = false;
    }

    const startX = ballMesh.position.x;
    const startY = ballMesh.position.y;
    const startZ = ballMesh.position.z;

    let targetX = 0;
    let targetY = HOOP.rimY + 0.05;
    let targetZ = HOOP.rimZ;

    if (ballPhys.isBankMake) {
      targetZ = HOOP.boardZ + BALL_R + 0.04;
      targetY = HOOP.rimY + 0.36;
      targetX = spot.x * 0.08;
    } else if (!ballPhys.isMake) {
      if (isOverload) {
        // Trop fort : tape le haut du panneau plexiglas
        targetZ = HOOP.boardZ + BALL_R + 0.04;
        targetY = HOOP.boardY + 0.35;
        targetX = (Math.random() - 0.5) * 0.35;
      } else if (lockedPowerPct > targetWin.maxMake) {
        // Trop fort : tape l'arrière de l'arceau
        targetZ = HOOP.rimZ - HOOP.rimR * 0.85;
        targetY = HOOP.rimY + 0.04;
        targetX = (Math.random() - 0.5) * 0.15;
      } else if (missedReason.includes("VENT")) {
        // Dévié latéralement par le vent : tape le bord gauche ou droit du cercle
        const windDir = Math.sign(state.currentWindKmh) || 1;
        targetX = windDir * (HOOP.rimR + 0.04);
        targetZ = HOOP.rimZ;
        targetY = HOOP.rimY + 0.02;
      } else {
        // Trop court : tape l'avant de l'arceau
        targetZ = HOOP.rimZ + HOOP.rimR + 0.06;
        targetY = HOOP.rimY - 0.04;
        targetX = (Math.random() - 0.5) * 0.12;
      }
    }

    const flightDuration = 0.90 + Math.hypot(spot.x, spot.z) * 0.04;
    const g = 9.81;
    ballPhys.vx = (targetX - startX) / flightDuration;
    ballPhys.vz = (targetZ - startZ) / flightDuration;
    ballPhys.vy = (targetY - startY + 0.5 * g * flightDuration * flightDuration) / flightDuration;
  }

  canvas.addEventListener("pointerdown", (e) => {
    initAudio();
    if (state.phase !== "aiming" || state.paused) return;
    state.phase = "charging";
    chargeActive = true;
    swipePoints = [{ x: e.clientX, y: e.clientY }];
    lockedPowerPct = 18;

    powerMeterWrap?.classList.remove("opacity-0");
  });

  window.addEventListener("pointermove", (e) => {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;
    const last = swipePoints[swipePoints.length - 1];
    if (last) {
      const d = Math.hypot(e.clientX - last.x, e.clientY - last.y);
      if (d > 4) {
        swipePoints.push({ x: e.clientX, y: e.clientY });
        if (lockedPowerPct < 80) {
          lockedPowerPct = Math.min(80, lockedPowerPct + d * 0.06);
        }
      }
    }
  });

  window.addEventListener("pointerup", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) commitShotRelease();
  });
  window.addEventListener("pointercancel", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) commitShotRelease();
  });

  /* -------------------------------------------------------------------------- */
  /*  PHYSIQUE & COLLISIONS DU BALLON                                           */
  /* -------------------------------------------------------------------------- */
  function updateBasketballPhysics(dt: number) {
    if (!ballPhys.active) return;
    ballPhys.elapsed += dt;

    const SUBSTEPS = 6;
    const subDt = dt / SUBSTEPS;

    // Dérive due au vent latéral sur le vol du ballon
    const windAccelX = (state.currentWindKmh / 3.6) * 0.18;

    for (let s = 0; s < SUBSTEPS; s++) {
      ballPhys.vy -= 9.81 * subDt;
      ballPhys.vx += windAccelX * subDt;
      ballMesh.position.x += ballPhys.vx * subDt;
      ballMesh.position.y += ballPhys.vy * subDt;
      ballMesh.position.z += ballPhys.vz * subDt;

      // Backspin naturel
      ballMesh.rotation.x -= 10.5 * subDt;

      // 1. Choc avec la planche plexiglas (Z = 0)
      if (
        !ballPhys.hitBackboard &&
        ballMesh.position.z <= HOOP.boardZ + BALL_R + 0.04 &&
        ballMesh.position.z >= HOOP.boardZ - 0.2 &&
        Math.abs(ballMesh.position.x) < 0.9 &&
        ballMesh.position.y > 2.75 &&
        ballMesh.position.y < 3.95
      ) {
        ballPhys.hitBackboard = true;
        playBackboardHitAudio();
        ballMesh.position.z = HOOP.boardZ + BALL_R + 0.04;

        if (ballPhys.isBankMake) {
          // Rebond précis vers le centre de l'arceau
          ballPhys.vz = (HOOP.rimZ - ballMesh.position.z) * 3.8;
          ballPhys.vx = -ballMesh.position.x * 3.5;
          ballPhys.vy = -1.2;
        } else {
          ballPhys.vz = Math.abs(ballPhys.vz) * 0.52;
          ballPhys.vx += (Math.random() - 0.5) * 2.4;
        }
      }

      // 2. Passage au niveau de l'arceau (Y ≈ 3.05m)
      if (!ballPhys.scoredTriggered && ballPhys.vy < 0 && Math.abs(ballMesh.position.y - HOOP.rimY) < 0.09) {
        if (ballPhys.isMake) {
          ballPhys.scoredTriggered = true;
          ballMesh.position.x = 0;
          ballMesh.position.z = HOOP.rimZ;
          ballPhys.vx = 0;
          ballPhys.vz = 0;
          ballPhys.vy = -3.6;
          triggerNetSwish();
          playSwishAudio();
          onShotResolved(true, ballPhys.isSwish ? "SWISH NET ! 🔥" : "AVEC LA PLANCHE ! 🏀");
        } else if (!ballPhys.hitRim) {
          ballPhys.hitRim = true;
          playRimClangAudio();
          ballPhys.vy = Math.abs(ballPhys.vy) * 0.48;
          ballPhys.vz = 2.4 + Math.random() * 1.5;
          ballPhys.vx = (Math.random() - 0.5) * 3.0;
          onShotResolved(false, ballPhys.missedReason || "REBOND SUR L'ARCEAU !");
        }
      }

      // 3. Rebond au sol bitume
      if (ballMesh.position.y < BALL_R) {
        ballMesh.position.y = BALL_R;
        if (Math.abs(ballPhys.vy) > 0.8) {
          playCourtBounceAudio(Math.min(1, Math.abs(ballPhys.vy) / 6));
        }
        ballPhys.vy = Math.abs(ballPhys.vy) * 0.62;
        ballPhys.vx *= 0.78;
        ballPhys.vz *= 0.78;
      }
    }
  }

  function onShotResolved(made: boolean, title: string) {
    state.phase = "result";
    if (made) state.goalsInSeries++;
    state.shotsAttempted++;

    updateHud();

    const tier = getActiveTier();
    if (shotToast && toastTitle && toastSubtitle && toastEmoji) {
      toastEmoji.textContent = made ? "🏀" : "❌";
      toastTitle.textContent = title;
      toastTitle.className = made
        ? "font-display text-lg uppercase tracking-wider text-or leading-none font-black"
        : "font-display text-lg uppercase tracking-wider text-red-500 leading-none font-black";
      toastSubtitle.textContent = made
        ? `Panier validé ! ${state.goalsInSeries}/${tier.targetGoals} pts (${state.shotsAttempted}e shoot)`
        : `Tir manqué (${state.shotsAttempted}e shoot) · Enchaîne vite !`;
      shotToast.classList.remove("opacity-0", "-translate-y-4");
    }

    setTimeout(() => {
      shotToast?.classList.add("opacity-0", "-translate-y-4");
      if (state.levelTimeRemaining > 0) {
        state.spotIndex++;
        setupNextShot();
      } else {
        endSeries(true);
      }
    }, 600);
  }

