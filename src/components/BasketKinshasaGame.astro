  function createCourtsidePartnerTex() {
    const cv = document.createElement("canvas");
    cv.width = 2048;
    cv.height = 256;
    const ctx = cv.getContext("2d")!;
    const tex = new THREE.CanvasTexture(cv);
    tex.colorSpace = THREE.SRGBColorSpace;
    const slotW = cv.width / PARTNER_ADS.length;

    ctx.fillStyle = "#081126";
    ctx.fillRect(0, 0, cv.width, cv.height);
    PARTNER_ADS.forEach((ad, i) => {
      const x0 = i * slotW;
      ctx.fillStyle = "#f7d618";
      ctx.fillRect(x0, 0, slotW, 12);
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(x0 + 14, 20, slotW - 28, cv.height - 36);
      const img = new Image();
      img.crossOrigin = "anonymous";
      img.onload = () => {
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(x0 + 14, 20, slotW - 28, cv.height - 36);
        const scale = Math.min((slotW - 60) / img.width, (cv.height - 56) / img.height);
        const w = img.width * scale;
        const h = img.height * scale;
        ctx.drawImage(img, x0 + (slotW - w) / 2, 20 + (cv.height - 36 - h) / 2, w, h);
        tex.needsUpdate = true;
      };
      img.src = ad.src;
    });
    tex.needsUpdate = true;
    return tex;
  }

