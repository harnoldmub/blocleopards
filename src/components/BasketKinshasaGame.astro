  /* -------------------------------------------------------------------------- */
  let audioCtx: AudioContext | null = null;
  function initAudio() {
    if (!audioCtx) {
      const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AC) audioCtx = new AC();
    }
    if (audioCtx && audioCtx.state === "suspended") audioCtx.resume();
    if (state.audioEnabled && bgMusic.paused) {
      bgMusic.play().catch(() => {});
    }
  }

  function playCourtBounceAudio(intensity = 0.6) {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(165, now);
      osc.frequency.exponentialRampToValueAtTime(50, now + 0.11);
      gain.gain.setValueAtTime(intensity * 0.55, now);
      gain.gain.exponentialRampToValueAtTime(0.005, now + 0.12);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.12);
    } catch {}
  }

  function playBackboardHitAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "triangle";
      osc.frequency.setValueAtTime(240, now);
      osc.frequency.exponentialRampToValueAtTime(70, now + 0.09);
      gain.gain.setValueAtTime(0.55, now);
      gain.gain.exponentialRampToValueAtTime(0.008, now + 0.1);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.1);
    } catch {}
  }

  function playRimClangAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      [620, 1180, 1840].forEach((f, i) => {
        const osc = audioCtx!.createOscillator();
        const gain = audioCtx!.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(f, now);
        gain.gain.setValueAtTime(0.28 / (i + 1), now);
        gain.gain.exponentialRampToValueAtTime(0.002, now + 0.28);
        osc.connect(gain);
        gain.connect(audioCtx!.destination);
        osc.start(now);
        osc.stop(now + 0.28);
      });
    } catch {}
  }

  function playSwishAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const dur = 0.28;
      const bufSize = Math.floor(audioCtx.sampleRate * dur);
      const buf = audioCtx.createBuffer(1, bufSize, audioCtx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < bufSize; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.sin((i / bufSize) * Math.PI);
      }
      const src = audioCtx.createBufferSource();
      src.buffer = buf;
      const filter = audioCtx.createBiquadFilter();
      filter.type = "bandpass";
      filter.frequency.setValueAtTime(2500, now);
      filter.frequency.exponentialRampToValueAtTime(1100, now + dur);
      filter.Q.value = 1.6;
      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.65, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + dur);
      src.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);
      src.start(now);
      src.stop(now + dur);
    } catch {}
  }

  function playBuzzerAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const dur = 0.85;
      [220, 226, 440].forEach((f, i) => {
        const osc = audioCtx!.createOscillator();
        const gain = audioCtx!.createGain();
        osc.type = "sawtooth";
        osc.frequency.setValueAtTime(f, now);
        gain.gain.setValueAtTime(0.24 / (i + 1), now);
        gain.gain.linearRampToValueAtTime(0.35 / (i + 1), now + 0.05);
        gain.gain.exponentialRampToValueAtTime(0.005, now + dur);
        osc.connect(gain);
        gain.connect(audioCtx!.destination);
        osc.start(now);
        osc.stop(now + dur);
      });
    } catch {}
  }

