  let netSwishTimer = 0;
  function triggerNetSwish() {
    netSwishTimer = 1.0;
  }
  function updateNetMesh(dt: number) {
    if (netSwishTimer <= 0) return;
    netSwishTimer = Math.max(0, netSwishTimer - dt * 2.8);
    const posAttr = netGeo.attributes.position as THREE.BufferAttribute;
    for (let i = 0; i < posAttr.count; i++) {
      const ox = netOrigPos[i * 3];
      const oy = netOrigPos[i * 3 + 1];
      const oz = netOrigPos[i * 3 + 2];
      const bottomFactor = (0.22 - oy) / 0.44;
      const flare = 1 + Math.sin(netSwishTimer * Math.PI * 3) * 0.38 * bottomFactor;
      posAttr.setXYZ(i, ox * flare, oy, oz * flare);
    }
    posAttr.needsUpdate = true;
  }

