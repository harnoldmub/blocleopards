---
/**
 * Classement du Groupe E, calculé depuis src/data/can2027.ts.
 */
import type { Standing } from "../../data/can2027";

interface Props {
  standings: Standing[];
}

const { standings } = Astro.props;
const diff = (n: number) => (n > 0 ? `+${n}` : `${n}`);
---

<div class="overflow-hidden rounded-[12px] border border-white/15 bg-white/[0.03]">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-4 py-4 sm:px-6">
    <h3 class="font-display text-2xl uppercase tracking-wide text-white">Groupe E</h3>
    <p class="inline-flex items-center gap-2 text-xs text-white/60">
      <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
      Les 2 premiers se qualifient
    </p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-white">
      <caption class="sr-only">Classement du groupe E des éliminatoires de la CAN 2027</caption>
      <thead>
        <tr class="border-b border-white/10 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-white/50">
          <th scope="col" class="py-3 pl-4 pr-2 sm:pl-6">#</th>
          <th scope="col" class="px-3 py-3">Équipe</th>
          <th scope="col" class="px-2 py-3 text-center"><abbr title="Matchs joués" class="no-underline">MJ</abbr></th>
          <th scope="col" class="px-2 py-3 text-center"><abbr title="Victoires" class="no-underline">V</abbr></th>
          <th scope="col" class="px-2 py-3 text-center"><abbr title="Nuls" class="no-underline">N</abbr></th>
          <th scope="col" class="px-2 py-3 text-center"><abbr title="Défaites" class="no-underline">D</abbr></th>
          <th scope="col" class="hidden px-2 py-3 text-center sm:table-cell"><abbr title="Buts pour" class="no-underline">BP</abbr></th>
          <th scope="col" class="hidden px-2 py-3 text-center sm:table-cell"><abbr title="Buts contre" class="no-underline">BC</abbr></th>
          <th scope="col" class="px-2 py-3 text-center"><abbr title="Différence de buts" class="no-underline">Diff</abbr></th>
          <th scope="col" class="py-3 pl-2 pr-4 text-center text-or sm:pr-6">Pts</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {standings.map((row) => (
          <tr class={row.team.isRDC ? "bg-congo/20" : ""}>
            <td class="py-3.5 pl-4 pr-2 sm:pl-6">
              <span class={`grid h-6 w-6 place-items-center rounded-full text-xs font-bold ${
                row.team.isRDC ? "bg-or text-congo-night" : row.position <= 2 ? "bg-emerald-400/15 text-emerald-300" : "text-white/50"
              }`}>{row.position}</span>
            </td>
            <th scope="row" class="px-3 py-3.5 font-normal">
              <span class="flex items-center gap-3">
                <img src={row.team.flag} alt="" width="24" height="16" class="h-4 w-6 shrink-0 rounded-[2px] object-cover" loading="lazy" />
                <span class={row.team.isRDC ? "font-bold text-white" : "text-white/85"}>{row.team.name}</span>
              </span>
            </th>
            <td class="px-2 py-3.5 text-center tabular-nums text-white/75">{row.played}</td>
            <td class="px-2 py-3.5 text-center tabular-nums text-white/75">{row.won}</td>
            <td class="px-2 py-3.5 text-center tabular-nums text-white/75">{row.drawn}</td>
            <td class="px-2 py-3.5 text-center tabular-nums text-white/75">{row.lost}</td>
            <td class="hidden px-2 py-3.5 text-center tabular-nums text-white/60 sm:table-cell">{row.goalsFor}</td>
            <td class="hidden px-2 py-3.5 text-center tabular-nums text-white/60 sm:table-cell">{row.goalsAgainst}</td>
            <td class="px-2 py-3.5 text-center tabular-nums text-white/85">{diff(row.goalDiff)}</td>
            <td class="py-3.5 pl-2 pr-4 text-center sm:pr-6">
              <span class={`font-mega text-lg tabular-nums ${row.team.isRDC ? "text-or" : "text-white"}`}>{row.points}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
