---
/**
 * Aperçu éditorial CAN 2027 pour la page d'accueil.
 * La composition reste volontairement sobre : un message, deux actions et une affiche.
 */
import { CAN2027_DATA } from "../../data/can2027";
---

<section id="can-2027" class="can-home-section scroll-mt-24" aria-labelledby="can-home-title">
  <div class="can-grain-overlay" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-[84rem] px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="can-meta">
      <span>{CAN2027_DATA.campaign.surtitre}</span>
      <span class="can-meta__group">{CAN2027_DATA.campaign.groupName} · Phase éliminatoire</span>
    </div>

    <div class="mt-10 grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <span data-reveal class="text-[0.7rem] font-extrabold uppercase tracking-[0.28em] text-or">
          La campagne des Léopards
        </span>

        <h2 id="can-home-title" data-reveal class="mt-4 max-w-[8ch] text-balance font-mega uppercase leading-[0.86] text-white [font-size:clamp(3.5rem,7.5vw,7.2rem)]">
          Les Léopards
        </h2>

        <p data-reveal class="mt-6 font-display text-2xl uppercase tracking-[0.04em] text-white sm:text-3xl">
          {CAN2027_DATA.campaign.signature}
        </p>

        <p data-reveal class="mt-6 max-w-lg text-base leading-7 text-white/75 sm:text-lg">
          La RDC part à la conquête de la CAN 2027. Un même élan, une même ferveur, derrière les Léopards dans le Groupe E.
        </p>

        <div data-reveal class="mt-9 flex flex-wrap items-center gap-6">
          <a
            href="/can-2027"
            class="group inline-flex min-h-12 items-center gap-3 rounded-full bg-or px-7 py-3.5 text-[0.78rem] font-black uppercase tracking-[0.12em] text-congo-night shadow-[0_12px_30px_-14px_rgba(244,196,0,0.55)] transition-colors hover:bg-yellow-300"
          >
            <span>Voir la campagne</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </a>

          <a
            href="/can-2027#calendrier"
            class="inline-flex min-h-12 items-center border-b border-white/35 px-1 text-[0.76rem] font-bold uppercase tracking-[0.12em] text-white transition-colors hover:border-or hover:text-or"
          >
            Calendrier des matchs
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <a
          href="/can-2027"
          class="can-poster group relative mx-auto block max-w-2xl overflow-hidden rounded-lg border border-white/20 bg-congo-night shadow-[0_30px_80px_-35px_rgba(0,0,0,0.85)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-or"
          aria-label="Découvrir la campagne des Léopards pour la CAN 2027"
        >
          <img
            src="/media/can-2027/poster-equipe-bleu-800.webp"
            alt="Les Léopards de la RDC pour les éliminatoires de la CAN 2027"
            width="800"
            height="1024"
            class="aspect-[5/6] h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.015]"
            loading="lazy"
          />
          <span class="can-poster__link">
            Explorer la campagne <span aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .can-home-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 22%, rgba(0, 127, 255, 0.2), transparent 34%),
      linear-gradient(135deg, #071c46 0%, #0a2e6c 48%, #050f25 100%);
    color: #fff;
  }

  .can-home-section::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: linear-gradient(90deg, #007fff 0 33.3%, #f7d618 33.3% 66.6%, #ce1021 66.6%);
    z-index: 10;
  }

  .can-grain-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.035;
    background-image: radial-gradient(rgba(255, 255, 255, 0.8) 0.8px, transparent 0.8px);
    background-size: 5px 5px;
  }

  .can-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding-bottom: 1rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .can-meta__group {
    color: rgba(255, 255, 255, 0.55);
  }

  .can-poster::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(4, 13, 31, 0.76), transparent 28%);
    pointer-events: none;
  }

  .can-poster__link {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 639px) {
    .can-meta__group {
      display: none;
    }

    .can-poster__link {
      right: 1rem;
      bottom: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .can-poster img,
    .can-home-section a span {
      transition: none;
    }
  }
</style>
