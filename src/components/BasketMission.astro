---
/**
 * Bandeau compact « Léopards Basket — Mission Dakar » (home).
 *
 * Volontairement court : une vidéo, le programme en trois lignes, un lien vers
 * la page complète /basket. Tout le détail (texte de mission, affiche, second
 * média, hashtags) vit sur /basket, pas ici.
 *
 * Reste visible même si la table `events` n'est pas migrée : le calendrier de
 * repli ci-dessous est aligné sur l'affiche officielle FIBA.
 */
interface EventRow {
  slug: string;
  date: string;
  time?: string;
}

interface Props {
  events?: EventRow[];
}

const { events = [] } = Astro.props as Props;

const FIXTURES = [
  { slug: "2026-08-27-leopards-basket-rdc-angola", date: "2026-08-27", time: "13H30", opponent: "Angola", flag: "/flags/ao.png" },
  { slug: "2026-08-29-leopards-basket-rdc-mali", date: "2026-08-29", time: "16H30", opponent: "Mali", flag: "/flags/ml.svg" },
  { slug: "2026-08-30-leopards-basket-rdc-egypte", date: "2026-08-30", time: "13H30", opponent: "Égypte", flag: "/flags/eg.svg" }
];

// L'heure en base est enrichie (« 13H30 (Kinshasa) · 12H30 GMT ») : sur la home
// on ne garde que la première valeur pour rester dense.
const bySlug = new Map(events.map((e) => [e.slug, e]));
const fixtures = FIXTURES.map((fx) => ({
  ...fx,
  date: bySlug.get(fx.slug)?.date ?? fx.date,
  time: (bySlug.get(fx.slug)?.time || fx.time).split(" (")[0]
}));

const FR_DAYS = ["DIM", "LUN", "MAR", "MER", "JEU", "VEN", "SAM"];
const FR_MONTHS = ["JAN", "FÉV", "MAR", "AVR", "MAI", "JUIN", "JUIL", "AOÛT", "SEPT", "OCT", "NOV", "DÉC"];
const parse = (d: string) => new Date(`${d}T12:00:00Z`);

const today = new Date().toISOString().slice(0, 10);
---

<section id="basket" class="bloc-basket scroll-mt-24" aria-labelledby="basket-title">
  <div class="relative z-10 mx-auto grid max-w-[84rem] gap-8 px-4 py-12 sm:grid-cols-[auto_1fr] sm:items-center lg:gap-12 lg:px-8 lg:py-14">
    <!-- Vidéo -->
    <figure data-reveal="fade" class="bloc-basket__video">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster="/videos/basket/leopards-basket-01-poster.jpg"
        data-hero-media
        aria-label="Les Léopards Basketball avant la fenêtre de Dakar"
      >
        <source src="/videos/basket/leopards-basket-01.mp4" type="video/mp4" />
      </video>
    </figure>

    <div>
      <div data-reveal class="flex items-center gap-2.5">
        <img
          src="/media/basket/logo-febaco.webp"
          alt="Fédération de Basketball du Congo"
          width="26"
          height="26"
          loading="lazy"
          decoding="async"
          class="h-[26px] w-[26px] rounded-full bg-white object-contain p-px"
        />
        <span class="text-[0.66rem] font-bold uppercase tracking-[0.2em] text-white/80">
          Léopards Basket · Qualif. Mondial FIBA 2027
        </span>
      </div>

      <h2 id="basket-title" data-reveal class="mt-3 font-display text-4xl uppercase leading-[0.9] text-white md:text-6xl">
        Mission Dakar
      </h2>
      <p data-reveal class="mt-3 max-w-md text-sm leading-relaxed text-white/80">
        Trois matchs à la Dakar Arena, du 27 au 30 août. Un seul drapeau.
      </p>

      <ol data-reveal class="mt-6 max-w-xl divide-y divide-white/15 border-y border-white/15">
        {fixtures.map((fx) => (
          <li>
            <a href={`/evenements/${fx.slug}`} class="bloc-basket__row group" data-past={fx.date < today ? "true" : undefined}>
              <span class="w-[5.5rem] shrink-0 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-or">
                {String(parse(fx.date).getUTCDate())} {FR_MONTHS[parse(fx.date).getUTCMonth()]}
                <span class="ml-1 text-white/45">{FR_DAYS[parse(fx.date).getUTCDay()]}</span>
              </span>
              <span class="flex flex-1 items-center gap-2 truncate text-sm font-semibold text-white">
                RDC
                <span class="text-white/40">–</span>
                {fx.opponent}
                <img src={fx.flag} alt="" aria-hidden="true" width="20" height="14" class="h-[14px] w-[20px] rounded-[1px] object-cover" />
              </span>
              <span class="shrink-0 text-[0.72rem] font-semibold tabular-nums text-white/70">{fx.time}</span>
            </a>
          </li>
        ))}
      </ol>

      <a
        data-reveal
        href="/basket"
        class="mt-6 inline-flex items-center gap-2 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-congo-night transition-colors"
      >
        <span class="rounded-full bg-or px-5 py-2.5 transition-transform hover:-translate-y-0.5">La mission en détail →</span>
      </a>
    </div>
  </div>
</section>

<style>
  .bloc-basket {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(105deg, #b83a05 0%, #e0350f 42%, #ff6a13 100%);
  }
  /* Aplat bleu Congo en biais côté droit — rappel du drapeau sans dégradé mou.
     Masqué en dessous de 640px : la diagonale coupait la colonne des horaires. */
  .bloc-basket::after {
    content: none;
    position: absolute;
    inset: 0 -10% 0 auto;
    z-index: 0;
    width: 30%;
    background: #0b47b0;
    clip-path: polygon(34% 0, 100% 0, 100% 100%, 0 100%);
    opacity: 0.9;
  }
  @media (min-width: 640px) {
    .bloc-basket::after {
      content: "";
    }
  }

  .bloc-basket__video {
    position: relative;
    z-index: 1;
    margin: 0;
    width: clamp(9rem, 24vw, 12.5rem);
    aspect-ratio: 9 / 14;
    overflow: hidden;
    border-radius: 4px;
    background: #08132b;
    box-shadow: 0 24px 60px -34px rgba(0, 0, 0, 0.95);
  }
  .bloc-basket__video video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bloc-basket__row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0;
    transition: padding-left 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bloc-basket__row:hover {
    padding-left: 0.4rem;
  }
  .bloc-basket__row[data-past="true"] {
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .bloc-basket__row {
      transition: none;
    }
  }
</style>
