  /* -------------------------------------------------------------------------- */
  /*  ARCHITECTURE RÉALISTE DU STADE DES MARTYRS                                */
  /* -------------------------------------------------------------------------- */
  const BOWL = { rx: 46, rz: 56, centerZ: 20 };
  const SECTOR_PATTERN = ["b", "b", "y", "b", "r", "b", "b", "y", "r", "b", "s", "b", "b", "y", "b", "r", "b", "b", "y", "r", "b", "s", "b", "r"];
  const SDM_COLORS = {
    seatBlue: "#1b4fc4",
    seatSky: "#2f86f0",
    seatYellow: "#f7d618",
    seatRed: "#b3202c",
    concrete: "#151924"
  };

  interface BowlRow { d: number; h: number }
  const bowlRows: BowlRow[] = [];
  for (let i = 0; i < 14; i++) bowlRows.push({ d: i * 1.05, h: 2.2 + i * 0.58 });
  const baseD = 14 * 1.05 + 2.5;
  const baseH = 2.2 + 14 * 0.58 + 2.4;
  for (let i = 0; i < 14; i++) bowlRows.push({ d: baseD + i * 1.05, h: baseH + i * 0.72 });

  function buildMartyrsBowl() {
    const segments = 96;
    const profile: [number, number][] = [[-1.2, 0], [-1.2, 2.1]];
    bowlRows.forEach((r, i) => {
      const prevH = i === 0 ? 2.1 : bowlRows[i - 1].h;
      profile.push([r.d, prevH], [r.d, r.h]);
      const next = bowlRows[i + 1];
      profile.push([next ? next.d : r.d + 2, r.h]);
    });
    const last = profile[profile.length - 1];
    profile.push([last[0] + 0.2, last[1] + 4.2], [last[0] + 2.2, last[1] + 4.2], [last[0] + 2.2, 0]);

    const positions: number[] = [];
    const indices: number[] = [];
    for (let s = 0; s <= segments; s++) {
      const a = (s / segments) * Math.PI * 2;
      const c = Math.cos(a);
      const sn = Math.sin(a);
      for (const [d, h] of profile) {
        positions.push((BOWL.rx + d) * c, h, BOWL.centerZ + (BOWL.rz + d) * sn);
      }
    }
    const P = profile.length;
    for (let s = 0; s < segments; s++) {
      for (let p = 0; p < P - 1; p++) {
        const a = s * P + p;
        const b = (s + 1) * P + p;
        indices.push(a, b, a + 1, b, b + 1, a + 1);
      }
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3));
    geo.setIndex(indices);
    geo.computeVertexNormals();
    return geo;
  }

  scene.add(
    new THREE.Mesh(
      buildMartyrsBowl(),
      new THREE.MeshStandardMaterial({ color: SDM_COLORS.concrete, roughness: 0.88, side: THREE.DoubleSide })
    )
  );

  const seatItems: { x: number; y: number; z: number; color: THREE.Color }[] = [];
  let seed = 17;
  const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

  bowlRows.forEach((r, ri) => {
    const rx = BOWL.rx + r.d + 0.45;
    const rz = BOWL.rz + r.d + 0.45;
    const count = 144;
    for (let i = 0; i < count; i++) {
      const a = (i / count) * Math.PI * 2;
      const idx = Math.floor(((a / (Math.PI * 2)) * SECTOR_PATTERN.length) % SECTOR_PATTERN.length);
      let key = SECTOR_PATTERN[idx];
      if (ri >= bowlRows.length - 2) key = "y";
      const hex = key === "y" ? SDM_COLORS.seatYellow : key === "r" ? SDM_COLORS.seatRed : key === "s" ? SDM_COLORS.seatSky : SDM_COLORS.seatBlue;
      const col = new THREE.Color(hex);
      col.offsetHSL(0, -0.06 * rand(), (rand() - 0.5) * 0.08);
      seatItems.push({ x: rx * Math.cos(a), y: r.h + 0.35, z: BOWL.centerZ + rz * Math.sin(a), color: col });
    }
  });

  const seatsInstanced = new THREE.InstancedMesh(
    new THREE.BoxGeometry(1.45, 0.62, 0.65),
    new THREE.MeshStandardMaterial({ roughness: 0.5, metalness: 0.08 }),
    seatItems.length
  );
  const dummy = new THREE.Object3D();
  seatItems.forEach((s, i) => {
    dummy.position.set(s.x, s.y, s.z);
