  function applyLightingMode(night: boolean) {
    state.isNight = night;
    if (night) {
      scene.background = new THREE.Color("#050811");
      scene.fog = new THREE.FogExp2("#050811", 0.0038);
      hemiLight.intensity = 0.48;
      sunLight.intensity = 1.42;
      sunLight.color.setHex(0xeef6ff);
      floodCones.forEach((c) => (c.visible = true));
      crowdFlashes.visible = true;
      btnSetNight?.classList.add("bg-congo", "border-or/40");
      btnSetDay?.classList.remove("bg-congo", "border-or/40");
    } else {
      scene.background = new THREE.Color("#60a5fa");
      scene.fog = new THREE.FogExp2("#93c5fd", 0.0022);
      hemiLight.intensity = 0.88;
      sunLight.intensity = 1.95;
      sunLight.color.setHex(0xfffbeb);
      floodCones.forEach((c) => (c.visible = false));
      crowdFlashes.visible = false;
      btnSetDay?.classList.add("bg-congo", "border-or/40");
      btnSetNight?.classList.remove("bg-congo", "border-or/40");
    }
  }

  function updateHud() {
    const tier = getActiveTier();
    const shooter = getActiveShooter();
    const keeper = getActiveKeeper();
    if (hudRdcScore) hudRdcScore.textContent = String(state.goalsInSeries);
    if (hudOppScore) hudOppScore.textContent = String(tier.oppScore);
    if (hudLevelBadge) hudLevelBadge.textContent = `NIV. ${tier.id} · ${tier.name.toUpperCase()}`;
    if (hudMatchupLabel) {
      hudMatchupLabel.textContent = `#${shooter.number} ${shooter.backName} vs #${keeper.number} ${keeper.shortName}`;
    }

    const currentShotNum = Math.min(state.kickIndex + 1, TOTAL_KICKS_PER_SERIES);
    if (hudKickCounter) {
      hudKickCounter.textContent = `TIR ${currentShotNum}/${TOTAL_KICKS_PER_SERIES} · OBJECTIF ${tier.targetGoals} BUTS`;
    }
    if (pauseScoreSummary) {
      pauseScoreSummary.textContent = `RDC ${state.goalsInSeries} - ${tier.oppScore} ADV · Tir ${currentShotNum}/${TOTAL_KICKS_PER_SERIES}`;
    }

    // Mettre à jour les 5 pastilles de tirs
    if (hudFiveDots) {
      hudFiveDots.innerHTML = "";
      for (let i = 0; i < TOTAL_KICKS_PER_SERIES; i++) {
        const dot = document.createElement("span");
        const res = state.kickHistory[i];
        if (res === "goal") {
          dot.className = "h-2.5 w-2.5 rounded-full bg-emerald-400 border border-emerald-200 shadow-xs shadow-emerald-400";
        } else if (res === "miss") {
          dot.className = "h-2.5 w-2.5 rounded-full bg-red-500 border border-red-300";
        } else if (i === state.kickIndex) {
          dot.className = "h-2.5 w-2.5 rounded-full border-2 border-or bg-or/40 animate-pulse";
        } else {
          dot.className = "h-2.5 w-2.5 rounded-full border border-white/25 bg-white/10";
        }
        hudFiveDots.appendChild(dot);
      }
    }

    if (hudWindPill && hudWindVal && hudWindArrow) {
      if (state.windKmh === 0) {
        hudWindVal.textContent = "0 km/h";
        hudWindArrow.style.transform = "rotate(0deg)";
        hudWindPill.classList.add("opacity-55");
      } else {
        hudWindPill.classList.remove("opacity-55");
        hudWindVal.textContent = `${Math.abs(state.windKmh)} km/h`;
        hudWindArrow.style.transform = state.windKmh > 0 ? "rotate(0deg)" : "rotate(180deg)";
      }
    }
  }

  function setPaused(pauseState: boolean) {
    if (state.phase === "gameover") return;
    state.paused = pauseState;
    if (iconPause) iconPause.textContent = state.paused ? "▶" : "⏸";
    if (state.paused) {
      updateHud();
      updateMusicUi();
      pauseModal?.classList.remove("hidden");
      pauseModal?.classList.add("flex");
    } else {
      pauseModal?.classList.add("hidden");
      pauseModal?.classList.remove("flex");
      prevTime = performance.now();
    }
  }

  btnPause?.addEventListener("click", () => setPaused(!state.paused));
  btnPauseResume?.addEventListener("click", () => setPaused(false));
  btnPauseRestart?.addEventListener("click", () => {
    setPaused(false);
    startLevelSeries(state.currentTierIndex);
  });
  btnPauseToMenu?.addEventListener("click", () => {
    pauseModal?.classList.add("hidden");
    pauseModal?.classList.remove("flex");
    openMenu("music");
  });

  window.addEventListener("keydown", (e) => {
    if (e.code === "Space" || e.key === "p" || e.key === "P" || e.key === "Escape") {
      e.preventDefault();
      setPaused(!state.paused);
    }
  });

  function setupNextKick() {
    const tier = getActiveTier();

    if (tier.windMaxKmh === 0) {
      state.windKmh = 0;
    } else {
      const dir = Math.random() < 0.5 ? -1 : 1;
      state.windKmh = Math.round(dir * (tier.windMaxKmh * 0.55 + Math.random() * tier.windMaxKmh * 0.45));
    }

    state.wallSide = Math.random() < 0.5 ? -1 : 1;
    buildDefensiveWall(tier.wallPlayers, state.wallSide);

    ballMesh.position.set(0, BALL_R, PENALTY_Z);
    ballMesh.rotation.set(0, 0, 0);
    ballContactShadow.position.set(0, 0.014, PENALTY_Z);
    ballContactShadow.scale.set(1, 1, 1);
    (ballContactShadow.material as THREE.MeshBasicMaterial).opacity = 0.62;
    ballGlowRing.visible = true;
    ballTrailLine.visible = false;
    trailHistory.length = 0;
    goalGroup.position.x = 0;

    keeperGroup.position.set(0, 0, 0.28);
    keeperGroup.rotation.set(0, 0, 0);
    keeperGroundShadow.position.set(0, 0.012, 0.28);
    keeperGroundShadow.scale.set(1, 1, 1);
    upperBodyGroup.position.set(0, 0.90, 0);
    upperBodyGroup.rotation.set(0.14, 0, 0);
    kPelvis.position.set(0, 0.86, 0);
    kArmL.rotation.set(0, 0, 0.52);
    kArmR.rotation.set(0, 0, -0.52);
    armL.elbowPivot.rotation.set(-0.68, 0, 0.35);
    armR.elbowPivot.rotation.set(-0.68, 0, -0.35);
    legL.hipPivot.rotation.set(-0.22, 0, 0.09);
    legR.hipPivot.rotation.set(-0.22, 0, -0.09);
    legL.kneePivot.rotation.set(0.42, 0, 0);
    legR.kneePivot.rotation.set(0.42, 0, 0);
    legL.anklePivot.rotation.set(-0.20, 0, 0);
    legR.anklePivot.rotation.set(-0.20, 0, 0);

    setShooterIdlePose(0);

    swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
    hudCurvePill?.classList.add("hidden");
    hudCurvePill?.classList.remove("flex");

    if (powerMeterWrap) powerMeterWrap.classList.add("opacity-0");
    if (powerMeterFill) powerMeterFill.style.height = "0%";

    state.phase = "aiming";
    applyPlayableCameraFraming();
    cinematicBar?.classList.add("hidden");
    aimInstruction?.classList.remove("opacity-0");
    updateHud();
  }

  /* -------------------------------------------------------------------------- */
  /*  PROJECTION 3D <-> ÉCRAN & TRAJECTOIRE EXACTE CALÉE SUR LE DOIGT           */
  /* -------------------------------------------------------------------------- */
  interface SwipePoint {
    x: number;
    y: number;
  }

  let chargeActive = false;
  let swipePoints: SwipePoint[] = [];
  let chargePeakPushY = 0;
  let lockedPowerPct = 0;
  let currentCurveSpin = 0;

  const raycaster = new THREE.Raycaster();
  const ndcVec = new THREE.Vector2();
  const projVec = new THREE.Vector3();

  function worldToScreen(x: number, y: number, z: number): { x: number; y: number } {
    projVec.set(x, y, z);
    projVec.project(camera);
    return {
      x: (projVec.x * 0.5 + 0.5) * window.innerWidth,
      y: (-projVec.y * 0.5 + 0.5) * window.innerHeight
    };
  }

  function screenToPlaneZ(screenX: number, screenY: number, planeZ: number): THREE.Vector3 {
    ndcVec.set(
      (screenX / Math.max(1, window.innerWidth)) * 2 - 1,
      -(screenY / Math.max(1, window.innerHeight)) * 2 + 1
    );
    raycaster.setFromCamera(ndcVec, camera);
    const originZ = raycaster.ray.origin.z;
    const dirZ = raycaster.ray.direction.z;
    const t = (planeZ - originZ) / (Math.abs(dirZ) < 0.0001 ? -0.0001 : dirZ);
    return new THREE.Vector3(
      raycaster.ray.origin.x + raycaster.ray.direction.x * t,
      raycaster.ray.origin.y + raycaster.ray.direction.y * t,
      planeZ
    );
  }

  const FLIGHT_GRAVITY = 6.8; // Gravité calibrée pour un arc tendu sans rebond prématuré

  const shotPhys = {
    active: false,
    inGoalCage: false,
    flightElapsed: 0,
    vx: 0,
    vy: 0,
    vz: 0,
    totalAx: 0,
    spinY: 0,
    spinX: 0,
    speedKmh: 0,
    keeperTargetX: 0,
    keeperTargetY: 0,
    keeperDiveDir: 0,
    keeperReadsRight: true,
    wallJumping: false,
    caughtByKeeper: false,
    parriedByKeeper: false,
    touchedGlove: false,
    touchedPost: "" as "" | "in" | "out" | "bar",
    forceOutcome: "" as "" | "catch" | "deflect_goal",
    gaugeZone: "perfect" as "weak" | "medium" | "perfect" | "overload",
    powerPct: 78,
    postContactElapsed: 0,
    resolved: false
  };

  interface ExactShotTrajectory {
    targetX: number;
    targetY: number;
    midWorldX: number;
    spinCurve: number;
    speedMs: number;
    flightTime: number;
    vx0: number;
    vy0: number;
    totalAx: number;
    gaugeZone: "weak" | "medium" | "perfect" | "overload";
  }

  // Calcule la trajectoire 3D EXACTE en respectant strictement les zones de la jauge :
  // - < 48% ("weak")     : Frappe trop molle, retombe bas et lente
  // - 48..69% ("medium") : Frappe correcte mais vitesse modérée
  // - 70..91% ("perfect"): LA PLUS BELLE FRAPPE (Zone Verte) — précision 100%, vitesse & enroulé optimaux
  // - >= 92% ("overload"): PUISSANCE AU MAX (Zone Rouge) — Frappe ratée qui s'envole au-dessus de la barre !
  function computeExactTrajectory(powerPct: number): ExactShotTrajectory {
    const finalPower = Math.max(18, Math.min(powerPct, 100));
    const gaugeZone: "weak" | "medium" | "perfect" | "overload" =
      finalPower >= 92
        ? "overload"
        : finalPower >= 70
          ? "perfect"
          : finalPower >= 48
            ? "medium"
            : "weak";

    // Vitesse (m/s) calée sur la jauge
    let speedMs = 24.0;
    if (gaugeZone === "weak") {
      speedMs = 15.5 + ((finalPower - 18) / 30) * 5.0; // ~56 - 74 km/h
    } else if (gaugeZone === "medium") {
      speedMs = 21.0 + ((finalPower - 48) / 22) * 6.5; // ~76 - 99 km/h
    } else if (gaugeZone === "perfect") {
      speedMs = 28.8 + ((finalPower - 70) / 21) * 3.6; // ~104 - 117 km/h (Frappe pure)
    } else {
      speedMs = 33.0 + ((finalPower - 92) / 8) * 3.5;  // > 119 km/h (Surcharge incontrôlable)
    }
    const flightTime = PENALTY_Z / speedMs;

    if (swipePoints.length < 2) {
      const defaultY = gaugeZone === "overload" ? GOAL.height + 1.25 : 1.15;
      const vy0 = ((defaultY - BALL_R) + 0.5 * FLIGHT_GRAVITY * flightTime * flightTime) / flightTime;
      return {
        targetX: 0,
        targetY: defaultY,
        midWorldX: 0,
        spinCurve: 0,
        speedMs,
        flightTime,
        vx0: 0,
        vy0,
        totalAx: 0,
        gaugeZone
      };
    }

    const start = swipePoints[0];
    const end = swipePoints[swipePoints.length - 1];
    const ballScreen = worldToScreen(0, BALL_R, PENALTY_Z);
    const goalBotScreen = worldToScreen(0, 0.16, 0);
    const goalTopScreen = worldToScreen(0, GOAL.height, 0);

    // Si le joueur commence son geste un peu à côté du ballon, on translate le tracé pour qu'il parte du ballon
    const distFromBall = Math.hypot(start.x - ballScreen.x, start.y - ballScreen.y);
    const offsetScale = distFromBall > 95 ? 0.65 : 0.0;
    const effEndX = end.x + (ballScreen.x - start.x) * offsetScale;

    // Si le bout du doigt arrive dans la zone écran du but, on prend directement la position exacte sous le doigt !
    // Sinon (petit swipe court en bas de l'écran), on projette proportionnellement la poussée verticale vers le but.
    let effEndY = end.y;
    if (end.y > goalBotScreen.y + 12) {
      const pushUpPx = Math.max(10, start.y - end.y);
      const goalSpanPx = Math.max(80, goalBotScreen.y - goalTopScreen.y);
      const ratioY = Math.min(1.22, pushUpPx / (goalSpanPx * 1.45));
      effEndY = goalBotScreen.y - ratioY * goalSpanPx;
    }

    const goalHit3D = screenToPlaneZ(effEndX, effEndY, 0);
    let targetX = THREE.MathUtils.clamp(goalHit3D.x, -4.35, 4.35);
    let targetY = THREE.MathUtils.clamp(goalHit3D.y, BALL_R + 0.04, 2.38);

    // Respect strict de la jauge :
    // 1. Si la jauge atteint le MAX / Zone Rouge (>= 92%), la frappe est OBLIGATOIREMENT RATÉE (s'envole au-dessus de la barre) !
    if (gaugeZone === "overload") {
      const overRatio = (finalPower - 92) / 8; // 0..1
      targetY = GOAL.height + 0.88 + overRatio * 1.35; // 3.32m à 4.67m (au-dessus de la transversale !)
      targetX += (targetX >= 0 ? 1 : -1) * (0.45 + overRatio * 0.65);
    } else if (gaugeZone === "weak") {
      // 2. Si la jauge est trop faible (< 48%), le ballon manque de levée et retombe bas
      const weakFactor = (finalPower - 18) / 30; // 0..1
      targetY = Math.max(BALL_R + 0.02, targetY * (0.38 + weakFactor * 0.42));
    } else if (gaugeZone === "medium") {
      // 3. Zone moyenne (48..69%) : légère perte de hauteur sur les lucarnes
      targetY = Math.max(BALL_R + 0.04, targetY * 0.92);
    }
    // 4. En Zone Verte ("perfect", 70..91%) : targetX et targetY respectent à 100% la visée pour la plus belle frappe !

    // Mesure de la courbure ("ventre" du tracé du doigt entre start et end)
    let maxSignedDevX = 0;
    const chordX = end.x - start.x;
    const chordY = end.y - start.y;
    const chordLen = Math.hypot(chordX, chordY);

    if (chordLen > 20 && swipePoints.length >= 4) {
      for (let i = 1; i < swipePoints.length - 1; i++) {
        const pt = swipePoints[i];
        const t = Math.max(0, Math.min(1, ((pt.x - start.x) * chordX + (pt.y - start.y) * chordY) / (chordLen * chordLen)));
        const projX = start.x + t * chordX;
        const devX = pt.x - projX;
        if (Math.abs(devX) > Math.abs(maxSignedDevX)) {
          maxSignedDevX = devX;
        }
      }
    }

    // En Zone Verte ("perfect"), l'effet enroulé est pur et amplifié ; en surcharge ("overload"), l'effet dévisse
    const curveGain = gaugeZone === "perfect" ? 1.15 : gaugeZone === "weak" ? 0.65 : 1.0;

    // Conversion exacte du ventre écran à mi-parcours (Z = 5.5m) en coordonnée 3D midWorldX
    const midZ = PENALTY_Z * 0.5;
    const straightMidScreen = worldToScreen(targetX * 0.5, (BALL_R + targetY) * 0.5, midZ);
    const midWorld3D = screenToPlaneZ(straightMidScreen.x + maxSignedDevX * curveGain, straightMidScreen.y, midZ);
    const midWorldX = THREE.MathUtils.clamp(midWorld3D.x, -5.6, 5.6);

    // Cinématique exacte : X(0) = 0, X(T/2) = midWorldX, X(T) = targetX
    const totalAx = THREE.MathUtils.clamp(
      (4 * (targetX - 2 * midWorldX)) / (flightTime * flightTime),
      -34.0,
      34.0
    );
    const vx0 = (targetX - 0.5 * totalAx * flightTime * flightTime) / flightTime;
    const vy0 = ((targetY - BALL_R) + 0.5 * FLIGHT_GRAVITY * flightTime * flightTime) / flightTime;

    return {
      targetX,
      targetY,
      midWorldX,
      spinCurve: totalAx,
      speedMs,
      flightTime,
      vx0,
      vy0,
      totalAx,
      gaugeZone
    };
  }

  function drawSwipeTrail() {
    swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
    if (swipePoints.length < 2) return;

    const traj = computeExactTrajectory(lockedPowerPct);
    const isOverload = traj.gaugeZone === "overload";
    const isPerfect = traj.gaugeZone === "perfect";
    const isCurved = Math.abs(traj.spinCurve) > 3.2;

    swipeCtx.save();
    swipeCtx.lineCap = "round";
    swipeCtx.lineJoin = "round";

    // 1. Tracé discret du geste brut sous le doigt
    swipeCtx.strokeStyle = "rgba(255, 255, 255, 0.18)";
    swipeCtx.lineWidth = 4;
    swipeCtx.setLineDash([6, 6]);
    swipeCtx.beginPath();
    swipeCtx.moveTo(swipePoints[0].x, swipePoints[0].y);
    for (let i = 1; i < swipePoints.length; i++) {
      swipeCtx.lineTo(swipePoints[i].x, swipePoints[i].y);
    }
    swipeCtx.stroke();
    swipeCtx.setLineDash([]);

    // 2. Projection 2D de la VRAIE trajectoire 3D (X(t), Y(t), Z(t)) que le ballon va suivre exactement !
    const SAMPLES = 24;
    const screenPts: { x: number; y: number }[] = [];
    for (let i = 0; i <= SAMPLES; i++) {
      const u = i / SAMPLES;
      const t = u * traj.flightTime;
      const x = traj.vx0 * t + 0.5 * traj.totalAx * t * t;
      const y = BALL_R + traj.vy0 * t - 0.5 * FLIGHT_GRAVITY * t * t;
      const z = PENALTY_Z - traj.speedMs * t;
      screenPts.push(worldToScreen(x, y, z));
    }

    // Couleur de la trajectoire selon le respect de la jauge :
    // - Rouge vif si MAX/Surcharge (tir raté au-dessus)
    // - Vert émeraude brillant si Zone Parfaite (70-91%) ou effet enroulé
    // - Or en zone moyenne / Bleu ciel en zone faible
    const haloColor = isOverload
      ? "rgba(239, 68, 68, 0.52)"
      : isPerfect || isCurved
        ? "rgba(16, 185, 129, 0.48)"
        : traj.gaugeZone === "weak"
          ? "rgba(56, 189, 248, 0.38)"
          : "rgba(250, 204, 21, 0.42)";
    const coreColor = isOverload
      ? "#ef4444"
      : isPerfect || isCurved
        ? "#34d399"
        : traj.gaugeZone === "weak"
          ? "#38bdf8"
          : "#facc15";

    // Halo externe de la trajectoire 3D projetée
    swipeCtx.strokeStyle = haloColor;
    swipeCtx.lineWidth = 13;
    swipeCtx.beginPath();
    swipeCtx.moveTo(screenPts[0].x, screenPts[0].y);
    for (let i = 1; i < screenPts.length; i++) {
      swipeCtx.lineTo(screenPts[i].x, screenPts[i].y);
    }
    swipeCtx.stroke();

    // Ligne principale lumineuse de la trajectoire exacte
    swipeCtx.strokeStyle = coreColor;
    swipeCtx.lineWidth = 4.5;
    swipeCtx.stroke();

    // 3. Cible exacte d'impact sur le plan de but (Z = 0)
    const targetScreen = screenPts[screenPts.length - 1];
    swipeCtx.strokeStyle = coreColor;
    swipeCtx.lineWidth = 2.5;
    swipeCtx.beginPath();
    swipeCtx.arc(targetScreen.x, targetScreen.y, 12, 0, Math.PI * 2);
    swipeCtx.stroke();

    swipeCtx.fillStyle = isOverload ? "#ef4444" : "#ffffff";
    swipeCtx.beginPath();
    swipeCtx.arc(targetScreen.x, targetScreen.y, 4.5, 0, Math.PI * 2);
    swipeCtx.fill();

    swipeCtx.restore();
  }

  function updateChargeGauge(dt: number) {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;

    // La jauge monte de façon strictement irréversible (ne redescend jamais) à vitesse maîtrisée (54%/s),
    // sans sauter brutalement au max quand on vise la lucarne.
    // Si le joueur maintient trop longtemps et atteint la zone rouge (>= 92%) ou 100% MAX, la frappe est ratée !
    lockedPowerPct = Math.min(100, lockedPowerPct + dt * 54);

    const displayPct = Math.round(lockedPowerPct);
    if (powerMeterFill) powerMeterFill.style.height = `${displayPct}%`;

    const isOverload = lockedPowerPct >= 92;
    const isPerfect = lockedPowerPct >= 70 && lockedPowerPct < 92;

    if (powerMeterPct) {
      powerMeterPct.textContent = isOverload ? "MAX !" : `${displayPct}%`;
      powerMeterPct.className = isOverload
        ? "rounded bg-red-600 px-1.5 py-0.5 font-display text-xs tracking-wider text-white shadow animate-pulse"
        : isPerfect
          ? "rounded bg-emerald-500 px-1.5 py-0.5 font-display text-xs tracking-wider text-slate-950 font-black shadow"
          : "rounded bg-black/90 px-1.5 py-0.5 font-display text-xs tracking-wider text-or shadow";
    }

    if (powerMeterZoneBadge) {
      if (isOverload) {
        powerMeterZoneBadge.textContent = "TROP FORT !";
        powerMeterZoneBadge.className = "rounded bg-red-600 px-1.5 py-0.5 text-[0.5rem] font-black uppercase tracking-wider text-white shadow";
      } else if (isPerfect) {
        powerMeterZoneBadge.textContent = "PARFAIT ✨";
        powerMeterZoneBadge.className = "rounded bg-emerald-400 px-1.5 py-0.5 text-[0.5rem] font-black uppercase tracking-wider text-slate-950 shadow";
      } else if (lockedPowerPct >= 48) {
        powerMeterZoneBadge.textContent = "CORRECT";
        powerMeterZoneBadge.className = "rounded bg-amber-400/90 px-1.5 py-0.5 text-[0.5rem] font-black uppercase tracking-wider text-slate-950 shadow";
      } else {
        powerMeterZoneBadge.textContent = "FAIBLE";
        powerMeterZoneBadge.className = "rounded bg-sky-500/90 px-1.5 py-0.5 text-[0.5rem] font-black uppercase tracking-wider text-white shadow";
      }
    }

    const traj = computeExactTrajectory(lockedPowerPct);
    currentCurveSpin = traj.spinCurve;
    if (Math.abs(traj.spinCurve) > 3.2) {
      hudCurvePill?.classList.remove("hidden");
      hudCurvePill?.classList.add("flex");
      if (hudCurveLabel) {
        hudCurveLabel.textContent = traj.spinCurve < 0 ? "ENROULÉ GAUCHE ↶" : "ENROULÉ DROIT ↷";
      }
    } else {
      hudCurvePill?.classList.add("hidden");
      hudCurvePill?.classList.remove("flex");
    }

    drawSwipeTrail();

    // Si la jauge touche 100% (MAX), le tir part tout seul immédiatement en surcharge (au-dessus de la barre) !
    if (lockedPowerPct >= 100) {
      commitShotRelease();
    }
  }

  function commitShotRelease() {
    if (!chargeActive) return;
    chargeActive = false;
    ballGlowRing.visible = false;

    const traj = computeExactTrajectory(lockedPowerPct);
    setTimeout(() => {
      swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
      if (powerMeterWrap) powerMeterWrap.classList.add("opacity-0");
    }, 320);

    fireShot(lockedPowerPct, traj);
  }

  canvas.addEventListener("pointerdown", (e) => {
    initAudio();
    if (state.phase !== "aiming" || state.paused) return;
    state.phase = "charging";
    chargeActive = true;
    swipePoints = [{ x: e.clientX, y: e.clientY }];
    chargePeakPushY = 0;
    lockedPowerPct = 18;
    currentCurveSpin = 0;

    aimInstruction?.classList.add("opacity-0");
    powerMeterWrap?.classList.remove("opacity-0");
  });

  window.addEventListener("pointermove", (e) => {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;
    const lastPt = swipePoints[swipePoints.length - 1];
    if (lastPt) {
      const stepDist = Math.hypot(e.clientX - lastPt.x, e.clientY - lastPt.y);
      if (stepDist > 4) {
        swipePoints.push({ x: e.clientX, y: e.clientY });
        // Légère montée liée à l'amplitude du geste, plafonnée pour laisser le joueur viser la zone verte (70-91%)
        if (lockedPowerPct < 78) {
          lockedPowerPct = Math.min(78, lockedPowerPct + stepDist * 0.055);
        }
      }
    }
    const startY = swipePoints[0].y;
    const currentPushY = Math.max(0, startY - e.clientY);
    if (currentPushY > chargePeakPushY) {
      chargePeakPushY = currentPushY;
    }
  });

  window.addEventListener("pointerup", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) commitShotRelease();
  });
  window.addEventListener("pointercancel", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) commitShotRelease();
  });

  const RUNUP_DURATION = 0.25;
  let pendingShotConfig: {
    powerPct: number;
    traj: ExactShotTrajectory;
    forceKeeperSave?: boolean;
    forceOutcome?: "" | "catch" | "deflect_goal";
  } | null = null;

  function fireShot(
    powerPct: number,
    traj: ExactShotTrajectory,
    forceKeeperSave?: boolean,
    forceOutcome: "" | "catch" | "deflect_goal" = ""
  ) {
    pendingShotConfig = { powerPct, traj, forceKeeperSave, forceOutcome };
    state.phase = "runup";
    state.runupElapsed = 0;
  }

  function executeBallLaunch() {
    if (!pendingShotConfig) return;
    const { powerPct, traj, forceKeeperSave, forceOutcome } = pendingShotConfig;
    pendingShotConfig = null;

    state.phase = "shooting";

    shotPhys.active = true;
    shotPhys.inGoalCage = false;
    shotPhys.resolved = false;
    shotPhys.caughtByKeeper = false;
    shotPhys.parriedByKeeper = false;
    shotPhys.touchedGlove = false;
    shotPhys.touchedPost = "";
    shotPhys.forceOutcome = forceOutcome || "";
    shotPhys.gaugeZone = traj.gaugeZone;
    shotPhys.powerPct = Math.round(powerPct);
    shotPhys.postContactElapsed = 0;
    shotPhys.flightElapsed = 0;
    shotPhys.vz = -traj.speedMs;
    shotPhys.vx = traj.vx0;
    shotPhys.vy = traj.vy0;
    shotPhys.totalAx = traj.totalAx;
    shotPhys.spinY = traj.spinCurve;
    shotPhys.spinX = traj.speedMs * 0.65;
    shotPhys.speedKmh = Math.round(traj.speedMs * 3.6);
    shotPhys.wallJumping = true;

    // Ruban aérodynamique 3D et particules d'herbe/craie à l'impact du pied
    trailHistory.length = 0;
    trailMat.color.setHex(
      traj.gaugeZone === "overload"
        ? 0xef4444
        : traj.gaugeZone === "perfect" || Math.abs(traj.spinCurve) > 3.2
          ? 0x34d399
          : 0xfacc15
    );
    ballTrailLine.visible = true;
    spawnTurfBurst(0, BALL_R * 0.5, PENALTY_Z, 26, false);
    cameraShakeAmp = traj.gaugeZone === "overload" ? 0.065 : 0.032;

    playKickAudio(powerPct / 100);

    const tier = getActiveTier();
    const tKeeper = (PENALTY_Z - 0.28) / traj.speedMs;
    const predX = shotPhys.vx * tKeeper + 0.5 * shotPhys.totalAx * tKeeper * tKeeper;
    const predY = Math.max(BALL_R, BALL_R + shotPhys.vy * tKeeper - 0.5 * FLIGHT_GRAVITY * tKeeper * tKeeper);

    // La plus belle frappe (Zone Verte "perfect" 70-91% + effet enroulé) prend le gardien de vitesse !
    // À l'inverse, une frappe trop faible ("weak" < 48%) est très facilement lue et captée par le gardien.
    const isCentralShot = Math.abs(predX) < 1.05;
    const curveDeception = Math.min(Math.abs(traj.spinCurve) * 0.015, 0.28);
    const gaugeReadModifier =
      traj.gaugeZone === "perfect"
        ? -0.26
        : traj.gaugeZone === "weak"
          ? 0.30
          : 0;

    shotPhys.keeperReadsRight =
      forceKeeperSave !== undefined
        ? forceKeeperSave
        : isCentralShot || Math.random() < (tier.keeperReadProb - curveDeception + gaugeReadModifier);

    if (shotPhys.keeperReadsRight) {
      const spinOffset =
        forceKeeperSave === true
          ? 0
          : -Math.sign(traj.spinCurve) * Math.min(0.46, Math.abs(traj.spinCurve) * 0.02);
      shotPhys.keeperTargetX = THREE.MathUtils.clamp(predX + spinOffset, -3.55, 3.55);
      shotPhys.keeperTargetY = THREE.MathUtils.clamp(predY, 0.35, 2.35);
      shotPhys.keeperDiveDir = Math.sign(predX || 1);
    } else {
      const wrongDir = predX >= 0 ? -1 : 1;
      shotPhys.keeperTargetX = wrongDir * (1.6 + Math.random() * 1.4);
      shotPhys.keeperTargetY = 0.65 + Math.random() * 1.1;
      shotPhys.keeperDiveDir = wrongDir;
    }
  }

  // Permet de déclencher à la demande les 6 cas physiques (Arrêt capté, Dévié au fond, But, Parade, Poteau rentrant, Poteau sortant)
  (window as unknown as Record<string, unknown>).triggerPenaltyDemoCase = (
    demoCase: "catch" | "deflect_goal" | "goal" | "save" | "post_in" | "post_out"
  ) => {
    initAudio();
    setupNextKick();
    let speedMs = 28.5;
    let powerPct = 82;
    let gaugeZone: "weak" | "medium" | "perfect" | "overload" = "perfect";
    let targetX = -2.85;
    let targetY = 1.72;
    let midWorldX = -1.85;
    let forceSave: boolean | undefined = false;
    let forceOutcome: "" | "catch" | "deflect_goal" = "";

    if (demoCase === "catch") {
      // Arrêt capté (Prise franche entre les deux gants du gardien)
      speedMs = 21.8;
      powerPct = 58;
      gaugeZone = "medium";
      targetX = 0.34;
      targetY = 1.12;
      midWorldX = 0.16;
      forceSave = true;
      forceOutcome = "catch";
    } else if (demoCase === "deflect_goal") {
      // Frappe puissante touchée/déviée du bout du gant mais qui finit quand même au fond des filets !
      speedMs = 30.2;
      powerPct = 85;
      gaugeZone = "perfect";
      targetX = -2.18;
      targetY = 1.46;
      midWorldX = -1.35;
      forceSave = true;
      forceOutcome = "deflect_goal";
    } else if (demoCase === "goal") {
      // Lucarne gauche enroulée dans le filet
      targetX = -2.92;
      targetY = 1.88;
      midWorldX = -1.95;
      forceSave = false;
    } else if (demoCase === "save") {
      // Frappe cadrée à mi-hauteur repoussée par le plongeon du gardien
      targetX = 1.85;
      targetY = 1.18;
      midWorldX = 0.92;
      forceSave = true;
    } else if (demoCase === "post_in") {
      // Impact sur le bord intérieur du montant droit (X = +3.57m) -> Poteau rentrant dans le filet !
      targetX = GOAL.width / 2 - 0.09;
      targetY = 1.32;
      midWorldX = targetX * 0.5;
      forceSave = false;
    } else if (demoCase === "post_out") {
      // Impact sur le bord extérieur du montant gauche (X = -3.69m) -> Poteau sortant !
      targetX = -(GOAL.width / 2 + 0.03);
      targetY = 1.36;
      midWorldX = targetX * 0.5;
      forceSave = false;
    }

    const flightTime = PENALTY_Z / speedMs;
    const totalAx = (4 * (targetX - 2 * midWorldX)) / (flightTime * flightTime);
    const vx0 = (targetX - 0.5 * totalAx * flightTime * flightTime) / flightTime;
    const vy0 = ((targetY - BALL_R) + 0.5 * FLIGHT_GRAVITY * flightTime * flightTime) / flightTime;

    aimInstruction?.classList.add("opacity-0");
    ballGlowRing.visible = false;
    fireShot(
      powerPct,
      {
        targetX,
        targetY,
        midWorldX,
        spinCurve: totalAx,
        speedMs,
        flightTime,
        vx0,
        vy0,
        totalAx,
        gaugeZone
      },
      forceSave,
      forceOutcome
    );
  };

  /* -------------------------------------------------------------------------- */
  /*  PHYSIQUE CCD PAR SOUS-PAS + 8 ANIMATIONS DU GARDIEN + POTEAU RENTRANT     */
  /* -------------------------------------------------------------------------- */
  function updatePhysics(dt: number) {
    const tier = getActiveTier();

    if (shotPhys.wallJumping && wallGroup.children.length > 0) {
      wallGroup.children.forEach((p) => {
        if (ballMesh.position.z > 4.2) {
          p.position.y = Math.min(0.66, p.position.y + dt * 4.2);
        } else {
          p.position.y = Math.max(0, p.position.y - dt * 2.5);
        }
      });
    }

    if (!shotPhys.active) return;

    shotPhys.flightElapsed += dt;

    // 1. Prise d'appui (Split-Step) avant le plongeon : flexion des genoux et transfert de poids
    if (shotPhys.flightElapsed < tier.keeperReactionSec) {
      const prepRatio = shotPhys.flightElapsed / Math.max(0.01, tier.keeperReactionSec);
      keeperGroup.position.y = -0.06 * Math.sin(prepRatio * Math.PI);
      legL.kneePivot.rotation.x = 0.42 + 0.25 * prepRatio;
      legR.kneePivot.rotation.x = 0.42 + 0.25 * prepRatio;
      upperBodyGroup.rotation.x = 0.14 + 0.10 * prepRatio;
    } else {
      // 2. Déclenchement de l'arrêt debout, du plongeon bas/haut, de la retombée et du relevé
      const diveElapsed = shotPhys.flightElapsed - tier.keeperReactionSec;
      const isStandingSave = Math.abs(shotPhys.keeperTargetX) < 0.78;
      const isHighDive = shotPhys.keeperTargetY >= 1.15;

      const desiredTorsoX = isStandingSave
        ? shotPhys.keeperTargetX * 0.75
        : THREE.MathUtils.clamp(
            shotPhys.keeperTargetX - shotPhys.keeperDiveDir * (tier.keeperArmSpan * 0.55),
            -2.65,
            2.65
          );

      // Après l'extension maximale (diveElapsed > 0.44s), le gardien retombe au sol avec du poids (landing -> getup)
      const inLanding = !isStandingSave && diveElapsed > 0.44;
      const desiredTorsoY = isStandingSave
        ? Math.max(0, (shotPhys.keeperTargetY - 1.15) * 0.35)
        : inLanding
          ? 0.04
          : THREE.MathUtils.clamp(shotPhys.keeperTargetY - 0.92, 0.02, 1.12);

      keeperGroup.position.x = THREE.MathUtils.lerp(
        keeperGroup.position.x,
        desiredTorsoX,
        Math.min(1, dt * tier.keeperDiveSpeed)
      );
      keeperGroup.position.y = THREE.MathUtils.lerp(
        keeperGroup.position.y,
        desiredTorsoY,
        Math.min(1, dt * (inLanding ? 8.5 : tier.keeperDiveSpeed * 0.95))
      );

      keeperGroundShadow.position.x = keeperGroup.position.x;
      keeperGroundShadow.scale.set(isStandingSave ? 1 : 1.45, 1, 1);

      if (isStandingSave) {
        // Arrêt debout : buste droit, gants projetés devant le visage/poitrine
        keeperGroup.rotation.z = THREE.MathUtils.lerp(keeperGroup.rotation.z, -shotPhys.keeperTargetX * 0.18, dt * 16);
        kArmL.rotation.z = THREE.MathUtils.lerp(kArmL.rotation.z, 2.25, dt * 20);
        kArmR.rotation.z = THREE.MathUtils.lerp(kArmR.rotation.z, -2.25, dt * 20);
        armL.elbowPivot.rotation.x = THREE.MathUtils.lerp(armL.elbowPivot.rotation.x, -0.35, dt * 20);
        armR.elbowPivot.rotation.x = THREE.MathUtils.lerp(armR.elbowPivot.rotation.x, -0.35, dt * 20);
      } else {
        // Plongeon bas ou haut + poussée de la jambe d'appui + retombée au sol
        const targetTilt = inLanding
          ? -shotPhys.keeperDiveDir * 1.42
          : THREE.MathUtils.clamp(-shotPhys.keeperTargetX * (isHighDive ? 0.48 : 0.54), -1.38, 1.38);
        keeperGroup.rotation.z = THREE.MathUtils.lerp(keeperGroup.rotation.z, targetTilt, dt * 18);
        kArmL.rotation.z = THREE.MathUtils.lerp(kArmL.rotation.z, 2.82, dt * 22);
        kArmR.rotation.z = THREE.MathUtils.lerp(kArmR.rotation.z, -2.82, dt * 22);
        armL.elbowPivot.rotation.x = THREE.MathUtils.lerp(armL.elbowPivot.rotation.x, 0, dt * 22);
        armR.elbowPivot.rotation.x = THREE.MathUtils.lerp(armR.elbowPivot.rotation.x, 0, dt * 22);

        // Extension de la jambe de poussée et flexion de la jambe libre
        if (shotPhys.keeperDiveDir > 0) {
          legR.kneePivot.rotation.x = THREE.MathUtils.lerp(legR.kneePivot.rotation.x, 0.06, dt * 18);
          legL.kneePivot.rotation.x = THREE.MathUtils.lerp(legL.kneePivot.rotation.x, 0.68, dt * 18);
        } else {
          legL.kneePivot.rotation.x = THREE.MathUtils.lerp(legL.kneePivot.rotation.x, 0.06, dt * 18);
          legR.kneePivot.rotation.x = THREE.MathUtils.lerp(legR.kneePivot.rotation.x, 0.68, dt * 18);
        }
      }
    }

    // Si le gardien a capté franchement le ballon entre ses gants, le ballon suit les mains du gardien
    if (shotPhys.caughtByKeeper) {
      ballMesh.position.set(
        keeperGroup.position.x + shotPhys.keeperDiveDir * 0.25,
        Math.max(BALL_R, keeperGroup.position.y + 1.05),
        0.34
      );
      shotPhys.postContactElapsed += dt;
      if (!shotPhys.resolved && shotPhys.postContactElapsed >= 0.32) {
        resolveShot(false, "PRISE FRANCHE DU GARDIEN !", "Ballon capté en deux temps par le portier !");
      }
      return;
    }

    const SUBSTEPS = 8;
    const subDt = dt / SUBSTEPS;

    for (let step = 0; step < SUBSTEPS; step++) {
      const prevX = ballMesh.position.x;
      const prevY = ballMesh.position.y;
      const prevZ = ballMesh.position.z;

      const afterImpact =
        shotPhys.inGoalCage ||
        shotPhys.resolved ||
        shotPhys.parriedByKeeper ||
        shotPhys.touchedGlove ||
        shotPhys.touchedPost !== "";

      const grav = afterImpact ? 9.81 : FLIGHT_GRAVITY;
      shotPhys.vy -= grav * subDt;
      if (!afterImpact) {
        shotPhys.vx += shotPhys.totalAx * subDt;
      }

      ballMesh.position.x += shotPhys.vx * subDt;
      ballMesh.position.y += shotPhys.vy * subDt;
      ballMesh.position.z += shotPhys.vz * subDt;

      ballMesh.rotation.x += (shotPhys.vz * subDt) / BALL_R;
      ballMesh.rotation.y += shotPhys.spinY * subDt * 0.78;
      ballMesh.rotation.z -= shotPhys.spinY * subDt * 0.35;

      // Contact avec le gazon
      if (ballMesh.position.y < BALL_R) {
        ballMesh.position.y = BALL_R;
        if (afterImpact) {
          shotPhys.vy = Math.abs(shotPhys.vy) * (shotPhys.inGoalCage ? 0.35 : 0.52);
          shotPhys.vx *= shotPhys.inGoalCage ? 0.72 : 0.85;
          shotPhys.vz *= shotPhys.inGoalCage ? 0.72 : 0.85;
        } else if (shotPhys.vy < 0) {
          shotPhys.vy = 0;
        }
      }

      // Confinement physique dans le filet une fois que le ballon entier est entré dans le but
      if (shotPhys.inGoalCage) {
        const maxSideX = GOAL.width / 2 - BALL_R - 0.08;
        const minBackZ = -GOAL.depth + BALL_R + 0.12;
        const maxTopY = GOAL.height - BALL_R - 0.08;

        if (ballMesh.position.z <= minBackZ) {
          const hitSpeed = Math.abs(shotPhys.vz);
          ballMesh.position.z = minBackZ;
          shotPhys.vz = Math.min(2.8, hitSpeed * 0.18);
          shotPhys.vx *= 0.28;
          shotPhys.vy = Math.min(0.5, shotPhys.vy * 0.25);
          shotPhys.spinX = 0;
          shotPhys.spinY = 0;
          if (hitSpeed > 1.2) {
            triggerNetDeformation(ballMesh.position.x, ballMesh.position.y, hitSpeed);
            cameraShakeAmp = Math.max(cameraShakeAmp, 0.055);
          }
        }
        if (ballMesh.position.x < -maxSideX) {
          ballMesh.position.x = -maxSideX;
          shotPhys.vx = Math.abs(shotPhys.vx) * 0.22;
          shotPhys.vz *= 0.45;
          if (Math.abs(shotPhys.vx) > 0.8) triggerNetDeformation(-GOAL.width / 2 + 0.3, ballMesh.position.y, 12);
        }
        if (ballMesh.position.x > maxSideX) {
          ballMesh.position.x = maxSideX;
          shotPhys.vx = -Math.abs(shotPhys.vx) * 0.22;
          shotPhys.vz *= 0.45;
          if (Math.abs(shotPhys.vx) > 0.8) triggerNetDeformation(GOAL.width / 2 - 0.3, ballMesh.position.y, 12);
        }
        if (ballMesh.position.y > maxTopY) {
          ballMesh.position.y = maxTopY;
          shotPhys.vy = -Math.abs(shotPhys.vy) * 0.22;
        }
        if (ballMesh.position.z > -0.18) {
          ballMesh.position.z = -0.18;
          if (shotPhys.vz > 0) shotPhys.vz = 0;
        }
        continue;
      }

      if (shotPhys.resolved) {
        if (ballMesh.position.z < -4.2) {
          ballMesh.position.z = -4.2;
          shotPhys.vz = Math.abs(shotPhys.vz) * 0.3;
          shotPhys.vx *= 0.5;
        }
        continue;
      }

      // 1. Mur défensif
      if (wallGroup.children.length > 0 && prevZ >= 5.2 && ballMesh.position.z <= 5.2) {
        const alpha = (prevZ - 5.2) / Math.max(0.00001, prevZ - ballMesh.position.z);
        const crossX = THREE.MathUtils.lerp(prevX, ballMesh.position.x, alpha);
        const crossY = THREE.MathUtils.lerp(prevY, ballMesh.position.y, alpha);

        let blockedByWall = false;
        for (const p of wallGroup.children) {
          if (Math.abs(crossX - p.position.x) < 0.38 && crossY < 1.88 + p.position.y) {
            blockedByWall = true;
            break;
          }
        }
        if (blockedByWall) {
          ballMesh.position.set(crossX, crossY, 5.25);
          shotPhys.vz = Math.abs(shotPhys.vz) * 0.38;
          shotPhys.vx += (Math.random() - 0.5) * 5;
          shotPhys.vy = 2.8;
          shotPhys.parriedByKeeper = true;
          spawnTurfBurst(crossX, crossY, 5.25, 14, true);
          playSaveAudio();
          resolveShot(false, "CONTRÉ PAR LE MUR !", "Enroule ton geste avec le doigt pour contourner le mur !");
          break;
        }
      }

      // 2. Gardien : Prise franche (Catch), Parade repoussée (Parry) ou Ballon effleuré (Deflection)
      if (!shotPhys.parriedByKeeper && !shotPhys.touchedGlove && prevZ >= 0.28 && ballMesh.position.z <= 0.28) {
        const alpha = (prevZ - 0.28) / Math.max(0.00001, prevZ - ballMesh.position.z);
        const crossX = THREE.MathUtils.lerp(prevX, ballMesh.position.x, alpha);
        const crossY = THREE.MathUtils.lerp(prevY, ballMesh.position.y, alpha);

        const torsoX = keeperGroup.position.x;
        const diveDir = shotPhys.keeperDiveDir;
        const minCoverX = Math.min(torsoX - 0.62, torsoX + diveDir * tier.keeperArmSpan - 0.32);
        const maxCoverX = Math.max(torsoX + 0.62, torsoX + diveDir * tier.keeperArmSpan + 0.32);
        const maxCoverY = keeperGroup.position.y + 1.98;

        if (shotPhys.forceOutcome === "catch") {
          shotPhys.caughtByKeeper = true;
          playSaveAudio();
          break;
        } else if (shotPhys.forceOutcome === "deflect_goal") {
          // Déviation du bout des gants qui finit quand même au fond des filets !
          shotPhys.touchedGlove = true;
          shotPhys.vx *= 0.82;
          shotPhys.vy += 0.55;
          shotPhys.vz *= 0.80;
          spawnTurfBurst(crossX, crossY, 0.30, 14, true);
          cameraShakeAmp = 0.04;
          playSaveAudio();
        } else if (crossY >= 0 && crossY <= maxCoverY) {
          // Cas A : Prise franche près du buste / entre les deux gants
          if (Math.abs(crossX - torsoX) < 0.32 && crossY >= 0.55 && crossY <= 1.58 && Math.abs(shotPhys.vz) < 25.5) {
            shotPhys.caughtByKeeper = true;
            playSaveAudio();
            break;
          }
          // Cas B : Parade ferme de la paume du gant (ballon repoussé)
          if (crossX >= minCoverX && crossX <= maxCoverX) {
            ballMesh.position.set(crossX, crossY, 0.34);
            shotPhys.vz = Math.abs(shotPhys.vz) * 0.44;
            shotPhys.vx = (diveDir || 1) * 6.6;
            shotPhys.vy = 2.8;
            shotPhys.parriedByKeeper = true;
            spawnTurfBurst(crossX, crossY, 0.34, 16, true);
            cameraShakeAmp = 0.045;
            playSaveAudio();
          } else if (crossX >= minCoverX - 0.16 && crossX <= maxCoverX + 0.16) {
            // Cas C : Ballon effleuré du bout des gants ! La trajectoire est déviée mais continue vers le but
            shotPhys.touchedGlove = true;
            shotPhys.vx += (diveDir || 1) * 2.8;
            shotPhys.vy += 1.1;
            shotPhys.vz *= 0.82;
            spawnTurfBurst(crossX, crossY, 0.30, 10, true);
            playSaveAudio();
          }
        }
      }

      // 3. Collision continue (CCD) avec les montants (Poteau rentrant vs Poteau sortant) et la barre
      if (shotPhys.touchedPost === "" && prevZ >= 0 && ballMesh.position.z <= 0) {
        const alpha = prevZ / Math.max(0.00001, prevZ - ballMesh.position.z);
        const crossX = THREE.MathUtils.lerp(prevX, ballMesh.position.x, alpha);
        const crossY = THREE.MathUtils.lerp(prevY, ballMesh.position.y, alpha);
        const halfW = GOAL.width / 2;
        const postRadiusSum = GOAL.postR + BALL_R * 0.85; // ~0.188m

        const distLeftPost = Math.abs(crossX + halfW);
        const distRightPost = Math.abs(crossX - halfW);
        const distBar = Math.abs(crossY - GOAL.height);

        const hitLeftPost = distLeftPost < postRadiusSum && crossY <= GOAL.height + 0.14;
        const hitRightPost = distRightPost < postRadiusSum && crossY <= GOAL.height + 0.14;
        const hitBar = distBar < postRadiusSum && Math.abs(crossX) <= halfW + 0.14;

        if (hitLeftPost || hitRightPost || hitBar) {
          spawnTurfBurst(crossX, crossY, 0.06, 22, true);
          cameraShakeAmp = 0.085;
          goalFrameVibration = 0.25;
          playPostAudio();

          if (hitBar) {
            // Barre transversale : si le ballon tape sous la barre (crossY < GOAL.height - 0.02), il peut rentrer, sinon il rebondit dehors
            const barIn = crossY < GOAL.height - 0.035 && Math.abs(crossX) < halfW - BALL_R;
            if (barIn) {
              shotPhys.touchedPost = "in";
              ballMesh.position.set(crossX, GOAL.height - BALL_R - 0.02, -0.02);
              shotPhys.vy = -Math.abs(shotPhys.vy) * 0.45;
              shotPhys.vz *= 0.68;
            } else {
              shotPhys.touchedPost = "bar";
              ballMesh.position.set(crossX, crossY, 0.08);
              shotPhys.vz = Math.abs(shotPhys.vz) * 0.42;
              shotPhys.vy = Math.abs(shotPhys.vy) * 0.58 + 2.2;
            }
          } else {
            // Poteau gauche ou droit :
            // Si le centre du ballon frappe la face INTÉRIEURE du poteau (|crossX| < halfW - 0.015), le rebond dévie le ballon DANS le but (Poteau rentrant !)
            const isInnerFace = Math.abs(crossX) < halfW - 0.015;
            const postSign = hitRightPost ? 1 : -1;
            if (isInnerFace) {
              shotPhys.touchedPost = "in";
              ballMesh.position.set(postSign * (halfW - BALL_R - 0.02), crossY, -0.02);
              shotPhys.vx = -postSign * Math.max(3.8, Math.abs(shotPhys.vz) * 0.28);
              shotPhys.vz = -Math.abs(shotPhys.vz) * 0.58;
            } else {
              shotPhys.touchedPost = "out";
              ballMesh.position.set(crossX, crossY, 0.10);
              shotPhys.vx = postSign * Math.max(4.8, Math.abs(shotPhys.vx) * 0.7 + 3.5);
              shotPhys.vz = Math.abs(shotPhys.vz) * 0.44;
            }
          }
        }
      }

      // 4. Validation du BUT : uniquement quand le ballon ENTIER a franchi la ligne (z <= -BALL_R) dans l'ouverture du but
      // et que la jauge n'a JAMAIS atteint le MAX ("overload") !
      const halfW = GOAL.width / 2;
      if (ballMesh.position.z <= -BALL_R && !shotPhys.inGoalCage) {
        const insideX = Math.abs(ballMesh.position.x) <= halfW - BALL_R * 0.65;
        const insideY =
          shotPhys.gaugeZone !== "overload" &&
          ballMesh.position.y > 0 &&
          ballMesh.position.y <= GOAL.height - BALL_R * 0.55;

        if (insideX && insideY) {
          shotPhys.inGoalCage = true;
          ballMesh.position.x = THREE.MathUtils.clamp(ballMesh.position.x, -halfW + BALL_R + 0.08, halfW - BALL_R - 0.08);
          ballMesh.position.y = THREE.MathUtils.clamp(ballMesh.position.y, BALL_R, GOAL.height - BALL_R - 0.08);

          const curvedTag = Math.abs(shotPhys.spinY) > 3.2 ? " · ENROULÉ 🌀" : "";
          const gaugeTag =
            shotPhys.gaugeZone === "perfect"
              ? ` · JAUGE PARFAITE ✨ (${shotPhys.powerPct}%)`
              : ` · Jauge ${shotPhys.powerPct}%`;
          const goalTitle =
            shotPhys.touchedPost === "in"
              ? "POTEAU RENTRANT ! ⚽"
              : shotPhys.touchedGlove
                ? "DÉVIÉ AU FOND ! ⚽"
                : shotPhys.gaugeZone === "perfect"
                  ? "FRAPPE PARFAITE ! ⚽✨"
                  : "BUT AUX MARTYRS ! ⚽";
          resolveShot(true, goalTitle, `${shotPhys.speedKmh} km/h${gaugeTag}${curvedTag}`);
          continue;
        } else if (shotPhys.touchedPost === "" && !shotPhys.parriedByKeeper) {
          // Ballon passé derrière le plan de but en dehors du cadre ou jauge au MAX ("overload")
          if (shotPhys.gaugeZone === "overload") {
            resolveShot(
              false,
              "PUISSANCE MAX · TIR RATÉ !",
              `Jauge dans le rouge (${shotPhys.powerPct}%) · Relâche dans la zone verte (70–91%) !`
            );
          } else {
            const msg = ballMesh.position.y >= GOAL.height ? "AU-DESSUS DE LA BARRE !" : "À CÔTÉ DU CADRE !";
            resolveShot(
              false,
              msg,
              ballMesh.position.y >= GOAL.height ? "Vise un peu plus bas dans le but" : "Place le cercle de visée dans le cadre"
            );
          }
          break;
        }
      }

      // 5. Résolution différée après un contact avec un gant ou un montant sortant
      if (shotPhys.parriedByKeeper || shotPhys.touchedPost === "out" || shotPhys.touchedPost === "bar" || shotPhys.touchedGlove) {
        shotPhys.postContactElapsed += subDt;
        const waitLimit = shotPhys.touchedGlove ? 0.52 : 0.38;
        if (shotPhys.postContactElapsed >= waitLimit || ballMesh.position.z > 1.8 || Math.abs(ballMesh.position.x) > halfW + 1.6) {
          if (shotPhys.parriedByKeeper || shotPhys.touchedGlove) {
            resolveShot(
              false,
              shotPhys.touchedGlove ? "CLAQUETTE DU GARDIEN !" : "ARRÊT DU GARDIEN !",
              "Parade décisive du portier · Continue ta séance de 5 tirs !"
            );
          } else if (shotPhys.touchedPost === "bar") {
            resolveShot(false, "BARRE TRANSVERSALE !", "La transversale repousse ta frappe !");
          } else {
            resolveShot(false, "POTEAU SORTANT !", "Le montant repousse le ballon hors du but !");
          }
          break;
        }
      }
    }

    // Mise à jour du ruban aérodynamique 3D derrière le ballon
    trailHistory.unshift(ballMesh.position.clone());
    if (trailHistory.length > TRAIL_MAX_PTS) trailHistory.pop();
    const posAttr = trailGeo.getAttribute("position") as THREE.BufferAttribute;
    for (let i = 0; i < TRAIL_MAX_PTS; i++) {
      const pt = trailHistory[Math.min(i, trailHistory.length - 1)] || ballMesh.position;
      posAttr.setXYZ(i, pt.x, pt.y, pt.z);
    }
    posAttr.needsUpdate = true;
  }

  /* -------------------------------------------------------------------------- */
  /*  RÉSOLUTION DU TIR SUR LA SÉANCE DE 5 TIRS                                 */
  /* -------------------------------------------------------------------------- */
  function resolveShot(isGoal: boolean, title: string, subtitle: string) {
    shotPhys.resolved = true;
    state.phase = "result";

    if (isGoal) {
      state.goalsInSeries++;
      state.kickHistory.push("goal");
    } else {
      state.kickHistory.push("miss");
    }
    state.kickIndex++;

    playCrowdRoar(isGoal);
    updateHud();

    if (shotToast && toastTitle && toastSubtitle && toastEmoji) {
      toastEmoji.textContent = isGoal ? "⚽" : "🧤";
      toastTitle.textContent = `${title} (TIR ${state.kickIndex}/${TOTAL_KICKS_PER_SERIES})`;
      toastTitle.className = isGoal
        ? "font-display text-base sm:text-lg uppercase tracking-wider text-or leading-none"
        : "font-display text-base sm:text-lg uppercase tracking-wider text-red-400 leading-none";
      toastSubtitle.textContent = subtitle;
      shotToast.classList.remove("opacity-0", "-translate-y-4");
    }

    // Si les 5 tirs ne sont pas encore terminés, on enchaîne sur le tir suivant !
    if (state.kickIndex < TOTAL_KICKS_PER_SERIES) {
      setTimeout(() => {
        shotToast?.classList.add("opacity-0", "-translate-y-4");
        shotPhys.active = false;
        setupNextKick();
      }, 1550);
    } else {
      // Fin de la séance des 5 tirs : vérifier si la remontada est réussie !
      setTimeout(() => {
        shotToast?.classList.add("opacity-0", "-translate-y-4");
        shotPhys.active = false;
        showSeriesSummaryModal();
      }, 1600);
    }
  }

  function showSeriesSummaryModal() {
    state.phase = "gameover";
    const tier = getActiveTier();
    const wonLevel = state.goalsInSeries >= tier.targetGoals;

    if (wonLevel && tier.id < TIERS.length && tier.id + 1 > state.maxUnlockedTier) {
      state.maxUnlockedTier = tier.id + 1;
      localStorage.setItem("sdm_max_tier", String(state.maxUnlockedTier));
    }

    if (goBadge) {
      goBadge.textContent = wonLevel ? "🏆" : "🧤";
      goBadge.className = wonLevel
        ? "mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/20 text-2xl border border-emerald-400/40"
        : "mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-red-500/20 text-2xl border border-red-500/40";
    }
    if (goKicker) {
      goKicker.textContent = wonLevel
        ? `Niveau ${tier.id} Validé · Qualification !`
        : `Fin des 5 Tirs · Objectif ${tier.targetGoals}/5`;
      goKicker.className = wonLevel
        ? "mt-2 block text-[0.52rem] font-bold uppercase tracking-widest text-emerald-400"
        : "mt-2 block text-[0.52rem] font-bold uppercase tracking-widest text-red-400";
    }
    if (goTitle) {
      goTitle.textContent = wonLevel ? "REMONTADA AUX MARTYRS !" : "ÉLIMINATION AUX TAB";
    }
    if (goDesc) {
      goDesc.textContent = wonLevel
        ? `Score final : RDC ${state.goalsInSeries} – ${tier.oppScore} ADV. Prêt pour le niveau supérieur !`
        : `Score final : RDC ${state.goalsInSeries} – ${tier.oppScore} ADV. Il fallait ${tier.targetGoals} buts sur 5.`;
    }

    if (goFiveRecap) {
      goFiveRecap.innerHTML = "";
      state.kickHistory.forEach((res, idx) => {
        const pill = document.createElement("span");
        pill.className = `flex h-7 w-7 items-center justify-center rounded-full text-xs font-black border ${
          res === "goal"
            ? "bg-emerald-500/25 border-emerald-400 text-emerald-300"
            : "bg-red-500/25 border-red-400 text-red-300"
        }`;
        pill.textContent = res === "goal" ? "⚽" : "✕";
        pill.title = `Tir ${idx + 1}`;
        goFiveRecap.appendChild(pill);
      });
    }

    if (goStatScore) goStatScore.textContent = `${state.goalsInSeries} - ${tier.oppScore}`;
    if (goStatLevel) goStatLevel.textContent = `Niv. ${tier.id}`;
    if (goStatMade) goStatMade.textContent = `${state.goalsInSeries} / 5`;

    if (btnGoPrimary) {
      if (wonLevel && state.currentTierIndex + 1 < TIERS.length) {
        btnGoPrimary.textContent = `🔥 Niveau ${tier.id + 1} (${TIERS[state.currentTierIndex + 1].name})`;
        btnGoPrimary.onclick = () => startLevelSeries(state.currentTierIndex + 1);
      } else if (wonLevel) {
        btnGoPrimary.textContent = "👑 Rejouer la Finale (5 tirs)";
        btnGoPrimary.onclick = () => startLevelSeries(state.currentTierIndex);
      } else {
        btnGoPrimary.textContent = "🔄 Rejouer ce niveau (5 tirs)";
        btnGoPrimary.onclick = () => startLevelSeries(state.currentTierIndex);
      }
    }

    gameoverModal?.classList.remove("hidden");
    gameoverModal?.classList.add("flex");
    renderLevelsModal();
  }

  function startLevelSeries(tierIdx = 0) {
    state.paused = false;
    if (iconPause) iconPause.textContent = "⏸";
    state.currentTierIndex = THREE.MathUtils.clamp(tierIdx, 0, TIERS.length - 1);
    state.kickIndex = 0;
    state.kickHistory = [];
    state.goalsInSeries = 0;

    gameoverModal?.classList.add("hidden");
    gameoverModal?.classList.remove("flex");
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");
    setupNextKick();
    renderLevelsModal();
  }

