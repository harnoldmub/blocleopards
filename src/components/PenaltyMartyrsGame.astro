  function getTrackUrl(track: SongTrack): string {
    return `/audio/jeu/${encodeURIComponent(track.filename)}`;
  }

  function updateMusicUi() {
    const current = PLAYLIST[state.currentTrackIndex] || PLAYLIST[0];
    bgMusic.loop = state.loopMode === "single";
    if (hudTrackShort) hudTrackShort.textContent = current.shortTitle;
    if (hudTrackMobile) hudTrackMobile.textContent = current.shortTitle;
    if (pauseTrackName) pauseTrackName.textContent = current.title;
    if (menuNowPlaying) menuNowPlaying.textContent = current.title;
    if (menuLoopModeDesc) {
      menuLoopModeDesc.textContent =
        state.loopMode === "single"
          ? "🔂 Mode actif : 1 musique choisie aléatoirement tourne en boucle"
          : "🔁 Mode actif : Boucle sur les 5 chansons du dossier";
    }
    renderPlaylistMenu();
  }

  function loadAndPlayTrack(index: number, showToast = false) {
    state.currentTrackIndex = ((index % PLAYLIST.length) + PLAYLIST.length) % PLAYLIST.length;
    const track = PLAYLIST[state.currentTrackIndex];
    bgMusic.src = getTrackUrl(track);
    bgMusic.loop = state.loopMode === "single";
    updateMusicUi();

    if (state.audioEnabled) {
      bgMusic.play().then(() => {
        state.musicStarted = true;
      }).catch(() => {});
    }

    if (showToast && shotToast && toastTitle && toastSubtitle && toastEmoji && state.phase === "aiming") {
      toastEmoji.textContent = "🎵";
      toastTitle.textContent = track.shortTitle.toUpperCase();
      toastTitle.className = "font-display text-base sm:text-lg uppercase tracking-wider text-or leading-none";
      toastSubtitle.textContent = `${track.subtitle} · En boucle`;
      shotToast.classList.remove("opacity-0", "-translate-y-4");
      setTimeout(() => {
        if (state.phase === "aiming") shotToast.classList.add("opacity-0", "-translate-y-4");
      }, 1500);
    }
  }

  function pickRandomOtherTrackIndex(): number {
    if (PLAYLIST.length <= 1) return 0;
    let candidate = state.currentTrackIndex;
    while (candidate === state.currentTrackIndex) {
      candidate = Math.floor(Math.random() * PLAYLIST.length);
    }
    return candidate;
  }

  function playNextTrack(manual = false) {
    if (!manual && state.loopMode === "single") {
      bgMusic.currentTime = 0;
      if (state.audioEnabled) bgMusic.play().catch(() => {});
      return;
    }

    if (manual && state.loopMode === "single") {
      // Choisit aléatoirement une autre chanson et la met en boucle
      loadAndPlayTrack(pickRandomOtherTrackIndex(), true);
    } else {
      const nextIdx = (state.currentTrackIndex + 1) % PLAYLIST.length;
      loadAndPlayTrack(nextIdx, manual);
    }
  }

  function playPrevTrack() {
    const prevIdx = (state.currentTrackIndex - 1 + PLAYLIST.length) % PLAYLIST.length;
    loadAndPlayTrack(prevIdx, true);
  }

  bgMusic.addEventListener("ended", () => {
