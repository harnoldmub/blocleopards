---
/**
 * PenaltyMartyrsGame.astro
 * Expérience 3D plein écran : « Penalty aux Martyrs » (Stade des Martyrs, Kinshasa)
 * - Gardien 3D articulé réaliste (visage sculpté avec sourcils/eyebrows fins, maillot texturé, gants pro, crampons)
 * - Stade des Martyrs photo-réaliste avec panneaux publicitaires LED intégrant les vrais logos Partenaires & Bloc Léopards
 * - Eyebrow UI ultra-compact et discret
 * - Système de Pause complet (bouton ⏸ + touche P/Espace) qui fige la physique en temps réel
 * - Séparation stricte entre le Menu (Réglages, Pause, Stade, Partenaires) et la Progression de Niveau
 */
---

<div class="relative h-[100dvh] w-screen overflow-hidden bg-[#050811] font-body select-none" id="penalty-root">
  <!-- CANVAS WEBGL 3D PLEIN ÉCRAN -->
  <canvas id="penalty-canvas" class="block h-full w-full touch-none cursor-crosshair"></canvas>

  <!-- ================= HUD BROADCAST COMPACT ================= -->
  <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-start justify-between p-2.5 sm:p-4">
    
    <!-- GAUCHE : SCOREBUG TV & INDICATEURS EN DIRECT -->
    <div class="flex flex-col gap-1.5">
      <div class="pointer-events-auto flex items-center overflow-hidden rounded-xl border border-white/15 bg-[#070d1f]/90 shadow-2xl backdrop-blur-md">
        <!-- Logo Bloc Léopards -->
        <div class="flex items-center justify-center bg-white/95 px-2 py-1.5">
          <img src="/brand/logo.png" alt="Bloc Léopards" class="h-6 w-auto object-contain" />
        </div>
        <!-- Minute -->
        <div class="bg-feu px-2 py-1.5 text-center font-display text-xs font-black tracking-wider text-white">
          90'<span class="animate-pulse">+</span>
        </div>
        <!-- Score Série actuelle -->
        <div class="flex items-center gap-2 px-2.5 py-1">
          <div class="flex items-center gap-1.5">
            <img src="/flags/cd.svg" alt="RDC" class="h-3.5 w-5 rounded-[2px] object-cover" onerror="this.style.display='none'" />
            <span class="font-display text-sm tracking-wider text-white sm:text-base">RDC</span>
          </div>
          <div class="flex items-center gap-1 rounded bg-black/65 px-2 py-0.5 font-display text-lg font-black tracking-wider text-or">
            <span id="hud-streak">0</span>
            <span class="text-[0.55rem] font-sans font-bold uppercase tracking-wider text-slate-400">BUTS</span>
          </div>
        </div>
        <!-- Record -->
        <div class="border-l border-white/10 px-2.5 py-1 text-right">
          <span class="block text-[0.48rem] font-bold uppercase tracking-wider text-slate-400 leading-none">Record</span>
          <span id="hud-record" class="font-display text-xs font-black text-emerald-400">0 🏆</span>
        </div>
      </div>

      <!-- Mini barre Niveau + Vent (eyebrow réduit au minimum) -->
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          id="btn-open-levels"
          class="pointer-events-auto flex items-center gap-1.5 rounded-md border border-or/40 bg-[#070d1f]/85 px-2 py-0.5 backdrop-blur-md transition-all hover:border-or active:scale-95"
          title="Voir les détails des niveaux"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-or animate-pulse"></span>
          <span id="hud-level-badge" class="font-display text-[0.65rem] uppercase tracking-wider text-or">NIV. 1</span>
        </button>

        <div id="hud-wind-pill" class="flex items-center gap-1 rounded-md border border-white/10 bg-[#070d1f]/85 px-2 py-0.5 text-[0.65rem] font-bold text-sky-300 backdrop-blur-md">
          <span id="hud-wind-arrow" class="inline-block transition-transform duration-300">→</span>
          <span id="hud-wind-val">0 km/h</span>
        </div>
      </div>
    </div>

    <!-- DROITE : PAUSE + SON + MENU -->
    <div class="pointer-events-auto flex items-center gap-1.5">
      <button
        type="button"
        id="btn-pause"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/15 bg-[#070d1f]/88 text-xs font-bold text-white shadow-lg backdrop-blur-md transition-all hover:bg-slate-800 active:scale-95"
        aria-label="Mettre en pause"
        title="Pause (Espace / P)"
      >
        <span id="icon-pause">⏸</span>
      </button>

      <button
        type="button"
        id="btn-sound"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/15 bg-[#070d1f]/88 text-sm text-white shadow-lg backdrop-blur-md transition-all hover:bg-slate-800 active:scale-95"
        aria-label="Activer ou couper le son"
      >
        <span id="icon-sound">🔊</span>
      </button>

      <button
        type="button"
        id="btn-open-menu"
        class="flex h-9 items-center gap-1.5 rounded-xl border border-white/20 bg-congo px-3 text-[0.7rem] font-black uppercase tracking-wider text-white shadow-lg shadow-congo/30 transition-all hover:bg-congo-bright active:scale-95"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <span>Menu</span>
      </button>
    </div>
  </div>

  <!-- ================= JAUGE DE PUISSANCE IRRÉVERSIBLE (DROITE) ================= -->
  <div id="power-meter-wrap" class="pointer-events-none absolute right-3.5 top-1/2 z-20 -translate-y-1/2 flex flex-col items-center gap-1 opacity-0 transition-opacity duration-100">
    <span class="rounded bg-red-600/95 px-1.5 py-0.5 text-[0.52rem] font-black uppercase tracking-wider text-white shadow">MAX</span>
    <div class="relative h-48 w-4 overflow-hidden rounded-full border-2 border-white/35 bg-slate-950/90 p-0.5 shadow-2xl backdrop-blur-md">
      <div class="absolute inset-x-0 top-[8%] h-[24%] border-y border-emerald-400/70 bg-emerald-500/20"></div>
      <div class="absolute inset-x-0 top-0 h-[8%] bg-red-600/60"></div>
      <div id="power-meter-fill" class="absolute inset-x-0.5 bottom-0.5 rounded-full bg-gradient-to-t from-sky-400 via-emerald-400 to-red-500" style="height: 0%"></div>
    </div>
    <span id="power-meter-pct" class="rounded bg-black/90 px-1.5 py-0.5 font-display text-xs tracking-wider text-or shadow">0%</span>
  </div>

  <!-- ================= INDICATION DISCRÈTE EN BAS ================= -->
  <div id="aim-instruction" class="pointer-events-none absolute inset-x-0 bottom-4 z-20 flex flex-col items-center justify-center opacity-0 transition-opacity duration-300 px-3">
    <div class="flex items-center gap-2 rounded-full border border-white/15 bg-[#070d1f]/85 px-3.5 py-1 text-[0.7rem] font-semibold text-slate-200 shadow-xl backdrop-blur-md text-center">
      <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-or"></span>
      <span>Appuie & glisse vers le but · La jauge monte sans retour en arrière</span>
    </div>
  </div>

  <!-- BOUTON PASSER LA CINÉMATIQUE -->
  <div id="cinematic-bar" class="pointer-events-none absolute inset-x-0 bottom-5 z-20 flex items-center justify-between px-4 sm:px-8">
    <div class="rounded-lg border border-white/15 bg-[#070d1f]/85 px-3 py-1.5 backdrop-blur-md">
      <span id="cinematic-step-label" class="text-[0.65rem] font-bold uppercase tracking-wider text-or">
        Stade des Martyrs · Kinshasa
      </span>
    </div>
    <button
      type="button"
      id="btn-skip-cinematic"
      class="pointer-events-auto flex items-center gap-1.5 rounded-xl border border-or/40 bg-or px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-950 shadow-xl transition-transform hover:bg-yellow-300 active:scale-95"
    >
      <span>Jouer</span>
      <span>⏭</span>
    </button>
  </div>

  <!-- ================= BANDEAU RÉSULTAT DU TIR ================= -->
  <div id="shot-toast" class="pointer-events-none absolute inset-x-0 top-16 z-30 flex justify-center opacity-0 transition-all duration-200 -translate-y-4 px-3">
    <div class="flex items-center gap-2.5 rounded-2xl border border-white/20 bg-[#070d1f]/95 px-4 py-2 shadow-2xl backdrop-blur-xl">
      <span id="toast-emoji" class="text-xl">⚽</span>
      <div>
        <h3 id="toast-title" class="font-display text-lg uppercase tracking-wider text-or leading-none">BUT !</h3>
        <p id="toast-subtitle" class="mt-0.5 text-[0.68rem] font-semibold text-slate-300">104 km/h</p>
      </div>
    </div>
  </div>

  <!-- ================= ÉCRAN DE PAUSE ================= -->
  <div id="pause-modal" class="pointer-events-none fixed inset-0 z-40 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-md">
    <div class="pointer-events-auto w-full max-w-xs overflow-hidden rounded-3xl border border-white/20 bg-[#070f22] p-5 text-center shadow-2xl">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-white/95 p-1.5 shadow">
        <img src="/brand/logo.png" alt="Bloc Léopards" class="h-full w-auto object-contain" />
      </div>
      <span class="mt-2.5 block text-[0.55rem] font-bold uppercase tracking-widest text-or">Jeu en Pause</span>
      <h2 class="mt-0.5 font-display text-2xl uppercase tracking-wide text-white">PAUSE MATCH</h2>
      <p class="mt-1 text-[0.7rem] text-slate-400">
        Série en cours : <strong id="pause-streak-val" class="text-or">0</strong> but(s)
      </p>

      <div class="mt-4 flex flex-col gap-2">
        <button
          type="button"
          id="btn-pause-resume"
          class="w-full rounded-xl bg-or py-2.5 text-xs font-black uppercase tracking-wider text-slate-950 shadow-lg hover:bg-yellow-300 active:scale-95 transition-transform"
        >
          ▶ Reprendre la partie
        </button>
        <button
          type="button"
          id="btn-pause-restart"
          class="w-full rounded-xl border border-white/15 bg-white/10 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/20"
        >
          🔄 Recommencer à 0
        </button>
        <button
          type="button"
          id="btn-pause-to-menu"
          class="w-full rounded-xl border border-white/10 bg-white/5 py-2 text-xs font-bold uppercase tracking-wider text-slate-300 hover:bg-white/15 hover:text-white"
        >
          ⚙️ Réglages du Stade
        </button>
      </div>
    </div>
  </div>

  <!-- ================= ÉCRAN FIN DE SÉRIE (PREMIER RATÉ) ================= -->
  <div id="gameover-modal" class="pointer-events-none fixed inset-0 z-40 hidden items-center justify-center bg-black/75 p-4 backdrop-blur-md">
    <div class="pointer-events-auto w-full max-w-sm overflow-hidden rounded-3xl border border-white/20 bg-[#081126] p-5 text-center shadow-2xl">
      <div id="go-badge" class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-red-500/20 text-2xl border border-red-500/40">
        🧤
      </div>
      <span id="go-kicker" class="mt-2 block text-[0.55rem] font-bold uppercase tracking-widest text-red-400">Fin de Série</span>
      <h2 id="go-title" class="mt-0.5 font-display text-2xl uppercase tracking-wide text-white">ARRÊT DU GARDIEN !</h2>
      <p id="go-desc" class="mt-1 text-xs text-slate-300">
        Le portier a repoussé ta tentative.
      </p>

      <div class="mt-4 grid grid-cols-3 gap-2 rounded-2xl border border-white/10 bg-black/40 p-2.5">
        <div>
          <span class="block text-[0.55rem] font-bold uppercase tracking-wider text-slate-400">Buts</span>
          <span id="go-stat-streak" class="font-display text-xl text-or">0</span>
        </div>
        <div class="border-x border-white/10">
          <span class="block text-[0.55rem] font-bold uppercase tracking-wider text-slate-400">Palier</span>
          <span id="go-stat-level" class="font-display text-xl text-white">Niv. 1</span>
        </div>
        <div>
          <span class="block text-[0.55rem] font-bold uppercase tracking-wider text-slate-400">Record</span>
          <span id="go-stat-record" class="font-display text-xl text-emerald-400">0</span>
        </div>
      </div>

      <div class="mt-4 flex gap-2">
        <button
          type="button"
          id="btn-go-levels"
          class="rounded-xl border border-white/15 bg-white/10 px-3.5 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/20"
        >
          🏆 Niveaux
        </button>
        <button
          type="button"
          id="btn-go-retry"
          class="flex-1 rounded-xl bg-or px-4 py-2.5 text-xs font-black uppercase tracking-wider text-slate-950 shadow-lg shadow-or/25 hover:bg-yellow-300 active:scale-95 transition-transform"
        >
          🔄 Rejouer
        </button>
      </div>
    </div>
  </div>

  <!-- ================= MODALE DÉDIÉE UNIQUEMENT AUX NIVEAUX ================= -->
  <div id="levels-modal-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-3 sm:p-6 backdrop-blur-lg">
    <div class="relative flex max-h-[88dvh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl border border-or/30 bg-[#070f22] shadow-2xl">
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-3.5 bg-[#050a18]">
        <div>
          <span class="text-[0.55rem] font-bold uppercase tracking-widest text-or">Progression Sportive</span>
          <h2 class="font-display text-lg uppercase tracking-wider text-white leading-none">
            🏆 Paliers de Difficulté & IA Gardien
          </h2>
        </div>
        <button
          type="button"
          id="btn-close-levels"
          class="flex h-8 w-8 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-slate-300 hover:bg-white/15 hover:text-white"
        >
          ✕
        </button>
      </div>

      <div class="flex-1 overflow-y-auto p-4 space-y-3">
        <div class="flex items-center justify-between rounded-xl border border-white/10 bg-black/30 px-3.5 py-2 text-xs text-slate-300">
          <span>Le niveau évolue automatiquement à chaque palier de buts marqués :</span>
          <span class="font-bold text-or">Record : <strong id="levels-best-streak">0</strong> buts</span>
        </div>
        <div id="levels-grid" class="grid gap-2.5 sm:grid-cols-2"></div>
      </div>

      <div class="flex items-center justify-end border-t border-white/10 bg-[#050a18] px-5 py-2.5">
        <button type="button" id="btn-resume-from-levels" class="rounded-xl bg-or px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-950 hover:bg-yellow-300">
          Retour au terrain
        </button>
      </div>
    </div>
  </div>

  <!-- ================= MENU GÉNÉRAL (SANS DUPLICATION DES NIVEAUX) ================= -->
  <div id="game-menu-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-3 sm:p-6 backdrop-blur-lg">
    <div class="relative flex max-h-[88dvh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl border border-white/15 bg-[#070f22] shadow-2xl">
      
      <!-- En-tête du Menu avec Logo Bloc Léopards & SDM -->
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-3.5 bg-[#050a18]">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-white p-1">
            <img src="/brand/logo.png" alt="Bloc Léopards" class="h-full w-auto object-contain" />
          </div>
          <div>
            <span class="text-[0.55rem] font-bold uppercase tracking-widest text-or">Bloc Léopards · Kinshasa</span>
            <h2 class="font-display text-lg uppercase tracking-wider text-white leading-none">
              Menu & Réglages du Stade
            </h2>
          </div>
        </div>
        <button
          type="button"
          id="btn-close-menu"
          class="flex h-8 w-8 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-slate-300 hover:bg-white/15 hover:text-white"
          aria-label="Fermer le menu"
        >
          ✕
        </button>
      </div>

      <!-- Onglets du Menu (Réglages / Photos SDM / Partenaires) -->
      <div class="flex border-b border-white/10 bg-[#050a18]/60 px-5 pt-1.5 gap-2 overflow-x-auto">
        <button
          type="button"
          data-menu-tab="settings"
          class="menu-tab-btn border-b-2 border-or px-3.5 py-2 text-xs font-black uppercase tracking-wider text-or transition-colors"
        >
          ⚙️ Réglages & Stade
        </button>
        <button
          type="button"
          data-menu-tab="photos"
          class="menu-tab-btn border-b-2 border-transparent px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-400 hover:text-white transition-colors"
        >
          📸 Références SDM
        </button>
        <button
          type="button"
          data-menu-tab="partners"
          class="menu-tab-btn border-b-2 border-transparent px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-400 hover:text-white transition-colors"
        >
          🤝 Partenaires
        </button>
      </div>

      <!-- Contenu du Menu -->
      <div class="flex-1 overflow-y-auto p-4">
        
        <!-- ONGLET 1 : RÉGLAGES -->
        <div id="menu-panel-settings" class="space-y-3.5">
          <div class="grid gap-3.5 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-black/30 p-3.5">
              <span class="text-[0.58rem] font-bold uppercase tracking-wider text-or">Éclairage Stade des Martyrs</span>
              <h4 class="mt-0.5 font-display text-base uppercase text-white">Jour / Soir de Match</h4>
              <p class="mt-1 text-xs text-slate-400">
                Bascule entre la lumière zénithale de Kinshasa et les 4 mâts de projecteurs nocturnes.
              </p>
              <div class="mt-3 flex gap-2">
                <button type="button" id="btn-set-day" class="flex-1 rounded-xl border border-white/15 bg-white/5 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/15">
                  ☀️ Jour
                </button>
                <button type="button" id="btn-set-night" class="flex-1 rounded-xl border border-or/40 bg-congo py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-congo-bright">
                  🌙 Nuit
                </button>
              </div>
            </div>

            <div class="rounded-2xl border border-white/10 bg-black/30 p-3.5">
              <span class="text-[0.58rem] font-bold uppercase tracking-wider text-or">Ambiance Sonore</span>
              <h4 class="mt-0.5 font-display text-base uppercase text-white">Tam-tams & 80 000 Supporters</h4>
              <p class="mt-1 text-xs text-slate-400">
                Chants, percussions kinoises, impact des gants et explosion du virage.
              </p>
              <button type="button" id="btn-menu-audio-toggle" class="mt-3 w-full rounded-xl border border-emerald-500/40 bg-emerald-500/20 py-2 text-xs font-bold uppercase tracking-wider text-emerald-300">
                🔊 Son Activé
              </button>
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-black/30 p-3.5">
            <h4 class="font-display text-sm uppercase tracking-wider text-white">Actions de Partie</h4>
            <div class="mt-2.5 flex flex-wrap gap-2">
              <button type="button" id="btn-menu-restart" class="rounded-xl border border-white/15 bg-white/10 px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/20">
                🔄 Recommencer à 0
              </button>
              <button type="button" id="btn-menu-intro" class="rounded-xl border border-white/15 bg-white/10 px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/20">
                🎬 Caméra d'entrée au stade
              </button>
              <a href="/" class="rounded-xl border border-white/10 bg-white/5 px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-300 hover:bg-white/15 hover:text-white">
                ← Quitter vers l'accueil
              </a>
            </div>
          </div>
        </div>

        <!-- ONGLET 2 : PHOTOS OFFICIELLES SDM -->
        <div id="menu-panel-photos" class="hidden space-y-3">
          <div class="grid gap-3 sm:grid-cols-2">
            <figure class="overflow-hidden rounded-2xl border border-white/10 bg-black/40">
              <img src="/media/martyrs/pelouse-terrain-martyrs.jpg" alt="Pelouse et piste du Stade des Martyrs" class="h-32 w-full object-cover" />
              <figcaption class="p-2 text-[0.68rem] text-slate-300">
                <strong class="text-or block">Pelouse & Piste 8 Couloirs</strong>
                Perspective réelle depuis le point de penalty.
              </figcaption>
            </figure>
            <figure class="overflow-hidden rounded-2xl border border-white/10 bg-black/40">
              <img src="/media/martyrs/tribunes-couleurs-nationales.jpg" alt="Tribunes aux couleurs nationales" class="h-32 w-full object-cover" />
              <figcaption class="p-2 text-[0.68rem] text-slate-300">
                <strong class="text-or block">Gradins Bleu · Jaune · Rouge</strong>
                Anneau tricolore reproduit dans la cuvette 3D.
              </figcaption>
            </figure>
            <figure class="overflow-hidden rounded-2xl border border-white/10 bg-black/40">
              <img src="/media/martyrs/stade-nuit-lumieres.jpg" alt="Stade illuminé de nuit" class="h-32 w-full object-cover" />
              <figcaption class="p-2 text-[0.68rem] text-slate-300">
                <strong class="text-or block">Projecteurs Nocturnes SDM</strong>
                Ambiance soir de match à Kinshasa.
              </figcaption>
            </figure>
            <figure class="overflow-hidden rounded-2xl border border-white/10 bg-black/40">
              <img src="/media/martyrs/supporters-leopards.jpg" alt="Supporters des Léopards" class="h-32 w-full object-cover object-top" />
              <figcaption class="p-2 text-[0.68rem] text-slate-300">
                <strong class="text-or block">Tribune Bloc Léopards</strong>
                Ferveur derrière les buts.
              </figcaption>
            </figure>
          </div>
        </div>

        <!-- ONGLET 3 : PARTENAIRES OFFICIELS (INTÉGRÉS SUR LES PANNEAUX LED DU STADE) -->
        <div id="menu-panel-partners" class="hidden space-y-3">
          <p class="text-xs text-slate-300">
            Logos officiels affichés sur la panneautique LED autour de la pelouse du Stade des Martyrs :
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <div class="flex flex-col items-center justify-center rounded-xl bg-white p-3 h-20">
              <img src="/brand/logo.png" alt="Bloc Léopards" class="max-h-12 w-auto object-contain" />
            </div>
            <div class="flex flex-col items-center justify-center rounded-xl bg-white p-3 h-20">
              <img src="/logo-rdc.png" alt="RDC Cœur de l'Afrique" class="max-h-12 w-auto object-contain" />
            </div>
            <div class="flex flex-col items-center justify-center rounded-xl bg-white p-3 h-20">
              <img src="/media/partenaires/LOGO SONAS.png" alt="SONAS" class="max-h-12 w-auto object-contain" />
