---
/**
 * PenaltyMartyrsGame.astro
 * Expérience 3D plein écran : « Penalty aux Martyrs » (Stade des Martyrs, Kinshasa)
 * - Séance complète de 5 tirs au but en MODE MENÉ sur 5 Niveaux évolutifs (RDC menée au score, remontada en 5 tirs)
 * - Effet enroulé / brossé au doigt (tracé courbe interactif visible à l'écran + physique Magnus prononcée)
 * - Ballon 3D grand, net et parfaitement visible au premier plan avant de tirer + vue complète des poteaux et côtés sur mobile
 * - Playlist musicale officielle (`public/audio/jeu/`) avec boucle auto des 3 hits par défaut + changement de piste
 * - Pause (⏸), Gardien 3D athlétique réaliste, Panneaux LED Partenaires & Bloc Léopards
 */
---

<div class="relative h-[100dvh] w-screen overflow-hidden bg-[#050811] font-body select-none" id="penalty-root">
  <!-- CANVAS WEBGL 3D PLEIN ÉCRAN -->
  <canvas id="penalty-canvas" class="block h-full w-full touch-none cursor-crosshair"></canvas>

  <!-- CANVAS 2D OVERLAY POUR LE TRACÉ COURBE DU DOIGT (EFFET ENROULÉ) -->
  <canvas id="swipe-trail-canvas" class="pointer-events-none absolute inset-0 z-10 block h-full w-full"></canvas>

  <!-- ================= HUD BROADCAST COMPACT (SÉANCE DE 5 TIRS EN MODE MENÉ) ================= -->
  <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-start justify-between gap-2 p-2.5 sm:p-4">
    
    <!-- GAUCHE : SCOREBUG TV MODE MENÉ + 5 PASTILLES DE TIRS -->
    <div class="flex flex-col gap-1.5 min-w-0">
      <div class="pointer-events-auto inline-flex items-center overflow-hidden rounded-xl border border-white/15 bg-[#060c1d]/92 shadow-2xl backdrop-blur-md">
        <!-- Logo Bloc Léopards -->
        <div class="flex h-8 sm:h-9 items-center justify-center bg-white px-2">
          <img src="/brand/logo.png" alt="Bloc Léopards" class="h-5 sm:h-6 w-auto object-contain" />
        </div>
        <!-- Minute -->
        <div class="flex h-8 sm:h-9 items-center bg-feu px-2 text-center font-display text-[0.68rem] sm:text-xs font-black tracking-wider text-white">
          90'<span class="animate-pulse">+</span>
        </div>
        <!-- Score Mode Mené (RDC vs ADV) -->
        <div class="flex items-center gap-1.5 px-2 sm:px-2.5 py-1">
          <img src="/flags/cd.svg" alt="RDC" class="h-3.5 w-4.5 rounded-[2px] object-cover" onerror="this.style.display='none'" />
          <span class="font-display text-xs sm:text-sm tracking-wider text-white">RDC</span>
          <div class="flex items-center gap-1 rounded bg-black/75 px-2 py-0.5 font-display text-sm sm:text-base font-black tracking-wider">
            <span id="hud-rdc-score" class="text-or">0</span>
            <span class="text-slate-500">-</span>
            <span id="hud-opp-score" class="text-red-400">2</span>
          </div>
          <span class="font-display text-[0.68rem] sm:text-xs tracking-wider text-slate-300">ADV</span>
        </div>
        <!-- 5 Pastilles de la séance de 5 tirs -->
        <div class="border-l border-white/10 px-2 sm:px-2.5 py-1 flex flex-col items-center justify-center">
          <span id="hud-kick-counter" class="block text-[0.44rem] font-bold uppercase tracking-wider text-slate-400 leading-none mb-1">
            TIR 1/5 · OBJECTIF 3 BUTS
          </span>
          <div id="hud-five-dots" class="flex items-center gap-1">
            <span class="h-2.5 w-2.5 rounded-full border border-or bg-or/30 animate-pulse"></span>
            <span class="h-2.5 w-2.5 rounded-full border border-white/25 bg-white/10"></span>
            <span class="h-2.5 w-2.5 rounded-full border border-white/25 bg-white/10"></span>
            <span class="h-2.5 w-2.5 rounded-full border border-white/25 bg-white/10"></span>
            <span class="h-2.5 w-2.5 rounded-full border border-white/25 bg-white/10"></span>
          </div>
        </div>
      </div>

      <!-- Mini barre Niveau + Joueurs Choisis + Vent + Effet Enroulé -->
      <div class="flex flex-wrap items-center gap-1">
        <button
          type="button"
          id="btn-open-levels"
          class="pointer-events-auto flex items-center gap-1 rounded-md border border-or/45 bg-[#060c1d]/85 px-2 py-0.5 backdrop-blur-md transition-all hover:border-or active:scale-95"
          title="Voir les niveaux en mode mené"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-or animate-pulse"></span>
          <span id="hud-level-badge" class="font-display text-[0.62rem] uppercase tracking-wider text-or">NIV. 1 · ÉCHAUFFEMENT</span>
        </button>

        <button
          type="button"
          id="btn-open-selection-hud"
          class="pointer-events-auto flex items-center gap-1 rounded-md border border-sky-400/45 bg-[#060c1d]/90 px-2 py-0.5 text-[0.6rem] font-bold text-sky-200 backdrop-blur-md transition-all hover:border-sky-300 active:scale-95"
          title="Changer le tireur Léopard ou le gardien"
        >
          <span>👕</span>
          <span id="hud-matchup-label">#20 WISSA vs #1 MPASI</span>
        </button>

        <div id="hud-wind-pill" class="flex items-center gap-1 rounded-md border border-white/10 bg-[#060c1d]/85 px-1.5 py-0.5 text-[0.6rem] font-bold text-sky-300 backdrop-blur-md">
          <span id="hud-wind-arrow" class="inline-block transition-transform duration-300">→</span>
          <span id="hud-wind-val">0 km/h</span>
        </div>

        <div id="hud-curve-pill" class="hidden items-center gap-1 rounded-md border border-emerald-400/40 bg-emerald-950/85 px-1.5 py-0.5 text-[0.6rem] font-bold text-emerald-300 backdrop-blur-md">
          <span>🌀</span>
          <span id="hud-curve-label">ENROULÉ</span>
        </div>
      </div>
    </div>

    <!-- DROITE : CONTRÔLES COMPACTS (MUSIQUE + SON + PAUSE + MENU) -->
    <div class="pointer-events-auto flex flex-col items-end gap-1.5 shrink-0">
      <div class="flex items-center gap-1 sm:gap-1.5">
        <button
          type="button"
          id="btn-next-track-hud"
          class="flex h-8 sm:h-9 items-center gap-1 rounded-xl border border-or/35 bg-[#060c1d]/90 px-2 sm:px-2.5 text-[0.65rem] font-bold text-or shadow-lg backdrop-blur-md transition-all hover:bg-slate-800 active:scale-95"
          title="Changer de chanson"
        >
          <span>🎵</span>
          <span id="hud-track-short" class="hidden sm:inline max-w-[110px] truncate text-white">Oh Yaya !</span>
          <span class="text-[0.6rem] text-or">⏭</span>
        </button>

        <button
          type="button"
          id="btn-sound"
          class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl border border-white/15 bg-[#060c1d]/90 text-xs sm:text-sm text-white shadow-lg backdrop-blur-md transition-all hover:bg-slate-800 active:scale-95"
          aria-label="Activer ou couper le son"
        >
          <span id="icon-sound">🔊</span>
        </button>

        <button
          type="button"
          id="btn-pause"
          class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl border border-white/15 bg-[#060c1d]/90 text-xs font-bold text-white shadow-lg backdrop-blur-md transition-all hover:bg-slate-800 active:scale-95"
          aria-label="Mettre en pause"
        >
          <span id="icon-pause">⏸</span>
        </button>

        <button
          type="button"
          id="btn-open-menu"
          class="flex h-8 sm:h-9 items-center gap-1 rounded-xl border border-white/20 bg-congo px-2.5 sm:px-3 text-[0.65rem] sm:text-[0.7rem] font-black uppercase tracking-wider text-white shadow-lg shadow-congo/30 transition-all hover:bg-congo-bright active:scale-95"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span>Menu</span>
        </button>
      </div>

      <!-- Mini pilule chanson en cours sur mobile -->
      <button
        type="button"
        id="btn-mobile-track-pill"
        class="flex sm:hidden items-center gap-1 rounded-md border border-white/10 bg-[#060c1d]/80 px-2 py-0.5 text-[0.55rem] text-slate-300 backdrop-blur-md active:scale-95"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400 animate-ping"></span>
        <span id="hud-track-mobile" class="max-w-[130px] truncate font-semibold text-white">Oh Yaya · Nos Léopards</span>
        <span class="text-or font-bold">⏭</span>
      </button>
    </div>
  </div>

  <!-- ================= JAUGE DE PUISSANCE IRRÉVERSIBLE (DROITE) ================= -->
  <div id="power-meter-wrap" class="pointer-events-none absolute right-3 top-1/2 z-20 -translate-y-1/2 flex flex-col items-center gap-1 opacity-0 transition-opacity duration-100">
    <span id="power-meter-zone-badge" class="rounded bg-red-600/95 px-1.5 py-0.5 text-[0.5rem] font-black uppercase tracking-wider text-white shadow">MAX = RATÉ</span>
    <div class="relative h-44 sm:h-48 w-4 sm:w-4.5 overflow-hidden rounded-full border-2 border-white/35 bg-slate-950/90 p-0.5 shadow-2xl backdrop-blur-md">
      <!-- Zone Rouge MAX (92% - 100%) : Surcharge = Tir au-dessus -->
      <div class="absolute inset-x-0 top-0 h-[9%] border-b border-red-400/80 bg-red-600/75 z-10"></div>
      <!-- Zone Verte Optimale (70% - 91%) : La plus belle frappe -->
      <div class="absolute inset-x-0 top-[9%] h-[22%] border-y-2 border-emerald-300 bg-emerald-400/30 z-10 flex items-center justify-center">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-300 shadow-[0_0_6px_#6ee7b7]"></span>
      </div>
      <div id="power-meter-fill" class="absolute inset-x-0.5 bottom-0.5 rounded-full bg-gradient-to-t from-sky-400 via-emerald-400 to-red-500 transition-none" style="height: 0%"></div>
    </div>
    <span id="power-meter-pct" class="rounded bg-black/90 px-1.5 py-0.5 font-display text-xs tracking-wider text-or shadow">0%</span>
  </div>

  <!-- ================= INDICATION DISCRÈTE EN BAS + BOUTONS TEMPS RÉEL ================= -->
  <div id="aim-instruction" class="pointer-events-none absolute inset-x-0 bottom-2.5 z-20 flex flex-col items-center justify-center gap-1.5 opacity-0 transition-opacity duration-300 px-3">
    <div class="pointer-events-auto flex flex-wrap items-center justify-center gap-1.5">
      <button
        type="button"
        data-demo-case="catch"
        class="btn-demo-case flex items-center gap-1 rounded-full border border-sky-400/45 bg-[#060c1d]/90 px-2.5 py-1 text-[0.58rem] font-bold uppercase tracking-wider text-sky-200 shadow-lg backdrop-blur-md hover:bg-sky-900/60 active:scale-95"
      >
        <span>🧤</span>
        <span>Démo Arrêt Capté</span>
      </button>
      <button
        type="button"
        data-demo-case="deflect_goal"
        class="btn-demo-case flex items-center gap-1 rounded-full border border-emerald-400/45 bg-[#060c1d]/90 px-2.5 py-1 text-[0.58rem] font-bold uppercase tracking-wider text-emerald-200 shadow-lg backdrop-blur-md hover:bg-emerald-900/60 active:scale-95"
      >
        <span>🥅</span>
        <span>Démo Dévié au Fond</span>
      </button>
      <button
        type="button"
        id="btn-bottom-change-players"
        class="flex items-center gap-1 rounded-full border border-or/45 bg-[#060c1d]/90 px-2.5 py-1 text-[0.58rem] font-bold uppercase tracking-wider text-or shadow-lg backdrop-blur-md hover:bg-slate-800 active:scale-95"
      >
        <span>👕</span>
        <span>Changer Joueurs</span>
      </button>
    </div>
    <div class="flex items-center gap-1.5 rounded-full border border-white/15 bg-[#060c1d]/85 px-3 py-1 text-[0.63rem] font-semibold text-slate-200 shadow-xl backdrop-blur-md text-center">
      <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-or"></span>
      <span>Glisse en courbe 🌀 et relâche dans la zone verte (70–91%) !</span>
    </div>
  </div>

  <!-- BOUTON PASSER LA CINÉMATIQUE -->
  <div id="cinematic-bar" class="pointer-events-none absolute inset-x-0 bottom-4 z-20 flex items-center justify-between px-4 sm:px-8">
    <div class="rounded-lg border border-white/15 bg-[#060c1d]/85 px-3 py-1.5 backdrop-blur-md">
      <span id="cinematic-step-label" class="text-[0.62rem] font-bold uppercase tracking-wider text-or">
        Stade des Martyrs · Kinshasa
      </span>
    </div>
    <button
      type="button"
      id="btn-skip-cinematic"
      class="pointer-events-auto flex items-center gap-1.5 rounded-xl border border-or/40 bg-or px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-950 shadow-xl transition-transform hover:bg-yellow-300 active:scale-95"
    >
      <span>Choisir Tireur & Gardien</span>
      <span>⏭</span>
    </button>
  </div>

  <!-- ================= BANDEAU RÉSULTAT DU TIR ================= -->
  <div id="shot-toast" class="pointer-events-none absolute inset-x-0 top-16 z-30 flex justify-center opacity-0 transition-all duration-200 -translate-y-4 px-3">
    <div class="flex items-center gap-2.5 rounded-2xl border border-white/20 bg-[#060c1d]/95 px-4 py-2 shadow-2xl backdrop-blur-xl">
      <span id="toast-emoji" class="text-xl">⚽</span>
      <div>
        <h3 id="toast-title" class="font-display text-base sm:text-lg uppercase tracking-wider text-or leading-none">BUT !</h3>
        <p id="toast-subtitle" class="mt-0.5 text-[0.65rem] font-semibold text-slate-300">104 km/h</p>
      </div>
    </div>
  </div>

  <!-- ================= ÉCRAN DE PAUSE ================= -->
  <div id="pause-modal" class="pointer-events-none fixed inset-0 z-40 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-md">
    <div class="pointer-events-auto w-full max-w-xs overflow-hidden rounded-3xl border border-white/20 bg-[#070f22] p-5 text-center shadow-2xl">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-white p-1.5 shadow">
        <img src="/brand/logo.png" alt="Bloc Léopards" class="h-full w-auto object-contain" />
      </div>
      <span class="mt-2 block text-[0.52rem] font-bold uppercase tracking-widest text-or">Jeu en Pause</span>
      <h2 class="mt-0.5 font-display text-2xl uppercase tracking-wide text-white">PAUSE MATCH</h2>
      <p id="pause-score-summary" class="mt-1 text-xs font-bold text-slate-300">
        RDC 0 - 2 ADV · Tir 1/5
      </p>

      <!-- Contrôle rapide de la chanson en pause -->
      <div class="mt-3 flex items-center justify-between rounded-xl border border-white/10 bg-black/40 px-3 py-2 text-left">
        <div class="min-w-0 pr-2">
          <span class="block text-[0.5rem] uppercase tracking-wider text-or font-bold">Chanson en cours</span>
          <p id="pause-track-name" class="truncate text-xs font-semibold text-white">Oh Yaya ! Nos Léopards</p>
        </div>
        <button
          type="button"
          id="btn-pause-next-track"
          class="shrink-0 rounded-lg bg-white/10 px-2.5 py-1.5 text-xs font-bold text-or hover:bg-white/20"
        >
          ⏭ Changer
        </button>
      </div>

      <div class="mt-4 flex flex-col gap-2">
        <button
          type="button"
          id="btn-pause-resume"
          class="w-full rounded-xl bg-or py-2.5 text-xs font-black uppercase tracking-wider text-slate-950 shadow-lg hover:bg-yellow-300 active:scale-95 transition-transform"
        >
          ▶ Reprendre la séance
        </button>
        <button
          type="button"
          id="btn-pause-restart"
          class="w-full rounded-xl border border-white/15 bg-white/10 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/20"
        >
          🔄 Rejouer (Mêmes joueurs)
        </button>
        <button
          type="button"
          id="btn-pause-change-players"
          class="w-full rounded-xl border border-sky-400/35 bg-sky-500/15 py-2 text-xs font-bold uppercase tracking-wider text-sky-200 hover:bg-sky-500/25"
        >
          👕 Changer les joueurs
        </button>
        <button
          type="button"
          id="btn-pause-to-menu"
          class="w-full rounded-xl border border-white/10 bg-white/5 py-2 text-xs font-bold uppercase tracking-wider text-slate-300 hover:bg-white/15 hover:text-white"
        >
          🎵 Playlist & Réglages
        </button>
      </div>
    </div>
  </div>

  <!-- ================= BILAN DE LA SÉANCE DE 5 TIRS (VICTOIRE OU DÉFAITE) ================= -->
  <div id="gameover-modal" class="pointer-events-none fixed inset-0 z-40 hidden items-center justify-center bg-black/75 p-4 backdrop-blur-md">
    <div class="pointer-events-auto w-full max-w-sm overflow-hidden rounded-3xl border border-white/20 bg-[#081126] p-5 text-center shadow-2xl">
      <div id="go-badge" class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-or/20 text-2xl border border-or/40">
        🏆
      </div>
      <span id="go-kicker" class="mt-2 block text-[0.52rem] font-bold uppercase tracking-widest text-or">Bilan de la Séance (5 Tirs)</span>
      <h2 id="go-title" class="mt-0.5 font-display text-2xl uppercase tracking-wide text-white">REMONTADA RÉUSSIE !</h2>
      <p id="go-desc" class="mt-1 text-xs text-slate-300">
        Tu as renversé le score aux Martyrs !
      </p>

      <!-- Récap visuel des 5 tirs -->
      <div id="go-five-recap" class="mt-3 flex items-center justify-center gap-2"></div>

      <div class="mt-3.5 grid grid-cols-3 gap-2 rounded-2xl border border-white/10 bg-black/40 p-2.5">
        <div>
          <span class="block text-[0.52rem] font-bold uppercase tracking-wider text-slate-400">Score Final</span>
          <span id="go-stat-score" class="font-display text-lg text-or">3 - 2</span>
        </div>
        <div class="border-x border-white/10">
          <span class="block text-[0.52rem] font-bold uppercase tracking-wider text-slate-400">Niveau</span>
          <span id="go-stat-level" class="font-display text-lg text-white">Niv. 1</span>
        </div>
        <div>
          <span class="block text-[0.52rem] font-bold uppercase tracking-wider text-slate-400">Tirs Réussis</span>
          <span id="go-stat-made" class="font-display text-lg text-emerald-400">3 / 5</span>
        </div>
      </div>

      <div class="mt-4 flex flex-col gap-2">
        <div class="flex gap-2">
          <button
            type="button"
            id="btn-go-levels"
            class="rounded-xl border border-white/15 bg-white/10 px-3.5 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-white/20"
          >
            🏆 Niveaux
          </button>
          <button
            type="button"
            id="btn-go-primary"
            class="flex-1 rounded-xl bg-or px-4 py-2.5 text-xs font-black uppercase tracking-wider text-slate-950 shadow-lg shadow-or/25 hover:bg-yellow-300 active:scale-95 transition-transform"
          >
            🔥 Rejouer
          </button>
        </div>
        <button
          type="button"
          id="btn-go-change-players"
          class="w-full rounded-xl border border-sky-400/40 bg-sky-500/15 py-2.5 text-xs font-bold uppercase tracking-wider text-sky-200 hover:bg-sky-500/25"
        >
          👕 Changer les joueurs (Tireur & Gardien)
        </button>
      </div>
    </div>
  </div>

  <!-- ================= ÉTAPE DE SÉLECTION : CHOIX DU TIREUR LÉOPARD & DU GARDIEN ================= -->
  <div id="selection-modal-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-2.5 sm:p-5 backdrop-blur-lg">
    <div class="relative flex max-h-[92dvh] w-full max-w-3xl flex-col overflow-hidden rounded-3xl border border-or/35 bg-[#070f22] shadow-2xl">
      <!-- En-tête -->
      <div class="flex items-center justify-between border-b border-white/10 bg-[#050a18] px-4 py-3 sm:px-6">
        <div class="flex items-center gap-2.5">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white p-1 shadow">
            <img src="/brand/logo.png" alt="Bloc Léopards" class="h-full w-auto object-contain" />
          </div>
          <div>
            <span class="block text-[0.52rem] font-bold uppercase tracking-widest text-or">La Série de Kin · Stade des Martyrs</span>
            <h2 class="font-display text-base sm:text-xl uppercase tracking-wider text-white leading-none">
              Choisis ton Léopard & ton Gardien
            </h2>
          </div>
        </div>
        <button
          type="button"
          id="btn-close-selection"
          class="flex h-8 w-8 items-center justify-center rounded-xl border border-white/15 bg-white/5 text-slate-300 hover:bg-white/15 hover:text-white"
          title="Fermer"
        >
          ✕
        </button>
      </div>

      <!-- Corps défilant : 1. Tireur Léopard + 2. Gardien -->
      <div class="flex-1 overflow-y-auto p-3.5 sm:p-5 space-y-4">
        <!-- 1. Choisir son tireur parmi les Léopards -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-display text-sm sm:text-base uppercase tracking-wider text-sky-300">
              1. Choisis ton tireur parmi les Léopards (Maillot Bleu Ciel RDC)
            </h3>
            <span id="selected-shooter-pill" class="rounded-full bg-sky-500/20 border border-sky-400/40 px-2.5 py-0.5 text-[0.62rem] font-bold text-sky-200">
              #20 Yoane Wissa
            </span>
          </div>
          <div id="shooters-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5"></div>
        </div>

        <!-- 2. Choisir le gardien à affronter -->
        <div class="border-t border-white/10 pt-3.5">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-display text-sm sm:text-base uppercase tracking-wider text-or">
              2. Choisis ton adversaire dans les cages (Gardien)
            </h3>
            <span id="selected-keeper-pill" class="rounded-full bg-or/20 border border-or/40 px-2.5 py-0.5 text-[0.62rem] font-bold text-or">
              #1 Lionel Mpasi
            </span>
          </div>
          <div id="keepers-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5"></div>
        </div>
      </div>

      <!-- Pied de modale : Résumé + Bouton Entrer sur le terrain -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-2.5 border-t border-white/10 bg-[#050a18] px-4 py-3 sm:px-6">
        <div class="text-center sm:text-left">
          <span class="block text-[0.52rem] uppercase tracking-widest text-slate-400">Duel sélectionné aux Martyrs</span>
