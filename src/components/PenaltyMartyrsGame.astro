  /**
   * Calcule dynamiquement la position et le FOV de la caméra pour que sur mobile portrait :
   * - On voie TOUT le but (7.32m) + au moins 2.6m de marge à gauche et à droite des poteaux (total ~12.6m de large)
   * - Le ballon au point de penalty (Z = 11.0m) soit parfaitement entier dans le tiers inférieur de l'écran
   */
  function applyPlayableCameraFraming() {
    const aspect = window.innerWidth / Math.max(1, window.innerHeight);
    const isPortrait = aspect < 0.95;

    const camZ = isPortrait ? 15.6 : 14.3;
    const camY = isPortrait ? 1.68 : 1.48;
    const lookY = isPortrait ? 1.42 : 1.28;

    // Largeur minimale visible au niveau de la ligne de but (Z = 0) : 12.6m sur mobile portrait !
    const minGoalLineHalfWidth = isPortrait ? 6.35 : 7.8;
    const tanHalfHoriz = minGoalLineHalfWidth / camZ;
    const tanHalfVert = tanHalfHoriz / aspect;
    const computedFov = THREE.MathUtils.radToDeg(2 * Math.atan(tanHalfVert));

    camera.fov = THREE.MathUtils.clamp(computedFov, 46, 86);
    camera.aspect = aspect;
    camera.updateProjectionMatrix();

    if (state.phase === "aiming" || state.phase === "charging" || state.phase === "shooting" || state.phase === "result") {
      camera.position.set(0, camY, camZ);
      camera.lookAt(0, lookY, 0);
    }
  }

