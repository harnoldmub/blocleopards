  const GOAL = { width: 7.32, height: 2.44, depth: 2.15, postR: 0.068 };
  const goalGroup = new THREE.Group();
  const postMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.18, metalness: 0.72 });

  const postLeft = new THREE.Mesh(new THREE.CylinderGeometry(GOAL.postR, GOAL.postR, GOAL.height, 24), postMat);
