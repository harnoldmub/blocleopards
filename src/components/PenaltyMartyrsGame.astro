  // Panneau dorsal galbé affichant le NOM et le NUMÉRO face à la caméra (vers +Z)
  const sBackPlate = new THREE.Mesh(new THREE.PlaneGeometry(0.54, 0.55, 8, 8), shooterBackMat);
  const sBackPos = sBackPlate.geometry.attributes.position as THREE.BufferAttribute;
  for (let i = 0; i < sBackPos.count; i++) {
    const bx = sBackPos.getX(i);
    const by = sBackPos.getY(i);
    // Galbe anatomique du dos et tombé du maillot
    const curveZ = -Math.pow(bx / 0.28, 2) * 0.045 + Math.sin((by + 0.27) * 9) * 0.005;
    sBackPos.setZ(i, curveZ);
