      varying float vY; varying vec3 vN; varying vec3 vV;
      void main(){
        vY = uv.y;
        vec4 mv = modelViewMatrix * vec4(position,1.0);
        vN = normalize(normalMatrix * normal);
        vV = normalize(-mv.xyz);
