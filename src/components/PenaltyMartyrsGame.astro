  /* -------------------------------------------------------------------------- */
  /*  BOUCLE PRINCIPALE D'ANIMATION                                             */
  /* -------------------------------------------------------------------------- */
  let prevTime = performance.now();

  function animate() {
    requestAnimationFrame(animate);
    const now = performance.now();
    const dt = Math.min((now - prevTime) / 1000, 0.05);
    prevTime = now;

    if (state.paused) {
      renderer.render(scene, camera);
      return;
    }

    const elapsed = now * 0.001;
    flashMat.uniforms.uTime.value = elapsed;
    updateNetMesh(dt);
    updateTurfParticles(dt);

    // Ombre de contact sous le ballon (s'étale et s'estompe avec l'altitude Y du ballon)
    const heightAboveGround = Math.max(0, ballMesh.position.y - BALL_R);
    ballContactShadow.position.set(ballMesh.position.x, 0.014, ballMesh.position.z);
    const shadowScale = 1 + heightAboveGround * 0.45;
    ballContactShadow.scale.set(shadowScale, shadowScale, 1);
    (ballContactShadow.material as THREE.MeshBasicMaterial).opacity = Math.max(
      0.12,
      0.62 * Math.exp(-heightAboveGround * 0.85)
    );

    // Vibration physique des poteaux/barre en cas de frappe sur le montant
    if (goalFrameVibration > 0.001) {
      goalGroup.position.x = Math.sin(elapsed * 95) * goalFrameVibration * 0.09;
      goalFrameVibration = Math.max(0, goalFrameVibration - dt * 0.55);
    } else {
      goalGroup.position.x = 0;
    }

    if (state.phase === "cinematic") {
      state.cinematicTime += dt;
      const t = state.cinematicTime;
      setShooterIdlePose(elapsed);
      if (t < 2.2) {
        const p = t / 2.2;
        camera.position.set(Math.sin(p * 0.5) * 42, 36 - p * 20, 64 - p * 28);
        camera.lookAt(0, 6, -10);
        if (cinematicStepLabel) cinematicStepLabel.textContent = "1/2 · Stade des Martyrs · 80 000 places";
      } else if (t < 4.0) {
        const p = (t - 2.2) / 1.8;
        camera.position.set(-12 * (1 - p), 1.45 - p * 0.45, 20 - p * 6.85);
        camera.lookAt(0, 1.1, 0);
        if (cinematicStepLabel) cinematicStepLabel.textContent = "2/2 · Mode Mené · Séance de 5 Tirs";
      } else {
        startLevelSeries(0);
        if (!state.hasConfirmedSelection) {
          openSelectionModal();
        }
      }
    } else if (state.phase === "aiming" || state.phase === "charging") {
      setShooterIdlePose(elapsed);
      const tier = getActiveTier();
      const swayFreq = 3.8 + tier.id * 0.85;
      const swayAmp = 0.28 + tier.id * 0.08;
      const stepCycle = elapsed * swayFreq;
      // Pas latéral articulé sans glissement des pieds : alternance d'appui gauche/droite
      const stepPhase = Math.sin(stepCycle);
      const liftL = Math.max(0, Math.sin(stepCycle * 2));
      const liftR = Math.max(0, -Math.sin(stepCycle * 2));

      keeperGroup.position.x = stepPhase * swayAmp;
      keeperGroup.position.y = -0.04 + Math.max(liftL, liftR) * 0.055;
      keeperGroup.rotation.z = -stepPhase * 0.04;
      keeperGroup.rotation.x = 0.09; // Buste légèrement penché vers l'avant en posture d'attente

      // Articulation genoux/chevilles pendant le pas latéral
      legL.hipPivot.rotation.x = -0.18 - liftL * 0.28;
      legL.kneePivot.rotation.x = 0.34 + liftL * 0.42;
      legL.anklePivot.rotation.x = -0.16 - liftL * 0.14;

      legR.hipPivot.rotation.x = -0.18 - liftR * 0.28;
      legR.kneePivot.rotation.x = 0.34 + liftR * 0.42;
      legR.anklePivot.rotation.x = -0.16 - liftR * 0.14;

      // Bras prêts devant les hanches, coudes fléchis
      kArmL.rotation.set(-0.28, 0, 0.48 + Math.sin(elapsed * 6.5) * 0.08);
      kArmR.rotation.set(-0.28, 0, -0.48 - Math.sin(elapsed * 6.5) * 0.08);

      // Ombre au sol ancrée sous les appuis du gardien
      keeperGroundShadow.position.set(keeperGroup.position.x, 0.013, keeperGroup.position.z);
      keeperGroundShadow.scale.set(1.05, 1, 1);
      (keeperGroundShadow.material as THREE.MeshBasicMaterial).opacity = 0.46;

      // Pulsation douce de l'anneau sous le ballon avant le tir
      const pulse = 1 + Math.sin(elapsed * 4.5) * 0.06;
      ballGlowRing.scale.set(pulse, pulse, 1);

      if (state.phase === "charging") {
        updateChargeGauge(dt);
      }
    } else if (state.phase === "runup") {
      // Course d'élan du tireur Léopard synchronisée avec le départ du ballon
      state.runupElapsed += dt;
      const p = Math.min(1, state.runupElapsed / RUNUP_DURATION);
      updateShooterRunupPose(p);

      // Pendant la course d'élan, le gardien fléchit les genoux et prépare son impulsion
      keeperGroup.position.y = -0.06 - p * 0.05;
      keeperGroup.rotation.x = 0.12 + p * 0.05;
      legL.hipPivot.rotation.x = -0.26 - p * 0.18;
      legL.kneePivot.rotation.x = 0.48 + p * 0.28;
      legR.hipPivot.rotation.x = -0.26 - p * 0.18;
      legR.kneePivot.rotation.x = 0.48 + p * 0.28;

      if (state.runupElapsed >= RUNUP_DURATION) {
        executeBallLaunch();
      }
    } else if (state.phase === "shooting" || state.phase === "result") {
      updateShooterRunupPose(1 + shotPhys.flightElapsed * 2.2);
      updatePhysics(dt);

      // Suivi caméra dynamique léger type EA FC + tremblement d'impact (Camera Shake)
      const aspect = window.innerWidth / Math.max(1, window.innerHeight);
      const isPortrait = aspect < 0.95;
      const baseZ = isPortrait ? 13.15 : 13.35;
      const baseY = isPortrait ? 0.96 : 1.18;
      const lookY = isPortrait ? 1.04 : 1.15;
      const pushIn = Math.min(0.65, shotPhys.flightElapsed * 1.1);

      const shakeX = cameraShakeAmp > 0.001 ? (Math.random() - 0.5) * cameraShakeAmp : 0;
      const shakeY = cameraShakeAmp > 0.001 ? (Math.random() - 0.5) * cameraShakeAmp : 0;
      cameraShakeAmp = Math.max(0, cameraShakeAmp - dt * 0.18);

      camera.position.set(
        ballMesh.position.x * 0.08 + shakeX,
        baseY + shakeY,
        baseZ - pushIn
      );
      camera.lookAt(ballMesh.position.x * 0.18, lookY, 0);
    }

    renderer.render(scene, camera);
  }

  window.addEventListener("resize", () => {
    renderer.setSize(window.innerWidth, window.innerHeight);
    resizeSwipeCanvas();
    applyPlayableCameraFraming();
  });

  applyLightingMode(true);
  applyPlayableCameraFraming();
  applyShooterProfile(getActiveShooter());
  applyGoalkeeperKit(getActiveKeeper());
  renderSelectionModal();
  updateHud();
  updateMusicUi();
  renderLevelsModal();
  animate();
</script>
