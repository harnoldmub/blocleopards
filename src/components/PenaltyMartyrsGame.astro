      shorts.position.y = 0.78;
      const legs = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.62, 0.20), skinMat);
      legs.position.y = 0.34;
      legs.castShadow = true;
      player.add(torso, head, shorts, legs);
      player.position.set(startX + (i - (count - 1) / 2) * 0.58, 0, 5.2);
      wallGroup.add(player);
    }
  }

  /* -------------------------------------------------------------------------- */
  /*  BALLON OFFICIEL 3D + OMBRE DE CONTACT + PARTICULES DE PELOUSE & RUBAN 3D  */
  /* -------------------------------------------------------------------------- */
  const BALL_R = 0.142;
  function createBallTexture() {
    const cv = document.createElement("canvas");
    cv.width = 1024;
    cv.height = 512;
    const ctx = cv.getContext("2d")!;

    // Base cuir perlé haute réflectance
    const baseGrad = ctx.createLinearGradient(0, 0, 0, 512);
    baseGrad.addColorStop(0, "#ffffff");
    baseGrad.addColorStop(0.5, "#f8fafc");
    baseGrad.addColorStop(1, "#e2e8f0");
    ctx.fillStyle = baseGrad;
    ctx.fillRect(0, 0, 1024, 512);

    // Micro-grain de surface thermocollée
    ctx.fillStyle = "rgba(15, 23, 42, 0.035)";
    for (let i = 0; i < 1800; i++) {
      ctx.fillRect((i * 73) % 1024, (i * 41) % 512, 2, 2);
    }

    // Sillons des panneaux thermocollés
    ctx.strokeStyle = "rgba(30, 41, 59, 0.28)";
    ctx.lineWidth = 4;
    for (let x = 0; x <= 1024; x += 128) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, 512);
      ctx.stroke();
    }

    // Motifs étoiles / pentagones officiels CAF/FIFA aux couleurs des Léopards RDC
    for (let x = 0; x < 1024; x += 256) {
      // Anneau extérieur bleu Congo
      ctx.strokeStyle = "#007fff";
      ctx.lineWidth = 16;
      ctx.beginPath();
      ctx.arc(x + 128, 256, 76, 0, Math.PI * 2);
      ctx.stroke();

      // Ruban rouge & or dynamique
      ctx.strokeStyle = "#ce1021";
      ctx.lineWidth = 10;
      ctx.beginPath();
      ctx.arc(x + 128, 256, 56, 0.3, Math.PI * 1.4);
      ctx.stroke();

      ctx.strokeStyle = "#f7d618";
      ctx.lineWidth = 10;
      ctx.beginPath();
      ctx.arc(x + 128, 256, 56, Math.PI * 1.4, Math.PI * 2.3);
      ctx.stroke();

      // Noyau carbone sombre pour lire la rotation (spin) en plein vol
      ctx.fillStyle = "#0f172a";
      ctx.beginPath();
      ctx.arc(x + 128, 256, 36, 0, Math.PI * 2);
      ctx.fill();
    }

    // Bande équatoriale tricolore pour bien lire l'effet Magnus en vol
    ctx.fillStyle = "#007fff";
    ctx.fillRect(0, 230, 1024, 16);
    ctx.fillStyle = "#f7d618";
    ctx.fillRect(0, 246, 1024, 18);
    ctx.fillStyle = "#ce1021";
    ctx.fillRect(0, 264, 1024, 16);

    const t = new THREE.CanvasTexture(cv);
    t.colorSpace = THREE.SRGBColorSpace;
    t.anisotropy = 4;
    return t;
  }

  const ballMesh = new THREE.Mesh(
    new THREE.SphereGeometry(BALL_R, 36, 36),
    new THREE.MeshStandardMaterial({ map: createBallTexture(), roughness: 0.22, metalness: 0.14 })
  );
  ballMesh.castShadow = true;
  scene.add(ballMesh);

  // Ombre de contact douce au sol sous le ballon (indispensable pour lire la hauteur réelle du ballon)
  const ballContactShadow = new THREE.Mesh(
    new THREE.CircleGeometry(BALL_R * 1.35, 24),
    new THREE.MeshBasicMaterial({
      color: 0x020604,
      transparent: true,
      opacity: 0.62,
      depthWrite: false
    })
  );
  ballContactShadow.rotation.x = -Math.PI / 2;
  ballContactShadow.position.set(0, 0.014, PENALTY_Z);
  scene.add(ballContactShadow);

  // Ruban aérodynamique 3D derrière le ballon en vol
  const TRAIL_MAX_PTS = 18;
  const trailPositions = new Float32Array(TRAIL_MAX_PTS * 3);
  const trailGeo = new THREE.BufferGeometry();
  trailGeo.setAttribute("position", new THREE.BufferAttribute(trailPositions, 3));
  const trailMat = new THREE.LineBasicMaterial({
    color: 0xfacc15,
    transparent: true,
    opacity: 0.65
  });
  const ballTrailLine = new THREE.Line(trailGeo, trailMat);
  ballTrailLine.visible = false;
  scene.add(ballTrailLine);
  const trailHistory: THREE.Vector3[] = [];

  // Particules 3D de pelouse / terre / craie lors de la frappe et des impacts
  interface TurfParticle {
    mesh: THREE.Mesh;
    vx: number;
    vy: number;
    vz: number;
    life: number;
    maxLife: number;
  }
  const turfParticles: TurfParticle[] = [];
  const particleGroup = new THREE.Group();
  scene.add(particleGroup);
  const partGeo = new THREE.BoxGeometry(0.032, 0.018, 0.048);

  function spawnTurfBurst(originX: number, originY: number, originZ: number, count = 24, isPostSpark = false) {
    const palette = isPostSpark
      ? [0xffffff, 0xfacc15, 0xe2e8f0]
      : [0x15803d, 0x166534, 0x3f2e21, 0xffffff, 0x22c55e];

    for (let i = 0; i < count; i++) {
      const col = palette[i % palette.length];
      const mat = new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.92 });
      const m = new THREE.Mesh(partGeo, mat);
      m.position.set(
        originX + (Math.random() - 0.5) * 0.18,
        originY + Math.random() * 0.06,
        originZ + (Math.random() - 0.5) * 0.14
      );
      m.rotation.set(Math.random() * 3, Math.random() * 3, Math.random() * 3);
      particleGroup.add(m);

      turfParticles.push({
        mesh: m,
        vx: (Math.random() - 0.5) * (isPostSpark ? 4.5 : 2.6),
        vy: 1.4 + Math.random() * (isPostSpark ? 3.2 : 2.6),
        vz: isPostSpark ? (Math.random() - 0.5) * 3.5 : 0.8 + Math.random() * 2.4,
        life: 0,
        maxLife: 0.38 + Math.random() * 0.32
      });
    }
  }

  function updateTurfParticles(dt: number) {
    for (let i = turfParticles.length - 1; i >= 0; i--) {
      const p = turfParticles[i];
      p.life += dt;
      if (p.life >= p.maxLife) {
        particleGroup.remove(p.mesh);
        (p.mesh.material as THREE.Material).dispose();
        turfParticles.splice(i, 1);
        continue;
      }
      p.vy -= 9.81 * dt;
      p.mesh.position.x += p.vx * dt;
      p.mesh.position.y = Math.max(0.01, p.mesh.position.y + p.vy * dt);
      p.mesh.position.z += p.vz * dt;
      p.mesh.rotation.x += dt * 8;
      p.mesh.rotation.z += dt * 6;
      (p.mesh.material as THREE.MeshBasicMaterial).opacity = 1 - p.life / p.maxLife;
    }
  }

  // Impulsion de caméra (Camera Shake) et vibration de la cage sur poteau/filet
  let cameraShakeAmp = 0;
  let goalFrameVibration = 0;

  /* -------------------------------------------------------------------------- */
  /*  GESTION DU HUD (SÉANCE DE 5 TIRS EN MODE MENÉ)                            */
  /* -------------------------------------------------------------------------- */
  function applyLightingMode(night: boolean) {
    state.isNight = night;
    if (night) {
      scene.background = new THREE.Color("#050811");
      scene.fog = new THREE.FogExp2("#050811", 0.0038);
      hemiLight.intensity = 0.48;
      sunLight.intensity = 1.42;
      sunLight.color.setHex(0xeef6ff);
      floodCones.forEach((c) => (c.visible = true));
      crowdFlashes.visible = true;
      btnSetNight?.classList.add("bg-congo", "border-or/40");
      btnSetDay?.classList.remove("bg-congo", "border-or/40");
    } else {
      scene.background = new THREE.Color("#60a5fa");
      scene.fog = new THREE.FogExp2("#93c5fd", 0.0022);
      hemiLight.intensity = 0.88;
      sunLight.intensity = 1.95;
      sunLight.color.setHex(0xfffbeb);
      floodCones.forEach((c) => (c.visible = false));
      crowdFlashes.visible = false;
      btnSetDay?.classList.add("bg-congo", "border-or/40");
      btnSetNight?.classList.remove("bg-congo", "border-or/40");
    }
  }

  function updateHud() {
    const tier = getActiveTier();
    if (hudRdcScore) hudRdcScore.textContent = String(state.goalsInSeries);
    if (hudOppScore) hudOppScore.textContent = String(tier.oppScore);
    if (hudLevelBadge) hudLevelBadge.textContent = `NIV. ${tier.id} · ${tier.name.toUpperCase()}`;

    const currentShotNum = Math.min(state.kickIndex + 1, TOTAL_KICKS_PER_SERIES);
    if (hudKickCounter) {
      hudKickCounter.textContent = `TIR ${currentShotNum}/${TOTAL_KICKS_PER_SERIES} · OBJECTIF ${tier.targetGoals} BUTS`;
    }
    if (pauseScoreSummary) {
      pauseScoreSummary.textContent = `RDC ${state.goalsInSeries} - ${tier.oppScore} ADV · Tir ${currentShotNum}/${TOTAL_KICKS_PER_SERIES}`;
    }

    // Mettre à jour les 5 pastilles de tirs
    if (hudFiveDots) {
      hudFiveDots.innerHTML = "";
      for (let i = 0; i < TOTAL_KICKS_PER_SERIES; i++) {
        const dot = document.createElement("span");
        const res = state.kickHistory[i];
        if (res === "goal") {
          dot.className = "h-2.5 w-2.5 rounded-full bg-emerald-400 border border-emerald-200 shadow-xs shadow-emerald-400";
        } else if (res === "miss") {
          dot.className = "h-2.5 w-2.5 rounded-full bg-red-500 border border-red-300";
        } else if (i === state.kickIndex) {
          dot.className = "h-2.5 w-2.5 rounded-full border-2 border-or bg-or/40 animate-pulse";
        } else {
          dot.className = "h-2.5 w-2.5 rounded-full border border-white/25 bg-white/10";
        }
        hudFiveDots.appendChild(dot);
      }
    }

    if (hudWindPill && hudWindVal && hudWindArrow) {
      if (state.windKmh === 0) {
        hudWindVal.textContent = "0 km/h";
        hudWindArrow.style.transform = "rotate(0deg)";
        hudWindPill.classList.add("opacity-55");
      } else {
        hudWindPill.classList.remove("opacity-55");
        hudWindVal.textContent = `${Math.abs(state.windKmh)} km/h`;
        hudWindArrow.style.transform = state.windKmh > 0 ? "rotate(0deg)" : "rotate(180deg)";
      }
    }
  }

  function setPaused(pauseState: boolean) {
    if (state.phase === "gameover") return;
    state.paused = pauseState;
    if (iconPause) iconPause.textContent = state.paused ? "▶" : "⏸";
    if (state.paused) {
      updateHud();
      updateMusicUi();
      pauseModal?.classList.remove("hidden");
      pauseModal?.classList.add("flex");
    } else {
      pauseModal?.classList.add("hidden");
      pauseModal?.classList.remove("flex");
      prevTime = performance.now();
    }
  }

  btnPause?.addEventListener("click", () => setPaused(!state.paused));
  btnPauseResume?.addEventListener("click", () => setPaused(false));
  btnPauseRestart?.addEventListener("click", () => {
    setPaused(false);
    startLevelSeries(state.currentTierIndex);
  });
  btnPauseToMenu?.addEventListener("click", () => {
    pauseModal?.classList.add("hidden");
    pauseModal?.classList.remove("flex");
    openMenu("music");
  });

  window.addEventListener("keydown", (e) => {
    if (e.code === "Space" || e.key === "p" || e.key === "P" || e.key === "Escape") {
      e.preventDefault();
      setPaused(!state.paused);
    }
  });

  function setupNextKick() {
    const tier = getActiveTier();

    if (tier.windMaxKmh === 0) {
      state.windKmh = 0;
    } else {
      const dir = Math.random() < 0.5 ? -1 : 1;
      state.windKmh = Math.round(dir * (tier.windMaxKmh * 0.55 + Math.random() * tier.windMaxKmh * 0.45));
    }

    state.wallSide = Math.random() < 0.5 ? -1 : 1;
    buildDefensiveWall(tier.wallPlayers, state.wallSide);

    ballMesh.position.set(0, BALL_R, PENALTY_Z);
    ballMesh.rotation.set(0, 0, 0);
    ballContactShadow.position.set(0, 0.014, PENALTY_Z);
    ballContactShadow.scale.set(1, 1, 1);
    (ballContactShadow.material as THREE.MeshBasicMaterial).opacity = 0.62;
    ballGlowRing.visible = true;
    ballTrailLine.visible = false;
    trailHistory.length = 0;
    goalGroup.position.x = 0;

    keeperGroup.position.set(0, 0, 0.28);
    keeperGroup.rotation.set(0, 0, 0);
    kArmL.rotation.z = 0.52;
    kArmR.rotation.z = -0.52;
    armL.elbowPivot.rotation.set(-0.65, 0, 0.35);
    armR.elbowPivot.rotation.set(-0.65, 0, -0.35);

    swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
    hudCurvePill?.classList.add("hidden");
    hudCurvePill?.classList.remove("flex");

    if (powerMeterWrap) powerMeterWrap.classList.add("opacity-0");
    if (powerMeterFill) powerMeterFill.style.height = "0%";

    state.phase = "aiming";
    applyPlayableCameraFraming();
    cinematicBar?.classList.add("hidden");
    aimInstruction?.classList.remove("opacity-0");
    updateHud();
  }

  /* -------------------------------------------------------------------------- */
  /*  PROJECTION 3D <-> ÉCRAN & TRAJECTOIRE EXACTE CALÉE SUR LE DOIGT           */
  /* -------------------------------------------------------------------------- */
  interface SwipePoint {
    x: number;
    y: number;
  }

  let chargeActive = false;
  let swipePoints: SwipePoint[] = [];
  let chargePeakPushY = 0;
  let lockedPowerPct = 0;
  let currentCurveSpin = 0;

  const raycaster = new THREE.Raycaster();
  const ndcVec = new THREE.Vector2();
  const projVec = new THREE.Vector3();

  function worldToScreen(x: number, y: number, z: number): { x: number; y: number } {
    projVec.set(x, y, z);
    projVec.project(camera);
    return {
      x: (projVec.x * 0.5 + 0.5) * window.innerWidth,
      y: (-projVec.y * 0.5 + 0.5) * window.innerHeight
    };
  }

  function screenToPlaneZ(screenX: number, screenY: number, planeZ: number): THREE.Vector3 {
    ndcVec.set(
      (screenX / Math.max(1, window.innerWidth)) * 2 - 1,
      -(screenY / Math.max(1, window.innerHeight)) * 2 + 1
    );
    raycaster.setFromCamera(ndcVec, camera);
    const originZ = raycaster.ray.origin.z;
    const dirZ = raycaster.ray.direction.z;
    const t = (planeZ - originZ) / (Math.abs(dirZ) < 0.0001 ? -0.0001 : dirZ);
    return new THREE.Vector3(
      raycaster.ray.origin.x + raycaster.ray.direction.x * t,
      raycaster.ray.origin.y + raycaster.ray.direction.y * t,
      planeZ
    );
  }

  const FLIGHT_GRAVITY = 6.8; // Gravité calibrée pour un arc tendu sans rebond prématuré

  const shotPhys = {
    active: false,
    inGoalCage: false,
    flightElapsed: 0,
    vx: 0,
    vy: 0,
    vz: 0,
    totalAx: 0,
    spinY: 0,
    spinX: 0,
    speedKmh: 0,
    keeperTargetX: 0,
    keeperTargetY: 0,
    keeperDiveDir: 0,
    keeperReadsRight: true,
    wallJumping: false,
    resolved: false
  };

  interface ExactShotTrajectory {
    targetX: number;
    targetY: number;
    midWorldX: number;
    spinCurve: number;
    speedMs: number;
    flightTime: number;
    vx0: number;
    vy0: number;
    totalAx: number;
  }

  // Calcule la trajectoire 3D EXACTE correspondant au tracé du doigt sur l'écran
  function computeExactTrajectory(powerPct: number): ExactShotTrajectory {
    const finalPower = Math.max(28, Math.min(powerPct, 112));
    const normP = finalPower / 100;
    const speedMs = 18.0 + normP * 15.5;
    const flightTime = PENALTY_Z / speedMs;

    if (swipePoints.length < 2) {
      const defaultY = 1.15;
      const vy0 = ((defaultY - BALL_R) + 0.5 * FLIGHT_GRAVITY * flightTime * flightTime) / flightTime;
      return {
        targetX: 0,
        targetY: defaultY,
        midWorldX: 0,
        spinCurve: 0,
        speedMs,
        flightTime,
        vx0: 0,
        vy0,
        totalAx: 0
      };
    }

    const start = swipePoints[0];
    const end = swipePoints[swipePoints.length - 1];
    const ballScreen = worldToScreen(0, BALL_R, PENALTY_Z);
    const goalBotScreen = worldToScreen(0, 0.16, 0);
    const goalTopScreen = worldToScreen(0, GOAL.height, 0);

    // Si le joueur commence son geste un peu à côté du ballon, on translate le tracé pour qu'il parte du ballon
    const distFromBall = Math.hypot(start.x - ballScreen.x, start.y - ballScreen.y);
    const offsetScale = distFromBall > 95 ? 0.65 : 0.0;
    const effEndX = end.x + (ballScreen.x - start.x) * offsetScale;

    // Si le bout du doigt arrive dans la zone écran du but, on prend directement la position exacte sous le doigt !
    // Sinon (petit swipe court en bas de l'écran), on projette proportionnellement la poussée verticale vers le but.
    let effEndY = end.y;
    if (end.y > goalBotScreen.y + 12) {
      const pushUpPx = Math.max(10, start.y - end.y);
      const goalSpanPx = Math.max(80, goalBotScreen.y - goalTopScreen.y);
      const ratioY = Math.min(1.22, pushUpPx / (goalSpanPx * 1.45));
      effEndY = goalBotScreen.y - ratioY * goalSpanPx;
    }

    // Légère pénalité uniquement si la jauge dépasse 100% (zone rouge de surcharge)
    const overloadLiftM = finalPower > 100 ? (finalPower - 100) * 0.035 : 0;

    const goalHit3D = screenToPlaneZ(effEndX, effEndY, 0);
    const targetX = THREE.MathUtils.clamp(goalHit3D.x, -4.35, 4.35);
    const targetY = THREE.MathUtils.clamp(goalHit3D.y + overloadLiftM, BALL_R + 0.04, 3.15);

    // Mesure de la courbure ("ventre" du tracé du doigt entre start et end)
    let maxSignedDevX = 0;
    const chordX = end.x - start.x;
    const chordY = end.y - start.y;
    const chordLen = Math.hypot(chordX, chordY);

    if (chordLen > 20 && swipePoints.length >= 4) {
      for (let i = 1; i < swipePoints.length - 1; i++) {
        const pt = swipePoints[i];
        const t = Math.max(0, Math.min(1, ((pt.x - start.x) * chordX + (pt.y - start.y) * chordY) / (chordLen * chordLen)));
        const projX = start.x + t * chordX;
        const devX = pt.x - projX;
        if (Math.abs(devX) > Math.abs(maxSignedDevX)) {
          maxSignedDevX = devX;
        }
      }
    }

    // Conversion exacte du ventre écran à mi-parcours (Z = 5.5m) en coordonnée 3D midWorldX
    const midZ = PENALTY_Z * 0.5;
    const straightMidScreen = worldToScreen(targetX * 0.5, (BALL_R + targetY) * 0.5, midZ);
    const midWorld3D = screenToPlaneZ(straightMidScreen.x + maxSignedDevX, straightMidScreen.y, midZ);
    const midWorldX = THREE.MathUtils.clamp(midWorld3D.x, -5.6, 5.6);

    // Cinématique exacte : X(0) = 0, X(T/2) = midWorldX, X(T) = targetX
    const totalAx = THREE.MathUtils.clamp(
      (4 * (targetX - 2 * midWorldX)) / (flightTime * flightTime),
      -34.0,
      34.0
    );
    const vx0 = (targetX - 0.5 * totalAx * flightTime * flightTime) / flightTime;
    const vy0 = ((targetY - BALL_R) + 0.5 * FLIGHT_GRAVITY * flightTime * flightTime) / flightTime;

    return {
      targetX,
      targetY,
      midWorldX,
      spinCurve: totalAx,
      speedMs,
      flightTime,
      vx0,
      vy0,
      totalAx
    };
  }

  function drawSwipeTrail() {
    swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
    if (swipePoints.length < 2) return;

    const traj = computeExactTrajectory(lockedPowerPct);
    const isCurved = Math.abs(traj.spinCurve) > 3.2;

    swipeCtx.save();
    swipeCtx.lineCap = "round";
    swipeCtx.lineJoin = "round";

    // 1. Tracé discret du geste brut sous le doigt
    swipeCtx.strokeStyle = "rgba(255, 255, 255, 0.18)";
    swipeCtx.lineWidth = 4;
    swipeCtx.setLineDash([6, 6]);
    swipeCtx.beginPath();
    swipeCtx.moveTo(swipePoints[0].x, swipePoints[0].y);
    for (let i = 1; i < swipePoints.length; i++) {
      swipeCtx.lineTo(swipePoints[i].x, swipePoints[i].y);
    }
    swipeCtx.stroke();
    swipeCtx.setLineDash([]);

    // 2. Projection 2D de la VRAIE trajectoire 3D (X(t), Y(t), Z(t)) que le ballon va suivre exactement !
    const SAMPLES = 24;
    const screenPts: { x: number; y: number }[] = [];
    for (let i = 0; i <= SAMPLES; i++) {
      const u = i / SAMPLES;
      const t = u * traj.flightTime;
      const x = traj.vx0 * t + 0.5 * traj.totalAx * t * t;
      const y = BALL_R + traj.vy0 * t - 0.5 * FLIGHT_GRAVITY * t * t;
      const z = PENALTY_Z - traj.speedMs * t;
      screenPts.push(worldToScreen(x, y, z));
    }

    // Halo externe de la trajectoire 3D projetée
    swipeCtx.strokeStyle = isCurved ? "rgba(16, 185, 129, 0.45)" : "rgba(250, 204, 21, 0.42)";
    swipeCtx.lineWidth = 13;
    swipeCtx.beginPath();
    swipeCtx.moveTo(screenPts[0].x, screenPts[0].y);
    for (let i = 1; i < screenPts.length; i++) {
      swipeCtx.lineTo(screenPts[i].x, screenPts[i].y);
    }
    swipeCtx.stroke();

    // Ligne principale lumineuse de la trajectoire exacte
    swipeCtx.strokeStyle = isCurved ? "#34d399" : "#facc15";
    swipeCtx.lineWidth = 4.5;
    swipeCtx.stroke();

    // 3. Cible exacte d'impact sur le plan de but (Z = 0)
    const targetScreen = screenPts[screenPts.length - 1];
    swipeCtx.strokeStyle = isCurved ? "#34d399" : "#facc15";
    swipeCtx.lineWidth = 2.5;
    swipeCtx.beginPath();
    swipeCtx.arc(targetScreen.x, targetScreen.y, 12, 0, Math.PI * 2);
    swipeCtx.stroke();

    swipeCtx.fillStyle = "#ffffff";
    swipeCtx.beginPath();
    swipeCtx.arc(targetScreen.x, targetScreen.y, 4.5, 0, Math.PI * 2);
    swipeCtx.fill();

    swipeCtx.restore();
  }

  function updateChargeGauge(dt: number) {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;

    const h = window.innerHeight;
    const pushRatio = Math.max(0, chargePeakPushY / (h * 0.36));
    const pushPower = Math.min(96, pushRatio * 96);

    // La jauge monte de manière strictement irréversible (ne redescend jamais)
    // Montée progressive (dt * 28) pour laisser le temps de dessiner une belle courbe avec le doigt
    lockedPowerPct = Math.max(lockedPowerPct + dt * 28, pushPower);

    const displayPct = Math.min(Math.round(lockedPowerPct), 112);
    if (powerMeterFill) powerMeterFill.style.height = `${Math.min(displayPct, 100)}%`;
    if (powerMeterPct) {
      powerMeterPct.textContent = displayPct > 100 ? "MAX !" : `${displayPct}%`;
      powerMeterPct.className =
        displayPct > 100
          ? "rounded bg-red-600 px-1.5 py-0.5 font-display text-xs tracking-wider text-white shadow"
          : "rounded bg-black/90 px-1.5 py-0.5 font-display text-xs tracking-wider text-or shadow";
    }

    const traj = computeExactTrajectory(lockedPowerPct);
    currentCurveSpin = traj.spinCurve;
    if (Math.abs(traj.spinCurve) > 3.2) {
      hudCurvePill?.classList.remove("hidden");
      hudCurvePill?.classList.add("flex");
      if (hudCurveLabel) {
        hudCurveLabel.textContent = traj.spinCurve < 0 ? "ENROULÉ GAUCHE ↶" : "ENROULÉ DROIT ↷";
      }
    } else {
      hudCurvePill?.classList.add("hidden");
      hudCurvePill?.classList.remove("flex");
    }

    drawSwipeTrail();

    if (lockedPowerPct >= 112) {
      commitShotRelease();
    }
  }

  function commitShotRelease() {
    if (!chargeActive) return;
    chargeActive = false;
    ballGlowRing.visible = false;

    const traj = computeExactTrajectory(lockedPowerPct);
    setTimeout(() => {
      swipeCtx.clearRect(0, 0, swipeCanvas.width, swipeCanvas.height);
      if (powerMeterWrap) powerMeterWrap.classList.add("opacity-0");
    }, 320);

    fireShot(lockedPowerPct, traj);
  }

  canvas.addEventListener("pointerdown", (e) => {
    initAudio();
    if (state.phase !== "aiming" || state.paused) return;
    state.phase = "charging";
    chargeActive = true;
    swipePoints = [{ x: e.clientX, y: e.clientY }];
    chargePeakPushY = 0;
    lockedPowerPct = 26;
    currentCurveSpin = 0;

    aimInstruction?.classList.add("opacity-0");
    powerMeterWrap?.classList.remove("opacity-0");
  });

  window.addEventListener("pointermove", (e) => {
    if (!chargeActive || state.phase !== "charging" || state.paused) return;
    const lastPt = swipePoints[swipePoints.length - 1];
    if (!lastPt || Math.hypot(e.clientX - lastPt.x, e.clientY - lastPt.y) > 4) {
      swipePoints.push({ x: e.clientX, y: e.clientY });
    }
    const startY = swipePoints[0].y;
    const currentPushY = Math.max(0, startY - e.clientY);
    if (currentPushY > chargePeakPushY) {
      chargePeakPushY = currentPushY;
    }
  });

  window.addEventListener("pointerup", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) commitShotRelease();
  });
  window.addEventListener("pointercancel", () => {
    if (chargeActive && state.phase === "charging" && !state.paused) commitShotRelease();
  });

  function fireShot(powerPct: number, traj: ExactShotTrajectory) {
    state.phase = "shooting";

    shotPhys.active = true;
    shotPhys.inGoalCage = false;
    shotPhys.resolved = false;
    shotPhys.flightElapsed = 0;
    shotPhys.vz = -traj.speedMs;
    shotPhys.vx = traj.vx0;
    shotPhys.vy = traj.vy0;
    shotPhys.totalAx = traj.totalAx;
    shotPhys.spinY = traj.spinCurve;
    shotPhys.spinX = traj.speedMs * 0.65;
    shotPhys.speedKmh = Math.round(traj.speedMs * 3.6);
    shotPhys.wallJumping = true;

    // Ruban aérodynamique 3D et particules d'herbe/craie à l'impact du pied
    trailHistory.length = 0;
    trailMat.color.setHex(Math.abs(traj.spinCurve) > 3.2 ? 0x34d399 : 0xfacc15);
    ballTrailLine.visible = true;
    spawnTurfBurst(0, BALL_R * 0.5, PENALTY_Z, 26, false);
    cameraShakeAmp = 0.032;

    playKickAudio(powerPct / 100);

    const tier = getActiveTier();
    const tKeeper = (PENALTY_Z - 0.28) / traj.speedMs;
    const predX = shotPhys.vx * tKeeper + 0.5 * shotPhys.totalAx * tKeeper * tKeeper;
    const predY = Math.max(BALL_R, BALL_R + shotPhys.vy * tKeeper - 0.5 * FLIGHT_GRAVITY * tKeeper * tKeeper);

    // Un fort effet enroulé (spinCurve) trompe davantage le gardien !
    const isCentralShot = Math.abs(predX) < 1.15;
    const curveDeception = Math.min(Math.abs(traj.spinCurve) * 0.015, 0.30);
    shotPhys.keeperReadsRight = isCentralShot || Math.random() < (tier.keeperReadProb - curveDeception);

    if (shotPhys.keeperReadsRight) {
      const spinOffset = -Math.sign(traj.spinCurve) * Math.min(0.46, Math.abs(traj.spinCurve) * 0.02);
      shotPhys.keeperTargetX = THREE.MathUtils.clamp(predX + spinOffset, -3.55, 3.55);
      shotPhys.keeperTargetY = THREE.MathUtils.clamp(predY, 0.35, 2.35);
      shotPhys.keeperDiveDir = Math.sign(predX || 1);
    } else {
      const wrongDir = predX >= 0 ? -1 : 1;
      shotPhys.keeperTargetX = wrongDir * (1.6 + Math.random() * 1.4);
      shotPhys.keeperTargetY = 0.65 + Math.random() * 1.1;
      shotPhys.keeperDiveDir = wrongDir;
    }
  }

  /* -------------------------------------------------------------------------- */
  /*  PHYSIQUE PAR SOUS-PAS (SUB-STEPPING FIDÈLE À 100% AU TRACÉ)               */
  /* -------------------------------------------------------------------------- */
  function updatePhysics(dt: number) {
    const tier = getActiveTier();

    if (shotPhys.wallJumping && wallGroup.children.length > 0) {
      wallGroup.children.forEach((p) => {
        if (ballMesh.position.z > 4.2) {
          p.position.y = Math.min(0.66, p.position.y + dt * 4.2);
        } else {
          p.position.y = Math.max(0, p.position.y - dt * 2.5);
        }
      });
    }

    if (!shotPhys.active) return;

    shotPhys.flightElapsed += dt;

    if (shotPhys.flightElapsed >= tier.keeperReactionSec) {
      const desiredTorsoX = THREE.MathUtils.clamp(
        shotPhys.keeperTargetX - shotPhys.keeperDiveDir * (tier.keeperArmSpan * 0.55),
        -2.55,
        2.55
      );
      const desiredTorsoY = THREE.MathUtils.clamp(shotPhys.keeperTargetY - 0.95, 0, 1.05);

      keeperGroup.position.x = THREE.MathUtils.lerp(
        keeperGroup.position.x,
        desiredTorsoX,
        Math.min(1, dt * tier.keeperDiveSpeed)
      );
      keeperGroup.position.y = THREE.MathUtils.lerp(
        keeperGroup.position.y,
        desiredTorsoY,
        Math.min(1, dt * tier.keeperDiveSpeed * 0.95)
      );

      const diveTilt = THREE.MathUtils.clamp(-shotPhys.keeperTargetX * 0.46, -1.35, 1.35);
      keeperGroup.rotation.z = THREE.MathUtils.lerp(keeperGroup.rotation.z, diveTilt, dt * 18);
      kArmL.rotation.z = THREE.MathUtils.lerp(kArmL.rotation.z, 2.75, dt * 20);
      kArmR.rotation.z = THREE.MathUtils.lerp(kArmR.rotation.z, -2.75, dt * 20);
      armL.elbowPivot.rotation.x = THREE.MathUtils.lerp(armL.elbowPivot.rotation.x, 0, dt * 20);
      armR.elbowPivot.rotation.x = THREE.MathUtils.lerp(armR.elbowPivot.rotation.x, 0, dt * 20);
    }

    const SUBSTEPS = 6;
    const subDt = dt / SUBSTEPS;

    for (let step = 0; step < SUBSTEPS; step++) {
      const prevX = ballMesh.position.x;
      const prevY = ballMesh.position.y;
      const prevZ = ballMesh.position.z;

      // Tant que le ballon est en vol vers le but (non résolu), il suit EXACTEMENT la cinématique de la courbe tracée
      const grav = shotPhys.inGoalCage || shotPhys.resolved ? 9.81 : FLIGHT_GRAVITY;
      shotPhys.vy -= grav * subDt;
      if (!shotPhys.inGoalCage && !shotPhys.resolved) {
        shotPhys.vx += shotPhys.totalAx * subDt;
      }

      ballMesh.position.x += shotPhys.vx * subDt;
      ballMesh.position.y += shotPhys.vy * subDt;
      ballMesh.position.z += shotPhys.vz * subDt;

      ballMesh.rotation.x += (shotPhys.vz * subDt) / BALL_R;
      ballMesh.rotation.y += shotPhys.spinY * subDt * 0.78;
      ballMesh.rotation.z -= shotPhys.spinY * subDt * 0.35;

      // Pas de rebond parasite avant la ligne de but (le ballon rase l'herbe sans freiner)
      if (ballMesh.position.y < BALL_R) {
        ballMesh.position.y = BALL_R;
        if (shotPhys.inGoalCage || shotPhys.resolved) {
          shotPhys.vy = Math.abs(shotPhys.vy) * (shotPhys.inGoalCage ? 0.35 : 0.52);
          shotPhys.vx *= shotPhys.inGoalCage ? 0.72 : 0.85;
          shotPhys.vz *= shotPhys.inGoalCage ? 0.72 : 0.85;
        } else if (shotPhys.vy < 0) {
          shotPhys.vy = 0;
        }
      }

      if (shotPhys.inGoalCage) {
        const maxSideX = GOAL.width / 2 - BALL_R - 0.08;
        const minBackZ = -GOAL.depth + BALL_R + 0.12;
        const maxTopY = GOAL.height - BALL_R - 0.08;

        if (ballMesh.position.z <= minBackZ) {
          const hitSpeed = Math.abs(shotPhys.vz);
          ballMesh.position.z = minBackZ;
          shotPhys.vz = Math.min(2.8, hitSpeed * 0.18);
          shotPhys.vx *= 0.28;
          shotPhys.vy = Math.min(0.5, shotPhys.vy * 0.25);
          shotPhys.spinX = 0;
          shotPhys.spinY = 0;
          if (hitSpeed > 1.2) {
            triggerNetDeformation(ballMesh.position.x, ballMesh.position.y, hitSpeed);
            cameraShakeAmp = Math.max(cameraShakeAmp, 0.055);
          }
        }
        if (ballMesh.position.x < -maxSideX) {
          ballMesh.position.x = -maxSideX;
          shotPhys.vx = Math.abs(shotPhys.vx) * 0.22;
          shotPhys.vz *= 0.45;
        }
        if (ballMesh.position.x > maxSideX) {
          ballMesh.position.x = maxSideX;
          shotPhys.vx = -Math.abs(shotPhys.vx) * 0.22;
          shotPhys.vz *= 0.45;
        }
        if (ballMesh.position.y > maxTopY) {
          ballMesh.position.y = maxTopY;
          shotPhys.vy = -Math.abs(shotPhys.vy) * 0.22;
        }
        if (ballMesh.position.z > -0.18) {
          ballMesh.position.z = -0.18;
          if (shotPhys.vz > 0) shotPhys.vz = 0;
        }
        continue;
      }

      if (shotPhys.resolved) {
        if (ballMesh.position.z < -4.2) {
          ballMesh.position.z = -4.2;
          shotPhys.vz = Math.abs(shotPhys.vz) * 0.3;
          shotPhys.vx *= 0.5;
        }
        continue;
      }

      // 1. Mur défensif
      if (wallGroup.children.length > 0 && prevZ >= 5.2 && ballMesh.position.z <= 5.2) {
        const alpha = (prevZ - 5.2) / Math.max(0.00001, prevZ - ballMesh.position.z);
        const crossX = THREE.MathUtils.lerp(prevX, ballMesh.position.x, alpha);
        const crossY = THREE.MathUtils.lerp(prevY, ballMesh.position.y, alpha);

        let blockedByWall = false;
        for (const p of wallGroup.children) {
          if (Math.abs(crossX - p.position.x) < 0.38 && crossY < 1.88 + p.position.y) {
            blockedByWall = true;
            break;
          }
        }
        if (blockedByWall) {
          ballMesh.position.set(crossX, crossY, 5.25);
          shotPhys.vz = Math.abs(shotPhys.vz) * 0.38;
          shotPhys.vx += (Math.random() - 0.5) * 5;
          shotPhys.vy = 2.8;
          spawnTurfBurst(crossX, crossY, 5.25, 14, true);
          playSaveAudio();
          resolveShot(false, "CONTRÉ PAR LE MUR !", "Enroule ton geste avec le doigt pour contourner le mur !");
          break;
        }
      }

      // 2. Gardien
      if (prevZ >= 0.28 && ballMesh.position.z <= 0.28) {
        const alpha = (prevZ - 0.28) / Math.max(0.00001, prevZ - ballMesh.position.z);
        const crossX = THREE.MathUtils.lerp(prevX, ballMesh.position.x, alpha);
        const crossY = THREE.MathUtils.lerp(prevY, ballMesh.position.y, alpha);

        const torsoX = keeperGroup.position.x;
        const diveDir = shotPhys.keeperDiveDir;
        const minCoverX = Math.min(torsoX - 0.65, torsoX + diveDir * tier.keeperArmSpan - 0.35);
        const maxCoverX = Math.max(torsoX + 0.65, torsoX + diveDir * tier.keeperArmSpan + 0.35);
        const maxCoverY = keeperGroup.position.y + 1.98;

        if (crossX >= minCoverX && crossX <= maxCoverX && crossY >= 0 && crossY <= maxCoverY) {
          ballMesh.position.set(crossX, crossY, 0.34);
          shotPhys.vz = Math.abs(shotPhys.vz) * 0.42;
          shotPhys.vx = (diveDir || 1) * 6.8;
          shotPhys.vy = 3.0;
          spawnTurfBurst(crossX, crossY, 0.34, 16, true);
          cameraShakeAmp = 0.045;
          playSaveAudio();
          resolveShot(false, "ARRÊT DU GARDIEN !", "Parade du portier · Continue ta séance de 5 tirs !");
          break;
        }
      }

      // 3. Ligne de but
      if (prevZ >= 0 && ballMesh.position.z <= 0) {
        const alpha = prevZ / Math.max(0.00001, prevZ - ballMesh.position.z);
        const crossX = THREE.MathUtils.lerp(prevX, ballMesh.position.x, alpha);
        const crossY = THREE.MathUtils.lerp(prevY, ballMesh.position.y, alpha);
        const halfW = GOAL.width / 2;

        const hitLeftPost = Math.abs(crossX + halfW) < 0.16 && crossY <= GOAL.height + 0.14;
        const hitRightPost = Math.abs(crossX - halfW) < 0.16 && crossY <= GOAL.height + 0.14;
        const hitBar = Math.abs(crossY - GOAL.height) < 0.16 && Math.abs(crossX) <= halfW + 0.14;

        if (hitLeftPost || hitRightPost || hitBar) {
          ballMesh.position.set(crossX, crossY, 0.1);
          shotPhys.vz = Math.abs(shotPhys.vz) * 0.45;
          if (hitBar) shotPhys.vy = Math.abs(shotPhys.vy) * 0.55;
          else shotPhys.vx = -shotPhys.vx * 0.65;
          spawnTurfBurst(crossX, crossY, 0.08, 22, true);
          cameraShakeAmp = 0.08;
          goalFrameVibration = 0.22;
          playPostAudio();
          resolveShot(false, hitBar ? "BARRE TRANSVERSALE !" : "POTEAU SORTANT !", "Le montant repousse ta frappe !");
          break;
        }

        const insideX = Math.abs(crossX) < halfW - 0.08;
        const insideY = crossY > 0 && crossY < GOAL.height - 0.06;

        if (insideX && insideY) {
          shotPhys.inGoalCage = true;
          ballMesh.position.x = THREE.MathUtils.clamp(crossX, -halfW + BALL_R + 0.1, halfW - BALL_R - 0.1);
          ballMesh.position.y = THREE.MathUtils.clamp(crossY, BALL_R, GOAL.height - BALL_R - 0.1);
          ballMesh.position.z = Math.max(ballMesh.position.z, -GOAL.depth + BALL_R + 0.15);
          const curvedTag = Math.abs(shotPhys.spinY) > 3.2 ? " · FRAPPE ENROULÉE 🌀" : "";
          resolveShot(true, "BUT AUX MARTYRS ! ⚽", `${shotPhys.speedKmh} km/h${curvedTag}`);
        } else {
          if (Math.abs(ballMesh.position.x) < halfW + 0.25 && ballMesh.position.y < GOAL.height + 0.2) {
            ballMesh.position.x = Math.sign(ballMesh.position.x || 1) * (halfW + 0.3);
          }
          const msg = crossY >= GOAL.height ? "AU-DESSUS DE LA BARRE !" : "À CÔTÉ DU CADRE !";
          resolveShot(false, msg, crossY >= GOAL.height ? "Vise un peu plus bas dans le but" : "Place le cercle de visée dans le cadre");
          break;
        }
      }
    }

    // Mise à jour du ruban aérodynamique 3D derrière le ballon
    trailHistory.unshift(ballMesh.position.clone());
    if (trailHistory.length > TRAIL_MAX_PTS) trailHistory.pop();
    const posAttr = trailGeo.getAttribute("position") as THREE.BufferAttribute;
    for (let i = 0; i < TRAIL_MAX_PTS; i++) {
      const pt = trailHistory[Math.min(i, trailHistory.length - 1)] || ballMesh.position;
      posAttr.setXYZ(i, pt.x, pt.y, pt.z);
    }
    posAttr.needsUpdate = true;
  }

  /* -------------------------------------------------------------------------- */
  /*  RÉSOLUTION DU TIR SUR LA SÉANCE DE 5 TIRS                                 */
  /* -------------------------------------------------------------------------- */
  function resolveShot(isGoal: boolean, title: string, subtitle: string) {
    shotPhys.resolved = true;
    state.phase = "result";

    if (isGoal) {
      state.goalsInSeries++;
      state.kickHistory.push("goal");
    } else {
      state.kickHistory.push("miss");
    }
    state.kickIndex++;

    playCrowdRoar(isGoal);
    updateHud();

    if (shotToast && toastTitle && toastSubtitle && toastEmoji) {
      toastEmoji.textContent = isGoal ? "⚽" : "🧤";
      toastTitle.textContent = `${title} (TIR ${state.kickIndex}/${TOTAL_KICKS_PER_SERIES})`;
      toastTitle.className = isGoal
        ? "font-display text-base sm:text-lg uppercase tracking-wider text-or leading-none"
        : "font-display text-base sm:text-lg uppercase tracking-wider text-red-400 leading-none";
      toastSubtitle.textContent = subtitle;
      shotToast.classList.remove("opacity-0", "-translate-y-4");
    }

    // Si les 5 tirs ne sont pas encore terminés, on enchaîne sur le tir suivant !
    if (state.kickIndex < TOTAL_KICKS_PER_SERIES) {
      setTimeout(() => {
        shotToast?.classList.add("opacity-0", "-translate-y-4");
        shotPhys.active = false;
        setupNextKick();
      }, 1550);
    } else {
      // Fin de la séance des 5 tirs : vérifier si la remontada est réussie !
      setTimeout(() => {
        shotToast?.classList.add("opacity-0", "-translate-y-4");
        shotPhys.active = false;
        showSeriesSummaryModal();
      }, 1600);
    }
  }

  function showSeriesSummaryModal() {
    state.phase = "gameover";
    const tier = getActiveTier();
    const wonLevel = state.goalsInSeries >= tier.targetGoals;

    if (wonLevel && tier.id < TIERS.length && tier.id + 1 > state.maxUnlockedTier) {
      state.maxUnlockedTier = tier.id + 1;
      localStorage.setItem("sdm_max_tier", String(state.maxUnlockedTier));
    }

    if (goBadge) {
      goBadge.textContent = wonLevel ? "🏆" : "🧤";
      goBadge.className = wonLevel
        ? "mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/20 text-2xl border border-emerald-400/40"
        : "mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-red-500/20 text-2xl border border-red-500/40";
    }
    if (goKicker) {
      goKicker.textContent = wonLevel
        ? `Niveau ${tier.id} Validé · Qualification !`
        : `Fin des 5 Tirs · Objectif ${tier.targetGoals}/5`;
      goKicker.className = wonLevel
        ? "mt-2 block text-[0.52rem] font-bold uppercase tracking-widest text-emerald-400"
        : "mt-2 block text-[0.52rem] font-bold uppercase tracking-widest text-red-400";
    }
    if (goTitle) {
      goTitle.textContent = wonLevel ? "REMONTADA AUX MARTYRS !" : "ÉLIMINATION AUX TAB";
    }
    if (goDesc) {
      goDesc.textContent = wonLevel
        ? `Score final : RDC ${state.goalsInSeries} – ${tier.oppScore} ADV. Prêt pour le niveau supérieur !`
        : `Score final : RDC ${state.goalsInSeries} – ${tier.oppScore} ADV. Il fallait ${tier.targetGoals} buts sur 5.`;
    }

    if (goFiveRecap) {
      goFiveRecap.innerHTML = "";
      state.kickHistory.forEach((res, idx) => {
        const pill = document.createElement("span");
        pill.className = `flex h-7 w-7 items-center justify-center rounded-full text-xs font-black border ${
          res === "goal"
            ? "bg-emerald-500/25 border-emerald-400 text-emerald-300"
            : "bg-red-500/25 border-red-400 text-red-300"
        }`;
        pill.textContent = res === "goal" ? "⚽" : "✕";
        pill.title = `Tir ${idx + 1}`;
        goFiveRecap.appendChild(pill);
      });
    }

    if (goStatScore) goStatScore.textContent = `${state.goalsInSeries} - ${tier.oppScore}`;
    if (goStatLevel) goStatLevel.textContent = `Niv. ${tier.id}`;
    if (goStatMade) goStatMade.textContent = `${state.goalsInSeries} / 5`;

    if (btnGoPrimary) {
      if (wonLevel && state.currentTierIndex + 1 < TIERS.length) {
        btnGoPrimary.textContent = `🔥 Niveau ${tier.id + 1} (${TIERS[state.currentTierIndex + 1].name})`;
        btnGoPrimary.onclick = () => startLevelSeries(state.currentTierIndex + 1);
      } else if (wonLevel) {
        btnGoPrimary.textContent = "👑 Rejouer la Finale (5 tirs)";
        btnGoPrimary.onclick = () => startLevelSeries(state.currentTierIndex);
      } else {
        btnGoPrimary.textContent = "🔄 Rejouer ce niveau (5 tirs)";
        btnGoPrimary.onclick = () => startLevelSeries(state.currentTierIndex);
      }
    }

    gameoverModal?.classList.remove("hidden");
    gameoverModal?.classList.add("flex");
    renderLevelsModal();
  }

  function startLevelSeries(tierIdx = 0) {
    state.paused = false;
    if (iconPause) iconPause.textContent = "⏸";
    state.currentTierIndex = THREE.MathUtils.clamp(tierIdx, 0, TIERS.length - 1);
    state.kickIndex = 0;
    state.kickHistory = [];
    state.goalsInSeries = 0;

    gameoverModal?.classList.add("hidden");
    gameoverModal?.classList.remove("flex");
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");
    setupNextKick();
    renderLevelsModal();
  }

  /* -------------------------------------------------------------------------- */
  /*  MODALE NIVEAUX & MENU GÉNÉRAL                                             */
  /* -------------------------------------------------------------------------- */
  function renderLevelsModal() {
    if (!levelsGrid) return;
    levelsGrid.innerHTML = "";
    const activeTier = getActiveTier();

    TIERS.forEach((t, idx) => {
      const unlocked = t.id <= state.maxUnlockedTier;
      const isCurrent = t.id === activeTier.id;
      const card = document.createElement("button");
      card.type = "button";
      card.disabled = !unlocked;
      card.className = `flex flex-col justify-between rounded-2xl border p-3.5 text-left transition-all ${
        isCurrent
          ? "border-or bg-or/15 shadow-lg"
          : unlocked
            ? "border-white/15 bg-black/40 hover:border-white/35 hover:bg-white/5"
            : "border-white/5 bg-black/20 opacity-45 cursor-not-allowed"
      }`;

      card.innerHTML = `
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="rounded ${isCurrent ? "bg-or text-slate-950" : "bg-white/10 text-or"} px-2 py-0.5 font-display text-xs uppercase tracking-wider font-black">
              Niveau ${t.id} · ${t.deficitLabel}
            </span>
            <span class="text-[0.68rem] font-bold ${unlocked ? "text-emerald-400" : "text-slate-500"}">
              ${unlocked ? (isCurrent ? "● En cours" : "✓ Débloqué") : "🔒 Verrouillé"}
            </span>
          </div>
          <h4 class="mt-1.5 font-display text-lg uppercase tracking-wide text-white">${t.name}</h4>
          <p class="mt-0.5 text-xs text-slate-300 leading-relaxed">${t.desc}</p>
        </div>
        <div class="mt-2.5 flex items-center justify-between border-t border-white/10 pt-2 text-[0.62rem] font-bold uppercase tracking-wider text-slate-400">
          <span>Objectif : <strong class="text-emerald-400">${t.targetGoals}/5 buts</strong></span>
          <span>Mur : <strong class="text-or">${t.wallPlayers}</strong> · Vent : <strong class="text-sky-300">${t.windMaxKmh} km/h</strong></span>
        </div>
      `;

      if (unlocked) {
        card.addEventListener("click", () => startLevelSeries(idx));
      }
      levelsGrid.appendChild(card);
    });
  }

  function openLevelsModal() {
    initAudio();
    state.paused = true;
    if (iconPause) iconPause.textContent = "▶";
    renderLevelsModal();
    levelsModalOverlay?.classList.remove("hidden");
    levelsModalOverlay?.classList.add("flex");
  }

  function closeLevelsModal() {
    levelsModalOverlay?.classList.add("hidden");
    levelsModalOverlay?.classList.remove("flex");
    state.paused = false;
    if (iconPause) iconPause.textContent = "⏸";
    prevTime = performance.now();
  }

  btnOpenLevels?.addEventListener("click", openLevelsModal);
  btnCloseLevels?.addEventListener("click", closeLevelsModal);
  btnResumeFromLevels?.addEventListener("click", closeLevelsModal);
  btnGoLevels?.addEventListener("click", () => {
    gameoverModal?.classList.add("hidden");
    gameoverModal?.classList.remove("flex");
    openLevelsModal();
  });

  const tabBtns = document.querySelectorAll<HTMLButtonElement>(".menu-tab-btn");
  const panelMusic = document.getElementById("menu-panel-music");
  const panelSettings = document.getElementById("menu-panel-settings");
  const panelPhotos = document.getElementById("menu-panel-photos");
  const panelPartners = document.getElementById("menu-panel-partners");

  function switchMenuTab(tabName: string) {
    tabBtns.forEach((b) => {
      const active = b.dataset.menuTab === tabName;
      b.classList.toggle("border-or", active);
      b.classList.toggle("text-or", active);
      b.classList.toggle("border-transparent", !active);
      b.classList.toggle("text-slate-400", !active);
    });
    panelMusic?.classList.toggle("hidden", tabName !== "music");
    panelSettings?.classList.toggle("hidden", tabName !== "settings");
    panelPhotos?.classList.toggle("hidden", tabName !== "photos");
    panelPartners?.classList.toggle("hidden", tabName !== "partners");
  }

  tabBtns.forEach((b) => b.addEventListener("click", () => switchMenuTab(b.dataset.menuTab || "music")));

  function openMenu(tab = "music") {
    initAudio();
    state.paused = true;
    if (iconPause) iconPause.textContent = "▶";
    updateMusicUi();
    switchMenuTab(tab);
    gameMenuOverlay?.classList.remove("hidden");
    gameMenuOverlay?.classList.add("flex");
  }

  function closeMenu() {
    gameMenuOverlay?.classList.add("hidden");
    gameMenuOverlay?.classList.remove("flex");
    state.paused = false;
    if (iconPause) iconPause.textContent = "⏸";
    prevTime = performance.now();
  }

  btnOpenMenu?.addEventListener("click", () => openMenu("music"));
  btnCloseMenu?.addEventListener("click", closeMenu);
  btnResumeGame?.addEventListener("click", closeMenu);
  btnMenuRestart?.addEventListener("click", () => startLevelSeries(state.currentTierIndex));

  btnSetDay?.addEventListener("click", () => applyLightingMode(false));
  btnSetNight?.addEventListener("click", () => applyLightingMode(true));

  function toggleAudio() {
    initAudio();
    state.audioEnabled = !state.audioEnabled;
    if (!state.audioEnabled) {
      bgMusic.pause();
    } else {
      bgMusic.play().catch(() => {});
    }
    if (iconSound) iconSound.textContent = state.audioEnabled ? "🔊" : "🔇";
    if (btnMenuAudioToggle) {
      btnMenuAudioToggle.textContent = state.audioEnabled ? "🔊 Son Activé" : "🔇 Son Coupé";
    }
  }
  btnSound?.addEventListener("click", toggleAudio);
  btnMenuAudioToggle?.addEventListener("click", toggleAudio);

  btnSkipCinematic?.addEventListener("click", () => {
    initAudio();
    startLevelSeries(0);
  });

  btnMenuIntro?.addEventListener("click", () => {
    closeMenu();
    state.phase = "cinematic";
    state.cinematicTime = 0;
    cinematicBar?.classList.remove("hidden");
    aimInstruction?.classList.add("opacity-0");
  });

  /* -------------------------------------------------------------------------- */
  /*  BOUCLE PRINCIPALE D'ANIMATION                                             */
  /* -------------------------------------------------------------------------- */
  let prevTime = performance.now();

  function animate() {
    requestAnimationFrame(animate);
    const now = performance.now();
    const dt = Math.min((now - prevTime) / 1000, 0.05);
    prevTime = now;

    if (state.paused) {
      renderer.render(scene, camera);
      return;
    }

    const elapsed = now * 0.001;
    flashMat.uniforms.uTime.value = elapsed;
    updateNetMesh(dt);
    updateTurfParticles(dt);

    // Ombre de contact sous le ballon (s'étale et s'estompe avec l'altitude Y du ballon)
    const heightAboveGround = Math.max(0, ballMesh.position.y - BALL_R);
    ballContactShadow.position.set(ballMesh.position.x, 0.014, ballMesh.position.z);
    const shadowScale = 1 + heightAboveGround * 0.45;
    ballContactShadow.scale.set(shadowScale, shadowScale, 1);
    (ballContactShadow.material as THREE.MeshBasicMaterial).opacity = Math.max(
      0.12,
      0.62 * Math.exp(-heightAboveGround * 0.85)
    );

    // Vibration physique des poteaux/barre en cas de frappe sur le montant
    if (goalFrameVibration > 0.001) {
      goalGroup.position.x = Math.sin(elapsed * 95) * goalFrameVibration * 0.09;
      goalFrameVibration = Math.max(0, goalFrameVibration - dt * 0.55);
    } else {
      goalGroup.position.x = 0;
    }

    if (state.phase === "cinematic") {
      state.cinematicTime += dt;
      const t = state.cinematicTime;
      if (t < 2.2) {
        const p = t / 2.2;
        camera.position.set(Math.sin(p * 0.5) * 42, 36 - p * 20, 64 - p * 28);
        camera.lookAt(0, 6, -10);
        if (cinematicStepLabel) cinematicStepLabel.textContent = "1/2 · Stade des Martyrs · 80 000 places";
      } else if (t < 4.0) {
        const p = (t - 2.2) / 1.8;
        camera.position.set(-12 * (1 - p), 1.45 - p * 0.45, 20 - p * 6.85);
        camera.lookAt(0, 1.1, 0);
        if (cinematicStepLabel) cinematicStepLabel.textContent = "2/2 · Mode Mené · Séance de 5 Tirs";
      } else {
        startLevelSeries(0);
      }
    } else if (state.phase === "aiming" || state.phase === "charging") {
      const tier = getActiveTier();
      const swayFreq = 4.2 + tier.id * 0.95;
      const swayAmp = 0.34 + tier.id * 0.09;
      keeperGroup.position.x = Math.sin(elapsed * swayFreq) * swayAmp;
      keeperGroup.position.y = Math.abs(Math.sin(elapsed * swayFreq * 2)) * 0.08;
      keeperGroup.rotation.z = -Math.sin(elapsed * swayFreq) * 0.05;
      kArmL.rotation.z = 0.52 + Math.sin(elapsed * 7.5) * 0.10;
      kArmR.rotation.z = -0.52 - Math.sin(elapsed * 7.5) * 0.10;

      // Pulsation douce de l'anneau sous le ballon avant le tir
      const pulse = 1 + Math.sin(elapsed * 4.5) * 0.06;
      ballGlowRing.scale.set(pulse, pulse, 1);

      if (state.phase === "charging") {
        updateChargeGauge(dt);
      }
    } else if (state.phase === "shooting" || state.phase === "result") {
      updatePhysics(dt);

      // Suivi caméra dynamique léger type EA FC + tremblement d'impact (Camera Shake)
      const aspect = window.innerWidth / Math.max(1, window.innerHeight);
      const isPortrait = aspect < 0.95;
      const baseZ = isPortrait ? 13.15 : 13.35;
      const baseY = isPortrait ? 0.96 : 1.18;
      const lookY = isPortrait ? 1.04 : 1.15;
      const pushIn = Math.min(0.65, shotPhys.flightElapsed * 1.1);

      const shakeX = cameraShakeAmp > 0.001 ? (Math.random() - 0.5) * cameraShakeAmp : 0;
      const shakeY = cameraShakeAmp > 0.001 ? (Math.random() - 0.5) * cameraShakeAmp : 0;
      cameraShakeAmp = Math.max(0, cameraShakeAmp - dt * 0.18);

      camera.position.set(
        ballMesh.position.x * 0.08 + shakeX,
        baseY + shakeY,
        baseZ - pushIn
      );
      camera.lookAt(ballMesh.position.x * 0.18, lookY, 0);
    }

    renderer.render(scene, camera);
  }

  window.addEventListener("resize", () => {
    renderer.setSize(window.innerWidth, window.innerHeight);
    resizeSwipeCanvas();
    applyPlayableCameraFraming();
  });

  applyLightingMode(true);
  applyPlayableCameraFraming();
  updateHud();
  updateMusicUi();
  renderLevelsModal();
  animate();
</script>
