  /* -------------------------------------------------------------------------- */
  /*  TIREUR LÉOPARD 3D DE DOS EN TROIS-QUARTS (MAILLOT BLEU CIEL RDC + NUMÉRO) */
  /* -------------------------------------------------------------------------- */
  function createShooterJerseyBackTexture(shooter: LeopardShooter = getActiveShooter()) {
    const cv = document.createElement("canvas");
    cv.width = 512;
    cv.height = 512;
    const ctx = cv.getContext("2d")!;

    // Fond Bleu Ciel officiel des Léopards RDC (avec tombé de tissu ombré)
    const bgGrad = ctx.createLinearGradient(0, 0, 0, 512);
    bgGrad.addColorStop(0, "#38bdf8");
    bgGrad.addColorStop(0.55, "#0ea5e9");
    bgGrad.addColorStop(1, "#0284c7");
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, 512, 512);

    // Plis subtils du tombé du maillot dans le dos
    ctx.strokeStyle = "rgba(3, 105, 161, 0.26)";
    ctx.lineWidth = 14;
    for (let i = 0; i < 5; i++) {
      ctx.beginPath();
      ctx.moveTo(90 + i * 80, 70);
      ctx.quadraticCurveTo(130 + i * 75, 260, 85 + i * 82, 480);
      ctx.stroke();
    }

    // Motifs pelage Léopard / zébrures Umbro RDC sur les flancs et le bas du dos
    ctx.strokeStyle = "rgba(255, 255, 255, 0.16)";
    ctx.lineWidth = 7;
    for (let y = 260; y < 495; y += 28) {
      ctx.beginPath();
      ctx.moveTo(40, y);
      ctx.quadraticCurveTo(256, y - 36, 472, y);
      ctx.stroke();
    }

    // Col tricolore RDC (Rouge / Or / Bleu) en haut du dos
    ctx.fillStyle = "#dc2626";
    ctx.fillRect(0, 0, 512, 22);
    ctx.fillStyle = "#facc15";
    ctx.fillRect(0, 22, 512, 10);

    // Mini drapeau RDC sous la nuque
    ctx.fillStyle = "#007fff";
    ctx.fillRect(232, 42, 48, 28);
    ctx.strokeStyle = "#facc15";
    ctx.lineWidth = 3;
    ctx.strokeRect(232, 42, 48, 28);
    ctx.fillStyle = "#ce1126";
    ctx.beginPath();
    ctx.moveTo(232, 68);
    ctx.lineTo(280, 44);
    ctx.lineTo(280, 52);
    ctx.lineTo(232, 70);
    ctx.fill();

    // Nom du joueur en haut du dos (ex. WISSA, MBEMBA, BAKAMBU)
    ctx.save();
    ctx.font = "900 54px Impact, 'Arial Black', sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.lineWidth = 8;
    ctx.strokeStyle = "#082f49";
    ctx.strokeText(shooter.backName, 256, 118);
    ctx.fillStyle = "#ffffff";
    ctx.fillText(shooter.backName, 256, 118);
    ctx.restore();

    // Grand Numéro officiel dans le dos (style officiel Léopards : Rouge-Orangé bordé de Blanc & Or)
    ctx.save();
    ctx.font = "900 235px Impact, 'Arial Black', sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.lineWidth = 18;
    ctx.strokeStyle = "#ffffff";
    ctx.strokeText(String(shooter.number), 256, 295);
    ctx.lineWidth = 8;
    ctx.strokeStyle = "#facc15";
    ctx.strokeText(String(shooter.number), 256, 295);
    const numGrad = ctx.createLinearGradient(0, 175, 0, 410);
    numGrad.addColorStop(0, "#f97316");
    numGrad.addColorStop(0.5, "#ea580c");
    numGrad.addColorStop(1, "#dc2626");
    ctx.fillStyle = numGrad;
    ctx.fillText(String(shooter.number), 256, 295);
    ctx.restore();

    const tex = new THREE.CanvasTexture(cv);
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.anisotropy = 4;
    return tex;
  }

