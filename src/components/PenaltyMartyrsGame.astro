  // Pelouse photo-réaliste à brins d'herbe + bandes de tonte + usure surface
  function createRealisticGrassTexture() {
    const cv = document.createElement("canvas");
    cv.width = 1024;
    cv.height = 1024;
    const ctx = cv.getContext("2d")!;
    const stripes = 18;
    for (let i = 0; i < stripes; i++) {
      ctx.fillStyle = i % 2 === 0 ? "#1d6b35" : "#247a3f";
      ctx.fillRect(0, (i * 1024) / stripes, 1024, 1024 / stripes + 1);
    }
    // Micro-brins d'herbe pour donner du grain réaliste dans le champ caméra
    for (let i = 0; i < 28000; i++) {
      const x = Math.random() * 1024;
      const y = Math.random() * 1024;
      ctx.fillStyle = Math.random() > 0.5 ? "rgba(255,255,255,0.035)" : "rgba(0,0,0,0.045)";
      ctx.fillRect(x, y, 2, 2);
    }
    const tex = new THREE.CanvasTexture(cv);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(3, 3);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

  const pitchMesh = new THREE.Mesh(
    new THREE.PlaneGeometry(74, 112),
    new THREE.MeshStandardMaterial({ map: createRealisticGrassTexture(), roughness: 0.86, metalness: 0.02 })
