    const forearm = new THREE.Mesh(new THREE.CylinderGeometry(0.066, 0.054, 0.34, 14), skinMat);
    forearm.position.y = -0.49;
    forearm.castShadow = true;
    shoulderPivot.add(forearm);

    // Gant de gardien professionnel (poignet + paume + dos du gant + pouce + 4 doigts)
    const gloveGroup = new THREE.Group();
    gloveGroup.position.y = -0.74;

    const wristStrap = new THREE.Mesh(new THREE.CylinderGeometry(0.064, 0.064, 0.09, 14), shortMat);
    wristStrap.position.y = 0.07;
    gloveGroup.add(wristStrap);

    const palm = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.20, 0.065), glovePalmMat);
    palm.position.z = 0.015;
    const backhand = new THREE.Mesh(new THREE.BoxGeometry(0.185, 0.205, 0.05), gloveLatexMat);
    backhand.position.z = -0.015;
    gloveGroup.add(palm, backhand);

    // 4 doigts + pouce écarté
    [-0.065, -0.022, 0.022, 0.065].forEach((fx, fi) => {
      const len = fi === 1 || fi === 2 ? 0.11 : 0.095;
      const finger = new THREE.Mesh(new THREE.CapsuleGeometry(0.018, len, 6, 8), gloveLatexMat);
      finger.position.set(fx, -0.13, 0);
      gloveGroup.add(finger);
