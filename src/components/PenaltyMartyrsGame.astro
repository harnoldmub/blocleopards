  /* -------------------------------------------------------------------------- */
  /*  WEB AUDIO API (EFFETS SONORES)                                            */
  /* -------------------------------------------------------------------------- */
  let audioCtx: AudioContext | null = null;

  function initAudio() {
    if (!audioCtx) {
      const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AC) audioCtx = new AC();
    }
    if (audioCtx && audioCtx.state === "suspended") audioCtx.resume();
    ensureMusicPlaying();
  }

  function playKickAudio(powerRatio: number) {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "triangle";
      osc.frequency.setValueAtTime(135 + powerRatio * 55, now);
      osc.frequency.exponentialRampToValueAtTime(28, now + 0.15);
      gain.gain.setValueAtTime(0.75, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.17);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.17);
    } catch {}
  }

  function playNetSwishAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const dur = 0.24;
      const bufSize = Math.floor(audioCtx.sampleRate * dur);
      const buf = audioCtx.createBuffer(1, bufSize, audioCtx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < bufSize; i++) data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufSize * 0.35));
      const src = audioCtx.createBufferSource();
      src.buffer = buf;
      const filter = audioCtx.createBiquadFilter();
      filter.type = "bandpass";
      filter.frequency.setValueAtTime(1900, now);
      filter.Q.value = 1.8;
      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.45, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + dur);
      src.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);
      src.start(now);
      src.stop(now + dur);
    } catch {}
  }

  function playPostAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      [740, 1210, 2380].forEach((f, i) => {
        const osc = audioCtx!.createOscillator();
        const gain = audioCtx!.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(f, now);
        gain.gain.setValueAtTime(0.32 / (i + 1), now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.48);
        osc.connect(gain);
        gain.connect(audioCtx!.destination);
        osc.start(now);
        osc.stop(now + 0.48);
      });
    } catch {}
  }

  function playSaveAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "sawtooth";
      osc.frequency.setValueAtTime(210, now);
      osc.frequency.exponentialRampToValueAtTime(55, now + 0.14);
      gain.gain.setValueAtTime(0.55, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.15);
    } catch {}
  }

  function playCrowdRoar(isGoal: boolean) {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const dur = isGoal ? 1.5 : 0.75;
      const bufSize = Math.floor(audioCtx.sampleRate * dur);
      const buf = audioCtx.createBuffer(1, bufSize, audioCtx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
      const src = audioCtx.createBufferSource();
      src.buffer = buf;

      const filter = audioCtx.createBiquadFilter();
      filter.type = "bandpass";
      filter.frequency.setValueAtTime(isGoal ? 550 : 310, now);
      filter.frequency.exponentialRampToValueAtTime(isGoal ? 1320 : 130, now + dur * 0.7);
      filter.Q.value = 1.5;

      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.01, now);
      gain.gain.linearRampToValueAtTime(isGoal ? 0.55 : 0.25, now + 0.18);
      gain.gain.exponentialRampToValueAtTime(0.008, now + dur);

      src.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);
      src.start(now);
      src.stop(now + dur);
    } catch {}
  }

  /* -------------------------------------------------------------------------- */
  /*  SCÈNE 3D : BALLON BIEN VISIBLE AU PREMIER PLAN + BUT ENTIER SUR MOBILE    */
  /* -------------------------------------------------------------------------- */
  const renderer = new THREE.WebGLRenderer({
    canvas,
    antialias: true,
    powerPreference: "high-performance"
  });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.08;

  function resizeSwipeCanvas() {
    swipeCanvas.width = window.innerWidth;
    swipeCanvas.height = window.innerHeight;
  }
  resizeSwipeCanvas();

  const scene = new THREE.Scene();
  scene.background = new THREE.Color("#050811");
  scene.fog = new THREE.FogExp2("#050811", 0.0038);

  const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 450);

  // Position du ballon au point de penalty (11.0m) et caméra rapprochée à 13.15m (seulement 2.15m derrière le ballon !)
  // Cela rend le ballon 2x plus grand et bien visible au premier plan tout en gardant les deux poteaux et côtés dans le cadre !
  const PENALTY_Z = 11.0;

  function applyPlayableCameraFraming() {
    const aspect = window.innerWidth / Math.max(1, window.innerHeight);
    const isPortrait = aspect < 0.95;

    // Caméra placée juste derrière le ballon (2.15m derrière) et un peu plus basse (0.98m)
    // pour que le ballon soit grand et net dans le tiers inférieur de l'écran !
    const camZ = isPortrait ? 13.15 : 13.35;
    const camY = isPortrait ? 0.96 : 1.18;
    const lookY = isPortrait ? 1.04 : 1.15;

    // On garantit au moins 11.2m de largeur visible sur la ligne de but (le but fait 7.32m -> ~2m de marge de chaque côté)
    const minGoalLineHalfWidth = isPortrait ? 5.65 : 7.4;
    const tanHalfHoriz = minGoalLineHalfWidth / camZ;
    const tanHalfVert = tanHalfHoriz / aspect;
    const computedFov = THREE.MathUtils.radToDeg(2 * Math.atan(tanHalfVert));

    camera.fov = THREE.MathUtils.clamp(computedFov, 46, 84);
    camera.aspect = aspect;
    camera.updateProjectionMatrix();

    if (state.phase === "aiming" || state.phase === "charging" || state.phase === "shooting" || state.phase === "result") {
      camera.position.set(0, camY, camZ);
      camera.lookAt(0, lookY, 0);
    }
  }

