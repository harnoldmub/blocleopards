  // Particules 3D de pelouse / terre / craie lors de la frappe et des impacts
  interface TurfParticle {
    mesh: THREE.Mesh;
    vx: number;
    vy: number;
    vz: number;
    life: number;
    maxLife: number;
  }
  const turfParticles: TurfParticle[] = [];
  const particleGroup = new THREE.Group();
  scene.add(particleGroup);
  const partGeo = new THREE.BoxGeometry(0.032, 0.018, 0.048);

  function spawnTurfBurst(originX: number, originY: number, originZ: number, count = 24, isPostSpark = false) {
    const palette = isPostSpark
      ? [0xffffff, 0xfacc15, 0xe2e8f0]
      : [0x15803d, 0x166534, 0x3f2e21, 0xffffff, 0x22c55e];

    for (let i = 0; i < count; i++) {
      const col = palette[i % palette.length];
      const mat = new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.92 });
      const m = new THREE.Mesh(partGeo, mat);
      m.position.set(
        originX + (Math.random() - 0.5) * 0.18,
        originY + Math.random() * 0.06,
        originZ + (Math.random() - 0.5) * 0.14
      );
      m.rotation.set(Math.random() * 3, Math.random() * 3, Math.random() * 3);
      particleGroup.add(m);

      turfParticles.push({
        mesh: m,
        vx: (Math.random() - 0.5) * (isPostSpark ? 4.5 : 2.6),
        vy: 1.4 + Math.random() * (isPostSpark ? 3.2 : 2.6),
        vz: isPostSpark ? (Math.random() - 0.5) * 3.5 : 0.8 + Math.random() * 2.4,
        life: 0,
        maxLife: 0.38 + Math.random() * 0.32
      });
    }
  }

  function updateTurfParticles(dt: number) {
    for (let i = turfParticles.length - 1; i >= 0; i--) {
      const p = turfParticles[i];
      p.life += dt;
      if (p.life >= p.maxLife) {
        particleGroup.remove(p.mesh);
        (p.mesh.material as THREE.Material).dispose();
        turfParticles.splice(i, 1);
        continue;
      }
      p.vy -= 9.81 * dt;
      p.mesh.position.x += p.vx * dt;
      p.mesh.position.y = Math.max(0.01, p.mesh.position.y + p.vy * dt);
      p.mesh.position.z += p.vz * dt;
      p.mesh.rotation.x += dt * 8;
      p.mesh.rotation.z += dt * 6;
      (p.mesh.material as THREE.MeshBasicMaterial).opacity = 1 - p.life / p.maxLife;
    }
  }

