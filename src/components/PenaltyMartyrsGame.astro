    fragmentShader: `
      uniform vec3 uColor; uniform float uOpacity;
      varying float vY; varying vec3 vN; varying vec3 vV;
      void main(){
        float core = pow(abs(dot(vN, vV)), 1.8);
        float fade = pow(vY, 1.5);
