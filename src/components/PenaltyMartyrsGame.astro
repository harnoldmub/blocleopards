        float flash = pow(max(0.0, sin(uTime * (0.8 + aSeed * 1.5) + aSeed * 50.0)), 40.0);
        float torch = 0.25 + 0.2 * sin(uTime * 1.5 + aSeed * 20.0);
        vA = max(flash, torch * 0.5);
        vec4 mv = modelViewMatrix * vec4(position, 1.0);
        gl_PointSize = 7.0 * (180.0 / -mv.z);
