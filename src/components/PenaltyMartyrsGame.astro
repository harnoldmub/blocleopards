  // Fonction de création d'un bras articulé réaliste (Épaule -> Bras -> Coude -> Avant-bras -> Gant Pro à doigts)
  function createArticulatedArm(isLeft: boolean) {
    const side = isLeft ? -1 : 1;
    const shoulderPivot = new THREE.Group();
    shoulderPivot.position.set(side * 0.34, 1.61, 0);

    const shoulderCap = new THREE.Mesh(new THREE.SphereGeometry(0.105, 14, 14), sleeveMat);
    shoulderPivot.add(shoulderCap);

