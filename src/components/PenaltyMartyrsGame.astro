  function setShooterIdlePose(elapsed: number) {
    const breath = Math.sin(elapsed * 2.8) * 0.012;
    // Placé à gauche/arrière du ballon en trois-quarts dos : le numéro dans le dos est parfaitement tourné vers la caméra
    shooterGroup.position.set(-0.35, 0, PENALTY_Z + 0.50);
    shooterGroup.rotation.set(0, -0.34, 0);
    sUpperBody.position.set(0, 0.88 + breath, 0);
    sUpperBody.rotation.set(-0.10, 0.08, 0);

    sArmL.rotation.set(0.12, 0, 0.24 + Math.sin(elapsed * 2.8) * 0.03);
    sArmR.rotation.set(-0.08, 0, -0.22 - Math.sin(elapsed * 2.8) * 0.03);

    // Jambe gauche légèrement fléchie en appui, jambe droite prête derrière
    sLegL.hipPivot.rotation.set(0.14, 0, 0.05);
    sLegL.kneePivot.rotation.set(-0.22, 0, 0);
    sLegL.anklePivot.rotation.set(0.08, 0, 0);

    sLegR.hipPivot.rotation.set(-0.16, 0, -0.05);
    sLegR.kneePivot.rotation.set(-0.28, 0, 0);
    sLegR.anklePivot.rotation.set(0.12, 0, 0);

    shooterGroundShadow.position.set(shooterGroup.position.x, 0.013, shooterGroup.position.z);
  }

  // Animation de course d'élan (p = 0..1 avant l'impact du pied à p = 1.0, puis p > 1.0 pour le suivi de jambe)
  function updateShooterRunupPose(p: number) {
    const approach = Math.min(1, p);
    // Le tireur s'avance de (-0.35, 11.50) jusqu'à poser son pied gauche d'appui à (-0.20, 11.02) juste à côté du ballon
    shooterGroup.position.x = THREE.MathUtils.lerp(-0.35, -0.20, approach);
    shooterGroup.position.z = THREE.MathUtils.lerp(PENALTY_Z + 0.50, PENALTY_Z + 0.02, approach);
    shooterGroup.rotation.y = THREE.MathUtils.lerp(-0.34, -0.16, approach);
    shooterGroup.rotation.z = THREE.MathUtils.lerp(0, 0.14, approach); // Inclinaison athlétique sur la jambe d'appui

    if (p <= 0.55) {
      // Phase 1 (0 -> 0.55) : foulée d'appui gauche et armé puissant de la jambe droite vers l'arrière
      const w = p / 0.55;
      sUpperBody.rotation.x = THREE.MathUtils.lerp(-0.10, -0.24, w);
      sArmL.rotation.set(-0.45 * w, 0, 0.24 + 0.55 * w); // Bras gauche s'ouvre pour équilibrer
      sArmR.rotation.set(0.35 * w, 0, -0.22 - 0.15 * w);

      // Jambe gauche s'avance vers le ballon
      sLegL.hipPivot.rotation.set(THREE.MathUtils.lerp(0.14, 0.42, w), 0, 0.05);
      sLegL.kneePivot.rotation.set(THREE.MathUtils.lerp(-0.22, -0.35, w), 0, 0);

      // Jambe droite s'arme franchement en arrière (rotation.x négative tire la cuisse vers +Z, pli du genou vers le haut)
      sLegR.hipPivot.rotation.set(THREE.MathUtils.lerp(-0.16, -0.78, w), 0, -0.06);
      sLegR.kneePivot.rotation.set(THREE.MathUtils.lerp(-0.28, -1.18, w), 0, 0);
      sLegR.anklePivot.rotation.set(-0.35 * w, 0, 0);
    } else if (p <= 1.0) {
      // Phase 2 (0.55 -> 1.0) : déclenchement explosif de la jambe droite jusqu'au contact exact pied-ballon à p = 1.0 !
      const s = (p - 0.55) / 0.45;
      sUpperBody.rotation.x = THREE.MathUtils.lerp(-0.24, 0.08, s);
      sArmL.rotation.set(-0.45, 0, 0.79);
      sArmR.rotation.set(THREE.MathUtils.lerp(0.35, -0.30, s), 0, -0.32);

      // Jambe gauche plantée au sol à côté du ballon
      sLegL.hipPivot.rotation.set(0.28, 0, 0.06);
      sLegL.kneePivot.rotation.set(-0.26, 0, 0);

      // Fouetté de la jambe droite qui traverse le ballon
      sLegR.hipPivot.rotation.set(THREE.MathUtils.lerp(-0.78, 0.52, s), 0, -0.04);
      sLegR.kneePivot.rotation.set(THREE.MathUtils.lerp(-1.18, -0.06, s), 0, 0);
      sLegR.anklePivot.rotation.set(THREE.MathUtils.lerp(-0.35, -0.45, s), 0, 0);
    } else {
      // Phase 3 (p > 1.0) : Accompagnement (follow-through) après le départ du ballon
      const f = Math.min(1, (p - 1.0) / 0.8);
      sUpperBody.rotation.x = THREE.MathUtils.lerp(0.08, 0.16, f);
      sLegR.hipPivot.rotation.set(THREE.MathUtils.lerp(0.52, 0.76, f), 0, 0.08 * f);
      sLegR.kneePivot.rotation.set(THREE.MathUtils.lerp(-0.06, -0.22, f), 0, 0);
    }

    shooterGroundShadow.position.set(shooterGroup.position.x, 0.013, shooterGroup.position.z);
  }

