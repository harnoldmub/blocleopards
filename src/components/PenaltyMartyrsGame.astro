    const thumb = new THREE.Mesh(new THREE.CapsuleGeometry(0.02, 0.08, 6, 8), gloveLatexMat);
    thumb.position.set(side * -0.11, -0.04, 0.02);
    thumb.rotation.z = side * 0.55;
    gloveGroup.add(thumb);

    shoulderPivot.add(gloveGroup);
    return shoulderPivot;
