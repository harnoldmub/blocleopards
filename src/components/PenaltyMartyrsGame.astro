<!-- ================= MOTEUR 3D, MUSIQUE & GAMEPLAY RÉALISTE ================= -->
<script>
  import * as THREE from "three";

  /* -------------------------------------------------------------------------- */
  /*  PLAYLIST OFFICIELLE DES CHANSONS (DOSSIER public/audio/jeu/)              */
  /* -------------------------------------------------------------------------- */
  interface SongTrack {
    id: string;
    title: string;
    shortTitle: string;
    subtitle: string;
    filename: string;
    inDefaultLoop: boolean;
  }

  const PLAYLIST: SongTrack[] = [
    {
      id: "oh-yaya",
      title: "Oh Yaya ! Nos Léopards viennent célébrer la qualification",
      shortTitle: "Oh Yaya · Nos Léopards",
      subtitle: "Hymne de célébration des Léopards · Boucle par défaut #1",
      filename: "oh-yaya.mp3",
      inDefaultLoop: true
    },
    {
      id: "ti-na-trois",
      title: "Tout droit Ti Na Trois",
      shortTitle: "Tout droit Ti Na Trois",
      subtitle: "Ambiance tribunes Stade des Martyrs · Boucle par défaut #2",
      filename: "ti-na-trois.mp3",
      inDefaultLoop: true
    },
    {
      id: "esimbi-mondial",
      title: "Esimbi — Mondial Bolukaki Yangoyoooo",
      shortTitle: "Esimbi · Mondial",
      subtitle: "Ferveur qualification RDC · Boucle par défaut #3",
      filename: "esimbi-mondial.mp3",
      inDefaultLoop: true
    },
    {
      id: "cest-fait-3-1",
      title: "C'est Fait !!! 3–1 Merci les Léopards",
      shortTitle: "C'est Fait ! 3–1 Léopards",
      subtitle: "Victoire historique @blocleopards",
      filename: "cest-fait-3-1.mp3",
      inDefaultLoop: false
    },
    {
      id: "rendez-vous-destin",
      title: "Le Rendez-vous avec le Destin (Un demi-siècle)",
      shortTitle: "Rendez-vous du Destin",
      subtitle: "50 ans de passion derrière la RDC",
      filename: "rendez-vous-destin.mp3",
      inDefaultLoop: false
    }
  ];

  /* -------------------------------------------------------------------------- */
  /*  NIVEAUX ÉVOLUTIFS AUTOMATIQUES                                            */
  /* -------------------------------------------------------------------------- */
  interface LevelTier {
    id: number;
    minGoals: number;
    name: string;
    desc: string;
    keeperReactionSec: number;
    keeperDiveSpeed: number;
    keeperArmSpan: number;
    keeperReadProb: number;
    windMaxKmh: number;
    wallPlayers: number;
  }

  const TIERS: LevelTier[] = [
    {
      id: 1,
      minGoals: 0,
      name: "Échauffement",
      desc: "Gardien explosif sur sa ligne. Vise près des poteaux pour le battre !",
      keeperReactionSec: 0.042,
      keeperDiveSpeed: 10.8,
      keeperArmSpan: 1.26,
      keeperReadProb: 0.84,
      windMaxKmh: 0,
      wallPlayers: 0
    },
    {
      id: 2,
      minGoals: 1,
      name: "Éliminatoires CAN",
      desc: "Vent léger (14 km/h) + Gardien international aux réflexes rapides.",
      keeperReactionSec: 0.030,
      keeperDiveSpeed: 12.4,
      keeperArmSpan: 1.33,
      keeperReadProb: 0.88,
      windMaxKmh: 14,
      wallPlayers: 0
    },
    {
      id: 3,
      minGoals: 2,
      name: "Quart de Finale",
      desc: "1 défenseur en mur + Vent (22 km/h) + Plongeon haute détente.",
      keeperReactionSec: 0.022,
      keeperDiveSpeed: 13.8,
      keeperArmSpan: 1.38,
      keeperReadProb: 0.91,
      windMaxKmh: 22,
      wallPlayers: 1
    },
    {
      id: 4,
      minGoals: 3,
      name: "Demi-Finale",
      desc: "Mur de 2 défenseurs qui sautent + Vent fort (28 km/h).",
      keeperReactionSec: 0.015,
      keeperDiveSpeed: 15.2,
      keeperArmSpan: 1.44,
      keeperReadProb: 0.94,
      windMaxKmh: 28,
      wallPlayers: 2
    },
    {
      id: 5,
      minGoals: 5,
      name: "Finale 90ᵉ · Martyrs",
      desc: "« Le Mur de Kin » : 3 défenseurs + rafales (36 km/h) + lecture quasi parfaite !",
      keeperReactionSec: 0.008,
      keeperDiveSpeed: 16.8,
      keeperArmSpan: 1.50,
      keeperReadProb: 0.97,
      windMaxKmh: 36,
      wallPlayers: 3
    }
  ];

  /* -------------------------------------------------------------------------- */
  /*  ÉTAT DU JEU & DU LECTEUR MUSICAL                                          */
  /* -------------------------------------------------------------------------- */
  const state = {
    phase: "cinematic" as "cinematic" | "aiming" | "charging" | "shooting" | "result" | "gameover",
    paused: false,
    cinematicTime: 0,
    streak: 0,
    baseTierIndex: 0,
    maxUnlockedTier: Number(localStorage.getItem("sdm_max_tier") || 1),
    bestStreak: Number(localStorage.getItem("sdm_best_streak") || 0),
    windKmh: 0,
    wallSide: 1,
    isNight: true,
    audioEnabled: true,
    currentTrackIndex: 0,
    loopMode: "top3" as "top3" | "all" | "single", // Par défaut : boucle sur les 3 premières chansons !
    musicStarted: false
  };

  function getActiveTier(): LevelTier {
    let tier = TIERS[state.baseTierIndex] || TIERS[0];
    for (const t of TIERS) {
      if (state.streak >= t.minGoals && t.id > tier.id) {
        tier = t;
      }
    }
    return tier;
  }

  /* -------------------------------------------------------------------------- */
  /*  RÉFÉRENCES DOM                                                            */
  /* -------------------------------------------------------------------------- */
  const canvas = document.getElementById("penalty-canvas") as HTMLCanvasElement;
  const hudStreak = document.getElementById("hud-streak");
  const hudRecord = document.getElementById("hud-record");
  const hudLevelBadge = document.getElementById("hud-level-badge");
  const hudWindPill = document.getElementById("hud-wind-pill");
  const hudWindArrow = document.getElementById("hud-wind-arrow");
  const hudWindVal = document.getElementById("hud-wind-val");

  const hudTrackShort = document.getElementById("hud-track-short");
  const hudTrackMobile = document.getElementById("hud-track-mobile");
  const btnNextTrackHud = document.getElementById("btn-next-track-hud");
  const btnMobileTrackPill = document.getElementById("btn-mobile-track-pill");

  const powerMeterWrap = document.getElementById("power-meter-wrap");
  const powerMeterFill = document.getElementById("power-meter-fill");
  const powerMeterPct = document.getElementById("power-meter-pct");
  const aimInstruction = document.getElementById("aim-instruction");
  const cinematicBar = document.getElementById("cinematic-bar");
  const cinematicStepLabel = document.getElementById("cinematic-step-label");
  const btnSkipCinematic = document.getElementById("btn-skip-cinematic");

  const shotToast = document.getElementById("shot-toast");
  const toastEmoji = document.getElementById("toast-emoji");
  const toastTitle = document.getElementById("toast-title");
  const toastSubtitle = document.getElementById("toast-subtitle");

  // Pause DOM
  const btnPause = document.getElementById("btn-pause");
  const iconPause = document.getElementById("icon-pause");
  const pauseModal = document.getElementById("pause-modal");
  const pauseStreakVal = document.getElementById("pause-streak-val");
  const pauseTrackName = document.getElementById("pause-track-name");
  const btnPauseNextTrack = document.getElementById("btn-pause-next-track");
  const btnPauseResume = document.getElementById("btn-pause-resume");
  const btnPauseRestart = document.getElementById("btn-pause-restart");
  const btnPauseToMenu = document.getElementById("btn-pause-to-menu");

  // Game Over DOM
  const gameoverModal = document.getElementById("gameover-modal");
  const goTitle = document.getElementById("go-title");
  const goDesc = document.getElementById("go-desc");
  const goStatStreak = document.getElementById("go-stat-streak");
  const goStatLevel = document.getElementById("go-stat-level");
  const goStatRecord = document.getElementById("go-stat-record");
  const btnGoRetry = document.getElementById("btn-go-retry");
  const btnGoLevels = document.getElementById("btn-go-levels");

  // Modale Niveaux dédiée
  const levelsModalOverlay = document.getElementById("levels-modal-overlay");
  const btnOpenLevels = document.getElementById("btn-open-levels");
  const btnCloseLevels = document.getElementById("btn-close-levels");
  const btnResumeFromLevels = document.getElementById("btn-resume-from-levels");
  const levelsGrid = document.getElementById("levels-grid");
  const levelsBestStreak = document.getElementById("levels-best-streak");

  // Menu Général & Musique DOM
  const gameMenuOverlay = document.getElementById("game-menu-overlay");
  const btnOpenMenu = document.getElementById("btn-open-menu");
  const btnCloseMenu = document.getElementById("btn-close-menu");
  const btnResumeGame = document.getElementById("btn-resume-game");
  const btnSetDay = document.getElementById("btn-set-day");
  const btnSetNight = document.getElementById("btn-set-night");
  const btnSound = document.getElementById("btn-sound");
  const iconSound = document.getElementById("icon-sound");
  const btnMenuAudioToggle = document.getElementById("btn-menu-audio-toggle");
  const btnMenuRestart = document.getElementById("btn-menu-restart");
  const btnMenuIntro = document.getElementById("btn-menu-intro");

  const menuNowPlaying = document.getElementById("menu-now-playing");
  const menuLoopModeDesc = document.getElementById("menu-loop-mode-desc");
  const playlistContainer = document.getElementById("playlist-container");
  const btnMusicPrev = document.getElementById("btn-music-prev");
  const btnMusicPlayPause = document.getElementById("btn-music-playpause");
  const btnMusicNext = document.getElementById("btn-music-next");

  /* -------------------------------------------------------------------------- */
  /*  LECTEUR MUSICAL HTML5 (BOUCLE AUTO 3 CHANSONS + CHANGEMENT DE PISTE)      */
  /* -------------------------------------------------------------------------- */
  const bgMusic = new Audio();
  bgMusic.preload = "auto";
  bgMusic.volume = 0.58;

  function getTrackUrl(track: SongTrack): string {
    return `/audio/jeu/${encodeURIComponent(track.filename)}`;
  }

  function updateMusicUi() {
    const current = PLAYLIST[state.currentTrackIndex] || PLAYLIST[0];
    if (hudTrackShort) hudTrackShort.textContent = current.shortTitle;
    if (hudTrackMobile) hudTrackMobile.textContent = current.shortTitle;
    if (pauseTrackName) pauseTrackName.textContent = current.title;
    if (menuNowPlaying) menuNowPlaying.textContent = current.title;
    if (menuLoopModeDesc) {
      menuLoopModeDesc.textContent =
        state.loopMode === "top3"
          ? "🔁 Mode actif : Rotation en boucle des 3 chansons phares"
          : state.loopMode === "all"
            ? "🔁 Mode actif : Boucle sur les 5 chansons du dossier"
            : "🔂 Mode actif : Répétition de cette chanson en boucle";
    }
    renderPlaylistMenu();
  }

  function loadAndPlayTrack(index: number, showToast = false) {
    state.currentTrackIndex = ((index % PLAYLIST.length) + PLAYLIST.length) % PLAYLIST.length;
    const track = PLAYLIST[state.currentTrackIndex];
    bgMusic.src = getTrackUrl(track);
    updateMusicUi();

    if (state.audioEnabled) {
      bgMusic.play().then(() => {
        state.musicStarted = true;
      }).catch(() => {
        // Attendre la première interaction tactile si bloqué par l'autoplay mobile
      });
    }

    if (showToast && shotToast && toastTitle && toastSubtitle && toastEmoji && state.phase === "aiming") {
      toastEmoji.textContent = "🎵";
      toastTitle.textContent = track.shortTitle.toUpperCase();
      toastTitle.className = "font-display text-base sm:text-lg uppercase tracking-wider text-or leading-none";
      toastSubtitle.textContent = track.subtitle;
      shotToast.classList.remove("opacity-0", "-translate-y-4");
      setTimeout(() => {
        if (state.phase === "aiming") shotToast.classList.add("opacity-0", "-translate-y-4");
      }, 1500);
    }
  }

  function playNextTrack(manual = false) {
    if (!manual && state.loopMode === "single") {
      bgMusic.currentTime = 0;
      if (state.audioEnabled) bgMusic.play().catch(() => {});
      return;
    }

    if (!manual && state.loopMode === "top3") {
      // Tourner en boucle parmi les 3 premières chansons (0 -> 1 -> 2 -> 0)
      const nextTop3 = (state.currentTrackIndex + 1) % 3;
      loadAndPlayTrack(nextTop3, false);
    } else {
      const poolSize = state.loopMode === "top3" && !manual ? 3 : PLAYLIST.length;
      const nextIdx = (state.currentTrackIndex + 1) % poolSize;
      loadAndPlayTrack(nextIdx, manual);
    }
  }

  function playPrevTrack() {
    const prevIdx = (state.currentTrackIndex - 1 + PLAYLIST.length) % PLAYLIST.length;
    loadAndPlayTrack(prevIdx, true);
  }

  bgMusic.addEventListener("ended", () => {
    playNextTrack(false);
  });

  // Charger dès le départ « Oh Yaya ! Nos Léopards viennent célébrer la qualification »
  bgMusic.src = getTrackUrl(PLAYLIST[0]);

  function ensureMusicPlaying() {
    if (!state.audioEnabled) return;
    if (bgMusic.paused) {
      bgMusic.play().then(() => {
        state.musicStarted = true;
      }).catch(() => {});
    }
  }

  function renderPlaylistMenu() {
    if (!playlistContainer) return;
    playlistContainer.innerHTML = "";

    PLAYLIST.forEach((track, idx) => {
      const isCurrent = idx === state.currentTrackIndex;
      const row = document.createElement("button");
      row.type = "button";
      row.className = `flex w-full items-center justify-between gap-3 rounded-xl border p-3 text-left transition-all ${
        isCurrent
          ? "border-or bg-or/15 shadow-md"
          : "border-white/10 bg-black/35 hover:border-white/30 hover:bg-white/5"
      }`;

      row.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg ${
            isCurrent ? "bg-or text-slate-950 font-black" : "bg-white/10 text-slate-300 font-bold"
          } text-xs">
            ${isCurrent ? "▶" : idx + 1}
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <p class="truncate text-xs sm:text-sm font-bold ${isCurrent ? "text-or" : "text-white"}">${track.title}</p>
              ${
                track.inDefaultLoop
                  ? `<span class="shrink-0 rounded bg-emerald-500/20 border border-emerald-400/30 px-1.5 py-0.5 text-[0.52rem] font-bold uppercase text-emerald-300">Boucle 3 Hits</span>`
                  : ""
              }
            </div>
            <p class="truncate text-[0.65rem] text-slate-400">${track.subtitle}</p>
          </div>
        </div>
        <span class="shrink-0 text-[0.65rem] font-bold uppercase tracking-wider ${
          isCurrent ? "text-or" : "text-slate-400"
        }">
          ${isCurrent ? "En écoute" : "Choisir"}
        </span>
      `;

      row.addEventListener("click", () => {
        loadAndPlayTrack(idx, false);
      });

      playlistContainer.appendChild(row);
    });
  }

  // Boutons de contrôle musical
  btnNextTrackHud?.addEventListener("click", () => {
    initAudio();
    playNextTrack(true);
  });
  btnMobileTrackPill?.addEventListener("click", () => {
    initAudio();
    playNextTrack(true);
  });
  btnPauseNextTrack?.addEventListener("click", () => {
    initAudio();
    playNextTrack(true);
  });
  btnMusicNext?.addEventListener("click", () => {
    initAudio();
    playNextTrack(true);
  });
  btnMusicPrev?.addEventListener("click", () => {
    initAudio();
    playPrevTrack();
  });
  btnMusicPlayPause?.addEventListener("click", () => {
    initAudio();
    if (bgMusic.paused) {
      state.audioEnabled = true;
      bgMusic.play().catch(() => {});
      if (iconSound) iconSound.textContent = "🔊";
    } else {
      bgMusic.pause();
    }
  });

  const loopModeBtns = document.querySelectorAll<HTMLButtonElement>(".loop-mode-btn");
  loopModeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const m = (btn.dataset.loopMode || "top3") as "top3" | "all" | "single";
      state.loopMode = m;
      loopModeBtns.forEach((b) => {
        const active = b.dataset.loopMode === m;
        b.className = active
          ? "loop-mode-btn rounded-lg border border-or bg-or/20 px-2.5 py-1 text-[0.68rem] font-bold text-or"
          : "loop-mode-btn rounded-lg border border-white/15 bg-white/5 px-2.5 py-1 text-[0.68rem] font-bold text-slate-300 hover:text-white";
      });
      updateMusicUi();
    });
  });

  /* -------------------------------------------------------------------------- */
  /*  WEB AUDIO API (EFFETS SONORES : FRAPPE, POTEAU, FILET, ARRÊT, FOULE)      */
  /* -------------------------------------------------------------------------- */
  let audioCtx: AudioContext | null = null;

  function initAudio() {
    if (!audioCtx) {
      const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AC) audioCtx = new AC();
    }
    if (audioCtx && audioCtx.state === "suspended") audioCtx.resume();
    ensureMusicPlaying();
  }

  function playKickAudio(powerRatio: number) {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "triangle";
      osc.frequency.setValueAtTime(135 + powerRatio * 55, now);
      osc.frequency.exponentialRampToValueAtTime(28, now + 0.15);
      gain.gain.setValueAtTime(0.75, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.17);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.17);
    } catch {}
  }

  function playNetSwishAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const dur = 0.24;
      const bufSize = Math.floor(audioCtx.sampleRate * dur);
      const buf = audioCtx.createBuffer(1, bufSize, audioCtx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < bufSize; i++) data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufSize * 0.35));
      const src = audioCtx.createBufferSource();
      src.buffer = buf;
      const filter = audioCtx.createBiquadFilter();
      filter.type = "bandpass";
      filter.frequency.setValueAtTime(1900, now);
      filter.Q.value = 1.8;
      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.45, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + dur);
      src.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);
      src.start(now);
      src.stop(now + dur);
    } catch {}
  }

  function playPostAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      [740, 1210, 2380].forEach((f, i) => {
        const osc = audioCtx!.createOscillator();
        const gain = audioCtx!.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(f, now);
        gain.gain.setValueAtTime(0.32 / (i + 1), now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.48);
        osc.connect(gain);
        gain.connect(audioCtx!.destination);
        osc.start(now);
        osc.stop(now + 0.48);
      });
    } catch {}
  }

  function playSaveAudio() {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "sawtooth";
      osc.frequency.setValueAtTime(210, now);
      osc.frequency.exponentialRampToValueAtTime(55, now + 0.14);
      gain.gain.setValueAtTime(0.55, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.15);
    } catch {}
  }

  function playCrowdRoar(isGoal: boolean) {
    if (!state.audioEnabled || !audioCtx) return;
    try {
      const now = audioCtx.currentTime;
      const dur = isGoal ? 1.5 : 0.75;
      const bufSize = Math.floor(audioCtx.sampleRate * dur);
      const buf = audioCtx.createBuffer(1, bufSize, audioCtx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
      const src = audioCtx.createBufferSource();
      src.buffer = buf;

      const filter = audioCtx.createBiquadFilter();
      filter.type = "bandpass";
      filter.frequency.setValueAtTime(isGoal ? 550 : 310, now);
      filter.frequency.exponentialRampToValueAtTime(isGoal ? 1320 : 130, now + dur * 0.7);
      filter.Q.value = 1.5;

      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.01, now);
      gain.gain.linearRampToValueAtTime(isGoal ? 0.55 : 0.25, now + 0.18);
      gain.gain.exponentialRampToValueAtTime(0.008, now + dur);

      src.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);
      src.start(now);
      src.stop(now + dur);
    } catch {}
  }

