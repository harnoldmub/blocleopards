  const floodBeamMat = new THREE.ShaderMaterial({
    transparent: true,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
    side: THREE.DoubleSide,
    uniforms: {
      uColor: { value: new THREE.Color("#e9f2ff") },
      uOpacity: { value: 0.13 }
    },
    vertexShader: `
      varying float vY; varying vec3 vN; varying vec3 vV;
      void main(){
        vY = uv.y;
        vec4 mv = modelViewMatrix * vec4(position,1.0);
        vN = normalize(normalMatrix * normal);
        vV = normalize(-mv.xyz);
        gl_Position = projectionMatrix * mv;
      }
    `,
    fragmentShader: `
      uniform vec3 uColor; uniform float uOpacity;
      varying float vY; varying vec3 vN; varying vec3 vV;
      void main(){
        float core = pow(abs(dot(vN, vV)), 1.8);
        float fade = pow(vY, 1.5);
        gl_FragColor = vec4(uColor, core * fade * uOpacity);
      }
    `
  });

  const floodCones: THREE.Mesh[] = [];
  const mastAngles = [0.65, Math.PI - 0.65, Math.PI + 0.55, -0.55];
  const mastHeight = 48;
  mastAngles.forEach((a) => {
    const bx = (BOWL.rx + 26) * Math.cos(a);
    const bz = BOWL.centerZ + (BOWL.rz + 26) * Math.sin(a);
    const mast = new THREE.Mesh(
      new THREE.CylinderGeometry(0.45, 1.0, mastHeight, 8),
      new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.6 })
    );
    mast.position.set(bx, mastHeight / 2, bz);
    scene.add(mast);

    const headPanel = new THREE.Mesh(
      new THREE.BoxGeometry(9.5, 4.4, 0.9),
      new THREE.MeshBasicMaterial({ color: 0xf8fafc })
    );
    headPanel.position.set(bx, mastHeight, bz);
    headPanel.lookAt(0, 2, 5);
    scene.add(headPanel);

    const headPos = new THREE.Vector3(bx, mastHeight, bz);
    const targetPos = new THREE.Vector3(0, 0, 5);
    const dir = headPos.clone().sub(targetPos);
    const len = dir.length();
    const cone = new THREE.Mesh(new THREE.ConeGeometry(24, len, 32, 1, true), floodBeamMat);
    cone.position.copy(targetPos.clone().add(headPos).multiplyScalar(0.5));
    cone.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.normalize());
    scene.add(cone);
    floodCones.push(cone);
  });

  const flashCount = 450;
  const flashPos = new Float32Array(flashCount * 3);
  const flashSeeds = new Float32Array(flashCount);
  for (let i = 0; i < flashCount; i++) {
    const r = bowlRows[Math.floor(Math.random() * bowlRows.length)];
    const a = Math.random() * Math.PI * 2;
    flashPos.set(
      [(BOWL.rx + r.d + 0.4) * Math.cos(a), r.h + 1.1, BOWL.centerZ + (BOWL.rz + r.d + 0.4) * Math.sin(a)],
      i * 3
    );
    flashSeeds[i] = Math.random();
  }
  const flashGeo = new THREE.BufferGeometry();
  flashGeo.setAttribute("position", new THREE.BufferAttribute(flashPos, 3));
  flashGeo.setAttribute("aSeed", new THREE.BufferAttribute(flashSeeds, 1));
  const flashMat = new THREE.ShaderMaterial({
    transparent: true,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
    uniforms: { uTime: { value: 0 } },
    vertexShader: `
      uniform float uTime; attribute float aSeed; varying float vA;
      void main(){
        float flash = pow(max(0.0, sin(uTime * (0.8 + aSeed * 1.5) + aSeed * 50.0)), 40.0);
        float torch = 0.25 + 0.2 * sin(uTime * 1.5 + aSeed * 20.0);
        vA = max(flash, torch * 0.5);
        vec4 mv = modelViewMatrix * vec4(position, 1.0);
        gl_PointSize = 7.0 * (180.0 / -mv.z);
        gl_Position = projectionMatrix * mv;
      }
    `,
    fragmentShader: `
      varying float vA;
      void main(){
        float d = length(gl_PointCoord - 0.5);
        float a = smoothstep(0.5, 0.0, d);
        gl_FragColor = vec4(vec3(0.96, 0.98, 1.0), a * vA);
      }
    `
  });
  const crowdFlashes = new THREE.Points(flashGeo, flashMat);
