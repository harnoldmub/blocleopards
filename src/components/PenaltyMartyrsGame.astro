  function createKeeperJerseyTexture() {
    const cv = document.createElement("canvas");
    cv.width = 512;
    cv.height = 512;
    const ctx = cv.getContext("2d")!;

    // Fond maillot gardien pro vert émeraude / or / motifs géométriques
    const grad = ctx.createLinearGradient(0, 0, 0, 512);
    grad.addColorStop(0, "#f97316");
    grad.addColorStop(1, "#c2410c");
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 512, 512);

    // Motifs chevrons subtils sur le torse
    ctx.strokeStyle = "rgba(255, 255, 255, 0.12)";
    ctx.lineWidth = 14;
    for (let y = 80; y < 440; y += 55) {
      ctx.beginPath();
      ctx.moveTo(110, y);
      ctx.lineTo(256, y + 36);
      ctx.lineTo(402, y);
      ctx.stroke();
    }

    // Bandes épaules
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, 512, 34);

    // Numéro 1 officiel sur la poitrine
    ctx.fillStyle = "#ffffff";
    ctx.font = "900 130px sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText("1", 256, 235);

    const tex = new THREE.CanvasTexture(cv);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

  const keeperGroup = new THREE.Group();
