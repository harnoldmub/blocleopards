  // Fonction qui génère la texture d'un panneau publicitaire LED et y dessine les vrais logos chargés
  function createPartnerBoardTexture(adIndices: number[]) {
    const cv = document.createElement("canvas");
    cv.width = 2048;
    cv.height = 256;
    const ctx = cv.getContext("2d")!;
    const tex = new THREE.CanvasTexture(cv);
    tex.colorSpace = THREE.SRGBColorSpace;

    const slotW = cv.width / adIndices.length;

    function drawBase() {
      ctx.fillStyle = "#060d1f";
      ctx.fillRect(0, 0, cv.width, cv.height);

      adIndices.forEach((adIdx, i) => {
        const ad = PARTNER_ADS[adIdx % PARTNER_ADS.length];
        const x0 = i * slotW;

        // Liseré tricolore supérieur et inférieur
        ctx.fillStyle = ad.accent;
        ctx.fillRect(x0, 0, slotW, 14);
        ctx.fillStyle = "#f7d618";
        ctx.fillRect(x0, cv.height - 12, slotW, 12);

        // Cartouche blanc lumineux pour mettre parfaitement en valeur chaque logo partenaire
        ctx.fillStyle = ad.bg;
        ctx.fillRect(x0 + 18, 22, slotW - 36, cv.height - 42);

        // Texte de secours avant chargement de l'image
        ctx.fillStyle = "#081126";
        ctx.font = "900 30px sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(ad.name, x0 + slotW / 2, cv.height / 2);
      });
      tex.needsUpdate = true;
    }

    drawBase();

    // Charger chaque logo réel (PNG/WEBP) et l'incruster proprement dans son espace pub
    adIndices.forEach((adIdx, i) => {
      const ad = PARTNER_ADS[adIdx % PARTNER_ADS.length];
      const img = new Image();
      img.crossOrigin = "anonymous";
      img.onload = () => {
        const x0 = i * slotW;
        // Nettoyer le cartouche blanc
        ctx.fillStyle = ad.bg;
        ctx.fillRect(x0 + 18, 22, slotW - 36, cv.height - 42);

        const maxW = slotW - 80;
