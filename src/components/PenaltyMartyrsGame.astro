  function buildDefensiveWall(count: number, side: number) {
    while (wallGroup.children.length > 0) wallGroup.remove(wallGroup.children[0]);
    if (count <= 0) return;

    const defKit = new THREE.MeshStandardMaterial({ color: 0xbe123c, roughness: 0.55 });
    const startX = side * 1.1;
    for (let i = 0; i < count; i++) {
      const player = new THREE.Group();
      const torso = new THREE.Mesh(new THREE.CylinderGeometry(0.24, 0.20, 0.68, 14), defKit);
      torso.scale.set(1.1, 1, 0.65);
      torso.position.y = 1.24;
      torso.castShadow = true;
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.135, 14, 14), skinMat);
      head.position.y = 1.74;
      const shorts = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.34, 0.24), shortMat);
      shorts.position.y = 0.78;
      const legs = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.62, 0.20), skinMat);
      legs.position.y = 0.34;
      legs.castShadow = true;
      player.add(torso, head, shorts, legs);
      player.position.set(startX + (i - (count - 1) / 2) * 0.58, 0, 5.2);
      wallGroup.add(player);
    }
  }

  /* -------------------------------------------------------------------------- */
  /*  BALLON PBR "TRIONDA — BLOC LÉOPARDS" AVEC NORMAL MAP & JONCTIONS          */
  /* -------------------------------------------------------------------------- */
  const BALL_R = 0.142;

  function createTriondaBallMaps(): { diffuse: THREE.CanvasTexture; normal: THREE.CanvasTexture } {
    // 1. DIFFUSE MAP (1024x512) : Panneaux en onde type Adidas Trionda + graphisme Bloc Léopards
    const cv = document.createElement("canvas");
    cv.width = 1024;
    cv.height = 512;
    const ctx = cv.getContext("2d")!;

    const baseGrad = ctx.createLinearGradient(0, 0, 0, 512);
    baseGrad.addColorStop(0, "#ffffff");
    baseGrad.addColorStop(0.5, "#f8fafc");
    baseGrad.addColorStop(1, "#e2e8f0");
    ctx.fillStyle = baseGrad;
    ctx.fillRect(0, 0, 1024, 512);

    // 4 grands panneaux "Trionda" en vague dynamique aux couleurs RDC / Bloc Léopards
    for (let p = 0; p < 4; p++) {
      const cx = p * 256 + 128;

      // Vague extérieure Bleu Congo
      ctx.save();
      ctx.beginPath();
      ctx.moveTo(cx - 98, 95);
      ctx.bezierCurveTo(cx - 30, 35, cx + 80, 120, cx + 96, 256);
      ctx.bezierCurveTo(cx + 80, 392, cx - 30, 475, cx - 98, 415);
      ctx.bezierCurveTo(cx - 42, 345, cx + 22, 300, cx + 22, 256);
      ctx.bezierCurveTo(cx + 22, 212, cx - 42, 165, cx - 98, 95);
      ctx.closePath();
      ctx.fillStyle = "#0066cc";
      ctx.fill();
      ctx.lineWidth = 5;
      ctx.strokeStyle = "#0f172a";
      ctx.stroke();

      // Taches de léopard stylisées subtiles dans le ruban bleu
      ctx.fillStyle = "rgba(5, 15, 35, 0.35)";
      for (let r = 0; r < 7; r++) {
        ctx.beginPath();
        ctx.arc(cx - 10 + (r % 3) * 24, 150 + r * 34, 8, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      // Arche Or Impérial & Rouge Feu (Trionda Tri-Wave)
      ctx.strokeStyle = "#f7d618";
      ctx.lineWidth = 14;
      ctx.beginPath();
      ctx.arc(cx + 8, 256, 68, -Math.PI * 0.65, Math.PI * 0.65);
      ctx.stroke();

      ctx.strokeStyle = "#ce1021";
      ctx.lineWidth = 10;
      ctx.beginPath();
      ctx.arc(cx + 8, 256, 50, Math.PI * 0.45, Math.PI * 1.55);
      ctx.stroke();

      // Étoile centrale sombre pour rendre la vitesse de rotation (spin) immédiatement lisible
      ctx.fillStyle = "#0f172a";
      ctx.beginPath();
      ctx.arc(cx + 8, 256, 26, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = "#f7d618";
      ctx.beginPath();
      ctx.arc(cx + 8, 256, 10, 0, Math.PI * 2);
      ctx.fill();
    }

    // Sillons profonds de jonction des panneaux thermocollés (visibles au premier plan)
    ctx.strokeStyle = "rgba(15, 23, 42, 0.52)";
    ctx.lineWidth = 5.5;
    for (let p = 0; p < 4; p++) {
      const x0 = p * 256;
      ctx.beginPath();
      ctx.moveTo(x0, 0);
      ctx.bezierCurveTo(x0 + 64, 160, x0 - 64, 352, x0, 512);
      ctx.stroke();
    }
    ctx.beginPath();
    ctx.moveTo(0, 148);
    ctx.bezierCurveTo(256, 200, 768, 96, 1024, 148);
    ctx.moveTo(0, 364);
    ctx.bezierCurveTo(256, 312, 768, 416, 1024, 364);
    ctx.stroke();

    const diffuse = new THREE.CanvasTexture(cv);
    diffuse.colorSpace = THREE.SRGBColorSpace;
    diffuse.anisotropy = 4;

    // 2. NORMAL MAP (512x256) : Micro-grain "Speedshell" + sillons creusés des jonctions de panneaux
    const nCv = document.createElement("canvas");
    nCv.width = 512;
    nCv.height = 256;
    const nCtx = nCv.getContext("2d")!;
    nCtx.fillStyle = "rgb(128, 128, 255)";
    nCtx.fillRect(0, 0, 512, 256);

    // Micro-alvéoles d'adhérence aérodynamique sur toute la surface du cuir
    for (let y = 4; y < 252; y += 6) {
      for (let x = 4; x < 508; x += 6) {
        nCtx.fillStyle = "rgb(108, 148, 245)";
        nCtx.fillRect(x, y, 2, 2);
        nCtx.fillStyle = "rgb(148, 108, 245)";
        nCtx.fillRect(x + 1, y + 1, 2, 2);
      }
    }

    // Sillons normaux creusés le long des coutures thermocollées
    nCtx.lineWidth = 5;
    nCtx.strokeStyle = "rgb(75, 75, 210)";
    for (let p = 0; p < 4; p++) {
      const x0 = p * 128;
      nCtx.beginPath();
      nCtx.moveTo(x0, 0);
      nCtx.bezierCurveTo(x0 + 32, 80, x0 - 32, 176, x0, 256);
      nCtx.stroke();
    }
    nCtx.beginPath();
    nCtx.moveTo(0, 74);
    nCtx.bezierCurveTo(128, 100, 384, 48, 512, 74);
    nCtx.moveTo(0, 182);
    nCtx.bezierCurveTo(128, 156, 384, 208, 512, 182);
    nCtx.stroke();

    const normal = new THREE.CanvasTexture(nCv);
    normal.anisotropy = 4;

    return { diffuse, normal };
  }

