  function createPartnerBoardTexture(adIndices: number[], flipInsideCylinder = false) {
    const cv = document.createElement("canvas");
    cv.width = 2048;
    cv.height = 256;
    const ctx = cv.getContext("2d")!;
    const tex = new THREE.CanvasTexture(cv);
    tex.colorSpace = THREE.SRGBColorSpace;
    if (flipInsideCylinder) {
      tex.wrapS = THREE.RepeatWrapping;
      tex.repeat.x = -1;
      tex.offset.x = 1;
    }
    const slotW = cv.width / adIndices.length;

    function drawBase() {
      ctx.fillStyle = "#060d1f";
      ctx.fillRect(0, 0, cv.width, cv.height);
      adIndices.forEach((adIdx, i) => {
        const ad = PARTNER_ADS[adIdx % PARTNER_ADS.length];
        const x0 = i * slotW;
        ctx.fillStyle = ad.accent;
        ctx.fillRect(x0, 0, slotW, 14);
        ctx.fillStyle = "#f7d618";
        ctx.fillRect(x0, cv.height - 12, slotW, 12);
        ctx.fillStyle = ad.bg;
        ctx.fillRect(x0 + 16, 22, slotW - 32, cv.height - 42);
        ctx.fillStyle = "#081126";
        ctx.font = "900 30px sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(ad.name, x0 + slotW / 2, cv.height / 2);
      });
      tex.needsUpdate = true;
    }

    drawBase();

    adIndices.forEach((adIdx, i) => {
      const ad = PARTNER_ADS[adIdx % PARTNER_ADS.length];
      const img = new Image();
      img.crossOrigin = "anonymous";
      img.onload = () => {
        const x0 = i * slotW;
        ctx.fillStyle = ad.bg;
        ctx.fillRect(x0 + 16, 22, slotW - 32, cv.height - 42);
        const maxW = slotW - 64;
        const maxH = cv.height - 60;
        const scale = Math.min(maxW / img.width, maxH / img.height);
        const drawW = img.width * scale;
        const drawH = img.height * scale;
        ctx.drawImage(img, x0 + (slotW - drawW) / 2, 22 + (cv.height - 42 - drawH) / 2, drawW, drawH);
        tex.needsUpdate = true;
      };
      img.src = ad.src;
    });

    return tex;
  }

