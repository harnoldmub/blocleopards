  function createKeeperJerseyTexture(keeper: GoalkeeperProfile = getActiveKeeper()) {
    const cv = document.createElement("canvas");
    cv.width = 512;
    cv.height = 512;
    const ctx = cv.getContext("2d")!;

    const grad = ctx.createLinearGradient(0, 0, 0, 512);
    grad.addColorStop(0, keeper.shirtPrimary);
    grad.addColorStop(0.65, keeper.shirtSecondary);
    grad.addColorStop(1, "#090d16");
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 512, 512);

    // Motifs chevrons dynamiques de maillot gardien pro
    ctx.strokeStyle = "rgba(255, 255, 255, 0.16)";
    ctx.lineWidth = 10;
    for (let y = 64; y < 440; y += 48) {
      ctx.beginPath();
      ctx.moveTo(90, y);
      ctx.lineTo(256, y + 32);
      ctx.lineTo(422, y);
      ctx.stroke();
    }

    // Liserés épaules & numéro officiel du gardien sélectionné
    ctx.fillStyle = keeper.accentColor;
    ctx.fillRect(0, 0, 512, 26);
    ctx.fillStyle = "rgba(255, 255, 255, 0.92)";
    ctx.font = "900 105px Impact, sans-serif";
    ctx.textAlign = "center";
    ctx.fillText(String(keeper.number), 256, 255);

    const tex = new THREE.CanvasTexture(cv);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

