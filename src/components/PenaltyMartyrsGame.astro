    // On garantit au moins 11.2m de largeur visible sur la ligne de but (le but fait 7.32m -> ~2m de marge de chaque côté)
    const minGoalLineHalfWidth = isPortrait ? 5.65 : 7.4;
    const tanHalfHoriz = minGoalLineHalfWidth / camZ;
    const tanHalfVert = tanHalfHoriz / aspect;
    const computedFov = THREE.MathUtils.radToDeg(2 * Math.atan(tanHalfVert));

    camera.fov = THREE.MathUtils.clamp(computedFov, 46, 84);
    camera.aspect = aspect;
    camera.updateProjectionMatrix();

    if (state.phase === "aiming" || state.phase === "charging" || state.phase === "shooting" || state.phase === "result") {
