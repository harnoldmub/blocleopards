      desc: "Séance de 5 tirs : RDC menée 0–3 ! Marque 4 buts sur 5 (1 joueur en mur + vent 22 km/h).",
      keeperReactionSec: 0.024,
      keeperDiveSpeed: 13.6,
      keeperArmSpan: 1.37,
      keeperReadProb: 0.90,
      windMaxKmh: 22,
      wallPlayers: 1
    },
    {
      id: 4,
      name: "Demi-Finale",
      deficitLabel: "RDC menée 0 – 3",
      oppScore: 3,
      targetGoals: 4,
      desc: "Séance de 5 tirs : Mur de 2 défenseurs qui sautent + vent fort (28 km/h). Enroule tes tirs (4/5) !",
      keeperReactionSec: 0.016,
      keeperDiveSpeed: 15.0,
      keeperArmSpan: 1.43,
      keeperReadProb: 0.93,
      windMaxKmh: 28,
      wallPlayers: 2
    },
    {
      id: 5,
      name: "Finale 90ᵉ · Martyrs",
      deficitLabel: "RDC menée 0 – 4",
      oppScore: 4,
      targetGoals: 5,
      desc: "Séance de 5 tirs : Sans-faute exigé (5/5) face au « Mur de Kin » (3 défenseurs + rafales 36 km/h) !",
      keeperReactionSec: 0.009,
      keeperDiveSpeed: 16.5,
      keeperArmSpan: 1.48,
      keeperReadProb: 0.96,
      windMaxKmh: 36,
      wallPlayers: 3
    }
  ];

  /* -------------------------------------------------------------------------- */
  /*  ÉTAT DU JEU (SÉANCE DE 5 TIRS PAR NIVEAU)                                 */
  /* -------------------------------------------------------------------------- */
  const TOTAL_KICKS_PER_SERIES = 5;

  const state = {
    phase: "cinematic" as "cinematic" | "aiming" | "charging" | "shooting" | "result" | "gameover",
    paused: false,
    cinematicTime: 0,
    currentTierIndex: 0,
    maxUnlockedTier: Number(localStorage.getItem("sdm_max_tier") || 1),
    kickIndex: 0,                      // 0..4 (5 tirs par séance)
    kickHistory: [] as ("goal" | "miss")[],
    goalsInSeries: 0,
    windKmh: 0,
    wallSide: 1,
    isNight: true,
    audioEnabled: true,
    currentTrackIndex: Math.floor(Math.random() * PLAYLIST.length),
    loopMode: "single" as "top3" | "all" | "single",
    musicStarted: false
  };

  function getActiveTier(): LevelTier {
    return TIERS[state.currentTierIndex] || TIERS[0];
  }

  /* -------------------------------------------------------------------------- */
  /*  RÉFÉRENCES DOM                                                            */
  /* -------------------------------------------------------------------------- */
  const canvas = document.getElementById("penalty-canvas") as HTMLCanvasElement;
  const swipeCanvas = document.getElementById("swipe-trail-canvas") as HTMLCanvasElement;
  const swipeCtx = swipeCanvas.getContext("2d")!;

  const hudRdcScore = document.getElementById("hud-rdc-score");
  const hudOppScore = document.getElementById("hud-opp-score");
  const hudKickCounter = document.getElementById("hud-kick-counter");
  const hudFiveDots = document.getElementById("hud-five-dots");
  const hudLevelBadge = document.getElementById("hud-level-badge");
  const hudWindPill = document.getElementById("hud-wind-pill");
  const hudWindArrow = document.getElementById("hud-wind-arrow");
  const hudWindVal = document.getElementById("hud-wind-val");
  const hudCurvePill = document.getElementById("hud-curve-pill");
  const hudCurveLabel = document.getElementById("hud-curve-label");

  const hudTrackShort = document.getElementById("hud-track-short");
  const hudTrackMobile = document.getElementById("hud-track-mobile");
  const btnNextTrackHud = document.getElementById("btn-next-track-hud");
  const btnMobileTrackPill = document.getElementById("btn-mobile-track-pill");

  const powerMeterWrap = document.getElementById("power-meter-wrap");
  const powerMeterFill = document.getElementById("power-meter-fill");
  const powerMeterPct = document.getElementById("power-meter-pct");
  const aimInstruction = document.getElementById("aim-instruction");
  const cinematicBar = document.getElementById("cinematic-bar");
  const cinematicStepLabel = document.getElementById("cinematic-step-label");
  const btnSkipCinematic = document.getElementById("btn-skip-cinematic");

  const shotToast = document.getElementById("shot-toast");
  const toastEmoji = document.getElementById("toast-emoji");
  const toastTitle = document.getElementById("toast-title");
  const toastSubtitle = document.getElementById("toast-subtitle");

  // Pause DOM
  const btnPause = document.getElementById("btn-pause");
  const iconPause = document.getElementById("icon-pause");
  const pauseModal = document.getElementById("pause-modal");
  const pauseScoreSummary = document.getElementById("pause-score-summary");
  const pauseTrackName = document.getElementById("pause-track-name");
  const btnPauseNextTrack = document.getElementById("btn-pause-next-track");
  const btnPauseResume = document.getElementById("btn-pause-resume");
  const btnPauseRestart = document.getElementById("btn-pause-restart");
  const btnPauseToMenu = document.getElementById("btn-pause-to-menu");

  // Bilan de Séance DOM
  const gameoverModal = document.getElementById("gameover-modal");
  const goBadge = document.getElementById("go-badge");
  const goKicker = document.getElementById("go-kicker");
  const goTitle = document.getElementById("go-title");
  const goDesc = document.getElementById("go-desc");
  const goFiveRecap = document.getElementById("go-five-recap");
  const goStatScore = document.getElementById("go-stat-score");
  const goStatLevel = document.getElementById("go-stat-level");
  const goStatMade = document.getElementById("go-stat-made");
  const btnGoPrimary = document.getElementById("btn-go-primary");
  const btnGoLevels = document.getElementById("btn-go-levels");

  // Modale Niveaux dédiée
  const levelsModalOverlay = document.getElementById("levels-modal-overlay");
  const btnOpenLevels = document.getElementById("btn-open-levels");
  const btnCloseLevels = document.getElementById("btn-close-levels");
  const btnResumeFromLevels = document.getElementById("btn-resume-from-levels");
  const levelsGrid = document.getElementById("levels-grid");

  // Menu Général & Musique DOM
  const gameMenuOverlay = document.getElementById("game-menu-overlay");
  const btnOpenMenu = document.getElementById("btn-open-menu");
  const btnCloseMenu = document.getElementById("btn-close-menu");
  const btnResumeGame = document.getElementById("btn-resume-game");
  const btnSetDay = document.getElementById("btn-set-day");
  const btnSetNight = document.getElementById("btn-set-night");
  const btnSound = document.getElementById("btn-sound");
  const iconSound = document.getElementById("icon-sound");
  const btnMenuAudioToggle = document.getElementById("btn-menu-audio-toggle");
  const btnMenuRestart = document.getElementById("btn-menu-restart");
  const btnMenuIntro = document.getElementById("btn-menu-intro");

  const menuNowPlaying = document.getElementById("menu-now-playing");
  const menuLoopModeDesc = document.getElementById("menu-loop-mode-desc");
  const playlistContainer = document.getElementById("playlist-container");
  const btnMusicPrev = document.getElementById("btn-music-prev");
  const btnMusicPlayPause = document.getElementById("btn-music-playpause");
  const btnMusicNext = document.getElementById("btn-music-next");

  /* -------------------------------------------------------------------------- */
  /*  LECTEUR MUSICAL HTML5 (1 MUSIQUE ALÉATOIRE EN BOUCLE PAR DÉFAUT)          */
  /* -------------------------------------------------------------------------- */
  const bgMusic = new Audio();
  bgMusic.preload = "auto";
  bgMusic.volume = 0.58;
  bgMusic.loop = state.loopMode === "single";

  function getTrackUrl(track: SongTrack): string {
    return `/audio/jeu/${encodeURIComponent(track.filename)}`;
  }

  function updateMusicUi() {
    const current = PLAYLIST[state.currentTrackIndex] || PLAYLIST[0];
    bgMusic.loop = state.loopMode === "single";
    if (hudTrackShort) hudTrackShort.textContent = current.shortTitle;
    if (hudTrackMobile) hudTrackMobile.textContent = current.shortTitle;
    if (pauseTrackName) pauseTrackName.textContent = current.title;
    if (menuNowPlaying) menuNowPlaying.textContent = current.title;
    if (menuLoopModeDesc) {
      menuLoopModeDesc.textContent =
        state.loopMode === "single"
          ? "🔂 Mode actif : 1 musique choisie aléatoirement tourne en boucle"
          : "🔁 Mode actif : Boucle sur les 5 chansons du dossier";
    }
    renderPlaylistMenu();
  }

  function loadAndPlayTrack(index: number, showToast = false) {
    state.currentTrackIndex = ((index % PLAYLIST.length) + PLAYLIST.length) % PLAYLIST.length;
    const track = PLAYLIST[state.currentTrackIndex];
    bgMusic.src = getTrackUrl(track);
    bgMusic.loop = state.loopMode === "single";
    updateMusicUi();

    if (state.audioEnabled) {
      bgMusic.play().then(() => {
        state.musicStarted = true;
      }).catch(() => {});
    }

    if (showToast && shotToast && toastTitle && toastSubtitle && toastEmoji && state.phase === "aiming") {
      toastEmoji.textContent = "🎵";
      toastTitle.textContent = track.shortTitle.toUpperCase();
      toastTitle.className = "font-display text-base sm:text-lg uppercase tracking-wider text-or leading-none";
      toastSubtitle.textContent = `${track.subtitle} · En boucle`;
      shotToast.classList.remove("opacity-0", "-translate-y-4");
      setTimeout(() => {
        if (state.phase === "aiming") shotToast.classList.add("opacity-0", "-translate-y-4");
      }, 1500);
    }
  }

  function pickRandomOtherTrackIndex(): number {
    if (PLAYLIST.length <= 1) return 0;
    let candidate = state.currentTrackIndex;
    while (candidate === state.currentTrackIndex) {
      candidate = Math.floor(Math.random() * PLAYLIST.length);
    }
    return candidate;
  }

  function playNextTrack(manual = false) {
    if (!manual && state.loopMode === "single") {
      bgMusic.currentTime = 0;
      if (state.audioEnabled) bgMusic.play().catch(() => {});
      return;
    }

    if (manual && state.loopMode === "single") {
      // Choisit aléatoirement une autre chanson et la met en boucle
      loadAndPlayTrack(pickRandomOtherTrackIndex(), true);
    } else {
      const nextIdx = (state.currentTrackIndex + 1) % PLAYLIST.length;
      loadAndPlayTrack(nextIdx, manual);
    }
  }

  function playPrevTrack() {
    const prevIdx = (state.currentTrackIndex - 1 + PLAYLIST.length) % PLAYLIST.length;
    loadAndPlayTrack(prevIdx, true);
  }

  bgMusic.addEventListener("ended", () => {
    playNextTrack(false);
  });

  bgMusic.src = getTrackUrl(PLAYLIST[state.currentTrackIndex]);

  function ensureMusicPlaying() {
    if (!state.audioEnabled) return;
    if (bgMusic.paused) {
      bgMusic.play().then(() => {
        state.musicStarted = true;
      }).catch(() => {});
    }
  }

  function renderPlaylistMenu() {
    if (!playlistContainer) return;
    playlistContainer.innerHTML = "";

    PLAYLIST.forEach((track, idx) => {
      const isCurrent = idx === state.currentTrackIndex;
      const row = document.createElement("button");
      row.type = "button";
      row.className = `flex w-full items-center justify-between gap-3 rounded-xl border p-3 text-left transition-all ${
        isCurrent
          ? "border-or bg-or/15 shadow-md"
          : "border-white/10 bg-black/35 hover:border-white/30 hover:bg-white/5"
      }`;

      row.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg ${
            isCurrent ? "bg-or text-slate-950 font-black" : "bg-white/10 text-slate-300 font-bold"
          } text-xs">
            ${isCurrent ? "▶" : idx + 1}
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <p class="truncate text-xs sm:text-sm font-bold ${isCurrent ? "text-or" : "text-white"}">${track.title}</p>
              ${
                track.inDefaultLoop
                  ? `<span class="shrink-0 rounded bg-emerald-500/20 border border-emerald-400/30 px-1.5 py-0.5 text-[0.52rem] font-bold uppercase text-emerald-300">Boucle 3 Hits</span>`
                  : ""
