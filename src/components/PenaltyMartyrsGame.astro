  let netImpactActive = false;
  let netImpactX = 0;
  let netImpactY = 1.2;
  let netImpactStrength = 0;
  let netWaveTime = 0;

  function triggerNetDeformation(hitX: number, hitY: number, speed: number) {
    netImpactActive = true;
    netWaveTime = 0;
    netImpactX = THREE.MathUtils.clamp(hitX, -GOAL.width / 2 + 0.2, GOAL.width / 2 - 0.2);
    netImpactY = THREE.MathUtils.clamp(hitY, 0.2, GOAL.height - 0.2) - GOAL.height / 2;
    netImpactStrength = Math.min(0.88, Math.max(0.34, speed * 0.028));
    playNetSwishAudio();
  }

  function updateNetMesh(dt: number) {
    if (!netImpactActive) return;
    netWaveTime += dt;
    netImpactStrength = THREE.MathUtils.lerp(netImpactStrength, 0, dt * 3.8);
    const posAttr = netBackGeo.attributes.position as THREE.BufferAttribute;
    for (let i = 0; i < posAttr.count; i++) {
      const ox = netBackOrigPos[i * 3];
      const oy = netBackOrigPos[i * 3 + 1];
      const edgeFactorX = 1 - Math.pow(Math.abs(ox) / (GOAL.width / 2), 4);
      const edgeFactorY = 1 - Math.pow(Math.abs(oy) / (GOAL.height / 2), 4);
      const dist = Math.hypot(ox - netImpactX, oy - netImpactY);
      // Poche d'impact principale + onde concentrique qui se propage dans les mailles
      const pocket = Math.max(0, 1 - dist / 1.95);
      const ripple = 0.28 * Math.cos(dist * 6.8 - netWaveTime * 24.0) * Math.exp(-dist * 0.95);
      const pull = (pocket + ripple) * netImpactStrength * edgeFactorX * edgeFactorY;
      posAttr.setZ(i, -pull);
    }
    posAttr.needsUpdate = true;
    if (netImpactStrength < 0.008) {
      netImpactActive = false;
      for (let i = 0; i < posAttr.count; i++) posAttr.setZ(i, 0);
      posAttr.needsUpdate = true;
    }
  }

