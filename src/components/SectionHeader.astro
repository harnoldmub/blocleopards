---
const { title, eyebrow, description } = Astro.props;
---
<div class="mb-10 max-w-3xl" data-reveal>
  {eyebrow && <span class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-congo">{eyebrow}</span>}
  <h2 class="mt-3 font-display text-4xl uppercase leading-[0.95] text-congo-night md:text-5xl">{title}</h2>
  {description && <p class="mt-4 max-w-2xl leading-relaxed text-slate-600">{description}</p>}
</div>
