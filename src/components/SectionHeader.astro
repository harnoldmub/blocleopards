---
const { title, eyebrow, description } = Astro.props;
---
<div class="mb-8 max-w-3xl lg:mb-10">
  {eyebrow && <p class="bl-label text-[var(--bl-ink)]">{eyebrow}</p>}
  <h2 class="bl-title bl-title--lg mt-3 text-[var(--bl-ink)]">{title}</h2>
  {description && <p class="bl-lead mt-4 text-[var(--bl-ink-2)]">{description}</p>}
</div>
