---
const { title, description, url, noindex } = Astro.props;
const SITE = "https://blocleopards.com";
const canonical = url ?? SITE;

// Pas d'og:image / twitter:image ici volontairement : sur WhatsApp/iMessage/X,
// une image (meme carree) declenche un grand apercu en banniere. Sans image OG,
// ces plateformes retombent sur le favicon du site pour une petite vignette
// compacte -- cf. mubuanga.com, verifie en direct comme reference du comportement voulu.
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Bloc Léopards" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
