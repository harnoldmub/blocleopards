---
const { title, description, url, noindex } = Astro.props;
const SITE = "https://blocleopards.com";
const canonical = url ?? SITE;

// Image de partage : icone carree 256x256 (logo sur fond bleu nuit), identique
// sur toutes les pages. Sous 300 px de large, WhatsApp l'affiche en petite
// vignette a cote du titre (et non en grande banniere) ; twitter:card reste
// "summary". Ne pas remplacer par un visuel 1200x630 ni une photo produit.
const SHARE_ICON = `${SITE}/share-icon.png`;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Bloc Léopards" />
<meta property="og:image" content={SHARE_ICON} />
<meta property="og:image:secure_url" content={SHARE_ICON} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="256" />
<meta property="og:image:height" content="256" />
<meta property="og:image:alt" content="Logo du Bloc Léopards" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:image" content={SHARE_ICON} />
<meta name="twitter:image:alt" content="Logo du Bloc Léopards" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
