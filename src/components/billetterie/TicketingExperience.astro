    padding: 0.5rem 0;
    color: #fff;
    text-decoration: none;
  }
  .tk-brand-title { font-size: 1.05rem; font-weight: 800; letter-spacing: 0.16em; }
  .tk-brand-caption {
    display: none;
    color: #a9b9d3;
