  }
  .tk-header-right { display: flex; align-items: center; gap: 0.75rem; }
  .tk-campaign-logo { display: block; height: 1.5rem; width: auto; }
  .tk-help-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font-size: 0.875rem;
