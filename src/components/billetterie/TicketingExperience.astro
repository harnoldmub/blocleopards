---
import { requireDatabase, hasDatabase } from "../../lib/neon";
import Turnstile from "../Turnstile.astro";

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;

let reservationsCount = 0;
const totalCapacity = 1000;

if (hasDatabase) {
  try {
    const db = requireDatabase();
    const rows = await db`
      select count(*)::int as total
      from billetterie_reservations
      where status <> 'cancelled'
    `;
    reservationsCount = Number(rows[0]?.total || 0);
  } catch (error) {
    console.error("[billetterie] Impossible de récupérer le nombre de réservations:", error);
  }
}

const remainingPlaces = Math.max(0, totalCapacity - reservationsCount);
---

<div
  class="tk-mono-page"
  id="ticketing-root"
  data-lang={lang}
  data-total-capacity={totalCapacity}
  data-reservations-count={reservationsCount}
  data-remaining-places={remainingPlaces}
>
  <!-- ======================================================================= -->
  <!-- HEADER BLANC ÉPURÉ                                                      -->
  <!-- ======================================================================= -->
  <header class="tk-header">
    <div class="tk-header-inner">
      <div class="tk-brand">
        <a href="/sport" class="tk-brand-link">
          <span class="tk-brand-title">TIKEO</span>
          <span class="tk-brand-caption">BILLETTERIE OFFICIELLE</span>
        </a>
      </div>

      <div class="tk-header-right">
        <div class="tk-campaign-logos" aria-label="Campagne de qualification CAN 2027">
          <img src="/billetterie/Liste Bloc Léopards 2.png" alt="CAN 2027 Qualifiers" class="tk-campaign-logo tk-campaign-logo--qualifiers" />
        </div>
        <div class="tk-lang-box">
          <span class="tk-lang tk-lang--active">FR</span>
          <span class="tk-header-sep" aria-hidden="true">/</span>
          <a href="/en/billetterie" class="tk-lang">EN</a>
        </div>
      </div>
    </div>
  </header>

  <!-- ======================================================================= -->
  <!-- GRILLE PRINCIPALE (65% CONTENU / 35% RÉSUMÉ STICKY)                     -->
  <!-- ======================================================================= -->
  <main class="tk-layout-container">
    <div class="tk-mobile-intro">
      <div class="tk-mobile-kicker">RÉSERVER EN QUELQUES CLICS</div>
      <h1>Tikeo, votre place pour le match.</h1>
      <p>Choisissez vos billets. <strong>Les consignes de retrait et de paiement s’affichent directement à l'écran dès la validation.</strong></p>
    </div>
    <div class="tk-grid">

      <!-- =================================================================== -->
      <!-- COLONNE GAUCHE (65%) : MATCH + BILLETS + INFORMATIONS               -->
      <!-- =================================================================== -->
      <div class="tk-content-col">

        <!-- BANDEAU D'INFORMATION RETRAIT & PAIEMENT SUR LE SITE -->
        <div class="tk-trust-callout">
          <div class="tk-trust-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
          </div>
          <div class="tk-trust-text">
            <strong>Réservation sans paiement en ligne :</strong> Réservez vos places sans rien payer maintenant. Dès la validation de vos informations, le lieu de retrait et les détails de paiement s’afficheront directement sur votre écran.
          </div>
        </div>

        <!-- ----------------------------------------------------------------- -->
        <!-- 1 — MATCH COMPACT                                                 -->
        <!-- ----------------------------------------------------------------- -->
        <section class="tk-card tk-card--match" aria-labelledby="match-heading">
          <div class="tk-match-eyebrow">
            <span class="tk-pill-tag">ÉLIMINATOIRES CAN 2027</span>
            <span class="tk-round-tag">JOURNÉE 1</span>
          </div>

          <div class="tk-fixture-row">
            <!-- RDC -->
            <div class="tk-fixture-team">
              <img src="/flags/cd.svg" alt="Drapeau RDC" class="tk-flag-img" />
              <div class="tk-team-meta">
                <span class="tk-team-code">RDC</span>
                <span class="tk-team-name">Rép. démocratique du Congo</span>
              </div>
            </div>

            <!-- VS -->
            <span class="tk-fixture-vs" aria-hidden="true">VS</span>

            <!-- GUINÉE ÉQUATORIALE -->
            <div class="tk-fixture-team tk-fixture-team--away">
              <img src="/flags/gq.svg" alt="Drapeau Guinée équatoriale" class="tk-flag-img" />
              <div class="tk-team-meta">
                <span class="tk-team-code">GUINÉE ÉQUATORIALE</span>
                <span class="tk-team-name">Nzalang Nacional</span>
              </div>
            </div>
          </div>

          <div class="tk-fixture-footer">
            <div class="tk-fixture-info-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              <span>Jeudi 24 septembre 2026 · 17:00</span>
            </div>
            <span class="tk-dot-sep" aria-hidden="true">•</span>
            <div class="tk-fixture-info-item">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Stade des Martyrs · Kinshasa</span>
            </div>
          </div>
        </section>

        <!-- ----------------------------------------------------------------- -->
        <!-- 2 — VOS BILLETS                                                   -->
        <!-- ----------------------------------------------------------------- -->
        <section class="tk-card tk-card--tickets" aria-labelledby="tickets-title">
          <div class="tk-section-header">
            <h2 id="tickets-title" class="tk-section-title">VOS BILLETS</h2>
          <span class="tk-max-tag">Maximum 4 billets par commande</span>
          </div>
          <p class="tk-section-helper">Un billet = une entrée au Stade des Martyrs.</p>

          <div class="tk-ticket-row">
            <div class="tk-ticket-info">
              <div class="tk-ticket-name-wrap">
                <span class="tk-ticket-name">STANDARD</span>
              </div>
              <div class="tk-ticket-sub">Tribune latérale · Placement libre</div>
            </div>

            <div class="tk-ticket-pricing">
              <div class="tk-price-val">69 000 FC</div>
              <div class="tk-counter" role="group" aria-label="Quantité de billets">
                <button type="button" class="tk-counter-btn" id="btn-minus" aria-label="Diminuer" disabled>−</button>
                <span class="tk-counter-num" id="display-qty" aria-live="polite">1</span>
                <button type="button" class="tk-counter-btn" id="btn-plus" aria-label="Augmenter">+</button>
              </div>
            </div>
          </div>
        </section>

        <!-- ----------------------------------------------------------------- -->
        <!-- 3 — VOS INFORMATIONS (DIRECTEMENT SOUS LES BILLETS)               -->
        <!-- ----------------------------------------------------------------- -->
        <section class="tk-card tk-card--info" aria-labelledby="info-title">
          <div class="tk-section-header">
            <h2 id="info-title" class="tk-section-title">VOS INFORMATIONS</h2>
            <span class="tk-required-legend">* Champs obligatoires</span>
          </div>
          <p class="tk-section-helper">Ces informations servent uniquement à confirmer votre réservation.</p>

          <form id="mono-checkout-form" novalidate class="tk-form">
            <div class="tk-form-grid">
              <!-- PRÉNOM -->
              <div class="tk-form-group" data-field="prenom">
                <label for="inp-prenom" class="tk-label">PRÉNOM *</label>
                <input
                  type="text"
                  id="inp-prenom"
                  name="prenom"
                  autocomplete="given-name"
                  required
                  class="tk-input"
                />
                <span class="tk-error-text" id="err-prenom" aria-live="polite"></span>
              </div>

              <!-- NOM -->
              <div class="tk-form-group" data-field="nom">
                <label for="inp-nom" class="tk-label">NOM *</label>
                <input
                  type="text"
                  id="inp-nom"
                  name="nom"
                  autocomplete="family-name"
                  required
                  class="tk-input"
                />
                <span class="tk-error-text" id="err-nom" aria-live="polite"></span>
              </div>

              <!-- NUMÉRO DE TÉLÉPHONE (WHATSAPP) -->
              <div class="tk-form-group" data-field="phone">
                <label for="inp-phone" class="tk-label">NUMÉRO DE TÉLÉPHONE (WHATSAPP) *</label>
                <input
                  type="tel"
                  id="inp-phone"
                  name="phone"
                  autocomplete="tel"
                  required
                  class="tk-input"
                  placeholder="+243 ..."
                />
                <span class="tk-error-text" id="err-phone" aria-live="polite"></span>
              </div>

              <!-- PAYS DE RÉSIDENCE -->
              <div class="tk-form-group" data-field="country">
                <label for="inp-country" class="tk-label">PAYS DE RÉSIDENCE *</label>
                <select id="inp-country" name="country" required class="tk-input tk-select">
                  <option value="" disabled selected>Sélectionnez votre pays</option>
                  <option value="République Démocratique du Congo">République Démocratique du Congo (RDC)</option>
                  <option value="Guinée Équatoriale">Guinée Équatoriale</option>
                  <option value="France">France</option>
                  <option value="Belgique">Belgique</option>
                  <option value="Suisse">Suisse</option>
                  <option value="Canada">Canada</option>
                  <option value="États-Unis">États-Unis</option>
                  <option value="Royaume-Uni">Royaume-Uni</option>
                  <option value="Afrique du Sud">Afrique du Sud</option>
                  <option value="Congo-Brazzaville">Congo-Brazzaville</option>
                  <option value="Angola">Angola</option>
                  <option value="Autre pays">Autre pays</option>
                </select>
                <span class="tk-error-text" id="err-country" aria-live="polite"></span>
              </div>

              <!-- PROTECTION CLOUDFLARE TURNSTILE & ANTI-BOT -->
              <input type="text" name="_hp" tabindex="-1" autocomplete="off" style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0;" aria-hidden="true" />
              <div class="tk-turnstile-wrap">
                <Turnstile />
              </div>
            </div>
          </form>
        </section>

      </div>

      <!-- =================================================================== -->
      <!-- COLONNE DROITE (35%) : RÉSUMÉ STICKY "VOTRE COMMANDE"               -->
      <!-- =================================================================== -->
      <aside class="tk-summary-col">
        <div class="tk-summary-card">
          <h2 class="tk-summary-title">VOTRE COMMANDE</h2>

          <!-- RAPPEL DU MATCH -->
          <div class="tk-sum-match">
            <div class="tk-sum-teams">RDC <span class="tk-sum-vs">vs</span> GUINÉE ÉQUATORIALE</div>
            <div class="tk-sum-date">24 SEPTEMBRE 2026 · 17:00</div>
            <div class="tk-sum-stadium">Stade des Martyrs · Kinshasa</div>
          </div>

          <hr class="tk-divider" />

          <!-- DÉTAIL DES BILLETS -->
          <div class="tk-sum-item">
            <div class="tk-sum-item-header">
              <span class="tk-sum-item-name">STANDARD</span>
              <span class="tk-sum-item-subtotal" id="sum-item-subtotal">69 000 FC</span>
            </div>
            <div class="tk-sum-item-calc" id="sum-item-calc">1 × 69 000 FC</div>
          </div>


          <hr class="tk-divider" />

          <!-- TOTAL -->
          <div class="tk-sum-total-row">
            <span class="tk-sum-total-lbl">TOTAL</span>
            <span class="tk-sum-total-amount" id="sum-total-amount">69 000 FC</span>
          </div>

          <!-- RAPPEL PAIEMENT & RETRAIT -->
          <div class="tk-sum-reassurance">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Lieu de retrait et paiement affichés à l’écran dès la validation.</span>
          </div>

          <!-- BOUTON D'ACTION PRINCIPAL -->
          <button
            type="button"
            class="tk-btn-submit"
            id="btn-validate-order"
            disabled
          >
            <span class="tk-inline-spinner" id="btn-spinner" aria-hidden="true"></span>
            <span id="btn-text">RÉSERVER MA PLACE →</span>
          </button>

        </div>
      </aside>

    </div>
  </main>

  <!-- ======================================================================= -->
  <!-- BOTTOM ACTION BAR POUR MOBILE (STICKY)                                  -->
  <!-- ======================================================================= -->
  <div class="tk-mobile-sticky-bar" id="mobile-bar">
    <div class="tk-mobile-bar-content">
      <div class="tk-mobile-total-box">
        <span class="tk-mobile-total-caption">TOTAL</span>
        <span class="tk-mobile-total-val" id="mobile-total-val">69 000 FC</span>
      </div>
      <button type="button" class="tk-btn-submit tk-btn-submit--mobile" id="btn-mobile-validate" disabled>
        <span id="btn-mobile-text">RÉSERVER</span>
      </button>
    </div>
  </div>
  <div class="tk-tension-toast" id="tension-toast" role="status" aria-live="polite"><span id="tension-toast-text"></span></div>

  <!-- ======================================================================= -->
  <!-- TRAITEMENT EN COURS / CHARGEMENT INFINI ("SITE QUI RAME")               -->
  <!-- ======================================================================= -->
  <div class="tk-loading-backdrop" id="loading-backdrop" aria-live="assertive" aria-hidden="true">
    <div class="tk-loading-modal">
      <div class="tk-loading-kicker">RDC — GUINÉE ÉQUATORIALE</div>
      <h2 class="tk-loading-title" id="loading-title">BILLETTERIE TRÈS SOLLICITÉE</h2>

      <div class="tk-spinner-ring" aria-hidden="true"></div>

      <p class="tk-loading-message" id="loading-msg">
        Il y a actuellement beaucoup de monde dans la billetterie.
      </p>

      <p class="tk-patience-note" id="patience-note">
        Votre demande est bien prise en compte. Merci de patienter quelques instants sans fermer cette page.
      </p>
    </div>
  </div>
  <section class="tk-confirmation" id="ticket-confirmation" aria-live="polite" aria-hidden="true">
    <div class="tk-confirmation-card">
      <button type="button" class="tk-confirmation-close" id="close-confirmation" aria-label="Fermer le récapitulatif">×</button>
      <p class="tk-confirmation-kicker">RÉSERVATION ENREGISTRÉE</p>
      <h2>Votre pré-réservation est enregistrée</h2>
      <p class="tk-confirmation-match">RDC <span>vs</span> GUINÉE ÉQUATORIALE</p>
      <p class="tk-confirmation-meta">Jeudi 24 septembre 2026 · 17:00<br />Stade des Martyrs · Kinshasa</p>
      <div class="tk-confirmation-pickup"><span>RETRAIT DU BILLET</span><strong>Stade Tata Raphaël à 10 h</strong><small>Paiement sur place lors du retrait</small></div>
      <p class="tk-booking-label">N° DE DOSSIER</p>
      <strong class="tk-booking-number" id="booking-number"></strong>
      <img class="tk-booking-qr" id="booking-qr" alt="QR code de réservation" width="220" height="220" />
      <p class="tk-confirmation-note">Votre pré-réservation est bien enregistrée. Rendez-vous demain à 10 h au Stade Tata Raphaël pour effectuer le paiement sur place et retirer votre billet. Présentez votre numéro de dossier et votre QR code.</p>
      <div class="tk-confirmation-actions"><button type="button" id="download-card">Télécharger ma carte PNG</button></div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- MODALE D'AIDE : RETRAIT ET PAIEMENT DES BILLETS (#aide)                 -->
  <!-- ======================================================================= -->
  <aside
    class="tk-help-modal-backdrop"
    id="help-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="help-modal-title"
    aria-hidden="true"
  >
    <div class="tk-help-modal-card">
      <button
        type="button"
        class="tk-help-modal-close"
        id="btn-close-help"
        aria-label="Fermer la fenêtre d'aide"
      >×</button>

      <div class="tk-help-modal-header">
        <span class="tk-help-kicker">INFORMATIONS & RETRAIT</span>
        <h2 id="help-modal-title">Où récupérer et payer vos billets ?</h2>
      </div>

      <div class="tk-help-notice-box">
        <div class="tk-help-notice-icon" aria-hidden="true">💡</div>
        <p><strong>Aucun paiement en ligne requis aujourd’hui.</strong> Vous effectuez votre réservation sans rien payer sur le site. Dès que vous validez votre formulaire, toutes les informations pratiques (lieu de retrait physique, horaires et modalités de paiement sur place) s'affichent instantanément à l'écran.</p>
      </div>

      <div class="tk-help-steps">
        <div class="tk-help-step">
          <div class="tk-help-step-num">1</div>
          <div class="tk-help-step-body">
            <strong>1. Réservez vos places en ligne (0 FC)</strong>
            <p>Sélectionnez votre nombre de billets et renseignez vos informations (prénom, nom, numéro de téléphone). Aucun compte bancaire ni carte n'est requis.</p>
          </div>
        </div>

        <div class="tk-help-step">
          <div class="tk-help-step-num">2</div>
          <div class="tk-help-step-body">
            <strong>2. Affichage instantané des consignes</strong>
            <p>Dès la validation de vos coordonnées, votre écran affiche immédiatement votre récapitulatif complet : le lieu officiel de retrait (Stade Tata Raphaël), l'horaire précis, votre numéro de dossier unique et votre QR code officiel.</p>
          </div>
        </div>

        <div class="tk-help-step">
          <div class="tk-help-step-num">3</div>
          <div class="tk-help-step-body">
            <strong>3. Retrait du billet physique et paiement sur place</strong>
            <p>Présentez votre numéro de dossier ou votre QR code (vous pouvez télécharger votre carte d'un clic) au point de retrait indiqué pour payer et récupérer vos billets en main propre.</p>
          </div>
        </div>
      </div>

      <div class="tk-help-modal-footer">
        <button type="button" class="tk-btn-help-ok" id="btn-ok-help">J'ai compris →</button>
      </div>
    </div>
  </aside>
</div>

<!-- ========================================================================= -->
<!-- SCRIPTS CLIENTS : REACTIVITÉ, VALIDATION EN DIRECT & CHARGEMENT INFINI    -->
<!-- ========================================================================= -->
<script lang="ts">
  function initMonoPageCheckout() {
    const root = document.getElementById('ticketing-root');
    if (!root) return;

    // --- State ---
    let quantity = 1;
    const unitPrice = 69000;
    const formatPrice = (amount) => `${amount.toLocaleString('fr-FR')} FC`;
    const totalCapacity = Number(root.dataset.totalCapacity || 1000);
    let reservationsCount = Number(root.dataset.reservationsCount || 0);
    let remainingPlaces = Math.max(0, Number(root.dataset.remainingPlaces ?? (totalCapacity - reservationsCount)));
    const stockKey = 'tikeo-demo-stock-v2';
    const getStock = () => {
      const stored = localStorage.getItem(stockKey);
      if (stored !== null && !isNaN(Number(stored))) {
        return Math.max(0, Math.min(Number(stored), remainingPlaces));
      }
      return remainingPlaces;
    };
    const minQty = 1;
    const maxQty = 4;

    // --- Elements ---
    const btnMinus = document.getElementById('btn-minus');
    const btnPlus = document.getElementById('btn-plus');
    const displayQty = document.getElementById('display-qty');
    const sumItemCalc = document.getElementById('sum-item-calc');
    const sumItemSubtotal = document.getElementById('sum-item-subtotal');
    const sumTotalAmount = document.getElementById('sum-total-amount');
    const mobileTotalVal = document.getElementById('mobile-total-val');
    const tensionToast = document.getElementById('tension-toast');
    const tensionToastText = document.getElementById('tension-toast-text');

    const checkoutForm = document.getElementById('mono-checkout-form');
    const btnValidateOrder = document.getElementById('btn-validate-order');
    const btnMobileValidate = document.getElementById('btn-mobile-validate');
    const btnText = document.getElementById('btn-text');
    const btnMobileText = document.getElementById('btn-mobile-text');
    const btnSpinner = document.getElementById('btn-spinner');

    let isSubmitting = false;
    let currentBookingId = '';
    let currentQrData = '';

    const inpPrenom = document.getElementById('inp-prenom');
    const inpNom = document.getElementById('inp-nom');
    const inpPhone = document.getElementById('inp-phone');
    const inpCountry = document.getElementById('inp-country');

    const loadingBackdrop = document.getElementById('loading-backdrop');
    const loadingMsg = document.getElementById('loading-msg');
    const loadingTitle = document.getElementById('loading-title');
    const patienceNote = document.getElementById('patience-note');
    const confirmation = document.getElementById('ticket-confirmation');
    const bookingNumber = document.getElementById('booking-number');
    const bookingQr = document.getElementById('booking-qr');
    const downloadCard = document.getElementById('download-card');
    const closeConfirmation = document.getElementById('close-confirmation');

    const helpModal = document.getElementById('help-modal');
    const btnHelpModal = document.getElementById('btn-help-modal');
    const linkTrustHelp = document.getElementById('link-trust-help');
    const btnCloseHelp = document.getElementById('btn-close-help');
    const btnOkHelp = document.getElementById('btn-ok-help');

    function openHelpModal(e?: Event) {
      if (e) e.preventDefault();
      helpModal?.classList.add('tk-help-modal--visible');
      helpModal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (window.location.hash !== '#aide') {
        history.replaceState(null, '', window.location.pathname + window.location.search + '#aide');
      }
    }

    function closeHelpModal() {
      helpModal?.classList.remove('tk-help-modal--visible');
      helpModal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (window.location.hash === '#aide') {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    }

    btnHelpModal?.addEventListener('click', openHelpModal);
    linkTrustHelp?.addEventListener('click', openHelpModal);
    btnCloseHelp?.addEventListener('click', closeHelpModal);
    btnOkHelp?.addEventListener('click', closeHelpModal);

    helpModal?.addEventListener('click', (e) => {
      if (e.target === helpModal) closeHelpModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && helpModal?.classList.contains('tk-help-modal--visible')) {
        closeHelpModal();
      }
    });

    // Ouvrir automatiquement si l'URL contient #aide
    if (window.location.hash === '#aide') {
      openHelpModal();
    }
    window.addEventListener('hashchange', () => {
      if (window.location.hash === '#aide') {
        openHelpModal();
      } else if (helpModal?.classList.contains('tk-help-modal--visible')) {
        closeHelpModal();
      }
    });

    closeConfirmation?.addEventListener('click', () => {
      confirmation?.classList.remove('tk-confirmation--visible');
      confirmation?.setAttribute('aria-hidden', 'true');
      isSubmitting = false;
      if (btnText) btnText.textContent = 'RÉSERVER MA PLACE →';
      if (btnMobileText) btnMobileText.textContent = 'RÉSERVER';
      checkValidity();
    });

    function resetForm() {
      if (checkoutForm && typeof checkoutForm.reset === 'function') {
        checkoutForm.reset();
      }
      if (inpPrenom) inpPrenom.value = '';
      if (inpNom) inpNom.value = '';
      if (inpPhone) inpPhone.value = '';
      if (inpCountry) inpCountry.selectedIndex = 0;

      document.querySelectorAll('.tk-form-group--error').forEach((grp) => {
        grp.classList.remove('tk-form-group--error');
      });
      document.querySelectorAll('.tk-error-text').forEach((span) => {
        span.textContent = '';
      });

      quantity = 1;
      updatePrices();

      if (btnSpinner) btnSpinner.style.display = 'none';
      if (btnValidateOrder) {
        btnValidateOrder.disabled = true;
        btnValidateOrder.classList.remove('tk-btn-submit--loading');
      }
      if (btnMobileValidate) {
        btnMobileValidate.disabled = true;
        btnMobileValidate.classList.remove('tk-btn-submit--loading');
      }

      if ((window as any).turnstile && typeof (window as any).turnstile.reset === 'function') {
        try {
          (window as any).turnstile.reset();
        } catch (_) {}
      }
    }

    // --- Update Quantities & Prices ---
    function updatePrices() {
      const total = quantity * unitPrice;
      if (displayQty) displayQty.textContent = String(quantity);
      if (sumItemCalc) sumItemCalc.textContent = `${quantity} × ${formatPrice(unitPrice)}`;
      if (sumItemSubtotal) sumItemSubtotal.textContent = formatPrice(total);
      if (sumTotalAmount) sumTotalAmount.textContent = formatPrice(total);
      if (mobileTotalVal) mobileTotalVal.textContent = formatPrice(total);

      if (btnMinus) btnMinus.disabled = quantity <= minQty;
      if (btnPlus) btnPlus.disabled = quantity >= maxQty;
    }

    function updateStock() {
      const stock = Math.max(0, getStock());
      const soldOut = stock === 0;
      const label = stock === 1 ? '1 place restante' : `${stock.toLocaleString('fr-FR')} places restantes`;
      let urgency = 'PLACES DISPONIBLES';
      if (stock === 0) urgency = 'SOLD OUT';
      else if (stock <= 10) urgency = `PLUS QUE ${stock} PLACES DISPONIBLES`;
      else if (stock <= 20) urgency = `PRESQUE COMPLET — ${stock} PLACES RESTANTES`;
      else if (stock <= 50) urgency = `DERNIÈRES PLACES — ${stock} RESTANTES`;
      else if (stock <= 100) urgency = 'MOINS DE 100 PLACES DISPONIBLES';
      else urgency = `FORTE DEMANDE — PLUS QUE ${stock.toLocaleString('fr-FR')} PLACES`;
      if (mobileTotalVal) mobileTotalVal.textContent = formatPrice(quantity * unitPrice);
      if (soldOut) {
        if (btnPlus) btnPlus.disabled = true;
        if (btnMinus) btnMinus.disabled = true;
        if (btnValidateOrder) { btnValidateOrder.disabled = true; btnValidateOrder.textContent = 'SOLD OUT'; }
        if (btnMobileValidate) { btnMobileValidate.disabled = true; btnMobileValidate.textContent = 'SOLD OUT'; }
      }
    }

    function showTensionToast(message, kind) {
      if (!tensionToast || !tensionToastText) return;
      tensionToast.classList.remove('tk-tension-toast--visible');
      window.setTimeout(() => {
        tensionToastText.textContent = message;
        tensionToast.classList.remove('tk-tension-toast--demand');
        tensionToast.classList.add('tk-tension-toast--visible');
        window.setTimeout(() => tensionToast.classList.remove('tk-tension-toast--visible'), 5000);
      }, 260);
    }

    function updateOnlineDemo() {
      const connected = Math.floor(Math.random() * 151) + 300;
      const stock = Math.max(0, getStock());
      showTensionToast(`👥 ${connected} personnes consultent la billetterie`, 'online');
      const placesText = stock <= 0
        ? 'SOLD OUT'
        : `🔥 Forte demande — plus que ${stock === 1 ? '1 place' : `${stock.toLocaleString('fr-FR')} places`}`;
      window.setTimeout(() => showTensionToast(placesText, 'demand'), 5600);
    }

    async function syncDynamicStock() {
      try {
        const res = await fetch('/api/billetterie/reservations');
        if (res.ok) {
          const data = await res.json();
          if (typeof data.remainingPlaces === 'number') {
            remainingPlaces = Math.max(0, data.remainingPlaces);
            updateStock();
          }
        }
      } catch (err) {
        // Silencieux
      }
    }

    btnMinus?.addEventListener('click', () => {
      if (quantity > minQty) {
        quantity--;
        updatePrices();
      }
    });

    btnPlus?.addEventListener('click', () => {
      if (quantity < maxQty) {
        quantity++;
        updatePrices();
      }
    });

    // --- Real-time Front-end Validation ---
    function checkValidity() {
      const phoneRegex = /^[\d\s\+\(\)\-\.]{7,20}$/;

      const p = (inpPrenom?.value || '').trim();
      const n = (inpNom?.value || '').trim();
      const ph = (inpPhone?.value || '').trim();
      const c = (inpCountry?.value || '').trim();

      const validP = p.length >= 2;
      const validN = n.length >= 2;
      const validPh = phoneRegex.test(ph);
      const validC = c.length > 0;

      if (isSubmitting) return false;
      const isAllValid = validP && validN && validPh && validC;

      // Enable / Disable buttons
      if (btnValidateOrder) btnValidateOrder.disabled = !isAllValid;
      if (btnMobileValidate) btnMobileValidate.disabled = !isAllValid;

      return isAllValid;
    }

    // Input error feedback on blur / typing
    function setupFieldFeedback(
      input,
      errId,
      validator
    ) {
      if (!input) return;
      const errSpan = document.getElementById(errId);
      const group = input.closest('.tk-form-group');

      const handleValidate = () => {
        if (!input.value && !input.matches(':focus')) {
          // don't show error immediately on empty field before interaction
          return;
        }
        const res = validator();
        if (!res.valid && input.value.trim().length > 0) {
          if (errSpan) errSpan.textContent = res.msg;
          group?.classList.add('tk-form-group--error');
        } else {
          if (errSpan) errSpan.textContent = '';
          group?.classList.remove('tk-form-group--error');
        }
        checkValidity();
      };

      input.addEventListener('input', () => {
        checkValidity();
        if (group?.classList.contains('tk-form-group--error')) {
          handleValidate();
        }
      });
      input.addEventListener('blur', handleValidate);
    }

    setupFieldFeedback(inpPrenom, 'err-prenom', () => ({
      valid: (inpPrenom?.value.trim().length || 0) >= 2,
      msg: 'Prénom requis (min. 2 caractères)'
    }));

    setupFieldFeedback(inpNom, 'err-nom', () => ({
      valid: (inpNom?.value.trim().length || 0) >= 2,
      msg: 'Nom requis (min. 2 caractères)'
    }));



    setupFieldFeedback(inpPhone, 'err-phone', () => ({
      valid: /^[\d\s\+\(\)\-\.]{7,20}$/.test(inpPhone?.value.trim() || ''),
      msg: 'Numéro de téléphone requis'
    }));

    setupFieldFeedback(inpCountry, 'err-country', () => ({
      valid: (inpCountry?.value.trim().length || 0) > 0,
      msg: 'Veuillez sélectionner un pays'
    }));

    // --- Action : Clic sur Valider (Chargement Infini) ---
    async function triggerOrderValidation() {
      // Bloquer immédiatement tout clic concurrent ou multiple
      if (isSubmitting) return;

      if (!checkValidity()) return;
      const stock = getStock();
      if (stock < quantity) {
        updateStock();
        return;
      }

      // Verrouiller la soumission dès le premier clic
      isSubmitting = true;

      // 1. Désactiver immédiatement les boutons et appliquer l'état de chargement
      if (btnValidateOrder) {
        btnValidateOrder.disabled = true;
        btnValidateOrder.classList.add('tk-btn-submit--loading');
      }
      if (btnMobileValidate) {
        btnMobileValidate.disabled = true;
        btnMobileValidate.classList.add('tk-btn-submit--loading');
      }

      // 2. Remplacer contenu par spinner + "Validation en cours…"
      if (btnSpinner) btnSpinner.style.display = 'inline-block';
      if (btnText) btnText.textContent = 'Validation en cours…';
      if (btnMobileText) btnMobileText.textContent = 'Validation…';

      let bookingId = '';
      try {
        const reservationResponse = await fetch('/api/billetterie/reservations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: (inpPrenom?.value || '').trim(),
            lastName: (inpNom?.value || '').trim(),
            whatsapp: (inpPhone?.value || '').trim(),
            country: (inpCountry?.value || '').trim(),
            quantity,
            turnstileToken: ((document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement)?.value || '').trim(),
            _hp: ((document.querySelector('[name="_hp"]') as HTMLInputElement)?.value || '').trim()
          })
        });
        const reservationData = await reservationResponse.json();
        if (!reservationResponse.ok || !reservationData?.reservation?.reservation_code) {
          throw new Error(reservationData?.error || 'Réservation impossible');
        }
        bookingId = reservationData.reservation.reservation_code;
        remainingPlaces = Math.max(0, remainingPlaces - quantity);
        localStorage.setItem(stockKey, String(Math.max(0, stock - quantity)));
        updateStock();
      } catch (error: any) {
        console.error('[billetterie] Réservation non enregistrée:', error);
        isSubmitting = false;
        if ((window as any).turnstile && typeof (window as any).turnstile.reset === 'function') {
          try {
            (window as any).turnstile.reset();
          } catch (_) {}
        }
        if (btnSpinner) btnSpinner.style.display = 'none';
        if (btnText) btnText.textContent = 'RÉESSAYER';
        if (btnMobileText) btnMobileText.textContent = 'RÉESSAYER';
        if (btnValidateOrder) {
          btnValidateOrder.disabled = false;
          btnValidateOrder.classList.remove('tk-btn-submit--loading');
        }
        if (btnMobileValidate) {
          btnMobileValidate.disabled = false;
          btnMobileValidate.classList.remove('tk-btn-submit--loading');
        }
        if (loadingMsg) loadingMsg.textContent = error?.message || 'La réservation n’a pas pu être enregistrée. Vérifiez votre connexion et réessayez.';
        return;
      }

      // Voile de chargement
      if (loadingBackdrop) {
        loadingBackdrop.classList.add('tk-loading-backdrop--active');
        loadingBackdrop.setAttribute('aria-hidden', 'false');
      }
      if (loadingTitle) loadingTitle.textContent = 'RÉSERVATION ENREGISTRÉE';
      if (loadingMsg) loadingMsg.textContent = 'Votre réservation est prête. Vous pouvez poursuivre le retrait de votre billet.';
      if (patienceNote) patienceNote.textContent = 'Présentez votre QR code et votre numéro de réservation lors du retrait.';

      window.setTimeout(() => {
        if (loadingBackdrop) {
          loadingBackdrop.classList.remove('tk-loading-backdrop--active');
          loadingBackdrop.setAttribute('aria-hidden', 'true');
        }

        // Réinitialiser les champs du formulaire après validation
        resetForm();

        if (btnSpinner) btnSpinner.style.display = 'none';
        if (btnText) btnText.textContent = 'RÉSERVATION ENREGISTRÉE';
        if (btnMobileText) btnMobileText.textContent = 'ENREGISTRÉE';
        if (btnValidateOrder) btnValidateOrder.disabled = true;
        if (btnMobileValidate) btnMobileValidate.disabled = true;

        fetch(`/api/can2027/qr?reservation=${encodeURIComponent(bookingId)}`)
          .then((response) => response.json())
          .then((data) => {
            currentBookingId = bookingId;
            currentQrData = data.qr;
            if (bookingNumber) bookingNumber.textContent = bookingId;
            if (bookingQr) bookingQr.src = data.qr;
            confirmation?.classList.add('tk-confirmation--visible');
            confirmation?.setAttribute('aria-hidden', 'false');
          });
      }, 650);
    }

    // Gestion du téléchargement de la carte (enregistré une seule fois)
    downloadCard?.addEventListener('click', () => {
      if (!currentQrData || !currentBookingId) return;
      const qrImage = new Image();
      qrImage.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = 900;
        canvas.height = 1000;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#10213d';
        ctx.font = '800 42px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('PRÉ-RÉSERVATION ENREGISTRÉE', 450, 85);
        ctx.font = '800 30px Arial';
        ctx.fillText('RDC vs GUINÉE ÉQUATORIALE', 450, 145);
        ctx.font = '24px Arial';
        ctx.fillText('Jeudi 24 septembre 2026 · 17:00', 450, 195);
        ctx.fillText('Stade des Martyrs · Kinshasa', 450, 235);
        ctx.font = '800 22px Arial';
        ctx.fillText('N° DE DOSSIER', 450, 300);
        ctx.font = '800 34px monospace';
        ctx.fillText(currentBookingId, 450, 345);
        ctx.drawImage(qrImage, 340, 385, 220, 220);
        ctx.fillStyle = '#fff5f5';
        ctx.fillRect(120, 650, 660, 115);
        ctx.fillStyle = '#d32f2f';
        ctx.fillRect(120, 650, 8, 115);
        ctx.fillStyle = '#d32f2f';
        ctx.font = '800 18px Arial';
        ctx.fillText('RETRAIT DU BILLET', 450, 685);
        ctx.fillStyle = '#10213d';
        ctx.font = '700 24px Arial';
        ctx.fillText('Stade Tata Raphaël', 450, 720);
        ctx.font = '18px Arial';
        ctx.fillText('Paiement sur place lors du retrait', 450, 750);
        ctx.fillStyle = '#10213d';
        ctx.font = '18px Arial';
        ctx.fillText('Cette carte confirme votre pré-réservation.', 450, 825);
        canvas.toBlob((blob) => {
          if (!blob) return;
          const link = document.createElement('a');
          link.href = URL.createObjectURL(blob);
          link.download = `${currentBookingId}-carte.png`;
          link.click();
          URL.revokeObjectURL(link.href);
        }, 'image/png');
      };
      qrImage.src = currentQrData;
    });

    btnValidateOrder?.addEventListener('click', triggerOrderValidation);
    btnMobileValidate?.addEventListener('click', triggerOrderValidation);
    checkoutForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      triggerOrderValidation();
    });

    // Initial calculation
    updatePrices();
    updateStock();
    updateOnlineDemo();
    window.setInterval(updateOnlineDemo, 10000);
    window.setInterval(syncDynamicStock, 30000);
    checkValidity();
  }

  initMonoPageCheckout();
  document.addEventListener('astro:page-load', initMonoPageCheckout);
</script>

