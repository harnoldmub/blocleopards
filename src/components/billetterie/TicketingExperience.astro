---
import { requireDatabase, hasDatabase } from "../../lib/neon";
import { getSetting } from "../../lib/settings";
import { billetterie as cfg, matchDateTime, matchPlace } from "../../data/billetterie";
import Turnstile from "../Turnstile.astro";

interface Props {
  lang?: "fr" | "en";
}

const { lang = "fr" } = Astro.props;

let reservationsCount = 0;
const capacitySetting = await getSetting("billetterie_capacity", "5000");
const totalCapacity = Number(capacitySetting) || 5000;

if (hasDatabase) {
  try {
    const db = requireDatabase();
    const rows = await db`
      select count(*)::int as total
      from billetterie_reservations
      where status <> 'cancelled'
        and created_at >= ${cfg.reservationsSince}
    `;
    reservationsCount = Number(rows[0]?.total || 0);
  } catch (error) {
    console.error("[billetterie] Impossible de récupérer le nombre de réservations:", error);
  }
}

const remainingPlaces = Math.max(0, totalCapacity - reservationsCount);
const formatFc = (amount: number) => `${amount.toLocaleString("fr-FR")} FC`;
const unitPrice = formatFc(cfg.ticket.unitPriceFc);

const clientConfig = JSON.stringify({
  unitPrice: cfg.ticket.unitPriceFc,
  maxQty: cfg.ticket.maxPerOrder,
  kickoff: cfg.kickoff,
  match: `${cfg.home.name} – ${cfg.away.name}`,
  dateTime: matchDateTime,
  place: matchPlace,
  competition: `${cfg.competition} · ${cfg.round}`,
  ticketName: cfg.ticket.name,
  pickupPlace: cfg.pickup.place,
  pickupTime: cfg.pickup.time,
  pickupPayment: cfg.pickup.payment,
});
---

<div
  class="tk"
  id="ticketing-root"
  data-lang={lang}
  data-config={clientConfig}
  data-total-capacity={totalCapacity}
  data-reservations-count={reservationsCount}
  data-remaining-places={remainingPlaces}
>
  <a class="tk-skip" href="#tk-reservation">Aller à la réservation</a>

  <!-- ===================================================================== -->
  <!-- EN-TÊTE                                                               -->
  <!-- ===================================================================== -->
  <header class="tk-header">
    <div class="tk-header-inner">
      <a href="/" class="tk-brand" aria-label="Tikeo, billetterie officielle — retour au site Bloc Léopards">
        <span class="tk-brand-title">TIKEO</span>
        <span class="tk-brand-caption">Billetterie officielle</span>
      </a>
      <div class="tk-header-right">
        <img
          src="/billetterie/Liste Bloc Léopards 2.png"
          alt="Éliminatoires de la CAN 2027"
          class="tk-campaign-logo"
          width="88"
          height="24"
        />
        <button type="button" class="tk-help-btn" id="btn-help-modal" aria-haspopup="dialog">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2.5-3 4.5" />
            <line x1="12" y1="17.5" x2="12.01" y2="17.5" />
          </svg>
          <span>Aide</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- AFFICHE DU MATCH                                                      -->
  <!-- ===================================================================== -->
  <section class="tk-hero" aria-labelledby="match-heading">
    <div class="tk-hero-inner">
      <p class="tk-hero-tags">
        <span class="tk-tag tk-tag--solid">{cfg.competition}</span>
        <span class="tk-tag">{cfg.round}</span>
        <span class="tk-tag">{cfg.group}</span>
      </p>

      <h1 id="match-heading" class="tk-sr-only">
        Billets {cfg.home.name} – {cfg.away.name}, {cfg.dateLong} à {cfg.time}, {cfg.venue}, {cfg.city}
      </h1>

      <div class="tk-fixture" aria-hidden="true">
        <div class="tk-team">
          <img src={cfg.home.flag} alt="" class="tk-flag" width="96" height="72" />
          <span class="tk-team-name">{cfg.home.name}</span>
          <span class="tk-team-nick">{cfg.home.nickname}</span>
        </div>
        <div class="tk-kickoff">
          <span class="tk-kickoff-day">{cfg.dateShort}</span>
          <span class="tk-kickoff-time">{cfg.time}</span>
          <span class="tk-kickoff-label">Coup d'envoi</span>
        </div>
        <div class="tk-team">
          <img src={cfg.away.flag} alt="" class="tk-flag" width="96" height="72" />
          <span class="tk-team-name">{cfg.away.name}</span>
          <span class="tk-team-nick">{cfg.away.nickname}</span>
        </div>
      </div>

      <div class="tk-hero-foot">
        <p class="tk-venue">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>{cfg.venue} · {cfg.city}</span>
        </p>

        <div class="tk-countdown" id="tk-countdown" hidden>
          <span class="tk-countdown-label" id="tk-countdown-label">Coup d'envoi dans</span>
          <div class="tk-countdown-units" aria-hidden="true">
            <span class="tk-unit"><b id="cd-days">00</b><i>j</i></span>
            <span class="tk-unit"><b id="cd-hours">00</b><i>h</i></span>
            <span class="tk-unit"><b id="cd-minutes">00</b><i>min</i></span>
            <span class="tk-unit"><b id="cd-seconds">00</b><i>s</i></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- PARCOURS EN 3 TEMPS                                                   -->
  <!-- ===================================================================== -->
  <main class="tk-main" id="tk-reservation">
    <ol class="tk-how" aria-label="Comment ça marche">
      <li class="tk-how-step">
        <span class="tk-how-num" aria-hidden="true">1</span>
        <span class="tk-how-text"><strong>Réservez en ligne</strong>Rien à payer sur le site.</span>
      </li>
      <li class="tk-how-step">
        <span class="tk-how-num" aria-hidden="true">2</span>
        <span class="tk-how-text"><strong>Recevez votre QR code</strong>Avec votre numéro de dossier.</span>
      </li>
      <li class="tk-how-step">
        <span class="tk-how-num" aria-hidden="true">3</span>
        <span class="tk-how-text"><strong>Payez et retirez</strong>{cfg.pickup.place}, {cfg.pickup.time}.</span>
      </li>
    </ol>

    <div class="tk-soldout" id="tk-soldout" role="status" hidden>
      <strong>Complet.</strong> Toutes les places ont été réservées pour ce match.
    </div>

    <div class="tk-grid">
      <div class="tk-content-col">

        <!-- ================================================================= -->
        <!-- 1 — BILLETS                                                       -->
        <!-- ================================================================= -->
        <section class="tk-card" aria-labelledby="tickets-title">
          <div class="tk-card-head">
            <h2 id="tickets-title" class="tk-card-title"><span class="tk-card-num" aria-hidden="true">1</span>Vos billets</h2>
            <span class="tk-card-aside">{cfg.ticket.maxPerOrder} billets maximum par commande</span>
          </div>

          <div class="tk-ticket">
            <div class="tk-ticket-info">
              <span class="tk-ticket-name">{cfg.ticket.name}</span>
              <span class="tk-ticket-sub">{cfg.ticket.detail}</span>
            </div>
            <span class="tk-ticket-price">{unitPrice} <small>par billet</small></span>
            <div class="tk-counter" role="group" aria-label="Nombre de billets">
              <button type="button" class="tk-counter-btn" id="btn-minus" aria-label="Retirer un billet" disabled>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /></svg>
              </button>
              <output class="tk-counter-num" id="display-qty" aria-live="polite" aria-atomic="true">1</output>
              <button type="button" class="tk-counter-btn" id="btn-plus" aria-label="Ajouter un billet">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
              </button>
            </div>
          </div>

          <p class="tk-stock" id="tk-stock">
            <span class="tk-stock-dot" aria-hidden="true"></span>
            <span id="tk-stock-text">{remainingPlaces.toLocaleString("fr-FR")} places restantes</span>
          </p>
        </section>

        <!-- ================================================================= -->
        <!-- 2 — COORDONNÉES                                                   -->
        <!-- ================================================================= -->
        <section class="tk-card" aria-labelledby="info-title">
          <div class="tk-card-head">
            <h2 id="info-title" class="tk-card-title"><span class="tk-card-num" aria-hidden="true">2</span>Vos coordonnées</h2>
            <span class="tk-card-aside">Tous les champs sont obligatoires</span>
          </div>
          <p class="tk-card-helper">Elles servent uniquement à retrouver votre réservation au moment du retrait.</p>

          <form id="mono-checkout-form" novalidate class="tk-form">
            <div class="tk-form-grid">
              <div class="tk-field" data-field="prenom">
                <label for="inp-prenom" class="tk-label">Prénom</label>
                <input type="text" id="inp-prenom" name="prenom" autocomplete="given-name" autocapitalize="words" required class="tk-input" aria-describedby="err-prenom" />
                <span class="tk-error" id="err-prenom" aria-live="polite"></span>
              </div>

              <div class="tk-field" data-field="nom">
                <label for="inp-nom" class="tk-label">Nom</label>
                <input type="text" id="inp-nom" name="nom" autocomplete="family-name" autocapitalize="words" required class="tk-input" aria-describedby="err-nom" />
                <span class="tk-error" id="err-nom" aria-live="polite"></span>
              </div>

              <div class="tk-field" data-field="phone">
                <label for="inp-phone" class="tk-label">Téléphone (WhatsApp)</label>
                <input type="tel" id="inp-phone" name="phone" autocomplete="tel" inputmode="tel" required class="tk-input" placeholder="+243 ..." aria-describedby="err-phone" />
                <span class="tk-error" id="err-phone" aria-live="polite"></span>
              </div>

              <div class="tk-field" data-field="country">
                <label for="inp-country" class="tk-label">Pays de résidence</label>
                <select id="inp-country" name="country" autocomplete="country-name" required class="tk-input tk-select" aria-describedby="err-country">
                  <option value="" disabled selected>Sélectionnez votre pays</option>
                  <option value="République Démocratique du Congo">République Démocratique du Congo (RDC)</option>
                  <option value="Sierra Leone">Sierra Leone</option>
                  <option value="France">France</option>
                  <option value="Belgique">Belgique</option>
                  <option value="Suisse">Suisse</option>
                  <option value="Canada">Canada</option>
                  <option value="États-Unis">États-Unis</option>
                  <option value="Royaume-Uni">Royaume-Uni</option>
                  <option value="Afrique du Sud">Afrique du Sud</option>
                  <option value="Congo-Brazzaville">Congo-Brazzaville</option>
                  <option value="Angola">Angola</option>
                  <option value="Autre pays">Autre pays</option>
                </select>
                <span class="tk-error" id="err-country" aria-live="polite"></span>
              </div>
            </div>

            <!-- Protection anti-robot : champ piège + Cloudflare Turnstile -->
            <input type="text" name="_hp" tabindex="-1" autocomplete="off" class="tk-hp" aria-hidden="true" />
            <div class="tk-turnstile-wrap">
              <Turnstile />
            </div>

            <div class="tk-alert" id="tk-alert" role="alert" hidden>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12.5" /><line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
              <span id="tk-alert-text"></span>
            </div>
          </form>
        </section>
      </div>

      <!-- =================================================================== -->
      <!-- 3 — RÉCAPITULATIF                                                   -->
      <!-- =================================================================== -->
      <aside class="tk-summary-col" aria-labelledby="summary-title">
        <div class="tk-summary">
          <div class="tk-summary-top">
            <h2 id="summary-title" class="tk-summary-title">Votre commande</h2>
            <p class="tk-summary-match">{cfg.home.name} – {cfg.away.name}</p>
            <p class="tk-summary-meta">{matchDateTime}<br />{matchPlace}</p>
          </div>

          <div class="tk-summary-notch" aria-hidden="true"></div>

          <div class="tk-summary-body">
            <div class="tk-sum-line">
              <span>
                <b>{cfg.ticket.name}</b>
                <small id="sum-item-calc">1 × {unitPrice}</small>
              </span>
              <span class="tk-sum-amount" id="sum-item-subtotal">{unitPrice}</span>
            </div>

            <div class="tk-sum-total">
              <span>Total à payer au retrait</span>
              <strong id="sum-total-amount">{unitPrice}</strong>
            </div>

            <div class="tk-sum-pickup">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" />
              </svg>
              <span><b>Aucun paiement en ligne.</b> Retrait et paiement : {cfg.pickup.place}, {cfg.pickup.time}.</span>
            </div>

            <button type="submit" form="mono-checkout-form" class="tk-submit tk-submit--desktop" id="btn-validate-order">
              <span class="tk-spinner" aria-hidden="true"></span>
              <span id="btn-text">Réserver ma place</span>
            </button>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <footer class="tk-footer">
    <p>Billetterie Tikeo pour le Bloc Léopards.</p>
    <a href="/can-2027">Programme des éliminatoires CAN 2027</a>
  </footer>

  <!-- ===================================================================== -->
  <!-- BARRE D'ACTION MOBILE                                                 -->
  <!-- ===================================================================== -->
  <div class="tk-mobile-bar" id="mobile-bar">
    <div class="tk-mobile-total">
      <span class="tk-mobile-total-caption">Total · <span id="mobile-qty">1 billet</span></span>
      <span class="tk-mobile-total-val" id="mobile-total-val">{unitPrice}</span>
    </div>
    <button type="submit" form="mono-checkout-form" class="tk-submit tk-submit--mobile" id="btn-mobile-validate">
      <span class="tk-spinner" aria-hidden="true"></span>
      <span id="btn-mobile-text">Réserver</span>
    </button>
  </div>

  <div class="tk-toast" id="tension-toast" role="status" aria-live="polite"><span id="tension-toast-text"></span></div>

  <!-- ===================================================================== -->
  <!-- CONFIRMATION : BILLET DE PRÉ-RÉSERVATION                              -->
  <!-- ===================================================================== -->
  <dialog class="tk-dialog tk-dialog--ticket" id="ticket-confirmation" aria-labelledby="confirmation-title">
    <div class="tk-pass">
      <button type="button" class="tk-dialog-close tk-dialog-close--light" id="close-confirmation" aria-label="Fermer le récapitulatif">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
      </button>

      <div class="tk-pass-top">
        <span class="tk-pass-check" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
        </span>
        <p class="tk-pass-kicker">Réservation enregistrée</p>
        <h2 id="confirmation-title">Votre pré-réservation est enregistrée</h2>
        <p class="tk-pass-match">{cfg.home.name} – {cfg.away.name}</p>
        <p class="tk-pass-meta">{matchDateTime}<br />{matchPlace}</p>
      </div>

      <div class="tk-summary-notch tk-summary-notch--pass" aria-hidden="true"></div>

      <div class="tk-pass-body">
        <div class="tk-pass-code">
          <span class="tk-pass-label">N° de dossier</span>
          <strong class="tk-booking-number" id="booking-number"></strong>
          <button type="button" class="tk-copy" id="copy-booking">Copier</button>
        </div>

        <div class="tk-pass-qr" id="booking-qr-wrap">
          <img class="tk-booking-qr" id="booking-qr" alt="QR code de réservation" width="200" height="200" />
        </div>
        <p class="tk-pass-qr-error" id="booking-qr-error" hidden>
          Le QR code n'a pas pu s'afficher. Votre réservation est bien enregistrée : notez votre numéro de dossier.
        </p>

        <div class="tk-pass-pickup">
          <span class="tk-pass-label">Retrait du billet</span>
          <strong>{cfg.pickup.place} à {cfg.pickup.time}</strong>
          <small id="confirmation-order">{cfg.pickup.payment}</small>
        </div>

        <p class="tk-pass-note">
          Présentez votre numéro de dossier et votre QR code au {cfg.pickup.place} pour payer sur place et retirer votre billet.
        </p>

        <div class="tk-pass-actions">
          <button type="button" class="tk-submit" id="download-card">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11" /><path d="m7 11 5 5 5-5" /><path d="M5 20h14" /></svg>
            <span>Télécharger ma carte (PNG)</span>
          </button>
          <button type="button" class="tk-ghost" id="done-confirmation">Terminer</button>
        </div>
      </div>
    </div>
  </dialog>

  <!-- ===================================================================== -->
  <!-- AIDE : RETRAIT ET PAIEMENT (#aide)                                    -->
  <!-- ===================================================================== -->
  <dialog class="tk-dialog" id="help-modal" aria-labelledby="help-modal-title">
    <div class="tk-help">
      <button type="button" class="tk-dialog-close" id="btn-close-help" aria-label="Fermer l'aide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
      </button>

      <p class="tk-help-kicker">Informations et retrait</p>
      <h2 id="help-modal-title">Où récupérer et payer vos billets ?</h2>

      <p class="tk-help-notice">
        <strong>Aucun paiement en ligne.</strong> Vous réservez sans rien payer sur le site. Le lieu de retrait, l'horaire et les modalités de paiement s'affichent à l'écran dès la validation.
      </p>

      <ol class="tk-help-steps">
        <li>
          <span class="tk-how-num" aria-hidden="true">1</span>
          <div>
            <strong>Réservez vos places en ligne (0 FC)</strong>
            <p>Choisissez votre nombre de billets et renseignez prénom, nom et numéro de téléphone. Ni compte bancaire ni carte.</p>
          </div>
        </li>
        <li>
          <span class="tk-how-num" aria-hidden="true">2</span>
          <div>
            <strong>Vos consignes s'affichent tout de suite</strong>
            <p>Lieu de retrait ({cfg.pickup.place}), horaire, numéro de dossier unique et QR code.</p>
          </div>
        </li>
        <li>
          <span class="tk-how-num" aria-hidden="true">3</span>
          <div>
            <strong>Retrait et paiement sur place</strong>
            <p>Présentez votre numéro de dossier ou votre QR code (carte téléchargeable d'un clic) au point de retrait pour payer et récupérer vos billets en main propre.</p>
          </div>
        </li>
      </ol>

      <button type="button" class="tk-submit" id="btn-ok-help">J'ai compris</button>
    </div>
  </dialog>
</div>

<script is:inline>
  function initMonoPageCheckout() {
    const root = document.getElementById('ticketing-root');
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    let cfg = {};
    try { cfg = JSON.parse(root.dataset.config || '{}'); } catch (_) {}

    // --- État ---
    let quantity = 1;
    const unitPrice = Number(cfg.unitPrice) || 0;
    const minQty = 1;
    const maxQty = Number(cfg.maxQty) || 4;
    const formatPrice = (amount) => `${amount.toLocaleString('fr-FR')} FC`;
    const totalCapacity = Number(root.dataset.totalCapacity || 5000);
    const reservationsCount = Number(root.dataset.reservationsCount || 0);
    let remainingPlaces = Math.max(0, Number(root.dataset.remainingPlaces ?? (totalCapacity - reservationsCount)));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let isSubmitting = false;
    let currentBookingId = '';
    let currentQrData = '';
    let lastOrder = { quantity: 1, total: unitPrice };

    // --- Éléments ---
    const $ = (id) => document.getElementById(id);
    const btnMinus = $('btn-minus');
    const btnPlus = $('btn-plus');
    const displayQty = $('display-qty');
    const sumItemCalc = $('sum-item-calc');
    const sumItemSubtotal = $('sum-item-subtotal');
    const sumTotalAmount = $('sum-total-amount');
    const mobileTotalVal = $('mobile-total-val');
    const mobileQty = $('mobile-qty');
    const stockLine = $('tk-stock');
    const stockText = $('tk-stock-text');
    const soldOutBanner = $('tk-soldout');
    const toast = $('tension-toast');
    const toastText = $('tension-toast-text');
    const alertBox = $('tk-alert');
    const alertText = $('tk-alert-text');

    const checkoutForm = $('mono-checkout-form');
    const btnValidateOrder = $('btn-validate-order');
    const btnMobileValidate = $('btn-mobile-validate');
    const btnText = $('btn-text');
    const btnMobileText = $('btn-mobile-text');

    const inpPrenom = $('inp-prenom');
    const inpNom = $('inp-nom');
    const inpPhone = $('inp-phone');
    const inpCountry = $('inp-country');

    const confirmation = $('ticket-confirmation');
    const bookingNumber = $('booking-number');
    const bookingQr = $('booking-qr');
    const bookingQrWrap = $('booking-qr-wrap');
    const bookingQrError = $('booking-qr-error');
    const confirmationOrder = $('confirmation-order');
    const downloadCard = $('download-card');
    const copyBooking = $('copy-booking');
    const closeConfirmation = $('close-confirmation');
    const doneConfirmation = $('done-confirmation');

    const helpModal = $('help-modal');
    const btnHelpModal = $('btn-help-modal');
    const btnCloseHelp = $('btn-close-help');
    const btnOkHelp = $('btn-ok-help');

    // --- Fenêtres modales (élément <dialog> natif : focus piégé + Échap) ---
    function openDialog(dialog) {
      if (!dialog || dialog.open) return;
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      document.documentElement.classList.add('tk-no-scroll');
    }
    function closeDialog(dialog) {
      if (!dialog || !dialog.open) return;
      if (typeof dialog.close === 'function') dialog.close();
      else {
        dialog.removeAttribute('open');
        dialog.dispatchEvent(new Event('close'));
      }
    }
    [helpModal, confirmation].forEach((dialog) => {
      dialog?.addEventListener('close', () => {
        if (!helpModal?.open && !confirmation?.open) document.documentElement.classList.remove('tk-no-scroll');
      });
      // Clic sur le fond : fermeture
      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) closeDialog(dialog);
      });
    });

    // Aide
    function openHelpModal() {
      openDialog(helpModal);
      if (window.location.hash !== '#aide') {
        history.replaceState(null, '', window.location.pathname + window.location.search + '#aide');
      }
    }
    helpModal?.addEventListener('close', () => {
      if (window.location.hash === '#aide') {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
      btnHelpModal?.focus();
    });
    btnHelpModal?.addEventListener('click', openHelpModal);
    btnCloseHelp?.addEventListener('click', () => closeDialog(helpModal));
    btnOkHelp?.addEventListener('click', () => closeDialog(helpModal));
    if (window.location.hash === '#aide') openHelpModal();
    window.addEventListener('hashchange', () => {
      if (window.location.hash === '#aide') openHelpModal();
      else closeDialog(helpModal);
    });

    // --- Messages ---
    let toastTimer = 0;
    function showToast(message, kind) {
      if (!toast || !toastText) return;
      window.clearTimeout(toastTimer);
      toastText.textContent = message;
      toast.classList.toggle('tk-toast--error', kind === 'error');
      toast.classList.add('tk-toast--visible');
      toastTimer = window.setTimeout(() => toast.classList.remove('tk-toast--visible'), 5000);
    }
    function showAlert(message) {
      if (!alertBox || !alertText) return;
      alertText.textContent = message;
      alertBox.hidden = false;
    }
    function hideAlert() {
      if (alertBox) alertBox.hidden = true;
    }

    // --- Quantités et prix ---
    function updatePrices() {
      const total = quantity * unitPrice;
      if (displayQty) {
        displayQty.textContent = String(quantity);
        if (!reduceMotion) {
          displayQty.classList.remove('tk-bump');
          void displayQty.offsetWidth;
          displayQty.classList.add('tk-bump');
        }
      }
      if (sumItemCalc) sumItemCalc.textContent = `${quantity} × ${formatPrice(unitPrice)}`;
      if (sumItemSubtotal) sumItemSubtotal.textContent = formatPrice(total);
      if (sumTotalAmount) sumTotalAmount.textContent = formatPrice(total);
      if (mobileTotalVal) mobileTotalVal.textContent = formatPrice(total);
      if (mobileQty) mobileQty.textContent = quantity > 1 ? `${quantity} billets` : '1 billet';

      const cap = Math.min(maxQty, remainingPlaces);
      if (btnMinus) btnMinus.disabled = quantity <= minQty || remainingPlaces === 0;
      if (btnPlus) btnPlus.disabled = quantity >= cap;
    }

    function setButtons(label, mobileLabel, opts) {
      const disabled = Boolean(opts && opts.disabled);
      const loading = Boolean(opts && opts.loading);
      if (btnText) btnText.textContent = label;
      if (btnMobileText) btnMobileText.textContent = mobileLabel;
      [btnValidateOrder, btnMobileValidate].forEach((btn) => {
        if (!btn) return;
        btn.disabled = disabled;
        btn.classList.toggle('tk-submit--loading', loading);
        if (loading) btn.setAttribute('aria-busy', 'true');
        else btn.removeAttribute('aria-busy');
      });
    }

    // Places restantes : chiffre réel, issu de la base.
    function updateStock() {
      const stock = Math.max(0, remainingPlaces);
      const soldOut = stock === 0;
      if (stockText) {
        stockText.textContent = soldOut
          ? 'Complet'
          : stock === 1 ? '1 place restante' : `${stock.toLocaleString('fr-FR')} places restantes`;
      }
      stockLine?.classList.toggle('tk-stock--low', !soldOut && stock <= 100);
      stockLine?.classList.toggle('tk-stock--out', soldOut);
      if (soldOutBanner) soldOutBanner.hidden = !soldOut;
      if (soldOut) {
        setButtons('Complet', 'Complet', { disabled: true });
      } else if (quantity > stock) {
        quantity = Math.max(minQty, Math.min(quantity, stock));
      }
      updatePrices();
    }

    async function syncDynamicStock() {
      if (isSubmitting || document.hidden) return;
      try {
        const res = await fetch('/api/billetterie/reservations');
        if (!res.ok) return;
        const data = await res.json();
        if (typeof data.remainingPlaces === 'number') {
          remainingPlaces = Math.max(0, data.remainingPlaces);
          updateStock();
        }
      } catch (_) {
        // Hors ligne : on garde le dernier chiffre connu.
      }
    }

    btnMinus?.addEventListener('click', () => {
      if (quantity > minQty) { quantity--; updatePrices(); }
    });
    btnPlus?.addEventListener('click', () => {
      if (quantity < Math.min(maxQty, remainingPlaces)) { quantity++; updatePrices(); }
    });

    // --- Validation du formulaire ---
    const phoneRegex = /^[\d\s\+\(\)\-\.]{7,20}$/;
    const fields = [
      { input: inpPrenom, err: 'err-prenom', test: (v) => v.length >= 2, msg: 'Indiquez votre prénom (2 caractères minimum).' },
      { input: inpNom, err: 'err-nom', test: (v) => v.length >= 2, msg: 'Indiquez votre nom (2 caractères minimum).' },
      { input: inpPhone, err: 'err-phone', test: (v) => phoneRegex.test(v), msg: 'Indiquez un numéro valide, par exemple +243 81 234 56 78.' },
      { input: inpCountry, err: 'err-country', test: (v) => v.length > 0, msg: 'Sélectionnez votre pays de résidence.' },
    ];

    function validateField(field, show) {
      if (!field.input) return true;
      const valid = field.test((field.input.value || '').trim());
      if (show || valid) {
        const group = field.input.closest('.tk-field');
        const errSpan = $(field.err);
        group?.classList.toggle('tk-field--error', !valid);
        if (errSpan) errSpan.textContent = valid ? '' : field.msg;
        if (valid) field.input.removeAttribute('aria-invalid');
        else field.input.setAttribute('aria-invalid', 'true');
      }
      return valid;
    }

    fields.forEach((field) => {
      if (!field.input) return;
      field.input.addEventListener('blur', () => {
        if ((field.input.value || '').trim()) validateField(field, true);
      });
      const onEdit = () => {
        hideAlert();
        // On ne corrige en direct qu'un champ déjà signalé en erreur.
        validateField(field, field.input.closest('.tk-field')?.classList.contains('tk-field--error'));
      };
      field.input.addEventListener('input', onEdit);
      field.input.addEventListener('change', onEdit);
    });

    function resetForm() {
      checkoutForm?.reset();
      if (inpCountry) inpCountry.selectedIndex = 0;
      document.querySelectorAll('.tk-field--error').forEach((grp) => grp.classList.remove('tk-field--error'));
      document.querySelectorAll('.tk-error').forEach((span) => { span.textContent = ''; });
      fields.forEach((field) => field.input?.removeAttribute('aria-invalid'));
      hideAlert();
      quantity = 1;
      updatePrices();
      if (window.turnstile && typeof window.turnstile.reset === 'function') {
        try { window.turnstile.reset(); } catch (_) {}
      }
    }

    function showConfirmation() {
      if (bookingNumber) bookingNumber.textContent = currentBookingId;
      if (confirmationOrder) {
        const label = lastOrder.quantity > 1 ? `${lastOrder.quantity} billets` : '1 billet';
        confirmationOrder.textContent = `${label} · ${formatPrice(lastOrder.total)} · ${cfg.pickupPayment || ''}`;
      }
      const hasQr = Boolean(currentQrData);
      if (bookingQr && hasQr) bookingQr.src = currentQrData;
      if (bookingQrWrap) bookingQrWrap.hidden = !hasQr;
      if (bookingQrError) bookingQrError.hidden = hasQr;
      if (downloadCard) downloadCard.hidden = !hasQr;
      openDialog(confirmation);
    }

    // --- Envoi de la réservation ---
    async function triggerOrderValidation() {
      if (isSubmitting) return;
      hideAlert();

      const invalid = fields.filter((field) => !validateField(field, true));
      if (invalid.length) {
        const first = invalid[0].input;
        first?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
        first?.focus({ preventScroll: true });
        showToast(invalid.length > 1 ? `${invalid.length} champs sont à compléter.` : 'Un champ est à compléter.', 'error');
        return;
      }
      if (remainingPlaces < quantity) {
        updateStock();
        showAlert(remainingPlaces === 0
          ? 'Toutes les places ont été réservées.'
          : `Il ne reste que ${remainingPlaces} place${remainingPlaces > 1 ? 's' : ''}. Ajustez votre nombre de billets.`);
        return;
      }

      isSubmitting = true;
      setButtons('Validation en cours…', 'Validation…', { disabled: true, loading: true });

      let bookingId = '';
      try {
        const turnstileEl = document.querySelector('[name="cf-turnstile-response"]');
        const hpEl = document.querySelector('[name="_hp"]');
        const reservationResponse = await fetch('/api/billetterie/reservations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: (inpPrenom?.value || '').trim(),
            lastName: (inpNom?.value || '').trim(),
            whatsapp: (inpPhone?.value || '').trim(),
            country: (inpCountry?.value || '').trim(),
            quantity,
            turnstileToken: (turnstileEl && turnstileEl.value ? turnstileEl.value : '').trim(),
            _hp: (hpEl && hpEl.value ? hpEl.value : '').trim()
          })
        });
        const reservationData = await reservationResponse.json().catch(() => null);
        if (!reservationResponse.ok || !reservationData?.reservation?.reservation_code) {
          throw new Error(reservationData?.error || 'La réservation n’a pas pu être enregistrée. Réessayez.');
        }
        bookingId = reservationData.reservation.reservation_code;
      } catch (error) {
        console.error('[billetterie] Réservation non enregistrée:', error);
        isSubmitting = false;
        if (window.turnstile && typeof window.turnstile.reset === 'function') {
          try { window.turnstile.reset(); } catch (_) {}
        }
        setButtons('Réessayer', 'Réessayer', { disabled: false });
        const offline = error instanceof TypeError;
        const message = offline
          ? 'Connexion interrompue. Vérifiez votre réseau, puis réessayez : rien n’a été enregistré.'
          : (error && error.message) || 'La réservation n’a pas pu être enregistrée. Réessayez.';
        showAlert(message);
        showToast(message, 'error');
        return;
      }

      lastOrder = { quantity, total: quantity * unitPrice };
      currentBookingId = bookingId;
      currentQrData = '';
      remainingPlaces = Math.max(0, remainingPlaces - quantity);

      // Le QR code est un confort : si sa génération échoue, la réservation reste valable.
      try {
        const qrResponse = await fetch(`/api/can2027/qr?reservation=${encodeURIComponent(bookingId)}`);
        const qrData = await qrResponse.json();
        if (qrResponse.ok && qrData && qrData.qr) currentQrData = qrData.qr;
      } catch (_) {}

      resetForm();
      isSubmitting = false;
      setButtons('Réserver ma place', 'Réserver', { disabled: false });
      updateStock();
      showConfirmation();
    }

    confirmation?.addEventListener('close', () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
    closeConfirmation?.addEventListener('click', () => closeDialog(confirmation));
    doneConfirmation?.addEventListener('click', () => closeDialog(confirmation));

    copyBooking?.addEventListener('click', async () => {
      if (!currentBookingId) return;
      try {
        await navigator.clipboard.writeText(currentBookingId);
        copyBooking.textContent = 'Copié';
        window.setTimeout(() => { copyBooking.textContent = 'Copier'; }, 2000);
      } catch (_) {
        // Presse-papiers indisponible : on sélectionne le numéro pour une copie manuelle.
        const range = document.createRange();
        if (bookingNumber) {
          range.selectNodeContents(bookingNumber);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      }
    });

    // --- Carte PNG à télécharger ---
    downloadCard?.addEventListener('click', () => {
      if (!currentQrData || !currentBookingId) return;
      const qrImage = new Image();
      qrImage.onload = () => {
        const W = 900;
        const H = 1180;
        const canvas = document.createElement('canvas');
        canvas.width = W;
        canvas.height = H;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const cx = W / 2;

        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, W, H);

        // Bandeau du match
        ctx.fillStyle = '#0b1730';
        ctx.fillRect(0, 0, W, 330);
        ctx.fillStyle = '#007fff';
        ctx.fillRect(0, 330, W / 3, 8);
        ctx.fillStyle = '#f7d618';
        ctx.fillRect(W / 3, 330, W / 3, 8);
        ctx.fillStyle = '#ce1126';
        ctx.fillRect((W / 3) * 2, 330, W / 3, 8);

        ctx.textAlign = 'center';
        ctx.fillStyle = '#f7d618';
        ctx.font = '800 22px Arial';
        ctx.fillText('TIKEO · PRÉ-RÉSERVATION ENREGISTRÉE', cx, 70);
        ctx.fillStyle = '#ffffff';
        ctx.font = '800 52px Arial';
        ctx.fillText(String(cfg.match || '').toUpperCase(), cx, 150);
        ctx.fillStyle = '#c9d6ea';
        ctx.font = '700 22px Arial';
        ctx.fillText(String(cfg.competition || '').toUpperCase(), cx, 198);
        ctx.fillStyle = '#ffffff';
        ctx.font = '26px Arial';
        ctx.fillText(cfg.dateTime || '', cx, 250);
        ctx.fillText(cfg.place || '', cx, 290);

        // Dossier
        ctx.fillStyle = '#52627b';
        ctx.font = '800 20px Arial';
        ctx.fillText('N° DE DOSSIER', cx, 400);
        ctx.fillStyle = '#0b1730';
        ctx.font = '800 46px monospace';
        ctx.fillText(currentBookingId, cx, 455);

        ctx.drawImage(qrImage, cx - 150, 490, 300, 300);

        const orderLabel = lastOrder.quantity > 1 ? `${lastOrder.quantity} billets` : '1 billet';
        ctx.fillStyle = '#0b1730';
        ctx.font = '700 26px Arial';
        ctx.fillText(`${cfg.ticketName || 'Billet'} · ${orderLabel} · ${formatPrice(lastOrder.total)}`, cx, 845);

        // Retrait
        ctx.fillStyle = '#eef5ff';
        ctx.fillRect(90, 890, W - 180, 150);
        ctx.fillStyle = '#007fff';
        ctx.fillRect(90, 890, 8, 150);
        ctx.fillStyle = '#0b63c4';
        ctx.font = '800 20px Arial';
        ctx.fillText('RETRAIT DU BILLET', cx, 935);
        ctx.fillStyle = '#0b1730';
        ctx.font = '700 30px Arial';
        ctx.fillText(`${cfg.pickupPlace || ''} à ${cfg.pickupTime || ''}`, cx, 978);
        ctx.font = '20px Arial';
        ctx.fillText(cfg.pickupPayment || '', cx, 1014);

        ctx.fillStyle = '#74839a';
        ctx.font = '18px Arial';
        ctx.fillText('Cette carte confirme votre pré-réservation. Présentez-la au point de retrait.', cx, 1105);

        canvas.toBlob((blob) => {
          if (!blob) return;
          const link = document.createElement('a');
          link.href = URL.createObjectURL(blob);
          link.download = `${currentBookingId}-carte.png`;
          link.click();
          URL.revokeObjectURL(link.href);
          showToast('Carte enregistrée dans vos téléchargements.');
        }, 'image/png');
      };
      qrImage.src = currentQrData;
    });

    checkoutForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      triggerOrderValidation();
    });

    // --- Compte à rebours jusqu'au coup d'envoi ---
    const countdown = $('tk-countdown');
    const kickoff = Date.parse(cfg.kickoff || '');
    if (countdown && Number.isFinite(kickoff)) {
      const pad = (n) => String(n).padStart(2, '0');
      const label = $('tk-countdown-label');
      const units = { days: $('cd-days'), hours: $('cd-hours'), minutes: $('cd-minutes'), seconds: $('cd-seconds') };
      let timer = 0;
      const tick = () => {
        const diff = kickoff - Date.now();
        if (diff <= 0) {
          window.clearInterval(timer);
          countdown.classList.add('tk-countdown--live');
          // Deux heures de match, puis le compte à rebours disparaît.
          if (diff > -2 * 3600 * 1000) {
            if (label) label.textContent = 'Match en cours';
            countdown.hidden = false;
          } else {
            countdown.hidden = true;
          }
          return;
        }
        const s = Math.floor(diff / 1000);
        if (units.days) units.days.textContent = pad(Math.floor(s / 86400));
        if (units.hours) units.hours.textContent = pad(Math.floor((s % 86400) / 3600));
        if (units.minutes) units.minutes.textContent = pad(Math.floor((s % 3600) / 60));
        if (units.seconds) units.seconds.textContent = pad(s % 60);
        countdown.hidden = false;
      };
      tick();
      timer = window.setInterval(tick, 1000);
    }

    // Initialisation
    updateStock();
    window.setInterval(syncDynamicStock, 30000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMonoPageCheckout);
  } else {
    initMonoPageCheckout();
  }
  document.addEventListener('astro:page-load', initMonoPageCheckout);
</script>

