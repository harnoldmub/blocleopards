  }
  .tk-help-btn:active { background: rgba(255, 255, 255, 0.16); }

  /* ------------------------------------------------------- Affiche du match */
  .tk-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60rem 26rem at 50% -8rem, rgba(46, 151, 255, 0.34), transparent 70%),
      linear-gradient(180deg, var(--tk-night) 0%, var(--tk-night-2) 100%);
    color: #fff;
  }
  /* Rappel du drapeau : la bande diagonale rouge bordée de jaune. */
  .tk-hero::before {
    content: "";
    position: absolute;
    inset: -40% -10%;
    background: linear-gradient(
      118deg,
      transparent 45.5%,
      rgba(247, 214, 24, 0.5) 45.5% 46.3%,
      rgba(206, 17, 38, 0.5) 46.3% 49.7%,
      rgba(247, 214, 24, 0.5) 49.7% 50.5%,
      transparent 50.5%
    );
    opacity: 0.22;
    pointer-events: none;
  }
  .tk-hero-inner {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3.75rem;
  }
  .tk-hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
