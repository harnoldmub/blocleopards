---
/**
 * En-tête de page : photo réelle, voile fonctionnel en bas pour la lisibilité,
 * titre condensé, liseré drapeau. Même grammaire que l'accueil.
 */
const { title, subtitle, image, eyebrow } = Astro.props;
---
<section class="relative flex min-h-[44svh] items-end overflow-hidden bg-[var(--bl-night)] text-white lg:min-h-[52vh]">
  {image && (
    <img src={image} alt="" aria-hidden="true" decoding="async" class="absolute inset-0 z-0 h-full w-full object-cover" />
  )}
  <div class="absolute inset-0 z-0 bg-[linear-gradient(180deg,rgba(7,18,38,.25)_0%,rgba(7,18,38,.55)_45%,rgba(7,18,38,.94)_100%)]" aria-hidden="true"></div>

  <div class="bl-wrap relative z-10 pb-10 pt-24 lg:pb-14 lg:pt-32">
    {eyebrow && <p class="bl-label text-[var(--bl-yellow)]">{eyebrow}</p>}
    <h1 class="bl-title bl-title--xl mt-3">{title}</h1>
    {subtitle && <p class="bl-lead mt-4 text-white/85">{subtitle}</p>}
  </div>

  <div class="absolute bottom-0 left-0 right-0 z-10 grid h-[4px] grid-cols-3" aria-hidden="true">
    <div class="bg-flag-blue"></div>
    <div class="bg-flag-yellow"></div>
    <div class="bg-flag-red"></div>
  </div>
</section>
