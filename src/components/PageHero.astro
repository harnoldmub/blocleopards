---
const { title, subtitle, image, eyebrow } = Astro.props;
---
<section class="relative flex min-h-[52vh] items-end overflow-hidden bg-congo-night text-white">
  <div class="absolute inset-0 -z-10">
    {image
      ? <img src={image} alt="" aria-hidden="true" class="h-full w-full object-cover opacity-40" />
      : <div class="h-full w-full bg-congo-night"></div>}
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-congo-night via-congo-night/70 to-congo-night/40"></div>

  <div class="relative mx-auto w-full max-w-[84rem] px-4 pb-14 pt-28 lg:px-8">
    {eyebrow && <span data-reveal class="inline-flex items-center gap-3 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-or before:h-px before:w-9 before:bg-or/70">{eyebrow}</span>}
    <h1 data-reveal class="mt-5 font-display uppercase leading-[0.9] [font-size:clamp(2.6rem,7vw,6.5rem)]">{title}</h1>
    {subtitle && <p data-reveal data-reveal-delay="120" class="mt-5 max-w-2xl text-lg leading-relaxed text-white/75">{subtitle}</p>}
  </div>

  <div class="absolute bottom-0 left-0 right-0 grid h-[3px] grid-cols-3" aria-hidden="true">
    <div class="bg-flag-blue"></div>
    <div class="bg-flag-yellow"></div>
    <div class="bg-flag-red"></div>
  </div>
</section>
