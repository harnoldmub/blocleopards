---
const { title, description, meta, image, href, cta } = Astro.props;
const Tag = href ? "a" : "article";
---
<Tag href={href} class="bl-tile group flex h-full flex-col overflow-hidden rounded-[6px] border border-[var(--bl-line)] bg-white">
  {image && (
    <div class="aspect-[4/3] overflow-hidden bg-[var(--bl-paper)]">
      <img src={image} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none" />
    </div>
  )}
  <div class="flex flex-1 flex-col p-5">
    {meta && <span class="text-[0.72rem] font-extrabold uppercase tracking-[0.08em] text-[var(--bl-blue)]">{meta}</span>}
    <h3 class="bl-title mt-2 text-[1.6rem] text-[var(--bl-ink)]">{title}</h3>
    {description && <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-[var(--bl-ink-2)]">{description}</p>}
    {href && <span class="bl-link mt-3 self-start">{cta ?? "Lire"}</span>}
  </div>
</Tag>
