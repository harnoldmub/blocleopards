---
import { SHOP_ENABLED } from "../data/merch";

const nav = [
  { label: "Accueil", href: "/" },
  { label: "CAN 2027", href: "/can-2027" },
  {
    label: "Mouvement",
    href: "/mouvement",
    children: [
      { label: "Qui sommes-nous ?", href: "/mouvement" },
      { label: "Charte", href: "/charte" },
      { label: "Partenaires", href: "/partenaires" },
      { label: "Contact", href: "/contact" }
    ]
  },
  {
    label: "Actions",
    href: "/evenements",
    children: [
      { label: "Calendrier", href: "/evenements" },
      { label: "Léopards Basket", href: "/basket" },
      { label: "Campagnes", href: "/campagnes" }
    ]
  },
  { label: "Media", href: "/media" }
];
---
<header data-site-header class="sticky top-0 z-50 bg-white/85 backdrop-blur-xl transition-shadow duration-500">
  <div class="mx-auto flex max-w-[84rem] items-center justify-between px-4 py-3 lg:px-8">
    <!-- Bouton menu mobile -->
    <button id="mobile-menu-btn" class="p-2 text-congo-nuit lg:hidden" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>

    <!-- Logos (centrés mobile, à gauche desktop) — logos institutionnels préservés -->
    <a href="/" class="absolute left-1/2 flex -translate-x-1/2 items-center gap-3 lg:static lg:translate-x-0" aria-label="Accueil Bloc Léopards">
      <img src="/brand/logo-2026.png" alt="Bloc Leopards" class="h-12 w-auto lg:h-16" />
      <span class="hidden h-9 w-px bg-slate-200 lg:block"></span>
      <img src="/brand/logo-min-sport-black.webp" alt="Ministère des Sports et Loisirs" class="h-8 w-auto opacity-80 lg:h-10" />
    </a>

    <!-- Nav desktop -->
    <nav class="hidden items-center gap-1 lg:flex">
      {nav.map((item) => (
        item.children ? (
          <div class="group relative">
            <a href={item.href} class="flex items-center gap-1.5 whitespace-nowrap px-2.5 py-6 text-[0.82rem] xl:px-4 font-semibold uppercase tracking-[0.12em] text-congo-nuit/80 transition-colors hover:text-congo">
              {item.label}
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-congo transition-transform group-hover:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            <div class="invisible absolute left-1/2 top-full w-60 -translate-x-1/2 translate-y-1 opacity-0 transition-all duration-300 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
              <div class="flex flex-col border border-slate-100 bg-white p-2 shadow-2xl ring-1 ring-black/5">
                {item.children.map(child => (
                  <a href={child.href} class="rounded-[2px] px-4 py-2.5 text-sm font-medium text-slate-600 transition-colors hover:bg-congo/5 hover:text-congo">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class="flex items-center gap-1.5 whitespace-nowrap px-2.5 py-6 text-[0.82rem] xl:px-4 font-semibold uppercase tracking-[0.12em] text-congo-nuit/80 transition-colors hover:text-congo">
            {item.label}
            {item.isSpecial && (
              <span class="rounded bg-feu px-1.5 py-0.5 text-[0.55rem] font-black text-white leading-none shadow-xs">
                OFFICIEL
              </span>
            )}
          </a>
        )
      ))}
    </nav>

    <!-- CTA -->
    <div class="flex items-center gap-2">
      <a href="/rejoindre" aria-label="Rejoindre le Bloc" title="Rejoindre le Bloc" class="grid h-11 w-11 place-items-center rounded-full bg-congo text-white shadow-[0_10px_30px_-12px_rgba(20,102,224,0.7)] transition-all hover:-translate-y-0.5 hover:bg-congo-deep">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
      </a>
      {SHOP_ENABLED && (
      <a href="/boutique" aria-label="Boutique" class="inline-flex h-11 min-w-11 items-center justify-center gap-2 rounded-full bg-or px-3 text-[0.72rem] font-black uppercase tracking-[0.1em] text-congo-night transition-all hover:-translate-y-0.5 hover:bg-yellow-300 lg:px-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="hidden lg:inline">Boutique</span>
      </a>
      )}
    </div>
  </div>

  <!-- Barre RDC (identité visuelle — bleu / jaune / rouge) -->
  <div class="grid h-[3px] w-full grid-cols-3" aria-hidden="true">
    <div class="bg-flag-blue"></div>
    <div class="bg-flag-yellow"></div>
    <div class="bg-flag-red"></div>
  </div>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="absolute left-0 right-0 top-full hidden max-h-[calc(100vh-80px)] overflow-y-auto border-t border-slate-100 bg-white shadow-xl lg:hidden" data-lenis-prevent>
    <div class="flex flex-col space-y-1 p-4">
      {nav.map((item) => (
        item.children ? (
          <div class="border-b border-slate-100 pb-2 last:border-0">
            <button class="mobile-dropdown-btn flex w-full items-center justify-between py-3 text-sm font-bold uppercase tracking-[0.1em] text-congo-nuit">
              {item.label}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-congo transition-transform duration-200"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="mobile-dropdown-content mt-1 hidden space-y-1 pl-4">
              {item.children.map(child => (
                <a href={child.href} class="block py-2 text-sm text-slate-600 hover:text-congo">
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class="block border-b border-slate-100 py-3 text-sm font-bold uppercase tracking-[0.1em] text-congo-nuit last:border-0 hover:text-congo">
            {item.label}
          </a>
        )
      ))}
      <div class="flex flex-col gap-3 pt-4">
        <a href="/rejoindre" class="block w-full rounded-full bg-congo px-4 py-3 text-center text-xs font-bold uppercase tracking-[0.1em] text-white">
          Rejoindre le Bloc
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));

  document.querySelectorAll('.mobile-dropdown-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.nextElementSibling?.classList.toggle('hidden');
      btn.querySelector('svg')?.classList.toggle('rotate-180');
    });
  });

  // Ombre du header au scroll (compatible Lenis)
  const onScroll = (y: number) => header?.classList.toggle('is-scrolled', y > 12);
  const lenis = (window as any).lenis;
  if (lenis) lenis.on('scroll', (e: any) => onScroll(e.scroll));
  else window.addEventListener('scroll', () => onScroll(window.scrollY), { passive: true });
  onScroll(window.scrollY);
</script>

<style>
  [data-site-header].is-scrolled {
    box-shadow: 0 10px 30px -24px rgba(5, 11, 24, 0.5);
  }
</style>
