---
import { SHOP_ENABLED } from "../data/merch";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { label: "Accueil", href: "/", match: ["/"] },
  { label: "Matchs", href: "/can-2027", match: ["/can-2027", "/basket", "/billetterie"] },
  {
    label: "Actions",
    href: "/evenements",
    match: ["/evenements", "/campagnes", "/kit-supporters"],
    children: [
      { label: "Calendrier", href: "/evenements" },
      { label: "Campagnes", href: "/campagnes" },
      { label: "Kit supporter", href: "/kit-supporters" },
      { label: "Léopards Basket", href: "/basket" }
    ]
  },
  {
    label: "Le mouvement",
    href: "/mouvement",
    match: ["/mouvement", "/charte", "/partenaires", "/contact"],
    children: [
      { label: "Qui sommes-nous ?", href: "/mouvement" },
      { label: "Charte", href: "/charte" },
      { label: "Partenaires", href: "/partenaires" },
      { label: "Contact", href: "/contact" }
    ]
  },
  { label: "Médias", href: "/media", match: ["/media", "/actus"] },
  ...(SHOP_ENABLED ? [{ label: "Boutique", href: "/boutique", match: ["/boutique", "/merch"] }] : [])
];

const isActive = (item: { match: string[] }) =>
  item.match.some((m) => (m === "/" ? path === "/" : path === m || path.startsWith(`${m}/`)));

const bottomNav = [
  { label: "Accueil", href: "/", match: ["/"], icon: "home" },
  { label: "Matchs", href: "/can-2027", match: ["/can-2027", "/basket", "/billetterie"], icon: "match" },
  { label: "Actions", href: "/evenements", match: ["/evenements", "/campagnes", "/kit-supporters"], icon: "action" },
  { label: "Rejoindre", href: "/rejoindre", match: ["/rejoindre"], icon: "join" }
];
---
<a href="#contenu" class="bl-skip">Aller au contenu</a>

<header data-site-header class="bl-header">
  <div class="bl-header__bar">
    <a href="/" class="bl-header__brand bl-focus" aria-label="Bloc Léopards, accueil">
      <img src="/brand/logo-2026.png" alt="Bloc Léopards" width="56" height="56" />
      <span class="bl-header__sep" aria-hidden="true"></span>
      <img src="/brand/logo-min-sport-black.webp" alt="Ministère des Sports et Loisirs" class="bl-header__inst" height="36" />
    </a>

    <nav class="bl-header__nav" aria-label="Navigation principale">
      {nav.map((item) => (
        <div class="bl-header__item">
          <a href={item.href} class="bl-header__link bl-focus" aria-current={isActive(item) ? "page" : undefined}>
            {item.label}
            {item.children && (
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            )}
          </a>
          {item.children && (
            <div class="bl-header__sub">
              {item.children.map((child) => (
                <a href={child.href} class="bl-focus">{child.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="bl-header__actions">
      <a href="/rejoindre" class="bl-btn bl-btn--blue bl-header__join">Rejoindre le Bloc</a>
      <button type="button" id="mobile-menu-btn" class="bl-header__burger bl-focus" aria-expanded="false" aria-controls="mobile-menu">
        <span class="bl-sr">Ouvrir le menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <line class="bl-burger-1" x1="4" x2="20" y1="7" y2="7" /><line class="bl-burger-2" x1="4" x2="20" y1="12" y2="12" /><line class="bl-burger-3" x1="4" x2="20" y1="17" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Liseré drapeau -->
  <div class="bl-header__flag" aria-hidden="true"><i></i><i></i><i></i></div>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="bl-menu" hidden data-lenis-prevent>
    <nav aria-label="Menu">
      {nav.map((item) => (
        <div class="bl-menu__group">
          <a href={item.href} class="bl-menu__main" aria-current={isActive(item) ? "page" : undefined}>{item.label}</a>
          {item.children && (
            <div class="bl-menu__sub">
              {item.children.filter((c) => c.href !== item.href).map((child) => <a href={child.href}>{child.label}</a>)}
            </div>
          )}
        </div>
      ))}
    </nav>
    <a href="/rejoindre" class="bl-btn bl-btn--blue" style="width:100%;">Rejoindre le Bloc</a>
    <img src="/brand/logo-min-sport-black.webp" alt="Ministère des Sports et Loisirs" class="bl-menu__inst" height="40" loading="lazy" />
  </div>
</header>

<!-- Navigation basse : mobile et tablette -->
<nav class="bl-tabbar" aria-label="Accès rapide">
  {bottomNav.map((item, i) => (
    <>
    {i === 2 && (
      <button type="button" class="bl-tabbar__item bl-tabbar__captain" data-cap-trigger aria-haspopup="dialog" aria-expanded="false" aria-controls="captain-panel">
        <img src="/brand/logo-2026.png" alt="" width="28" height="28" />
        <span>Captain</span>
      </button>
    )}
    <a href={item.href} class:list={["bl-tabbar__item", item.icon === "join" && "bl-tabbar__item--join"]} aria-current={isActive(item) ? "page" : undefined}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {item.icon === "home" && <><path d="M3 11.5 12 4l9 7.5" /><path d="M5.5 10v10h13V10" /></>}
        {item.icon === "match" && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></>}
        {item.icon === "action" && <><path d="M4 21V4" /><path d="M4 5h13l-2.5 4L17 13H4" /></>}
        {item.icon === "join" && <><circle cx="10" cy="8" r="4" /><path d="M3 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 4 1.5" /><path d="M19 14v6M16 17h6" /></>}
      </svg>
      <span>{item.label}</span>
    </a>
    </>
  ))}
</nav>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const label = menuBtn?.querySelector('.bl-sr');

  const setMenu = (open: boolean) => {
    if (!menuBtn || !mobileMenu) return;
    mobileMenu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
    document.documentElement.classList.toggle('bl-menu-open', open);
  };
  menuBtn?.addEventListener('click', () => setMenu(mobileMenu?.hidden ?? true));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.hidden) {
      setMenu(false);
      menuBtn?.focus();
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setMenu(false));

  // Ombre du header au défilement (compatible Lenis)
  const onScroll = (y: number) => header?.classList.toggle('is-scrolled', y > 12);
  const lenis = (window as any).lenis;
  if (lenis) lenis.on('scroll', (e: any) => onScroll(e.scroll));
  else window.addEventListener('scroll', () => onScroll(window.scrollY), { passive: true });
  onScroll(window.scrollY);
</script>

<style>
  .bl-sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .bl-skip {
    position: absolute; left: 0.75rem; top: -5rem; z-index: 80;
    padding: 0.8rem 1rem; background: var(--bl-yellow); color: var(--bl-ink); font-weight: 800; text-decoration: none;
  }
  .bl-skip:focus { top: 0.75rem; }

  .bl-header { position: sticky; top: 0; z-index: 50; background: #fff; color: var(--bl-ink); transition: box-shadow 0.3s; }
  .bl-header.is-scrolled { box-shadow: 0 8px 24px -18px rgba(7, 18, 38, 0.55); }
  .bl-header__bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    max-width: var(--bl-wrap); margin-inline: auto; height: 3.75rem; padding-inline: 1rem;
  }
  .bl-header__brand { display: flex; align-items: center; gap: 0.75rem; flex: none; }
  .bl-header__brand img:first-child { height: 2.75rem; width: auto; }
  .bl-header__sep { display: block; width: 1px; height: 1.5rem; background: var(--bl-line); }
  .bl-header__inst { display: block; height: 1.75rem; width: auto; opacity: 0.85; }

  .bl-header__nav { display: none; align-items: stretch; height: 100%; }
  .bl-header__item { position: relative; display: flex; }
  .bl-header__link {
    position: relative; display: inline-flex; align-items: center; gap: 0.35rem; padding-inline: 0.8rem;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; white-space: nowrap;
  }
  .bl-header__link::after {
    content: ""; position: absolute; left: 0.8rem; right: 0.8rem; bottom: 0; height: 3px; background: var(--bl-blue);
    transform: scaleX(0); transform-origin: left; transition: transform 0.25s var(--bl-ease);
  }
  .bl-header__link[aria-current="page"] { color: var(--bl-blue); }
  .bl-header__link[aria-current="page"]::after { transform: scaleX(1); }
  .bl-header__sub {
    position: absolute; left: 0; top: 100%; min-width: 14rem; padding: 0.4rem;
    background: #fff; border: 1px solid var(--bl-line); border-top: 3px solid var(--bl-blue); border-radius: 0 0 var(--bl-radius) var(--bl-radius);
    box-shadow: 0 18px 30px -20px rgba(7, 18, 38, 0.5);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity 0.18s, transform 0.18s var(--bl-ease), visibility 0.18s;
  }
  .bl-header__item:hover .bl-header__sub, .bl-header__item:focus-within .bl-header__sub { opacity: 1; visibility: visible; transform: none; }
  .bl-header__sub a { display: flex; align-items: center; min-height: 2.75rem; padding: 0 0.8rem; border-radius: 4px; font-size: 0.9rem; font-weight: 600; text-decoration: none; }

  .bl-header__actions { display: flex; align-items: center; gap: 0.25rem; }
  .bl-header__join { min-height: 2.75rem; padding: 0.5rem 1rem; font-size: 0.78rem; }
  .bl-header__burger { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; background: none; color: inherit; cursor: pointer; }
  .bl-header__burger line { transition: transform 0.25s var(--bl-ease), opacity 0.2s; transform-origin: 12px 12px; }
  .bl-header__burger[aria-expanded="true"] .bl-burger-1 { transform: translateY(5px) rotate(45deg); }
  .bl-header__burger[aria-expanded="true"] .bl-burger-2 { opacity: 0; }
  .bl-header__burger[aria-expanded="true"] .bl-burger-3 { transform: translateY(-5px) rotate(-45deg); }

  .bl-header__flag { display: grid; grid-template-columns: repeat(3, 1fr); height: 3px; }
  .bl-header__flag i:nth-child(1) { background: #007fff; }
  .bl-header__flag i:nth-child(2) { background: #f7d618; }
  .bl-header__flag i:nth-child(3) { background: #ce1021; }

  .bl-menu {
    position: absolute; inset: 100% 0 auto 0; max-height: calc(100dvh - 3.75rem - var(--bl-nav-h)); overflow-y: auto;
    padding: 0.5rem 1rem 1.5rem; background: #fff; border-top: 1px solid var(--bl-line); box-shadow: 0 24px 30px -20px rgba(7, 18, 38, 0.5);
  }
  .bl-menu[hidden] { display: none; }
  .bl-menu__group { border-bottom: 1px solid var(--bl-line); padding-block: 0.35rem; }
  .bl-menu__main {
    display: flex; align-items: center; min-height: 3rem;
    font-family: "Anton", system-ui, sans-serif; font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.01em; text-decoration: none;
  }
  .bl-menu__main[aria-current="page"] { color: var(--bl-blue); }
  .bl-menu__sub { display: flex; flex-wrap: wrap; gap: 0 1.25rem; padding-bottom: 0.35rem; }
  .bl-menu__sub a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--bl-ink-2); font-size: 0.95rem; font-weight: 600; text-decoration: none; }
  .bl-menu .bl-btn { margin-top: 1.25rem; }
  .bl-menu__inst { display: block; height: 2.25rem; width: auto; margin: 1.25rem auto 0; opacity: 0.8; }

  .bl-tabbar {
    position: fixed; inset: auto 0 0 0; z-index: 45; display: grid; grid-template-columns: repeat(5, 1fr);
    height: calc(var(--bl-nav-h) + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom);
    background: #fff; border-top: 1px solid var(--bl-line); color: var(--bl-ink-2);
  }
  .bl-tabbar__item {
    position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.15rem;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.03em; text-decoration: none;
  }
  .bl-tabbar__item:focus-visible { outline: 3px solid var(--bl-blue-vif); outline-offset: -3px; }
  .bl-tabbar__item[aria-current="page"] { color: var(--bl-blue); }
  .bl-tabbar__item[aria-current="page"]::before { content: ""; position: absolute; top: 0; left: 25%; right: 25%; height: 3px; background: var(--bl-blue); }
  /* Captain Léopard : ouvre le guide des supporters (panneau dans ChatAssistant.astro). */
  .bl-tabbar__captain { border: 0; background: none; color: inherit; font-family: inherit; cursor: pointer; }
  .bl-tabbar__captain img { width: 1.5rem; height: 1.5rem; margin-block: -1px; object-fit: contain; }
  .bl-tabbar__captain[aria-expanded="true"] { color: var(--bl-blue); }
  .bl-tabbar__item--join { background: var(--bl-yellow); color: var(--bl-ink); }
  .bl-tabbar__item--join[aria-current="page"] { color: var(--bl-ink); }

  @media (hover: hover) and (pointer: fine) {
    .bl-header__link:hover { color: var(--bl-blue); }
    .bl-header__link:hover::after { transform: scaleX(1); }
    .bl-header__sub a:hover { background: var(--bl-paper); color: var(--bl-blue); }
  }

  /* Sur mobile, « Rejoindre » vit dans la navigation basse. */
  @media (max-width: 479px) { .bl-header__join { display: none; } }

  @media (min-width: 1024px) {
    .bl-header__bar { height: 4.25rem; padding-inline: 2rem; }
    .bl-header__brand img:first-child { height: 3.25rem; }
    .bl-header__sep { height: 1.75rem; }
    .bl-header__inst { height: 2.1rem; }
    .bl-header__nav { display: flex; }
    .bl-header__burger, .bl-tabbar { display: none; }
    .bl-menu { display: none; }
  }
  @media (min-width: 1024px) and (max-width: 1180px) {
    .bl-header__sep, .bl-header__inst { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bl-header__link::after, .bl-header__sub, .bl-header__burger line { transition: none; }
  }
</style>
