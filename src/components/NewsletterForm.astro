---
import Turnstile from "./Turnstile.astro";
---
<form name="newsletter" method="POST" action="/api/newsletter" class="mt-6 grid gap-3">
  <input name="_hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
  <input name="_t" type="hidden" id="newsletter-t" />
  <script>document.getElementById('newsletter-t').value = Date.now();</script>
  <div class="grid items-end gap-3 md:grid-cols-[1fr_auto]">
    <label class="grid w-full gap-1.5">
      <span class="bloc-label">Adresse email</span>
      <input
        type="email"
        name="email"
        required
        class="bloc-control rounded-full text-sm"
      />
    </label>
    <button type="submit" class="bloc-submit px-6 py-3">
      Recevoir les actus
    </button>
  </div>
  <Turnstile />
</form>
