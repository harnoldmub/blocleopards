---
import BaseLayout from "../layouts/BaseLayout.astro";
import Can2027GroupTable from "../components/can2027/Can2027GroupTable.astro";
import { getCollection } from "astro:content";
import { SHOP_ENABLED } from "../data/merch";
import {
  FIXTURES,
  TEAMS,
  WINDOWS,
  computeStandings,
  dayNumber,
  formatMatchDate,
  formatMatchDay,
  formatMatchTime,
  nextRdcFixture,
  rdcFixtures
} from "../data/can2027";

const standings = computeStandings();
const rdc = standings.find((s) => s.team.isRDC)!;
const next = nextRdcFixture();
const november = rdcFixtures().filter((f) => f.matchday === 3 || f.matchday === 4);
const results = rdcFixtures("FINISHED");
const otherNovember = FIXTURES.filter((f) => (f.matchday === 3 || f.matchday === 4) && f.home !== "RDC" && f.away !== "RDC");

const news = (await getCollection("news"))
  .filter((post) => post.data.tags?.includes("CAN 2027"))
  .sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))
  .slice(0, 3);

const shareText = `Éliminatoires CAN 2027 : RDC – Sierra Leone le jeudi 12 novembre à 17h au Stade des Martyrs, puis Sierra Leone – RDC le mardi 17 novembre à El Jadida. Tous derrière les Léopards ! https://blocleopards.com/can-2027`;
const whatsappShare = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
const poster = "/media/can-2027/affiche-novembre-2026.webp";

---

<BaseLayout
  title="Éliminatoires CAN 2027 · Novembre"
  description="RDC – Sierra Leone le 12 novembre au Stade des Martyrs, Sierra Leone – RDC le 17 novembre à El Jadida. Programme, classement du groupe E et mobilisation du Bloc Léopards."
>
  <div class="bg-congo-night text-white">
    <!-- ================= HÉROS ================= -->
    <section class="relative flex min-h-[88svh] items-end overflow-hidden">
      <img src="/media/bloc-tribune-2026/bloc-tribune-243.jpg" alt="" aria-hidden="true" class="absolute inset-0 z-0 h-full w-full object-cover object-[50%_20%] opacity-60" />
      <div class="absolute inset-0 z-0 bg-gradient-to-t from-congo-night via-congo-night/55 to-congo-night/20"></div>

      <div class="relative z-10 mx-auto w-full max-w-[84rem] px-4 pb-14 pt-32 lg:px-8 lg:pb-20">
        <p data-reveal class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-white/80">Éliminatoires CAN 2027 · Groupe E</p>
        <h1 class="mt-4 font-mega uppercase leading-[0.82] text-or [font-size:clamp(4.2rem,16vw,14rem)]">
          <span class="lux-line-mask"><span data-reveal="mask">Novembre</span></span>
        </h1>
        <p data-reveal data-reveal-delay="120" class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">
          Deux matchs contre la Sierra Leone en cinq jours. Kinshasa d'abord, le Maroc ensuite.
        </p>

        {next && (
          <div data-reveal data-reveal-delay="200" class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/60">
                Prochain match · {TEAMS[next.home].name} – {TEAMS[next.away].name}
              </p>
              <div data-countdown={next.kickoff} class="mt-2 flex gap-5 font-mega text-4xl tabular-nums text-white sm:text-5xl" aria-live="off">
                <span><span data-cd="d">--</span><span class="ml-1 font-body text-xs font-semibold uppercase tracking-[0.12em] text-white/50">j</span></span>
                <span><span data-cd="h">--</span><span class="ml-1 font-body text-xs font-semibold uppercase tracking-[0.12em] text-white/50">h</span></span>
                <span><span data-cd="m">--</span><span class="ml-1 font-body text-xs font-semibold uppercase tracking-[0.12em] text-white/50">min</span></span>
              </div>
              <p data-cd-live class="mt-2 hidden text-sm font-semibold text-or">Le match a commencé. Allez les Léopards !</p>
            </div>
          </div>
        )}

        <div data-reveal data-reveal-delay="280" class="mt-9 flex flex-wrap gap-3">
          <a href="/calendrier/can-2027.ics" class="inline-flex min-h-12 items-center rounded-full bg-or px-7 text-[0.78rem] font-black uppercase tracking-[0.12em] text-congo-night transition-colors hover:bg-yellow-300">
            Ajouter au calendrier
          </a>
          <a href={whatsappShare} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center rounded-full border border-white/30 bg-white/10 px-7 text-[0.78rem] font-bold uppercase tracking-[0.12em] text-white backdrop-blur-sm transition-colors hover:border-or hover:text-or">
            Partager sur WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- ================= PROGRAMME ================= -->
    <section id="programme" class="scroll-mt-24 py-20 lg:py-28">
      <div class="mx-auto max-w-[84rem] px-4 lg:px-8">
        <h2 data-reveal class="font-mega text-5xl uppercase leading-none sm:text-6xl">Le programme</h2>
        <p data-reveal class="mt-3 max-w-xl text-white/70">Horaires à l'heure de Kinshasa. Le Maroc est sur le même fuseau en novembre.</p>

        <div class="mt-10 grid gap-5 lg:grid-cols-2">
          {november.map((f, i) => {
            const isHome = f.home === "RDC";
            return (
              <article data-reveal data-reveal-delay={i * 100} class="relative overflow-hidden rounded-[16px] border border-white/15 bg-white/[0.04] p-6 backdrop-blur-sm sm:p-8">
                <div class="flex items-start justify-between gap-4">
                  <span class={`rounded-full px-3 py-1 text-[0.68rem] font-black uppercase tracking-[0.14em] ${isHome ? "bg-or text-congo-night" : "bg-white/10 text-white"}`}>
                    {isHome ? "À domicile" : "À l'extérieur"}
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-[0.14em] text-white/50">Journée {f.matchday}</span>
                </div>

                <div class="mt-6 grid grid-cols-[auto_1fr] items-center gap-5 sm:gap-8">
                  <div class="border-r border-white/15 pr-5 text-center sm:pr-8">
                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/70">{formatMatchDay(f.kickoff!)}</p>
                    <p class="font-mega text-7xl leading-none text-white sm:text-8xl">{dayNumber(f.kickoff!)}</p>
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/50">nov.</p>
                  </div>
                  <div>
                    <p class="flex items-center gap-3 font-display text-3xl uppercase leading-none sm:text-4xl">
                      <img src={TEAMS[f.home].flag} alt="" width="30" height="20" class="h-5 w-[30px] rounded-[2px] object-cover" />
                      {TEAMS[f.home].name}
                    </p>
                    <p class="my-1.5 pl-[42px] text-xs font-bold uppercase tracking-[0.2em] text-white/40">contre</p>
                    <p class="flex items-center gap-3 font-display text-3xl uppercase leading-none sm:text-4xl">
                      <img src={TEAMS[f.away].flag} alt="" width="30" height="20" class="h-5 w-[30px] rounded-[2px] object-cover" />
                      {TEAMS[f.away].name}
                    </p>
                  </div>
                </div>

                <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-5">
                  <p class="text-sm leading-snug text-white/80">
                    <span class="font-semibold text-white">{f.venue}</span><br />
                    {f.city}, {f.country} · <span class="font-semibold text-or">{formatMatchTime(f.kickoff!)}</span>
                  </p>
                  <a href={`/calendrier/can-2027.ics?match=${f.id}`} class="inline-flex min-h-11 items-center rounded-full border border-white/25 px-5 text-[0.72rem] font-bold uppercase tracking-[0.12em] text-white transition-colors hover:border-or hover:text-or">
                    Ajouter ce match
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <p data-reveal class="mt-6 text-sm text-white/55">
          Les autres matchs du groupe : {otherNovember.map((f) => `${TEAMS[f.home].name} – ${TEAMS[f.away].name} (${f.dateLabel})`).join(" · ")}.
        </p>
      </div>
    </section>

    <!-- ================= GROUPE E ================= -->
    <section id="groupe" class="scroll-mt-24 border-y border-white/10 bg-[#071022] py-20 lg:py-28">
      <div class="mx-auto grid max-w-[84rem] gap-10 px-4 lg:grid-cols-12 grid-cols-1 lg:px-8">
        <div class="lg:col-span-4">
          <h2 data-reveal class="font-mega text-5xl uppercase leading-none sm:text-6xl">Le groupe E</h2>
          <p data-reveal class="mt-4 text-white/75">
            Après deux journées, la RDC est en tête avec <strong class="text-white">{rdc.points} points</strong> sur {rdc.played * 3} possibles.
            Les deux premiers du groupe filent à la CAN 2027.
          </p>

          <h3 class="mt-10 text-xs font-semibold uppercase tracking-[0.18em] text-white/50">Septembre, en résumé</h3>
          <ul class="mt-4 space-y-3">
            {results.map((f) => (
              <li class="rounded-[12px] border border-white/10 bg-white/[0.03] p-4">
                <div class="flex items-center justify-between gap-3">
                  <span class="text-sm text-white/80">{TEAMS[f.home].name} – {TEAMS[f.away].name}</span>
                  <span class="font-mega text-2xl tabular-nums text-or">{f.score!.home}–{f.score!.away}</span>
                </div>
                <p class="mt-1 text-xs text-white/50">
                  J{f.matchday} · {f.city}, {formatMatchDate(f.kickoff!)}
                  {f.scorers && <> · {f.scorers.map((s) => `${s.player} ${s.minute}`).join(", ")}</>}
                </p>
              </li>
            ))}
          </ul>
        </div>
        <div data-reveal class="lg:col-span-8">
          <Can2027GroupTable standings={standings} />
        </div>
      </div>
    </section>

    <!-- ================= CONSIGNES DU BLOC ================= -->
    <section id="consignes" class="scroll-mt-24 py-20 lg:py-28">
      <div class="mx-auto max-w-[84rem] px-4 lg:px-8">
        <div class="max-w-2xl">
          <div>
            <p data-reveal class="text-xs font-semibold uppercase tracking-[0.18em] text-or">Jeudi 12 novembre · Stade des Martyrs</p>
            <h2 data-reveal class="mt-3 font-mega text-5xl uppercase leading-[0.9] sm:text-6xl">Le Bloc au rendez-vous</h2>
            <p data-reveal class="mt-4 text-white/75">
              À Kinshasa, on remplit les Martyrs. Au Maroc, la diaspora prend le relais à El Jadida. Rejoignez le Bloc pour recevoir les infos pratiques de chaque match.
            </p>
            <div data-reveal class="mt-8 flex flex-wrap gap-3">
              <a href="/rejoindre" class="inline-flex min-h-12 items-center rounded-full bg-congo px-7 text-[0.78rem] font-black uppercase tracking-[0.12em] text-white transition-colors hover:bg-congo-bright">
                Rejoindre le Bloc
              </a>
              {SHOP_ENABLED && <a href="/boutique/maillot-supporter" class="inline-flex min-h-12 items-center rounded-full border border-white/25 px-7 text-[0.78rem] font-bold uppercase tracking-[0.12em] text-white transition-colors hover:border-or hover:text-or">
                Le maillot supporter
              </a>}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CALENDRIER DE CAMPAGNE + AFFICHE ================= -->
    <section id="calendrier" class="scroll-mt-24 border-t border-white/10 bg-[#071022] py-20 lg:py-28">
      <div class="mx-auto grid max-w-[84rem] items-start gap-12 px-4 lg:grid-cols-12 grid-cols-1 lg:px-8">
        <div class="lg:col-span-7">
          <h2 data-reveal class="font-mega text-5xl uppercase leading-none sm:text-6xl">Les 6 journées</h2>
          <ol class="mt-10 space-y-0">
            {WINDOWS.map((w) => (
              <li data-reveal class="relative grid grid-cols-[1.5rem_1fr] gap-5 pb-9 last:pb-0">
                <span class="absolute left-[11px] top-7 bottom-0 w-px bg-white/15 [li:last-child_&]:hidden" aria-hidden="true"></span>
                <span class={`mt-1 grid h-6 w-6 place-items-center rounded-full border-2 ${
                  w.state === "done" ? "border-or bg-or" : w.state === "current" ? "border-or bg-congo-night" : "border-white/30 bg-congo-night"
                }`} aria-hidden="true">
                  {w.state === "current" && <span class="h-2 w-2 animate-pulse rounded-full bg-or motion-reduce:animate-none"></span>}
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/50">
                    {w.label}{w.state === "current" && <span class="ml-2 rounded-full bg-or px-2 py-0.5 text-[0.62rem] font-black text-congo-night">Maintenant</span>}
                  </p>
                  <p class="mt-1 font-display text-3xl uppercase leading-none">{w.dates}</p>
                  <p class="mt-2 text-sm text-white/70">{w.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <figure data-reveal class="lg:col-span-5">
          <a href={poster} target="_blank" rel="noopener" class="block overflow-hidden rounded-[14px] ring-1 ring-white/15">
            <img src="/media/can-2027/affiche-novembre-2026-800.webp" alt="Affiche Bloc Léopards : RD Congo – Sierra Leone le jeudi 12 novembre au Stade des Martyrs à 17h, Sierra Leone – RD Congo le mardi 17 novembre au stade Ben Ahmed El Abdi d'El Jadida à 17h." width="800" height="1000" loading="lazy" class="h-auto w-full" />
          </a>
          <figcaption class="mt-4 flex flex-wrap items-center gap-3">
            <a href={poster} download="bloc-leopards-novembre-2026.webp" class="inline-flex min-h-11 items-center rounded-full bg-or px-6 text-[0.72rem] font-black uppercase tracking-[0.12em] text-congo-night hover:bg-yellow-300">
              Télécharger l'affiche
            </a>
            <a href={whatsappShare} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center rounded-full border border-white/25 px-6 text-[0.72rem] font-bold uppercase tracking-[0.12em] text-white hover:border-or hover:text-or">
              Partager
            </a>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ================= ACTUALITÉS ================= -->
    {news.length > 0 && (
      <section id="actualites" class="scroll-mt-24 py-20 lg:py-28">
        <div class="mx-auto max-w-[84rem] px-4 lg:px-8">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 data-reveal class="font-mega text-5xl uppercase leading-none sm:text-6xl">Actualités</h2>
            <a href="/actus" class="text-sm font-semibold text-or hover:text-white">Toutes les actualités</a>
          </div>
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {news.map((post) => (
              <article class="group relative overflow-hidden rounded-[14px] border border-white/10 bg-white/[0.03]">
                {post.data.image && (
                  <div class="aspect-video overflow-hidden">
                    <img src={post.data.image} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none" />
                  </div>
                )}
                <div class="p-5">
                  <time datetime={post.data.date} class="text-xs text-white/50">
                    {new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" }).format(new Date(post.data.date))}
                  </time>
                  <h3 class="mt-2 font-display text-2xl uppercase leading-tight group-hover:text-or">
                    <a href={`/actus/${post.slug}`} class="after:absolute after:inset-0">{post.data.title}</a>
                  </h3>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  // Compte à rebours vers le prochain match (mise à jour chaque minute).
  const el = document.querySelector<HTMLElement>("[data-countdown]");
  if (el) {
    const target = Date.parse(el.dataset.countdown!);
    const set = (k: string, v: number) => {
      const n = el.querySelector(`[data-cd="${k}"]`);
      if (n) n.textContent = String(v).padStart(2, "0");
    };
    const tick = () => {
      const ms = target - Date.now();
      if (ms <= 0) {
        el.classList.add("hidden");
        document.querySelector("[data-cd-live]")?.classList.remove("hidden");
        return;
      }
      set("d", Math.floor(ms / 86_400_000));
      set("h", Math.floor(ms / 3_600_000) % 24);
      set("m", Math.floor(ms / 60_000) % 60);
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>
