---
import { requireDatabase } from "../../lib/neon";

let reservations: any[] = [];
// 15 réservations historiques ont été réalisées avant la mise en place de
// l'enregistrement en base. Le total public reste donc base actuelle + historique.
const historicalReservations = 15;
try {
  const sql = requireDatabase();
  reservations = await sql`
    select reservation_code, first_name, last_name, whatsapp, status, quantity
    from billetterie_reservations
    where status <> 'cancelled'
    order by created_at desc
    limit 1000
  `;
} catch (error) {
  console.error("[billetterie] Liste publique indisponible:", error);
}

// Liste officielle des 5 gagnants du jeu-concours CAN 2027 (places offertes au Stade Tata Raphaël)
const contestWinners = [
  { rank: 1, name: "Eric Bangula" },
  { rank: 2, name: "Don de Dieu Mbengo" },
  { rank: 3, name: "Autsai Safi Carine" },
  { rank: 4, name: "Raphaël Mukala" },
  { rank: 5, name: "Grace Kwengani" },
];

const passedCount = reservations.filter((r) => r.status === "paid").length;
const totalTickets = reservations.reduce((acc, r) => acc + (Number(r.quantity) || 1), 0);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inscriptions — Billetterie Tikeo</title>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <a href="/billetterie" class="brand">TIKEO</a>
        <span>BILLETTERIE OFFICIELLE</span>
      </header>

      <section class="hero">
        <p class="eyebrow">SUIVI DES RÉSERVATIONS</p>
        <h1>Retrouvez une réservation</h1>
        <p>Recherchez par nom, prénom, numéro WhatsApp ou code de réservation.</p>
        <p class="activity">
          <strong>{reservations.length + historicalReservations}</strong> personnes au total
          <span aria-hidden="true">·</span>
          <span class="activity-tickets"><strong>{totalTickets}</strong> billets demandés</span>
          <span aria-hidden="true">·</span>
          <strong>{reservations.length}</strong> réservation{reservations.length > 1 ? "s" : ""}
          <span aria-hidden="true">·</span>
          <span class="passed-pill"><strong id="passed-count">{passedCount}</strong> présent{passedCount > 1 ? "s" : ""}</span>
        </p>

        <!-- CARTE OFFICIELLE : LES 5 GAGNANTS DU JEU-CONCOURS -->
        <section class="winners-block" aria-label="Gagnants du jeu-concours CAN 2027">
          <div class="winners-header">
            <span class="winners-pill">🏆 JEU-CONCOURS · 5 PLACES OFFERTES</span>
            <span class="winners-match">RDC vs Guinée Équatoriale</span>
          </div>
          <h2 class="winners-title">Liste des 5 Gagnants</h2>
          <p class="winners-subtitle">
            Tirage au sort officiel — retrait des places au Stade Tata Raphaël :
          </p>
          <div class="winners-grid">
            {contestWinners.map((w) => (
              <div class:list={["winner-chip", { "winner-chip--featured": w.rank === 3 }]}>
                <span class="winner-chip-rank">{w.rank}</span>
                <span class="winner-chip-name">{w.name}</span>
              </div>
            ))}
          </div>
        </section>

        <label class="search">
          <span aria-hidden="true">⌕</span>
          <input
            id="search"
            type="search"
            placeholder="Nom, prénom, WhatsApp ou BL-2026-000000"
            autocomplete="off"
          />
        </label>
      </section>

      <section class="results" aria-live="polite">
        <div id="reservation-list">
          {reservations.map((reservation) => {
            const isPassed = reservation.status === "paid";
            const qty = Number(reservation.quantity) || 1;
            const isWinner = reservation.reservation_code?.startsWith("BL-2026-WIN");
            const cleanDigits = (reservation.whatsapp || "").replace(/[^\d]/g, "");
            const waLink = cleanDigits ? `https://wa.me/${cleanDigits}` : null;
            return (
              <article
                class:list={["reservation", { "reservation--passed": isPassed, "reservation--winner": isWinner }]}
                data-code={reservation.reservation_code}
                data-search={`${reservation.first_name} ${reservation.last_name} ${reservation.reservation_code} ${!isWinner && reservation.whatsapp ? reservation.whatsapp : ""} ${isWinner ? "gagnant concours jeu" : ""} ${qty} billet ${qty} billets`.toLowerCase()}
              >
                <!-- CASE À COCHER (PRÉSENCE / RETRAIT) -->
                <div class="reservation-check">
                  <label class="check-control" title={isPassed ? "Décocher" : "Cocher si la personne se présente"}>
                    <input
                      type="checkbox"
                      class="check-input"
                      data-code={reservation.reservation_code}
                      checked={isPassed}
                    />
                    <span class="check-box" aria-hidden="true"></span>
                    <span class="check-label">Passé</span>
                  </label>
                </div>

                <div class="reservation-person">
                  <span class:list={["avatar", { "avatar--winner": isWinner }]}>
                    {isWinner ? "🏆" : reservation.first_name.charAt(0)}
                  </span>
                  <div class="reservation-info">
                    <div class="reservation-name-line">
                      <strong>{reservation.first_name} {reservation.last_name}</strong>
                      {isWinner && <span class="winner-badge">Gagnant Concours</span>}
                    </div>

                    {!isWinner && reservation.whatsapp && waLink && (
                      <a
                        href={waLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="whatsapp-pill"
                        title={`Ouvrir WhatsApp (${reservation.whatsapp})`}
                      >
                        <svg class="whatsapp-icon" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
                          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.01-1.24-.75-.67-1.25-1.49-1.4-1.74-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45s-.56-1.35-.77-1.85c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.61c.13.17 1.77 2.7 4.28 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.18-.48-.3"/>
                        </svg>
                        <span>{reservation.whatsapp}</span>
                      </a>
                    )}
                  </div>
                </div>

                <div class="reservation-meta">
                  <!-- NOMBRE DE BILLETS DEMANDÉS -->
                  <span class="badge-qty" title="Nombre de billets demandés">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect width="18" height="13" x="3" y="5" rx="2"/>
                      <path d="M3 10h18"/>
                      <path d="M8 14h.01"/>
                      <path d="M12 14h.01"/>
                      <path d="M16 14h.01"/>
                    </svg>
                    <strong>{qty}</strong> {qty > 1 ? "billets" : "billet"}
                  </span>

                  <code>{reservation.reservation_code}</code>
                  <b class:list={["status-badge", { "status-badge--winner": isWinner }]}>
                    {isPassed ? "RETIRÉ" : isWinner ? "OFFERT" : "ENREGISTRÉE"}
                  </b>
                </div>
              </article>
            );
          })}
          {reservations.length === 0 && <div class="empty" id="initial-empty">Aucune réservation enregistrée.</div>}
          <div class="empty" id="search-empty" hidden>Aucune réservation trouvée.</div>
        </div>
      </section>
    </main>
  </body>
</html>

<script>
  const input = document.getElementById('search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-search]'));
  const empty = document.getElementById('search-empty');
  const filterReservations = () => {
    const query = (input?.value || '').trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || (card.getAttribute('data-search') || '').includes(query);
      card.toggleAttribute('hidden', !matches);
      if (matches) visible += 1;
    });
    if (empty) empty.toggleAttribute('hidden', !query || visible > 0);
  };
  input?.addEventListener('input', filterReservations);

  // Synchronisation des cases à cocher (Base de données + localStorage backup)
  const LOCAL_STORAGE_KEY = 'tikeo_checked_reservations_v2';
  let localChecked = new Set<string>();
  try {
    const saved = localStorage.getItem(LOCAL_STORAGE_KEY);
    if (saved) localChecked = new Set(JSON.parse(saved));
  } catch (e) {}

  const checkboxes = document.querySelectorAll<HTMLInputElement>('.check-input');

  function updatePassedCountDisplay() {
    const totalPassed = document.querySelectorAll<HTMLInputElement>('.check-input:checked').length;
    const badge = document.getElementById('passed-count');
    if (badge) badge.textContent = String(totalPassed);
  }

  checkboxes.forEach((cb) => {
    const code = cb.dataset.code;
    const card = cb.closest<HTMLElement>('.reservation');
    const badge = card?.querySelector('.status-badge');

    // Restore from localStorage if needed
    if (code && localChecked.has(code) && !cb.checked) {
      cb.checked = true;
      card?.classList.add('reservation--passed');
      if (badge) badge.textContent = 'RETIRÉ';
    }

    cb.addEventListener('change', async () => {
      const isChecked = cb.checked;
      if (isChecked) {
        card?.classList.add('reservation--passed');
        if (badge) badge.textContent = 'RETIRÉ';
        if (code) localChecked.add(code);
      } else {
        card?.classList.remove('reservation--passed');
        if (badge) badge.textContent = 'ENREGISTRÉE';
        if (code) localChecked.delete(code);
      }

      try {
        localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(Array.from(localChecked)));
      } catch (e) {}

      updatePassedCountDisplay();

      if (code) {
        try {
          await fetch('/api/billetterie/checkin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code, checked: isChecked })
          });
        } catch (err) {
          console.warn('[checkin] Erreur sync réseau:', err);
        }
      }
    });
  });

  updatePassedCountDisplay();
</script>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: #f5f8fc; color: #10213d; font-family: Arial, sans-serif; }
  .page { min-height: 100vh; }
  .header { display: flex; align-items: center; gap: 1rem; padding: 1.25rem max(1.25rem, calc((100% - 76rem) / 2)); background: #10213d; color: #aebbd0; font-size: .72rem; font-weight: 700; letter-spacing: .12em; }
  .brand { color: #fff; font-size: 1.15rem; letter-spacing: .2em; text-decoration: none; }
  .hero, .results { width: min(100% - 2rem, 58rem); margin: auto; }
  .hero { padding: 4rem 0 2rem; }
  .eyebrow { margin: 0; color: #d32f2f; font-size: .72rem; font-weight: 800; letter-spacing: .14em; }
  h1 { margin: .7rem 0; font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 1.05; letter-spacing: -.035em; }
  .hero p:not(.eyebrow) { color: #637692; font-size: 1.05rem; }
  .activity { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .55rem; margin: 1rem 0 0; color: #637692 !important; font-size: .78rem !important; letter-spacing: .01em; }
  .activity strong { color: #1769d1; font-size: 1.05rem; }
  .activity span { color: #d32f2f; }
  .activity-tickets { display: inline-flex; align-items: center; gap: .25rem; }
  .activity-tickets strong { color: #0f56b3 !important; }
  .passed-pill { display: inline-flex; align-items: center; gap: .3rem; padding: .15rem .55rem; background: #e8f7ef; border: 1px solid #c0ebd2; border-radius: 999px; color: #16824b !important; }
  .passed-pill strong { color: #16824b !important; }

  /* Bloc Gagnants Concours */
  .winners-block {
    margin: 2rem 0 1.25rem;
    padding: 1.35rem 1.5rem;
    background: linear-gradient(135deg, #0e1e38 0%, #152c52 100%);
    border: 1.5px solid #f59e0b;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(16, 33, 61, 0.12), 0 0 0 1px rgba(245, 158, 11, 0.2);
    color: #fff;
  }
  .winners-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: .6rem;
  }
  .winners-pill {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .25rem .7rem;
    background: rgba(245, 158, 11, 0.2);
    border: 1px solid rgba(245, 158, 11, 0.5);
    border-radius: 999px;
    color: #fbbf24;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .08em;
  }
  .winners-match {
    color: #93c5fd;
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .winners-title {
    margin: 0 0 .3rem;
    font-size: 1.35rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: -.02em;
  }
  .winners-subtitle {
    margin: 0 0 1.1rem;
    color: #cbd5e1 !important;
    font-size: .84rem !important;
  }
  .winners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: .65rem;
  }
  .winner-chip {
    display: flex;
    align-items: center;
    gap: .7rem;
    padding: .6rem .85rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    transition: transform 160ms ease, border-color 160ms ease;
  }
  .winner-chip:hover {
    transform: translateY(-2px);
    border-color: #fbbf24;
  }
  .winner-chip--featured {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.45);
  }
  .winner-chip-rank {
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    background: #f59e0b;
    color: #10213d;
    font-size: .75rem;
    font-weight: 900;
    flex: none;
  }
  .winner-chip-name {
    font-size: .86rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search { display: flex; align-items: center; gap: .65rem; margin-top: 1.75rem; padding: 0 1rem; border: 1px solid #d8e2ee; border-radius: 8px; background: #fff; box-shadow: 0 10px 30px rgba(16,33,61,.06); transition: border-color 180ms ease, box-shadow 180ms ease; }
  .search:focus-within { border-color: #1769d1; box-shadow: 0 0 0 3px rgba(23,105,209,.1); }
  .search span { color: #1769d1; font-size: 1.5rem; }
  .search input { width: 100%; min-height: 3.6rem; border: 0; outline: 0; color: #10213d; background: transparent; font-size: 1rem; }
  .results { padding-bottom: 4rem; }
  #reservation-list { display: grid; gap: .75rem; }

  /* Carte Réservation */
  .reservation {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 5.25rem;
    padding: .9rem 1.15rem;
    border: 1px solid #dce4ee;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(16,33,61,.04);
    transition: background 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }
  .reservation:hover {
    border-color: #c0d1e5;
    box-shadow: 0 6px 20px rgba(16,33,61,.07);
  }
  .reservation--passed {
    background: #f6fbf8;
    border-color: #9fe0be;
    box-shadow: 0 4px 14px rgba(22, 130, 75, 0.08);
  }

  /* Case à cocher */
  .reservation-check {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .check-control {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    cursor: pointer;
    user-select: none;
    padding: .45rem .6rem;
    border-radius: 6px;
    background: #f3f6fa;
    transition: background 150ms ease;
  }
  .check-control:hover {
    background: #e6edf7;
  }
  .reservation--passed .check-control {
    background: #e5f6ec;
  }
  .check-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }
  .check-box {
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid #a4b6cb;
    border-radius: 4px;
    background: #fff;
    display: grid;
    place-items: center;
    transition: all 150ms ease;
    flex: none;
    position: relative;
  }
  .check-input:checked + .check-box {
    background: #16824b;
    border-color: #16824b;
  }
  .check-input:checked + .check-box::after {
    content: "";
    width: 4px;
    height: 8px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-top: -2px;
  }
  .check-label {
    font-size: .75rem;
    font-weight: 700;
    color: #556984;
    letter-spacing: .02em;
  }
  .check-input:checked ~ .check-label {
    color: #16824b;
    font-weight: 800;
  }

  /* Person info */
  .reservation-person { display: flex; align-items: center; gap: .85rem; min-width: 0; }
  .avatar { display: grid; place-items: center; width: 2.65rem; height: 2.65rem; flex: none; border-radius: 50%; background: #eaf2fc; color: #1769d1; font-size: .95rem; font-weight: 800; text-transform: uppercase; }
  .reservation--passed .avatar { background: #d7f2e3; color: #16824b; }
  .reservation-info { display: grid; gap: .25rem; min-width: 0; }
  .reservation-name-line { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .reservation strong { overflow: hidden; color: #111827; font-size: 1rem; text-overflow: ellipsis; white-space: nowrap; }

  /* Badge Nombre de billets */
  .badge-qty {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .35rem .6rem;
    background: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .01em;
    white-space: nowrap;
  }
  .badge-qty strong {
    font-size: .84rem;
    font-weight: 800;
    color: #1d4ed8;
  }
  .reservation--passed .badge-qty {
    background: #ecfdf5;
    color: #065f46;
    border-color: #a7f3d0;
  }
  .reservation--passed .badge-qty strong {
    color: #047857;
  }

  /* WhatsApp Pill */
  .whatsapp-pill {
    display: inline-flex;
    align-items: center;
    gap: .38rem;
    width: fit-content;
    padding: .2rem .55rem;
    background: #eafaf1;
    color: #0d6e3b;
    border: 1px solid rgba(37, 211, 102, 0.4);
    border-radius: 999px;
    text-decoration: none;
    font-size: .76rem;
    font-weight: 700;
    transition: all 140ms ease;
  }
  .whatsapp-pill:hover {
    background: #d6f6e2;
    border-color: #25d366;
    color: #075029;
    box-shadow: 0 2px 8px rgba(37, 211, 102, 0.25);
    transform: translateY(-1px);
  }
  .whatsapp-icon { color: #25d366; flex: none; }

  /* Meta code & Status */
  .reservation-meta { display: flex; align-items: center; gap: .65rem; flex: none; flex-wrap: wrap; justify-content: flex-end; }
  .reservation code { padding: .45rem .6rem; border: 1px solid #e4e4e0; border-radius: 5px; color: #40536d; background: #f7f7f4; font-size: .76rem; white-space: nowrap; }
  .status-badge { padding: .45rem .6rem; border-radius: 5px; background: #e8f7ef; color: #16824b; font-size: .62rem; font-weight: 800; letter-spacing: .08em; white-space: nowrap; }
  .status-badge--winner { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
  .reservation--passed .status-badge { background: #16824b; color: #ffffff; }

  /* Badges Gagnant */
  .winner-badge {
    display: inline-flex;
    align-items: center;
    padding: .15rem .5rem;
    background: #fef3c7;
    border: 1px solid #fde68a;
    border-radius: 999px;
    color: #92400e;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .02em;
  }
  .avatar--winner {
    background: #fef3c7 !important;
    color: #d97706 !important;
    font-size: 1.15rem !important;
  }
  .reservation--winner {
    border-color: #fde68a;
    background: #fffdf5;
  }
  .reservation--winner.reservation--passed {
    background: #f6fbf8;
    border-color: #9fe0be;
  }

  .empty { padding: 2.5rem; border: 1px dashed #bdcadd; border-radius: 8px; color: #637692; background: rgba(255,255,255,.5); text-align: center; }

  @media (max-width: 680px) {
    .header { padding: 1rem; }
    .hero { padding-top: 2.5rem; }
    .reservation {
      grid-template-columns: 1fr;
      gap: .75rem;
      padding: .85rem 1rem;
    }
    .reservation-check {
      justify-content: flex-start;
    }
    .reservation-meta {
      justify-content: space-between;
      width: 100%;
      border-top: 1px solid #edf2f7;
      padding-top: .6rem;
    }
    .reservation code { font-size: .7rem; }
  }
</style>
