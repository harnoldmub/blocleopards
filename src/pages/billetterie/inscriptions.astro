---
import { requireDatabase } from "../../lib/neon";

let reservations: any[] = [];
try {
  const sql = requireDatabase();
  reservations = await sql`
    select reservation_code, first_name, last_name, status
    from billetterie_reservations
    where status <> 'cancelled'
    order by created_at desc
    limit 1000
  `;
} catch (error) {
  console.error("[billetterie] Liste publique indisponible:", error);
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inscriptions — Billetterie Tikeo</title>
  </head>
  <body>
    <main class="page">
      <header class="header"><a href="/billetterie" class="brand">TIKEO</a><span>BILLETTERIE OFFICIELLE</span></header>
      <section class="hero"><p class="eyebrow">SUIVI DES RÉSERVATIONS</p><h1>Retrouvez une réservation</h1><p>Recherchez par nom, prénom ou code de réservation.</p><label class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Nom, prénom ou BL-2026-000000" autocomplete="off" /></label></section>
      <section class="results" aria-live="polite">
        <div id="reservation-list">
          {reservations.map((reservation) => (
            <article class="reservation" data-search={`${reservation.first_name} ${reservation.last_name} ${reservation.reservation_code}`.toLowerCase()}>
              <div class="reservation-person"><span class="avatar">{reservation.first_name.charAt(0)}</span><div><strong>{reservation.first_name} {reservation.last_name}</strong><span>Pré-réservation enregistrée</span></div></div>
              <div class="reservation-meta"><code>{reservation.reservation_code}</code><b>ENREGISTRÉE</b></div>
            </article>
          ))}
          {reservations.length === 0 && <div class="empty" id="initial-empty">Aucune réservation enregistrée.</div>}
          <div class="empty" id="search-empty" hidden>Aucune réservation trouvée.</div>
        </div>
      </section>
    </main>
  </body>
</html>

<script>
  const input = document.getElementById('search');
  const cards = Array.from(document.querySelectorAll('[data-search]'));
  const empty = document.getElementById('search-empty');
  const filterReservations = () => {
    const query = (input.value || '').trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || (card.getAttribute('data-search') || '').includes(query);
      card.toggleAttribute('hidden', !matches);
      if (matches) visible += 1;
    });
    if (empty) empty.toggleAttribute('hidden', !query || visible > 0);
  };
  input?.addEventListener('input', filterReservations);
</script>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: #f5f8fc; color: #10213d; font-family: Arial, sans-serif; }
  .page { min-height: 100vh; }
  .header { display: flex; align-items: center; gap: 1rem; padding: 1.25rem max(1.25rem, calc((100% - 76rem) / 2)); background: #10213d; color: #aebbd0; font-size: .72rem; font-weight: 700; letter-spacing: .12em; }
  .brand { color: #fff; font-size: 1.15rem; letter-spacing: .2em; text-decoration: none; }
  .hero, .results { width: min(100% - 2rem, 58rem); margin: auto; }
  .hero { padding: 4rem 0 2rem; }
  .eyebrow { margin: 0; color: #d32f2f; font-size: .72rem; font-weight: 800; letter-spacing: .14em; }
  h1 { margin: .7rem 0; font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 1.05; letter-spacing: -.035em; }
  .hero p:not(.eyebrow) { color: #637692; font-size: 1.05rem; }
  .search { display: flex; align-items: center; gap: .65rem; margin-top: 1.75rem; padding: 0 1rem; border: 1px solid #d8e2ee; border-radius: 8px; background: #fff; box-shadow: 0 10px 30px rgba(16,33,61,.06); transition: border-color 180ms ease, box-shadow 180ms ease; }
  .search:focus-within { border-color: #1769d1; box-shadow: 0 0 0 3px rgba(23,105,209,.1); }
  .search span { color: #1769d1; font-size: 1.5rem; }
  .search input { width: 100%; min-height: 3.6rem; border: 0; outline: 0; color: #10213d; background: transparent; font-size: 1rem; }
  .results { padding-bottom: 4rem; }
  #reservation-list { display: grid; gap: .75rem; }
  .reservation { display: flex; justify-content: space-between; align-items: center; gap: 1.25rem; min-height: 5rem; padding: 1rem 1.15rem; border: 1px solid #dce4ee; border-radius: 8px; background: #fff; box-shadow: 0 5px 18px rgba(16,33,61,.04); }
  .reservation-person { display: flex; align-items: center; gap: .85rem; min-width: 0; }
  .reservation-person > div { display: grid; gap: .28rem; min-width: 0; }
  .avatar { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; flex: none; border-radius: 50%; background: #eaf2fc; color: #1769d1; font-size: .9rem; font-weight: 800; text-transform: uppercase; }
  .reservation strong { overflow: hidden; color: #111827; font-size: 1rem; text-overflow: ellipsis; white-space: nowrap; }
  .reservation-person span:not(.avatar) { color: #7a8799; font-size: .78rem; }
  .reservation-meta { display: flex; align-items: center; gap: .65rem; flex: none; }
  .reservation code { padding: .45rem .6rem; border: 1px solid #e4e4e0; border-radius: 5px; color: #40536d; background: #f7f7f4; font-size: .76rem; white-space: nowrap; }
  .reservation b { padding: .45rem .6rem; border-radius: 5px; background: #e8f7ef; color: #16824b; font-size: .62rem; letter-spacing: .08em; white-space: nowrap; }
  .empty { padding: 2.5rem; border: 1px dashed #bdcadd; border-radius: 8px; color: #637692; background: rgba(255,255,255,.5); text-align: center; }
  @media (max-width: 600px) {
    .header { padding: 1rem; }
    .hero { padding-top: 2.5rem; }
    .reservation { display: grid; gap: .85rem; }
    .reservation-meta { justify-content: space-between; width: 100%; padding-left: 3.35rem; }
    .reservation code { font-size: .7rem; }
  }
</style>
