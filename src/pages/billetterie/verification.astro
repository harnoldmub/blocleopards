---
const reservation = Astro.url.searchParams.get("reservation")?.trim() || "";
const prenom = Astro.url.searchParams.get("prenom")?.trim() || "";
const nom = Astro.url.searchParams.get("nom")?.trim() || "";
const valid = /^BL-2026-\d{6}$/.test(reservation);
const fullName = [prenom, nom].filter(Boolean).join(" ") || "Nom non renseigné";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{valid ? "Réservation valide" : "Réservation invalide"} — Tikeo</title>
  </head>
  <body>
    <main class:list={["verification", { "verification--invalid": !valid }]}>
      <div class="verification-card">
        <div class="verification-mark" aria-hidden="true">{valid ? "✓" : "!"}</div>
        <p class="verification-kicker">VÉRIFICATION DE RÉSERVATION</p>
        <h1>{valid ? "Réservation valide" : "Réservation invalide"}</h1>
        <p class="verification-status">{valid ? "Cette pré-réservation est reconnue par la billetterie." : "Ce numéro de dossier n’est pas reconnu."}</p>
        {valid && <div class="verification-details"><span>N° DE DOSSIER</span><strong>{reservation}</strong><span>NOM DU SUPPORTER</span><strong>{fullName}</strong><span>RETRAIT DU BILLET</span><strong>Stade Tata Raphaël</strong></div>}
        {!valid && <p class="verification-help">Scannez un QR code officiel ou vérifiez le numéro de dossier.</p>}
        <a href="/billetterie">Retour à la billetterie</a>
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f5f8fc; color: #10213d; font-family: Arial, sans-serif; }
  .verification { min-height: 100vh; display: grid; place-items: center; padding: 1.25rem; }
  .verification-card { width: min(100%, 30rem); max-width: 30rem; padding: 2.25rem 2rem; border: 1px solid #dce5f0; border-radius: 1.25rem; background: #fff; text-align: center; box-shadow: 0 20px 50px rgba(16,33,61,.1); }
  .verification-mark { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; margin: 0 auto 1rem; border-radius: 50%; background: #e8f7ef; color: #16824b; font-size: 2rem; font-weight: 800; }
  .verification--invalid .verification-mark { background: #fff0f0; color: #c62828; }
  .verification-kicker, .verification-details span { color: #1769d1; font-size: .72rem; font-weight: 800; letter-spacing: .12em; }
  h1 { margin: .65rem 0; font-size: clamp(1.7rem, 5vw, 2.4rem); }
  .verification-status, .verification-help { color: #637692; line-height: 1.55; }
  .verification-details { display: grid; gap: .35rem; margin: 1.5rem 0; padding: 1rem; border-left: 4px solid #d32f2f; border-radius: 0 .75rem .75rem 0; background: #fff5f5; text-align: left; }
  .verification-details span:not(:first-child) { margin-top: .7rem; }
  .verification-details strong { font-size: 1.05rem; }
  a { display: inline-block; margin-top: 1rem; padding: .85rem 1.2rem; border-radius: 999px; background: #10213d; color: #fff; text-decoration: none; font-weight: 700; }
</style>
