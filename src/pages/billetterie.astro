---
import TicketingExperience from "../components/billetterie/TicketingExperience.astro";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tikeo — Billetterie Officielle</title>
    <meta name="description" content="Billetterie officielle du match RDC vs Guinée Équatoriale au Stade des Martyrs de Kinshasa." />
    <meta name="robots" content="index, follow" />
    {turnstileSiteKey && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}
  </head>
  <body>
    <TicketingExperience lang="fr" />
  </body>
</html>

