---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Turnstile from "../components/Turnstile.astro";
---
<BaseLayout title="Contact" description="Contacter l'équipe du Bloc Léopards.">
  <PageHero title="Contact" subtitle="Nous écrire" image="/media/atelier-1.svg" />
  <section class="mx-auto max-w-5xl px-4 py-16">
    {Astro.url.searchParams.get("status") === "success" && (
      <div class="mb-6 rounded-[6px] border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">
        Message enregistré. L'équipe revient vers toi rapidement.
      </div>
    )}
    {Astro.url.searchParams.get("status") === "error" && (
      <div class="mb-6 rounded-[6px] border border-red-200 bg-red-50 p-4 text-sm text-red-800">
        Impossible d'enregistrer le message pour le moment. Vérifie la connexion Neon.
      </div>
    )}
    {Astro.url.searchParams.get("status") === "captcha" && (
      <div class="mb-6 rounded-[6px] border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        Merci de valider le contrôle anti-robot avant d'envoyer le formulaire.
      </div>
    )}
    <form name="contact" method="POST" action="/api/contact" class="bloc-panel grid gap-4 p-6 text-sm">
      <input name="_hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
      <input name="_t" type="hidden" id="contact-t" />
      <script>document.getElementById('contact-t').value = Date.now();</script>
      <div class="grid gap-3 md:grid-cols-2">
        <label class="bloc-field">
          <span class="bloc-label">Nom</span>
          <input name="nom" required class="bloc-control" />
        </label>
        <label class="bloc-field">
          <span class="bloc-label">Email</span>
          <input type="email" name="email" required class="bloc-control" />
        </label>
      </div>
      <label class="bloc-field">
        <span class="bloc-label">Objet</span>
        <input name="objet" required class="bloc-control" />
      </label>
      <label class="bloc-field">
        <span class="bloc-label">Message</span>
        <textarea name="message" rows="5" class="bloc-control"></textarea>
      </label>

      <Turnstile />

      <button type="submit" class="bloc-submit px-6 py-3.5">Envoyer</button>
    </form>

    <div class="mt-8 rounded-[6px] border border-slate-200 bg-slate-50 p-6 text-sm text-slate-600">
      <p>Email : contact@blocaleopards.cd</p>
      <p>Adresse : Kinshasa, RDC</p>
    </div>
  </section>
</BaseLayout>
