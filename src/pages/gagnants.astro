---
import BaseLayout from "../layouts/BaseLayout.astro";

// Liste officielle des 5 gagnants du jeu-concours CAN 2027
// Tous les gagnants bénéficient du même traitement et de la même présentation
const winners = [
  { rank: 1, name: "Eric Bangula" },
  { rank: 2, name: "Don de Dieu Mbengo" },
  { rank: 3, name: "Autsai Safi Carine" },
  { rank: 4, name: "Raphaël Mukala" },
  { rank: 5, name: "Grace Kwengani" },
];
---

<BaseLayout
  title="Les 5 Gagnants du Jeu-Concours"
  description="Félicitations aux 5 gagnants du jeu-concours Bloc Léopards pour le match des Éliminatoires CAN 2027 RDC vs Guinée Équatoriale au Stade des Martyrs."
>
  <div class="relative min-h-screen overflow-hidden bg-[#050B18] text-white">
    <!-- Toile d'animation confettis & célébration (au-dessus du fond, sous les cartes) -->
    <canvas id="celebration-canvas" class="pointer-events-none fixed inset-0 z-10 h-full w-full" aria-hidden="true"></canvas>

    <!-- Halos de lumière ambiants en arrière-plan -->
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[32rem] w-[50rem] -translate-x-1/2 rounded-full bg-gradient-to-b from-or/20 via-brand-blue/15 to-transparent blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-1/3 -left-32 h-80 w-80 rounded-full bg-feu/15 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-1/2 -right-32 h-80 w-80 rounded-full bg-brand-blue/20 blur-3xl" aria-hidden="true"></div>

    <div class="relative z-20 mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      
      <!-- EN-TÊTE DE LA CÉLÉBRATION -->
      <header class="text-center anim-fade-in">
        <div class="inline-flex items-center gap-2 rounded-full border border-or/40 bg-or/10 px-4 py-1.5 text-xs font-black uppercase tracking-[0.2em] text-or shadow-lg shadow-or/10 backdrop-blur-md">
          <svg class="h-4 w-4 animate-spin-slow" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span>Tirage Officiel · Jeu-Concours CAN 2027</span>
        </div>

        <h1 class="mt-6 font-mega uppercase tracking-tight text-white [font-size:clamp(2.75rem,8vw,5.5rem)] leading-none">
          LES 5 <span class="text-transparent bg-clip-text bg-gradient-to-r from-or via-yellow-200 to-or">GAGNANTS</span>
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-base text-white/80 sm:text-lg leading-relaxed">
          Félicitations aux <strong>5 supporters</strong> tirés au sort qui remportent chacun leur place offerte pour soutenir les Léopards de la RDC face à la Guinée Équatoriale au <strong>Stade des Martyrs</strong> de Kinshasa !
        </p>

        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <button
            id="relaunch-confetti"
            type="button"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-5 py-2.5 text-xs font-extrabold uppercase tracking-wider text-white backdrop-blur-sm transition-all hover:scale-105 hover:border-or hover:bg-or hover:text-congo-night shadow-md"
            title="Relancer l'animation de fête"
          >
            <span aria-hidden="true">🎉</span>
            <span>Relancer la fête</span>
          </button>
          <a
            href="/billetterie/inscriptions"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white/90 backdrop-blur-sm transition-all hover:bg-white/15"
          >
            <span>Voir l'émargement complet →</span>
          </a>
        </div>
      </header>

      <!-- GRILLE DES 5 GAGNANTS (TOUS STRICTEMENT IDENTIQUES) -->
      <section class="mt-14 sm:mt-18" aria-label="Liste officielle des 5 gagnants">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {winners.map((winner, idx) => (
            <article
              class="winner-card group relative overflow-hidden rounded-2xl border border-white/15 bg-gradient-to-b from-white/[0.08] via-white/[0.04] to-white/[0.02] p-6 shadow-xl backdrop-blur-md transition-all duration-300 hover:-translate-y-1.5 hover:border-or/60 hover:shadow-2xl hover:shadow-or/10"
              style={`animation-delay: ${(idx + 1) * 120}ms`}
            >
              <!-- Lueur subtile au survol -->
              <div class="pointer-events-none absolute -inset-px rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100 bg-gradient-to-b from-or/20 via-transparent to-transparent" aria-hidden="true"></div>

              <div class="relative z-10 flex items-start justify-between gap-4">
                <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 font-mega text-lg font-black text-or shadow-inner border border-white/10 group-hover:bg-or group-hover:text-congo-night transition-colors">
                  {winner.rank}
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-emerald-300">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  Billet Offert
                </span>
              </div>

              <div class="relative z-10 mt-6">
                <p class="text-xs font-semibold uppercase tracking-widest text-white/60">Gagnant tiré au sort</p>
                <h2 class="mt-1 font-sans text-xl font-bold tracking-tight text-white group-hover:text-yellow-200 transition-colors">
                  {winner.name}
                </h2>
              </div>

              <div class="relative z-10 mt-6 border-t border-white/10 pt-4 flex items-center justify-between text-xs text-white/65">
                <span>RDC vs Guinée Équatoriale</span>
                <span class="font-mono font-semibold text-or/90">BL-2026-WIN00{winner.rank}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- PANNEAU INFORMATIF : MODALITÉS DE RETRAIT -->
      <section class="mt-14 sm:mt-18 rounded-3xl border border-white/15 bg-gradient-to-br from-white/[0.06] to-white/[0.02] p-6 sm:p-10 shadow-2xl backdrop-blur-md anim-fade-in" style="animation-delay: 750ms">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 border-b border-white/10 pb-6">
          <div>
            <span class="text-xs font-black uppercase tracking-[0.2em] text-or">CONSIGNES PRATIQUES</span>
            <h3 class="mt-1 text-2xl font-black uppercase tracking-tight text-white">Retrait de votre invitation</h3>
          </div>
          <div class="inline-flex items-center gap-2 rounded-xl bg-white/5 border border-white/10 px-4 py-2 text-xs font-semibold text-white/80">
            <svg class="h-4 w-4 text-or" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
            </svg>
            <span>Jeudi 24 septembre 2026</span>
          </div>
        </div>

        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
            <span class="text-xs font-bold uppercase tracking-wider text-or">1. LIEU DE RETRAIT</span>
            <p class="mt-2 text-base font-bold text-white">Stade Tata Raphaël</p>
            <p class="mt-1 text-xs text-white/60 leading-relaxed">Point d'accueil et tribune des supporters organisée par le Bloc Léopards.</p>
          </div>

          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
            <span class="text-xs font-bold uppercase tracking-wider text-or">2. JUSTIFICATIF</span>
            <p class="mt-2 text-base font-bold text-white">Pièce d'identité</p>
            <p class="mt-1 text-xs text-white/60 leading-relaxed">Présentez une pièce d'identité valide correspondant au nom du gagnant.</p>
          </div>

          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
            <span class="text-xs font-bold uppercase tracking-wider text-or">3. ÉMARGEMENT</span>
            <p class="mt-2 text-base font-bold text-white">Liste officielle</p>
            <p class="mt-1 text-xs text-white/60 leading-relaxed">Vos noms sont déjà enregistrés sur le terminal de contrôle des organisateurs.</p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4 pt-4">
          <p class="text-xs text-white/60">
            Une question ? Rendez-vous sur place au point d'accueil Bloc Léopards.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/billetterie"
              class="rounded-full bg-or px-6 py-3 text-xs font-black uppercase tracking-wider text-congo-night shadow-lg shadow-or/20 transition hover:bg-yellow-300"
            >
              Billetterie Officielle →
            </a>
            <a
              href="/can-2027"
              class="rounded-full border border-white/20 bg-white/10 px-6 py-3 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-white/20"
            >
              Campagne CAN 2027
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  /* Animations d'apparition avec courbe spring fluide */
  .anim-fade-in {
    opacity: 0;
    transform: translateY(18px);
    animation: fadeInUp 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .winner-card {
    opacity: 0;
    transform: translateY(28px) scale(0.96);
    animation: cardEntrance 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cardEntrance {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .animate-spin-slow {
    animation: spin 10s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-fade-in,
    .winner-card {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .animate-spin-slow {
      animation: none !important;
    }
  }
</style>

<script>
  // Animation de confettis sur canvas natif (haute performance, zéro dépendance)
  class CelebrationCanvas {
    private canvas: HTMLCanvasElement | null = null;
    private ctx: CanvasRenderingContext2D | null = null;
    private particles: any[] = [];
    private animationId: number | null = null;
    private colors = [
      "#F4C400", // Or Léopards
      "#FFD700", // Jaune éclatant
      "#1466E0", // Bleu Congo
      "#1E7BFF", // Bleu vif
      "#D81E27", // Rouge Léopards
      "#FFFFFF"  // Blanc pur
    ];

    constructor() {
      this.init();
    }

    private init() {
      this.canvas = document.getElementById("celebration-canvas") as HTMLCanvasElement;
      if (!this.canvas) return;
      this.ctx = this.canvas.getContext("2d");
      if (!this.ctx) return;

      this.resize();
      window.addEventListener("resize", () => this.resize());

      // Vérification reduced motion
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!prefersReducedMotion) {
        // Double salve festive au chargement
        this.burst(70, 0.3, 0.4);
        setTimeout(() => this.burst(70, 0.7, 0.4), 250);
        setTimeout(() => this.burst(90, 0.5, 0.3), 550);
        this.startLoop();
      }

      // Bouton pour relancer la fête
      const btn = document.getElementById("relaunch-confetti");
      btn?.addEventListener("click", () => {
        this.burst(100, 0.5, 0.4);
        setTimeout(() => this.burst(70, 0.2, 0.5), 180);
        setTimeout(() => this.burst(70, 0.8, 0.5), 360);
        this.startLoop();
      });
    }

    private resize() {
      if (!this.canvas) return;
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;
    }

    public burst(count: number, originX: number, originY: number) {
      if (!this.canvas) return;
      const startX = this.canvas.width * originX;
      const startY = this.canvas.height * originY;

      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 4 + Math.random() * 9;
        const color = this.colors[Math.floor(Math.random() * this.colors.length)];
        const size = 5 + Math.random() * 6;

        this.particles.push({
          x: startX,
          y: startY,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 3,
          size,
          color,
          rotation: Math.random() * 360,
          rotationSpeed: (Math.random() - 0.5) * 10,
          gravity: 0.18,
          drag: 0.96,
          wobble: Math.random() * 10,
          wobbleSpeed: 0.08 + Math.random() * 0.05,
          opacity: 1,
          decay: 0.005 + Math.random() * 0.008,
          shape: Math.random() > 0.3 ? "rect" : "circle"
        });
      }
    }

    private startLoop() {
      if (this.animationId !== null) return;

      const loop = () => {
        if (!this.ctx || !this.canvas) return;

        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];

          p.vx *= p.drag;
          p.vy = p.vy * p.drag + p.gravity;
          p.x += p.vx;
          p.y += p.vy;
          p.rotation += p.rotationSpeed;
          p.wobble += p.wobbleSpeed;
          p.opacity -= p.decay;

          if (p.opacity <= 0 || p.y > this.canvas.height + 20) {
            this.particles.splice(i, 1);
            continue;
          }

          this.ctx.save();
          this.ctx.translate(p.x, p.y);
          this.ctx.rotate((p.rotation * Math.PI) / 180);
          this.ctx.scale(Math.cos(p.wobble), 1);
          this.ctx.globalAlpha = Math.max(0, p.opacity);
          this.ctx.fillStyle = p.color;

          if (p.shape === "rect") {
            this.ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
          } else {
            this.ctx.beginPath();
            this.ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
            this.ctx.fill();
          }

          this.ctx.restore();
        }

        if (this.particles.length > 0) {
          this.animationId = requestAnimationFrame(loop);
        } else {
          this.animationId = null;
        }
      };

      this.animationId = requestAnimationFrame(loop);
    }
  }

  // Initialisation à chaque chargement de page (support Astro View Transitions)
  function setupCelebration() {
    new CelebrationCanvas();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCelebration);
  } else {
    setupCelebration();
  }
  document.addEventListener("astro:page-load", setupCelebration);
</script>
