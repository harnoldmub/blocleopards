---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import MatchBanner from "../components/MatchBanner.astro";
import Marquee from "../components/Marquee.astro";
import BasketMission from "../components/BasketMission.astro";
import site from "../data/site.json";
import { getSetting } from "../lib/settings";
import { requireDatabase } from "../lib/neon";

const partners = [
  { name: "SONAS", logo: "/media/partenaires/LOGO SONAS.png" },
  { name: "Equity BCDC", logo: "/media/partenaires/Logo_EquityBCDC.png" },
  { name: "MFS Groupe", logo: "/media/partenaires/MFS GROUPE.png" },
  { name: "Shalina Healthcare", logo: "/media/partenaires/Shalina-Logo-Blue.png" },
  { name: "Fonarev", logo: "/media/partenaires/logo-fonarev.webp" },
  { name: "Visa", logo: "/media/partenaires/logo-visa.png" }
];

const today = new Date().toISOString().slice(0, 10);
// Résilient : la home ne doit pas crasher si la table events n'est pas encore migrée.
let allEvents = [];
try {
  const sql = requireDatabase();
  allEvents = await sql`
    SELECT slug, title, description, date::text as date, time, location
    FROM events
    WHERE published = true
    ORDER BY date ASC, created_at ASC
  `;
} catch (err) {
  console.error("[index] chargement events échoué (table absente ?)", err);
  allEvents = [];
}
// Léopards Basket — fenêtre de Dakar (qualif. Mondial FIBA 2027).
// La section reste visible même si la migration 015 n'est pas encore passée :
// BasketMission.astro embarque son propre calendrier de repli.
const BASKET_SLUGS = [
  "2026-08-27-leopards-basket-rdc-angola",
  "2026-08-29-leopards-basket-rdc-mali",
  "2026-08-30-leopards-basket-rdc-egypte"
];
const basketEvents = allEvents.filter((event) => BASKET_SLUGS.includes(event.slug));

const upcomingEvents = allEvents.filter((event) => event.date >= today);
const events = upcomingEvents.slice(0, 4);
const FR_MONTHS = ["JAN","FEV","MAR","AVR","MAI","JUIN","JUIL","AOUT","SEPT","OCT","NOV","DEC"];
const getMonth = (d) => FR_MONTHS[parseInt(d.split("-")[1]) - 1];
const getDay = (d) => String(parseInt(d.split("-")[2])).padStart(2, "0");

const guadalajaraActive = (await getSetting("guadalajara_active", "true")) !== "false";

const tickerItems = [
  "Un seul bloc. Une seule voix.",
  "Tous en bleu et jaune.",
  "Tous en maillot Léopards.",
  "Support positif et respectueux.",
  "Toko bloque bango tii na tii.",
  "Toza bomoko."
];

const homeGallery = [
  { title: "Tribune debout", label: "01 · Ferveur", image: "/media/ivanor-tribune-drapeaux.jpg" },
  { title: "Un seul bloc", label: "02 · Voix", image: "/media/ivanor-foule-tribune.jpg" },
  { title: "Joie en tribune", label: "03 · Moment", image: "/media/ivanor-joie-tribune.jpg" },
  { title: "Couleurs en mouvement", label: "04 · Diaspora", image: "/media/supporters-diaspora-03.jpg" },
  { title: "La nuit du bloc", label: "05 · Après match", image: "/media/ivanor-supporters-nuit.jpg" }
];
---
<BaseLayout title="Accueil" description="Bloc Léopards — supporters des Léopards de la RDC. Un seul bloc, une seule voix. Mobilisation positive, informée et respectueuse.">
  {site.matchDay && <MatchBanner label={site.matchDayLabel} href={site.matchDayCTA} ctaLabel={site.matchDayCTALabel} />}

  <!-- ================= HERO ================= -->
  <section class="relative flex min-h-[92vh] items-end overflow-hidden bg-congo-night text-white">
    <video autoplay muted loop playsinline preload="auto" poster="/videos/hero-poster.jpg" data-hero-media class="absolute inset-0 z-0 h-full w-full object-cover">
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 z-0 bg-gradient-to-t from-congo-night via-congo-night/35 to-transparent"></div>
    <div class="absolute inset-0 z-0 bg-gradient-to-r from-congo-night/70 via-congo-night/15 to-transparent"></div>

    <div class="relative z-10 mx-auto w-full max-w-[84rem] px-4 pb-20 pt-28 lg:px-8">
      <span data-reveal class="inline-flex items-center gap-3 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-or before:h-px before:w-9 before:bg-or/70">Bloc Léopards · RDC</span>
      <h1 class="mt-6 font-mega uppercase leading-[0.82] [font-size:clamp(3.6rem,11vw,11.5rem)]">
        <span class="lux-line-mask"><span data-reveal="mask" class="text-transparent [-webkit-text-stroke:2px_#ffffff]">Un seul bloc.</span></span>
        <span class="lux-line-mask"><span data-reveal="mask" data-reveal-delay="120" class="text-transparent [-webkit-text-stroke:2px_#F4C400]">Une seule voix.</span></span>
      </h1>
      <p data-reveal data-reveal-delay="220" class="mt-7 max-w-xl text-lg leading-relaxed text-white/80">
        La tribune congolaise se rassemble : chants, drapeaux, ferveur et discipline. Derrière les Léopards, partout où ils jouent.
      </p>
      <div data-reveal data-reveal-delay="300" class="mt-9 flex flex-wrap gap-4">
        <a href="/rejoindre" class="rounded-full bg-or px-8 py-4 text-[0.8rem] font-bold uppercase tracking-[0.1em] text-congo-night transition-transform hover:-translate-y-0.5">Rejoindre le Bloc</a>
        <a href="#manifeste" class="rounded-full border border-white/30 px-8 py-4 text-[0.8rem] font-bold uppercase tracking-[0.1em] text-white backdrop-blur-sm transition-colors hover:border-or hover:text-or">Découvrir le mouvement</a>
      </div>
    </div>

    <div class="absolute bottom-6 right-5 hidden items-center gap-3 text-[0.62rem] uppercase tracking-[0.28em] text-white/50 lg:flex lg:right-8">
      Scroll
      <span class="h-8 w-px animate-[float_2.4s_ease-in-out_infinite] bg-gradient-to-b from-or to-transparent"></span>
    </div>
  </section>

  <Marquee items={tickerItems} />

  <!-- ================= LÉOPARDS BASKET — MISSION DAKAR ================= -->
  <BasketMission events={basketEvents} />

  <!-- ================= MANIFESTE ================= -->
  <section id="manifeste" class="scroll-mt-24 bg-congo py-24 text-white lg:py-32">
    <div class="mx-auto max-w-[84rem] px-4 lg:px-8">
      <span data-reveal class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-congo-night">Le manifeste</span>
      <div class="mt-6 font-mega uppercase leading-[0.86] [font-size:clamp(2.8rem,8vw,8rem)]">
        <div class="lux-line-mask"><span data-reveal="mask">Toza bo moko</span></div>
        <div class="lux-line-mask"><span data-reveal="mask" data-reveal-delay="100" class="text-congo-night">Bloc moko</span></div>
        <div class="lux-line-mask"><span data-reveal="mask" data-reveal-delay="200">Ekolo moko</span></div>
      </div>
      <p data-reveal data-reveal-delay="280" class="mt-8 font-display text-2xl uppercase tracking-[0.06em] text-white/90 md:text-3xl">Tous derrière les Léopards.</p>
    </div>
  </section>

  <!-- ================= GALERIE (bandeau photos horizontal) ================= -->
  <section class="bg-congo-night py-20 text-white lg:py-24" aria-label="Galerie du bloc">
    <div class="mx-auto max-w-[84rem] px-4 lg:px-8">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <div>
          <span data-reveal class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-or">Ambiance</span>
          <h2 data-reveal class="mt-3 font-display text-4xl uppercase leading-[0.95] md:text-6xl">La galerie</h2>
        </div>
        <a data-reveal href="/media" class="text-[0.74rem] font-bold uppercase tracking-[0.14em] text-or transition-colors hover:text-white">Voir toutes les photos →</a>
      </div>
    </div>
    <div class="photo-strip" data-reveal="fade">
      <div class="photo-strip__track">
        <div class="photo-strip__set">
          {homeGallery.map((item, i) => (
            <figure class="photo-strip__item">
              <img src={item.image} alt={item.title} loading={i === 0 ? "eager" : "lazy"} />
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
        <div class="photo-strip__set" aria-hidden="true">
          {homeGallery.map((item) => (
            <figure class="photo-strip__item">
              <img src={item.image} alt="" loading="lazy" />
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 52 ANS / RETOUR ================= -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto grid max-w-[84rem] items-center gap-12 px-4 lg:grid-cols-[0.85fr_1.15fr] lg:px-8">
      <div>
        <span data-reveal class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-feu">52 ans après</span>
        <h2 data-reveal class="mt-3 font-display text-4xl uppercase leading-[0.95] text-congo-night md:text-6xl">Les Léopards<br />sont de retour</h2>
        <p data-reveal class="mt-5 max-w-md leading-relaxed text-slate-600">Première nation d'Afrique subsaharienne à avoir joué une Coupe du monde, la RDC retrouve la scène mondiale avec ambition.</p>
        <a data-reveal href="/actus/2026-05-25-retour-mondial-52-ans" class="mt-7 inline-flex rounded-full bg-congo px-7 py-3.5 text-[0.78rem] font-bold uppercase tracking-[0.1em] text-white transition-transform hover:-translate-y-0.5">Lire le contexte</a>
      </div>
      <div data-reveal="fade" class="overflow-hidden rounded-[6px] border border-slate-200 shadow-deep">
        <video class="aspect-video w-full bg-congo-night object-cover" autoplay muted controls playsinline preload="metadata">
          <source src="/videos/retour-mondial-52-ans.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <!-- ================= ÉVÉNEMENTS (affiches) ================= -->
  {events.length > 0 && (
    <section class="bg-congo-night py-20 text-white lg:py-28">
      <div class="mx-auto max-w-[84rem] px-4 lg:px-8">
        <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
          <div>
            <span data-reveal class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-or">Mobilisation</span>
            <h2 data-reveal class="mt-3 font-display text-4xl uppercase leading-[0.95] md:text-6xl">Prochains rendez-vous</h2>
          </div>
          <a data-reveal href="/evenements" class="text-[0.74rem] font-bold uppercase tracking-[0.14em] text-or transition-colors hover:text-white">Calendrier complet →</a>
        </div>
        <div class="grid gap-4">
          {events.map((event, i) => (
            <a href={`/evenements/${event.slug}`} data-reveal data-reveal-delay={(i % 2) * 90} class="group flex items-stretch gap-0 overflow-hidden rounded-[4px] border border-white/10 bg-white/[0.03] transition-colors hover:border-or/40">
              <div class="w-1.5 shrink-0 bg-gradient-to-b from-flag-yellow to-feu"></div>
              <div class="flex w-24 shrink-0 flex-col items-center justify-center px-4 py-6 text-center md:w-32">
                <span class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-or">{getMonth(event.date)}</span>
                <span class="font-mega text-5xl leading-none md:text-6xl">{getDay(event.date)}</span>
                <span class="mt-1 text-[0.7rem] text-white/50">{event.time}</span>
              </div>
              <div class="w-px self-stretch bg-white/10"></div>
              <div class="flex flex-1 flex-col justify-center px-5 py-6 md:px-8">
                <p class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-or/90">{event.description}</p>
                <h3 class="mt-1.5 font-display text-2xl uppercase leading-none md:text-4xl">{event.title}</h3>
                <p class="mt-2 text-sm text-white/55">{event.location}</p>
              </div>
              <div class="hidden items-center pr-8 text-or opacity-0 transition-opacity group-hover:opacity-100 md:flex">→</div>
            </a>
          ))}
        </div>
        {guadalajaraActive && (
          <div data-reveal class="mt-10">
            <a href="/mondial" class="inline-flex items-center gap-2 rounded-full border border-or/40 bg-or/10 px-8 py-4 text-[0.78rem] font-bold uppercase tracking-[0.1em] text-or transition-colors hover:bg-or hover:text-congo-night">
              Programme diaspora · Mondial 2026 →
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ================= PARTENAIRES ================= -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-[84rem] px-4 lg:px-8">
      <div data-reveal class="mb-10 text-center">
        <span class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-slate-400">Ils soutiennent le Bloc</span>
        <h2 class="mt-2 font-display text-3xl uppercase text-congo-night md:text-4xl">Nos partenaires</h2>
      </div>
      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-[6px] border border-slate-200 bg-slate-200 sm:grid-cols-3 lg:grid-cols-6">
        {partners.map((p, i) => (
          <div data-reveal data-reveal-delay={(i % 6) * 60} class="group flex min-h-[110px] items-center justify-center bg-white p-6 transition-colors hover:bg-slate-50">
            <img src={p.logo} alt={p.name} loading="lazy" class="max-h-11 w-auto max-w-[120px] object-contain opacity-70 grayscale transition-all duration-500 group-hover:opacity-100 group-hover:grayscale-0" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= REJOINDRE LE BLOC ================= -->
  <section class="relative overflow-hidden bg-congo-night text-white">
    <img src="/media/bloc-jersey-tribune-01.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-25" />
    <div class="absolute inset-0 bg-gradient-to-t from-congo-night via-congo-night/80 to-congo-night/60"></div>
    <div class="relative mx-auto grid max-w-[84rem] items-center gap-12 px-4 py-24 lg:grid-cols-2 lg:px-8 lg:py-32">
      <div>
        <span data-reveal class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-or">Rejoindre</span>
        <h2 data-reveal class="mt-4 font-mega uppercase leading-[0.85] [font-size:clamp(2.8rem,7vw,6rem)]">Rejoins<br />le mouvement</h2>
        <p data-reveal class="mt-6 max-w-md text-lg leading-relaxed text-white/75">Reçois le kit supporters et participe aux mobilisations confirmées. Un seul bloc, une seule voix.</p>
        <div data-reveal class="mt-8 flex flex-wrap gap-4">
          <a href="/rejoindre" class="rounded-full bg-or px-8 py-4 text-[0.8rem] font-bold uppercase tracking-[0.1em] text-congo-night transition-transform hover:-translate-y-0.5">Formulaire d'adhésion</a>
          <a href="/charte" class="rounded-full border border-white/30 px-8 py-4 text-[0.8rem] font-bold uppercase tracking-[0.1em] text-white transition-colors hover:border-or hover:text-or">Lire la charte</a>
        </div>
      </div>
      <div data-reveal="fade" class="rounded-[6px] border border-white/10 bg-white p-7 text-slate-900 shadow-deep">
        <span class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-congo">Newsletter</span>
        <p class="mt-3 text-sm text-slate-600">Recevoir les mobilisations confirmées, fan zones et kits supporters.</p>
        <NewsletterForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Galerie home — bandeau photos qui defile en continu de gauche a droite */
  .photo-strip {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 5%, black 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 5%, black 95%, transparent);
  }
  .photo-strip__track {
    display: flex;
    width: max-content;
    animation: photo-strip-scroll 48s linear infinite;
  }
  .photo-strip:hover .photo-strip__track {
    animation-play-state: paused;
  }
  .photo-strip__set {
    display: flex;
    gap: 1rem;
    padding: 0 0.5rem;
  }
  .photo-strip__item {
    position: relative;
    flex: 0 0 auto;
    width: clamp(15rem, 26vw, 24rem);
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
    background: #0d1a35;
  }
  .photo-strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-strip__item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(5,11,24,0.85));
  }
  .photo-strip__item figcaption {
    position: absolute;
    left: 0.85rem;
    bottom: 0.75rem;
    z-index: 1;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }
  @keyframes photo-strip-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-strip { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .photo-strip__track { animation: none; }
    .photo-strip__set[aria-hidden="true"] { display: none; }
  }
  @media (max-width: 640px) {
    .photo-strip__item { width: 72vw; }
  }
</style>
