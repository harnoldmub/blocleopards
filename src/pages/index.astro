---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { getCollection } from "astro:content";
import { TEAMS, formatMatchDate, formatMatchDay, formatMatchTime, nextRdcFixture, rdcFixtures } from "../data/can2027";
import { billetterie } from "../data/billetterie";
import { MERCH_PRODUCTS, MERCH_CURRENCY, SHOP_ENABLED } from "../data/merch";
import { getSetting } from "../lib/settings";
import { requireDatabase } from "../lib/neon";

const TZ = "Africa/Kinshasa";
const shortDate = (iso: string) =>
  new Intl.DateTimeFormat("fr-FR", { weekday: "short", day: "numeric", month: "short", timeZone: TZ }).format(new Date(iso));
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// --- Matchs : source unique src/data/can2027.ts (jamais de date inventée) ---
const nextMatch = nextRdcFixture();
const lastResult = rdcFixtures("FINISHED").filter((f) => f.kickoff && f.score).sort((a, b) => Date.parse(b.kickoff!) - Date.parse(a.kickoff!))[0];

const home = nextMatch ? TEAMS[nextMatch.home] : null;
const away = nextMatch ? TEAMS[nextMatch.away] : null;
// La billetterie Tikeo ne couvre que le match pour lequel elle est configurée.
const hasTickets = billetterie.showLinks && Boolean(nextMatch && Date.parse(billetterie.kickoff) === Date.parse(nextMatch.kickoff!));

// --- Agenda du Bloc (base) : la page reste debout si la table manque ---
const today = new Date().toISOString().slice(0, 10);
let events: any[] = [];
let eventsError = false;
try {
  const sql = requireDatabase();
  const rows = await sql`
    SELECT slug, title, description, CAST(date AS text) as date, time, location
    FROM events
    WHERE published = true AND date >= ${today}
    ORDER BY date ASC, created_at ASC
    LIMIT 3
  `;
  events = rows as any[];
} catch (err) {
  console.error("[index] chargement events échoué (table absente ?)", err);
  eventsError = true;
}
// On n'affiche que les informations connues : « À confirmer » est retiré.
const known = (v?: string | null) => Boolean(v && !/confirmer/i.test(v));
const agenda = eventsError ? [] : events.map((e) => ({ ...e, meta: [e.time, e.location].filter(known).join(" · ") }));
const FR_MONTHS = ["janv.", "févr.", "mars", "avr.", "mai", "juin", "juil.", "août", "sept.", "oct.", "nov.", "déc."];
const eventDay = (d: string) => String(parseInt(d.split("-")[2]));
const eventMonth = (d: string) => FR_MONTHS[parseInt(d.split("-")[1]) - 1];

const guadalajaraActive = (await getSetting("guadalajara_active", "true")) !== "false";

// --- Campagne active (collection de contenu) ---
const campaigns = (await getCollection("campaigns")).sort((a, b) => b.id.localeCompare(a.id));
const campaign = campaigns[0];

// --- Barre d'information : des faits, pas de slogans ---
const infoItems = [
  nextMatch && {
    label: "Prochain match",
    text: `${home!.name} – ${away!.name}, ${shortDate(nextMatch.kickoff!)} à ${formatMatchTime(nextMatch.kickoff!)}, ${nextMatch.city}`,
    href: "#match"
  },
  lastResult && {
    label: "Dernier résultat",
    text: `${TEAMS[lastResult.home].name} ${lastResult.score!.home}–${lastResult.score!.away} ${TEAMS[lastResult.away].name}, ${shortDate(lastResult.kickoff!)}`,
    href: "/can-2027"
  },
  campaign && { label: "Campagne", text: campaign.data.title, href: "/campagnes" },
].filter(Boolean) as { label: string; text: string; href: string; pending?: boolean }[];

// --- Actions du Bloc : une action, un lien ---
const actions = [
  { title: "Rejoins une mobilisation", text: "Les rendez-vous confirmés, match après match.", cta: "Voir le calendrier", href: "/evenements", image: "/media/home/action-mobilisation.webp", w: 800, h: 1065 },
  { title: "Participe à une campagne de civisme", text: "Respect, propreté, fair-play.", cta: "Voir les campagnes", href: "/campagnes", image: "/media/home/action-civisme.webp", w: 800, h: 1067 },
  { title: "Trouve un rassemblement", text: "Kinshasa, provinces, diaspora.", cta: "Voir le programme", href: "/can-2027", image: "/media/home/action-rassemblement.webp", w: 800, h: 532 },
  { title: "Rejoins le Bloc depuis la diaspora", text: "Un relais dans chaque ville.", cta: "S'inscrire", href: "/rejoindre", image: "/media/home/action-diaspora.webp", w: 800, h: 1067 }
];

// --- Galerie : bandeau d'origine ---
const homeGallery = [
  { title: "Tribune debout", image: "/media/ivanor-tribune-drapeaux.jpg" },
  { title: "Un seul bloc", image: "/media/ivanor-foule-tribune.jpg" },
  { title: "Joie en tribune", image: "/media/ivanor-joie-tribune.jpg" },
  { title: "Couleurs en mouvement", image: "/media/supporters-diaspora-03.jpg" },
  { title: "La nuit du bloc", image: "/media/ivanor-supporters-nuit.jpg" }
];

// --- Partenaires ---
const partnerGroups = [
  {
    label: "Partenaires institutionnels",
    items: [
      { name: "R.D. Congo, Cœur de l'Afrique", logo: "/logo-rdc.png" },
      { name: "Ministère des Sports et Loisirs", logo: "/brand/logo-min-sport-black.webp" },
      { name: "Fonarev", logo: "/media/partenaires/logo-fonarev.webp" }
    ]
  },
  {
    label: "Partenaires officiels",
    items: [
      { name: "SONAS", logo: "/media/partenaires/LOGO SONAS.png" },
      { name: "Equity BCDC", logo: "/media/partenaires/Logo_EquityBCDC.png" },
      { name: "MFS Groupe", logo: "/media/partenaires/MFS GROUPE.png" },
      { name: "Shalina Healthcare", logo: "/media/partenaires/Shalina-Logo-Blue.png" },
      { name: "Visa", logo: "/media/partenaires/logo-visa.png" }
    ]
  },
  { label: "Partenaires techniques", items: [] as { name: string; logo: string }[] }
].filter((g) => g.items.length > 0);

// --- Boutique : quatre produits au plus, seulement si la boutique est ouverte ---
const AVAILABILITY: Record<string, string> = { in_stock: "En stock", low_stock: "Derniers exemplaires", preorder: "En précommande", out_of_stock: "Épuisé" };
const shopProducts = SHOP_ENABLED ? MERCH_PRODUCTS.slice(0, 4) : [];

const benefits = [
  "Recevoir les mobilisations confirmées",
  "Accéder au kit supporter",
  "Participer aux actions",
  "Rejoindre le réseau de la diaspora"
];
---
<BaseLayout title="Accueil" description="Bloc Léopards, le mouvement des supporters des Léopards de la RDC. Prochain match, rassemblements, kit supporter et actions du Bloc.">

  <!-- ================= HERO ================= -->
  <section class="hero">
    <video autoplay muted loop playsinline preload="metadata" poster="/videos/hero-can-poster.jpg" class="hero__photo" aria-hidden="true">
      <source src="/videos/hero-can.mp4" type="video/mp4" />
    </video>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="bl-wrap hero__inner">
      <div class="hero__copy">
        <h1 class="bl-title bl-title--xl hero__title">Un seul bloc.<br /><span>Une seule voix.</span></h1>
        <p class="hero__sub">Derrière les Léopards, partout où ils jouent.</p>
        <div class="hero__cta">
          <a href="/can-2027" class="bl-btn">Voir le programme</a>
          <a href="/rejoindre" class="bl-btn bl-btn--line">Rejoindre la mobilisation</a>
        </div>
      </div>

    </div>
  </section>

  <!-- ================= BARRE D'INFORMATION ================= -->
  <section class="infobar" aria-label="En ce moment">
    <ul class="infobar__list" data-lenis-prevent>
      {infoItems.map((item) => (
        <li>
          <a href={item.href} class="infobar__item">
            <span class="infobar__label">{item.label}</span>
            <span class:list={["infobar__text", item.pending && "bl-pending"]}>{item.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ================= PROCHAIN RENDEZ-VOUS ================= -->
  <section id="match" class="bl-section bl-on-paper">
    <div class="bl-wrap">
      <div class="head">
        <div>
          <p class="bl-label">Match center</p>
          <h2 class="bl-title bl-title--lg">Le prochain rendez-vous</h2>
        </div>
        <a href="/can-2027" class="bl-link">Tout le programme</a>
      </div>

      {nextMatch ? (
        <article class="mc bl-cut" data-kickoff={nextMatch.kickoff}>
          <p class="mc__top">Éliminatoires CAN 2027 · Groupe E · Journée {nextMatch.matchday}</p>

          <div class="mc__fixture">
            <div class="mc__team">
              <img src={home!.flag} alt="" width="96" height="72" loading="lazy" />
              <strong>{home!.name}</strong>
            </div>
            <div class="mc__center">
              <span class="mc__time">{formatMatchTime(nextMatch.kickoff!)}</span>
              <span class="mc__day">{cap(formatMatchDay(nextMatch.kickoff!))} {formatMatchDate(nextMatch.kickoff!)}</span>
            </div>
            <div class="mc__team">
              <img src={away!.flag} alt="" width="96" height="72" loading="lazy" />
              <strong>{away!.name}</strong>
            </div>
          </div>

          <p class="mc__place">
            {[nextMatch.venue, nextMatch.city].filter(Boolean).join(" · ")}
            <span class="mc__local" data-local-time hidden></span>
          </p>

          <div class="mc__countdown">
            <span class="mc__countdown-label" data-countdown-label>Coup d'envoi dans</span>
            <div class="mc__units" data-countdown-units aria-hidden="true">
              <span><b data-cd="d">––</b><i>jours</i></span>
              <span><b data-cd="h">––</b><i>heures</i></span>
              <span><b data-cd="m">––</b><i>min</i></span>
              <span><b data-cd="s">––</b><i>s</i></span>
            </div>
          </div>

          <div class="mc__links">
            {hasTickets && <a href="/billetterie" class="bl-btn">Billetterie</a>}
            <a href="/can-2027" class="bl-btn bl-btn--line">Programme</a>
          </div>
        </article>
      ) : (
        <div class="empty">
          <p class="bl-title bl-title--md">Le programme des Léopards</p>
          <a href="/can-2027" class="bl-btn bl-btn--blue">Voir le programme</a>
        </div>
      )}

      {agenda.length > 0 && (
        <div class="agenda">
          <h3 class="bl-title bl-title--md">Voici où nous retrouver</h3>
          <ul class="agenda__list">
            {agenda.map((event) => (
              <li>
                <a href={`/evenements/${event.slug}`} class="agenda__item bl-focus">
                  <span class="agenda__date"><b>{eventDay(event.date)}</b>{eventMonth(event.date)}</span>
                  <span class="agenda__body">
                    <strong>{event.title}</strong>
                    {event.meta && <span>{event.meta}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="agenda__links">
            <a href="/evenements" class="bl-link">Calendrier complet</a>
            {guadalajaraActive && <a href="/mondial" class="bl-link">Programme diaspora, Mondial 2026</a>}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ================= ACTIONS DU BLOC ================= -->
  <section class="bl-section bl-on-night">
    <div class="bl-wrap">
      <div class="head">
        <div>
          <p class="bl-label">Sur le terrain</p>
          <h2 class="bl-title bl-title--lg">Les actions du Bloc</h2>
        </div>
      </div>
      <ul class="actions">
        {actions.map((a, i) => (
          <li class:list={["actions__tile", i === 0 && "actions__tile--lead"]}>
            <a href={a.href} class="actions__link">
              <img src={a.image} alt="" width={a.w} height={a.h} loading="lazy" decoding="async" />
              <span class="actions__body">
                <strong class="bl-title">{a.title}</strong>
                <span class="actions__text">{a.text}</span>
                <span class="actions__cta">{a.cta}</span>
              </span>
            </a>
          </li>
        ))}
        <li class="actions__band">
          <div>
            <strong class="bl-title bl-title--md">Propose une action dans ta ville</strong>
            <span>Nettoyage de tribune, projection, collecte : dis-nous ce que tu veux lancer.</span>
          </div>
          <a href="/contact" class="bl-btn">Écrire à l'équipe</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ================= LE MOUVEMENT ================= -->
  <section class="bl-on-yellow mvt">
    <div class="bl-wrap mvt__inner">
      <div class="mvt__copy">
        <p class="bl-label">Le mouvement</p>
        <h2 class="bl-title mvt__manifesto" lang="ln">
          <span>Toza bomoko.</span>
          <span>Bloc moko.</span>
          <span>Ekolo moko.</span>
        </h2>
        <p class="bl-lead">Nous sommes ensemble. Un seul bloc, une seule nation : des supporters qui chantent, respectent et rassemblent, à Kinshasa, en province et dans la diaspora.</p>
        <ul class="mvt__links">
          <li><a href="/mouvement">L'histoire du mouvement</a></li>
          <li><a href="/charte">La charte du supporter</a></li>
          <li><a href="/campagnes">Nos engagements</a></li>
          <li><a href="/partenaires">Les partenaires</a></li>
        </ul>
      </div>
      <figure class="mvt__photo">
        <img src="/media/home/mouvement-joie.webp" alt="Une supportrice en maillot rouge des Léopards rit, drapeau de la RDC levé derrière elle." width="900" height="1200" loading="lazy" decoding="async" class="bl-cut" />
        <figcaption>Photo @ivanor_shoot</figcaption>
      </figure>
    </div>
  </section>

  <!-- ================= GALERIE (bandeau photos horizontal) ================= -->
  <section class="bl-section bl-on-night" aria-labelledby="galerie-titre">
    <div class="bl-wrap">
      <div class="head">
        <div>
          <p class="bl-label">Ambiance</p>
          <h2 id="galerie-titre" class="bl-title bl-title--lg">La galerie</h2>
        </div>
        <a href="/media" class="bl-link">Voir toutes les photos</a>
      </div>
    </div>
    <div class="photo-strip">
      <div class="photo-strip__track">
        <div class="photo-strip__set">
          {homeGallery.map((item) => (
            <figure class="photo-strip__item">
              <img src={item.image} alt={item.title} loading="lazy" decoding="async" />
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
        <div class="photo-strip__set" aria-hidden="true">
          {homeGallery.map((item) => (
            <figure class="photo-strip__item">
              <img src={item.image} alt="" loading="lazy" decoding="async" />
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BOUTIQUE (si ouverte) ================= -->
  {shopProducts.length > 0 && (
    <section class="bl-section bl-on-paper">
      <div class="bl-wrap">
        <div class="head">
          <div>
            <p class="bl-label">Merch</p>
            <h2 class="bl-title bl-title--lg">Porte les couleurs</h2>
          </div>
          <a href="/boutique" class="bl-btn bl-btn--blue">Voir la boutique</a>
        </div>
        <ul class="shop">
          {shopProducts.map((p) => (
            <li>
              <a href={`/boutique/${p.id}`} class="shop__item bl-focus">
                <img src={p.image} alt={p.name} loading="lazy" width="600" height="600" />
                <strong>{p.name}</strong>
                <span class="shop__price">{p.price} {MERCH_CURRENCY}</span>
                <span class="shop__stock">{AVAILABILITY[p.availability]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ================= PARTENAIRES ================= -->
  <section class="bl-section partners">
    <div class="bl-wrap">
      <div class="head">
        <div>
          <p class="bl-label">Ils soutiennent le Bloc</p>
          <h2 class="bl-title bl-title--lg">Nos partenaires</h2>
        </div>
        <a href="/partenaires" class="bl-link">Devenir partenaire</a>
      </div>
      {partnerGroups.map((group) => (
        <div class="partners__group">
          <h3>{group.label}</h3>
          <ul>
            {group.items.map((p) => (
              <li><img src={p.logo} alt={p.name} loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= ADHÉSION ================= -->
  <section class="bl-on-blue join">
    <div class="bl-wrap join__inner">
      <div>
        <h2 class="bl-title bl-title--xl">Rejoins le Bloc</h2>
        <ul class="join__list">
          {benefits.map((b) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              {b}
            </li>
          ))}
        </ul>
        <a href="/rejoindre" class="bl-btn">Rejoindre le mouvement</a>
      </div>
      <div class="join__news">
        <h3>Pas encore prêt ? Reçois d'abord les infos.</h3>
        <p>Mobilisations confirmées, fan zones et kits : un e-mail quand il y a du nouveau.</p>
        <NewsletterForm />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Compte à rebours + heure locale du visiteur. Sans JS, la date de Kinshasa reste affichée.
  const card = document.querySelector<HTMLElement>('[data-kickoff]');
  const kickoff = card ? Date.parse(card.dataset.kickoff || '') : NaN;

  if (card && Number.isFinite(kickoff)) {
    const local = document.querySelector<HTMLElement>('[data-local-time]');
    try {
      const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const fmt = (tz: string) => new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: tz }).format(kickoff);
      if (local && zone && fmt(zone) !== fmt('Africa/Kinshasa')) {
        local.textContent = `Chez toi : ${fmt(zone).replace(':', 'h')} (${zone.split('/').pop()!.replace(/_/g, ' ')})`;
        local.hidden = false;
      }
    } catch {
      /* fuseau indisponible : on garde l'heure de Kinshasa */
    }

    const label = document.querySelector<HTMLElement>('[data-countdown-label]');
    const units = document.querySelector<HTMLElement>('[data-countdown-units]');
    const cells: Record<string, HTMLElement | null> = {
      d: document.querySelector('[data-cd="d"]'),
      h: document.querySelector('[data-cd="h"]'),
      m: document.querySelector('[data-cd="m"]'),
      s: document.querySelector('[data-cd="s"]')
    };
    const pad = (n: number) => String(n).padStart(2, '0');
    let timer = 0;
    const tick = () => {
      const diff = kickoff - Date.now();
      if (diff <= 0) {
        window.clearInterval(timer);
        if (units) units.hidden = true;
        if (label) label.textContent = diff > -2 * 3600_000 ? 'Match en cours' : 'Match terminé';
        return;
      }
      const s = Math.floor(diff / 1000);
      if (cells.d) cells.d.textContent = pad(Math.floor(s / 86400));
      if (cells.h) cells.h.textContent = pad(Math.floor((s % 86400) / 3600));
      if (cells.m) cells.m.textContent = pad(Math.floor((s % 3600) / 60));
      if (cells.s) cells.s.textContent = pad(s % 60);
    };
    tick();
    timer = window.setInterval(tick, 1000);
  }
</script>

<style>
  /* ---------- En-têtes de section ---------- */
  .head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.75rem 2rem; margin-bottom: 1.75rem; }
  .head .bl-title { margin-top: 0.6rem; }

  /* ---------- Hero ---------- */
  .hero {
    position: relative; display: flex; align-items: flex-end; overflow: hidden;
    min-height: calc(100svh - 3.75rem - var(--bl-nav-h) - 3.5rem);
    background: var(--bl-night); color: #fff;
  }
  .hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; }
  /* Voile fonctionnel : le texte ne repose jamais sur une zone claire de la photo. */
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 18, 38, 0.1) 0%, rgba(7, 18, 38, 0.2) 30%, rgba(7, 18, 38, 0.86) 62%, var(--bl-night) 100%); }
  .hero__inner { position: relative; display: grid; gap: 1.25rem; padding-top: 9rem; padding-bottom: 2.5rem; }
  .hero__title span { color: var(--bl-yellow); }
  .hero__sub { margin-top: 0.75rem; font-size: 1.0625rem; font-weight: 600; }
  .hero__cta { display: grid; gap: 0.6rem; margin-top: 1.25rem; }

  /* ---------- Barre d'information ---------- */
  .infobar { background: var(--bl-blue); color: #fff; }
  .infobar__list { display: flex; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; max-width: var(--bl-wrap); margin-inline: auto; }
  .infobar__list::-webkit-scrollbar { display: none; }
  .infobar__list li { flex: none; scroll-snap-align: start; border-right: 1px solid rgba(255, 255, 255, 0.18); }
  .infobar__item { display: grid; gap: 0.1rem; min-height: 3.5rem; align-content: center; padding: 0.55rem 1.1rem; max-width: 19rem; text-decoration: none; }
  .infobar__item:focus-visible { outline: 3px solid var(--bl-yellow); outline-offset: -3px; }
  .infobar__label { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bl-yellow); }
  .infobar__text { font-size: 0.875rem; font-weight: 600; line-height: 1.3; }

  /* ---------- Match center ---------- */
  .mc { max-width: 56rem; padding: 1.5rem 1rem; background: var(--bl-night); color: #fff; border-radius: var(--bl-radius) 0 var(--bl-radius) var(--bl-radius); text-align: center; }
  .mc__top { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #c9d5ea; }
  .mc__fixture { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 0.5rem; margin-top: 1.5rem; }
  .mc__team { display: grid; justify-items: center; gap: 0.6rem; }
  .mc__team img { width: 4rem; height: 3rem; object-fit: cover; border-radius: 3px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25); }
  .mc__team strong { font-family: "Anton", system-ui, sans-serif; font-weight: 400; font-size: clamp(1.05rem, 4.6vw, 1.9rem); text-transform: uppercase; line-height: 1.05; text-wrap: balance; }
  .mc__center { display: grid; justify-items: center; gap: 0.2rem; }
  .mc__time { font-family: "Anton", system-ui, sans-serif; font-size: clamp(2.2rem, 10vw, 4rem); line-height: 1; color: var(--bl-yellow); }
