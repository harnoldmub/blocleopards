---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Icon from "../components/Icon.astro";
import Turnstile from "../components/Turnstile.astro";
import faq from "../data/faq.json";
import countries from "../data/countries.json";

// Rôles groupés — les rôles « créatifs » et « média » déclenchent le champ portfolio
const roleGroups = [
  {
    label: "Création de contenu",
    roles: [
      "Créateur de contenu",
      "Créateur de contenus chaîne WhatsApp",
      "Influenceur",
      "Graphiste",
      "Monteur vidéo",
      "Photographe",
      "Vidéaste",
    ],
  },
  {
    label: "Média",
    roles: ["Journaliste", "Animateur", "Radio", "TV"],
  },
  {
    label: "Scène & animation",
    roles: ["Humoriste", "Danseur", "Ambiance / chants"],
  },
  {
    label: "Ambiance & terrain",
    roles: ["Organisation fan zone", "Relais diaspora", "Modération digitale"],
  },
  {
    label: "Partenaires",
    roles: ["Sponsor", "Équipementier", "Imprimeur"],
  },
];

// Rôles pour lesquels on demande réseaux sociaux / portfolio
const creativeRoles = [
  "Créateur de contenu", "Créateur de contenus chaîne WhatsApp", "Influenceur",
  "Graphiste", "Monteur vidéo", "Photographe", "Vidéaste",
  "Journaliste", "Animateur", "Radio", "TV", "Humoriste", "Danseur",
];

// Liste à plat (pour les puces récapitulatives)
const roles = roleGroups.flatMap((g) => g.roles);

const canals = ["WhatsApp", "Email", "Téléphone", "Instagram"];

const disponibilites = [
  "Matchs uniquement",
  "Quelques heures par mois",
  "Chaque semaine",
  "Disponible pour organiser"
];
---
<BaseLayout title="Rejoindre" description="Appel à inscription Bloc Léopards : journalistes, humoristes, animateurs, danseurs, influenceurs, créateurs de contenu, graphistes, monteurs, photographes et vidéastes.">
  <PageHero title="Rejoindre" subtitle="Talents médias, créateurs et terrain : entre dans le Bloc" image="/media/atelier-1.svg" />
  <section class="mx-auto max-w-5xl px-4 py-16">

    <!-- Bannière campagne -->
    <div class="mb-10 overflow-hidden rounded-[6px] border border-or/30 bg-congo-night text-white shadow-deep">
      <div class="grid h-2 grid-cols-3" aria-hidden="true">
        <div class="bg-flag-blue"></div>
        <div class="bg-flag-yellow"></div>
        <div class="bg-flag-red"></div>
      </div>
      <div class="grid gap-6 p-7 md:grid-cols-[1fr_auto] md:items-center md:p-9">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-or px-4 py-1.5 text-xs font-bold uppercase tracking-[0.22em] text-congo-night">
            <Icon name="send" size={13} />Appel à inscription
          </p>
          <h2 class="mt-4 font-display uppercase leading-[0.95] [font-size:clamp(1.7rem,4vw,3rem)]">Fais rayonner ton talent avec Bloc Léopard</h2>
          <p class="mt-4 max-w-3xl text-sm leading-6 text-white/75">
            Journaliste, humoriste, animateur, danseur, influenceur, créateur de contenu, graphiste, monteur vidéo, photographe, vidéaste ou créateur sur chaîne WhatsApp : rejoins l'équipe.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white/85">18 ans minimum</span>
            <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white/85">Passeport valide</span>
            <span class="rounded-full border border-or/40 bg-or/10 px-3 py-1.5 text-xs font-semibold text-or">Inscriptions ouvertes</span>
          </div>
        </div>
        <a href="#formulaire" class="hidden shrink-0 rounded-full bg-or px-6 py-4 text-center text-[0.78rem] font-bold uppercase tracking-[0.1em] text-congo-night transition-transform hover:-translate-y-0.5 md:inline-block">
          Je m'inscris →
        </a>
      </div>
    </div>

    {Astro.url.searchParams.get("status") === "success" && (
      <div class="mb-6 rounded-[6px] border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">
        Adhésion reçue. Bienvenue dans le Bloc.
      </div>
    )}
    {Astro.url.searchParams.get("status") === "error" && (
      <div class="mb-6 rounded-[6px] border border-red-200 bg-red-50 p-4 text-sm text-red-800">
        Une erreur est survenue lors de l'enregistrement. Réessaie dans quelques instants ou contacte-nous si le problème persiste.
      </div>
    )}
    {Astro.url.searchParams.get("status") === "missing" && (
      <div class="mb-6 rounded-[6px] border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        Merci de remplir les champs obligatoires (*), de choisir un métier, de confirmer les conditions et d'accepter la charte.
      </div>
    )}
    {Astro.url.searchParams.get("status") === "captcha" && (
      <div class="mb-6 rounded-[6px] border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        Merci de valider le contrôle anti-robot avant d'envoyer le formulaire.
      </div>
    )}

    <div id="formulaire" class="grid gap-8 lg:grid-cols-[1fr_0.72fr]">
      <form name="adhesion" method="POST" action="/api/adhesion" class="bloc-panel grid gap-6 p-6 text-sm">
        <input name="_hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
        <input name="_t" type="hidden" id="adhesion-t" />
        <script>document.getElementById('adhesion-t').value = Date.now();</script>
        <div>
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-congo">Adhésion</p>
          <h2 class="mt-2 font-display uppercase leading-[0.95] text-2xl text-congo-night">Dis-nous comment tu veux aider</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">Le formulaire alimente la base membres pour organiser les chants, les fan zones, les relais diaspora et les équipes média.</p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="bloc-field">
            <span class="bloc-label">Prénom *</span>
            <input name="prenom" required autocomplete="given-name" class="bloc-control" />
          </label>
          <label class="bloc-field">
            <span class="bloc-label">Nom *</span>
            <input name="nom" required autocomplete="family-name" class="bloc-control" />
          </label>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="bloc-field">
            <span class="bloc-label">Email *</span>
            <input type="email" name="email" required autocomplete="email" class="bloc-control" />
          </label>
          <label class="bloc-field">
            <span class="bloc-label">Téléphone</span>
            <input type="tel" name="telephone" autocomplete="tel" class="bloc-control" />
          </label>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="bloc-field">
            <span class="bloc-label">Date de naissance</span>
            <input type="date" name="date_naissance" autocomplete="bday" class="bloc-control" />
          </label>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <!-- Pays : combobox avec drapeau -->
          <div class="bloc-field relative" data-country-combobox>
            <span class="bloc-label">Pays</span>
            <input type="hidden" name="pays" id="pays-hidden" />
            <button
              id="pays-trigger"
              type="button"
              role="combobox"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="pays-listbox"
              class="bloc-control flex items-center justify-between gap-3 text-left w-full"
            >
              <span id="pays-trigger-inner" class="flex items-center gap-2.5 min-w-0">
                <span id="pays-flag-preview" class="combobox-flag hidden"></span>
                <span data-pays-label class="truncate text-slate-400">Choisir un pays</span>
              </span>
              <span class="combobox-chevron">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </button>
            <div id="pays-panel" class="combobox-panel hidden" data-lenis-prevent>
              <label class="relative block">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input
                  id="pays-search"
                  type="search"
                  autocomplete="off"
                  placeholder="Rechercher un pays…"
                  class="combobox-search"
                />
              </label>
              <div id="pays-listbox" role="listbox" class="combobox-list">
                {countries.map((c) => (
                  <button
                    type="button"
                    role="option"
                    class="combobox-option pays-option"
                    data-pays-code={c.code}
                    data-pays-name={c.name}
                    data-pays-flag={c.flag}
                    aria-selected="false"
                  >
                    <span class="combobox-flag">{c.flag}</span>
                    <span>{c.name}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="combobox-check text-blue-600 ml-auto"><path d="M20 6 9 17l-5-5"/></svg>
                  </button>
                ))}
                <p class="combobox-empty hidden" data-pays-empty>Aucun pays trouvé.</p>
              </div>
            </div>
          </div>

          <!-- Ville : dynamique selon le pays -->
          <div class="bloc-field relative" id="ville-field">
            <span class="bloc-label">Ville *</span>
            <!-- Combobox ville (visible quand des villes sont disponibles) -->
            <div id="ville-combobox-wrap" class="hidden relative" data-city-combobox>
              <input type="hidden" id="ville-hidden" />
              <button
                id="ville-trigger"
                type="button"
                role="combobox"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="ville-listbox"
                class="bloc-control flex items-center justify-between gap-3 text-left w-full"
              >
                <span data-ville-label class="truncate text-slate-400">Choisir une ville</span>
                <span id="ville-spinner" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-blue-600 border-t-transparent"></span>
                <span id="ville-chevron" class="combobox-chevron">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </span>
              </button>
              <div id="ville-panel" class="combobox-panel hidden" data-lenis-prevent>
                <label class="relative block">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  <input
                    id="ville-search"
                    type="search"
                    autocomplete="off"
                    placeholder="Rechercher une ville…"
                    class="combobox-search"
                  />
                </label>
                <div id="ville-listbox" role="listbox" class="combobox-list">
                  <!-- Peuplé dynamiquement par JS -->
                </div>
              </div>
            </div>
            <!-- Champ libre ville (fallback ou pas de pays sélectionné) -->
            <input
              id="ville-free"
              name="ville"
              required
              autocomplete="address-level2"
              class="bloc-control"
              placeholder="Ta ville"
            />
            <p id="ville-hint" class="mt-1 text-xs text-slate-400 hidden">Ou tape directement le nom de ta ville.</p>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="bloc-field relative" data-role-combobox>
            <span class="bloc-label">Rôle souhaité *</span>
            <select id="role-select" name="role" required class="sr-only" aria-label="Rôle souhaité">
              <option value="">Choisir un rôle</option>
              {roleGroups.map((group) => (
                <optgroup label={group.label}>
                  {group.roles.map((role) => (
                    <option value={role} data-creative={creativeRoles.includes(role) ? "1" : "0"}>{role}</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <button
              id="role-trigger"
              type="button"
              role="combobox"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="role-listbox"
              class="bloc-control flex items-center justify-between gap-3 text-left w-full"
            >
              <span data-role-label class="truncate text-slate-400">Choisir un métier</span>
              <span class="combobox-chevron">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </button>
            <div id="role-panel" class="combobox-panel hidden" data-lenis-prevent>
              <label class="relative block">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input
                  id="role-search"
                  type="search"
                  autocomplete="off"
                  placeholder="Rechercher un métier…"
                  class="combobox-search"
                />
              </label>
              <div id="role-listbox" role="listbox" class="combobox-list">
                {roleGroups.map((group) => (
                  <div class="role-group" data-role-group>
                    <p class="combobox-group-label">{group.label}</p>
                    <div>
                      {group.roles.map((role) => (
                        <button
                          type="button"
                          role="option"
                          class="combobox-option role-option"
                          data-role-option
                          data-role-value={role}
                          data-role-creative={creativeRoles.includes(role) ? "1" : "0"}
                          aria-selected="false"
                        >
                          <span>{role}</span>
                          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="combobox-check text-blue-600"><path d="M20 6 9 17l-5-5"/></svg>
                        </button>
                      ))}
                    </div>
                  </div>
                ))}
                <p class="combobox-empty hidden" data-role-empty>Aucun métier trouvé.</p>
              </div>
            </div>
            <span class="text-xs text-slate-400">Tape quelques lettres pour filtrer.</span>
          </div>
          <label class="bloc-field">
            <span class="bloc-label">Canal préféré</span>
            <select name="canal" class="bloc-control bloc-select">
              <option value="">Choisir</option>
              {canals.map((canal) => <option value={canal}>{canal}</option>)}
            </select>
          </label>
        </div>

        <!-- Réseaux sociaux / portfolio — mis en avant pour les profils créatifs & média -->
        <div id="portfolio-block" class="rounded-[8px] border border-or/40 bg-or/5 p-4">
          <label class="bloc-field">
            <span class="flex items-center gap-2 font-semibold text-slate-800">
              <Icon name="camera" size={16} class="text-congo" />Réseaux sociaux &amp; exemples de tes travaux
              <span id="portfolio-required" class="hidden rounded-full bg-or px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-congo-night">Recommandé</span>
            </span>
            <textarea id="portfolio-input" name="portfolio" rows="3" placeholder="Instagram, TikTok, YouTube, Behance, Drive… colle tes liens ou @pseudos. Montre-nous ce que tu sais faire !" class="bloc-control"></textarea>
            <span class="text-xs text-slate-500">Pour les créateurs, graphistes, monteurs, photographes, vidéastes et médias : partage tes liens ou quelques exemples.</span>
          </label>
        </div>

        <fieldset class="rounded-[8px] border border-congo/10 bg-slate-50 p-4">
          <legend class="px-2 text-sm font-semibold text-slate-800">Disponibilité</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {disponibilites.map((item) => (
              <label class="bloc-choice text-sm">
                <input type="radio" name="disponibilite" value={item} />
                {item}
              </label>
            ))}
          </div>
        </fieldset>

        <label class="bloc-field">
          <span class="bloc-label">Motivation</span>
          <textarea name="motivation" rows="5" class="bloc-control"></textarea>
        </label>

        <div class="grid gap-3 rounded-[8px] border border-congo/10 bg-slate-50 p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Conditions campagne créateurs</p>
          <label class="bloc-choice text-sm">
            <input type="checkbox" name="is_adult" required />
            <span>Je confirme être âgé·e d'au moins <span class="font-semibold">18 ans</span>.</span>
          </label>
          <label class="bloc-choice text-sm">
            <input type="checkbox" name="has_passport" required />
            <span>Je dispose d'un <span class="font-semibold">passeport valide</span>.</span>
          </label>
        </div>

        <div class="grid gap-3 rounded-[8px] border border-congo/10 bg-slate-50 p-4">
          <label class="bloc-choice text-sm">
            <input type="checkbox" name="charte" required />
            <span>J'ai lu et j'accepte la <a href="/charte" class="font-semibold text-congo">Charte du Supporter</a>. *</span>
          </label>
          <label class="bloc-choice text-sm">
            <input type="checkbox" name="newsletter" />
            <span>Je veux recevoir les mobilisations confirmées, fan zones et infos du Bloc.</span>
          </label>
        </div>

        <Turnstile />

        <button type="submit" id="adhesion-submit" class="bloc-submit px-6 py-4">
          <span id="submit-label">Envoyer ma demande</span>
          <svg id="submit-spinner" class="hidden ml-3 h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 5 5.373 5 12h4z"></path>
          </svg>
        </button>
      </form>

      <aside class="grid content-start gap-5">
        <div class="rounded-[6px] border border-slate-200 bg-congo p-6 text-white shadow-deep">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-or">Parcours</p>
          <h3 class="mt-3 font-display uppercase leading-[0.95] text-2xl">Après l'inscription</h3>
          <ol class="mt-5 grid gap-4 text-sm text-white/85">
            <li><span class="font-semibold text-or">1.</span> On vérifie ta ville et ton rôle.</li>
            <li><span class="font-semibold text-or">2.</span> Tu reçois les infos utiles selon ton canal préféré.</li>
            <li><span class="font-semibold text-or">3.</span> Tu participes aux actions confirmées du Bloc.</li>
          </ol>
        </div>
        <div class="rounded-[6px] border border-slate-200 bg-slate-50 p-6 text-sm text-slate-700">
          <h3 class="font-display uppercase text-lg text-congo-night">Rôles recherchés</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {roles.map((role) => (
              <span class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700">{role}</span>
            ))}
          </div>
        </div>
      </aside>
    </div>

    <div class="mt-10 rounded-[6px] border border-slate-200 bg-slate-50 p-6 text-sm">
      <h3 class="font-display uppercase text-lg text-congo-night">Règles principales</h3>
      <ul class="mt-3 list-disc pl-4 text-slate-600">
        <li>Respect des joueurs, adversaires, arbitres.</li>
        <li>Zéro violence et zéro messages haineux.</li>
        <li>Chants coordonnés et discipline en tribune.</li>
        <li>Engagement digital responsable.</li>
      </ul>
      <a href="/charte" class="mt-4 inline-flex font-semibold text-congo">Lire la charte complète →</a>
    </div>

    <div class="mt-10">
      <h3 class="font-display uppercase text-lg text-congo-night">FAQ</h3>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {faq.map((item) => (
          <div class="rounded-[6px] border border-slate-200 bg-white p-4 text-sm">
            <p class="font-semibold text-slate-900">{item.q}</p>
            <p class="mt-2 text-slate-600">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const select = document.getElementById("role-select");
      const form = select && select.closest("form");
      const trigger = document.getElementById("role-trigger");
      const panel = document.getElementById("role-panel");
      const search = document.getElementById("role-search");
      const label = document.querySelector("[data-role-label]");
      const options = Array.from(document.querySelectorAll("[data-role-option]"));
      const groups = Array.from(document.querySelectorAll("[data-role-group]"));
      const empty = document.querySelector("[data-role-empty]");
      const block = document.getElementById("portfolio-block");
      const badge = document.getElementById("portfolio-required");
      const input = document.getElementById("portfolio-input");
      if (!select || !trigger || !panel || !search || !label || !block) return;

      function normalize(value) {
        return String(value || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      }

      function openPanel() {
        panel.classList.remove("hidden");
        trigger.setAttribute("aria-expanded", "true");
        window.setTimeout(function () { search.focus(); }, 20);
      }

      function closePanel() {
        panel.classList.add("hidden");
        trigger.setAttribute("aria-expanded", "false");
        search.value = "";
        filterOptions("");
      }

      function filterOptions(query) {
        const q = normalize(query);
        let visibleCount = 0;
        options.forEach(function (option) {
          const visible = !q || normalize(option.dataset.roleValue).includes(q);
          option.classList.toggle("hidden", !visible);
          if (visible) visibleCount += 1;
        });
        groups.forEach(function (group) {
          const hasVisibleOption = !!group.querySelector("[data-role-option]:not(.hidden)");
          group.classList.toggle("hidden", !hasVisibleOption);
        });
        if (empty) empty.classList.toggle("hidden", visibleCount > 0);
      }

      function syncSelectedOption() {
        const selectedValue = select.value;
        label.textContent = selectedValue || "Choisir un métier";
        label.classList.toggle("text-slate-400", !selectedValue);
        label.classList.toggle("text-slate-900", !!selectedValue);
        options.forEach(function (option) {
          const active = option.dataset.roleValue === selectedValue;
          option.setAttribute("aria-selected", String(active));
          option.classList.toggle("bg-congo/10", active);
          option.classList.toggle("text-congo", active);
          const check = option.querySelector("svg");
          if (check) check.classList.toggle("hidden", !active);
        });
      }

      function chooseRole(value) {
        select.value = value;
        select.setCustomValidity("");
        select.dispatchEvent(new Event("change", { bubbles: true }));
        closePanel();
        trigger.focus();
      }

      function sync() {
        const opt = select.options[select.selectedIndex];
        const creative = opt && opt.getAttribute("data-creative") === "1";
        syncSelectedOption();
        block.style.display = "";
        block.style.order = creative ? "-1" : "";
        block.classList.toggle("ring-2", !!creative);
        block.classList.toggle("ring-or/40", !!creative);
        if (badge) badge.classList.toggle("hidden", !creative);
        if (input) input.setAttribute("placeholder", creative
          ? "Colle tes liens : Instagram, TikTok, YouTube, Behance, Drive… Montre-nous ton meilleur travail !"
          : "Instagram, TikTok, YouTube, Behance, Drive… (optionnel)");
      }

      trigger.addEventListener("click", function () {
        if (panel.classList.contains("hidden")) openPanel();
        else closePanel();
      });

      search.addEventListener("input", function () {
        filterOptions(search.value);
      });

      options.forEach(function (option) {
        option.addEventListener("click", function () {
          chooseRole(option.dataset.roleValue);
        });
      });

      document.addEventListener("click", function (event) {
        const root = trigger.closest("[data-role-combobox]");
        if (root && !root.contains(event.target)) closePanel();
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && !panel.classList.contains("hidden")) closePanel();
      });

      form && form.addEventListener("submit", function (event) {
        if (!select.value) {
          event.preventDefault();
          select.setCustomValidity("Choisis un métier.");
          openPanel();
          trigger.focus();
        }
      });

      select.addEventListener("change", sync);
      sync();
    })();
  </script>

  <!-- ===== Pays & Ville comboboxes ===== -->
  <script is:inline>
    (function () {
      // ---- PAYS ----
      var paysHidden = document.getElementById("pays-hidden");
      var paysTrigger = document.getElementById("pays-trigger");
      var paysPanel = document.getElementById("pays-panel");
      var paysSearch = document.getElementById("pays-search");
      var paysLabel = document.querySelector("[data-pays-label]");
      var paysOptions = Array.from(document.querySelectorAll(".pays-option"));
      var paysEmpty = document.querySelector("[data-pays-empty]");

      // ---- VILLE ----
      var villeHidden = document.getElementById("ville-hidden");
      var villeTrigger = document.getElementById("ville-trigger");
      var villePanel = document.getElementById("ville-panel");
      var villeSearch = document.getElementById("ville-search");
      var villeLabel = document.querySelector("[data-ville-label]");
      var villeListbox = document.getElementById("ville-listbox");
      var villeComboWrap = document.getElementById("ville-combobox-wrap");
      var villeFree = document.getElementById("ville-free");
      var villeSpinner = document.getElementById("ville-spinner");
      var villeChevron = document.getElementById("ville-chevron");
      var villeHint = document.getElementById("ville-hint");

      var allCities = [];
      var selectedCountryName = "";

      function norm(s) {
        return String(s || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      }

      // ---- Pays panel open/close ----
      function openPays() {
        paysPanel.classList.remove("hidden");
        paysTrigger.setAttribute("aria-expanded", "true");
        setTimeout(function () { paysSearch.focus(); }, 20);
      }
      function closePays() {
        paysPanel.classList.add("hidden");
        paysTrigger.setAttribute("aria-expanded", "false");
        paysSearch.value = "";
        filterPays("");
      }
      function filterPays(q) {
        var n = norm(q);
        var visible = 0;
        paysOptions.forEach(function (opt) {
          var show = !n || norm(opt.dataset.paysName).includes(n);
          opt.classList.toggle("hidden", !show);
          if (show) visible++;
        });
        if (paysEmpty) paysEmpty.classList.toggle("hidden", visible > 0);
      }

      function choosePays(code, name, flag) {
        paysHidden.value = name;
        // Update label text
        paysLabel.textContent = name;
        paysLabel.classList.remove("text-slate-400");
        paysLabel.classList.add("text-slate-900", "font-medium");
        // Show flag in trigger
        var flagEl = document.getElementById("pays-flag-preview");
        if (flagEl) { flagEl.textContent = flag; flagEl.classList.remove("hidden"); }
        // Mark selected option
        paysOptions.forEach(function(opt) {
          opt.setAttribute("aria-selected", opt.dataset.paysName === name ? "true" : "false");
        });
        closePays();
        paysTrigger.focus();
        selectedCountryName = name;
        loadCities(name);
      }

      if (paysTrigger) {
        paysTrigger.addEventListener("click", function () {
          paysPanel.classList.contains("hidden") ? openPays() : closePays();
        });
      }
      if (paysSearch) {
        paysSearch.addEventListener("input", function () { filterPays(paysSearch.value); });
      }
      paysOptions.forEach(function (opt) {
        opt.addEventListener("click", function () {
          choosePays(opt.dataset.paysCode, opt.dataset.paysName, opt.dataset.paysFlag);
        });
      });
      document.addEventListener("click", function (e) {
        var root = paysTrigger && paysTrigger.closest("[data-country-combobox]");
        if (root && !root.contains(e.target)) closePays();
      });

      // ---- Ville panel open/close ----
      function openVille() {
        villePanel.classList.remove("hidden");
        villeTrigger && villeTrigger.setAttribute("aria-expanded", "true");
        setTimeout(function () { villeSearch && villeSearch.focus(); }, 20);
      }
      function closeVille() {
        villePanel && villePanel.classList.add("hidden");
        villeTrigger && villeTrigger.setAttribute("aria-expanded", "false");
        if (villeSearch) { villeSearch.value = ""; filterVilles(""); }
      }
      function filterVilles(q) {
        var n = norm(q);
        var items = villeListbox ? Array.from(villeListbox.querySelectorAll(".ville-option")) : [];
        var visible = 0;
        items.forEach(function (item) {
          var show = !n || norm(item.dataset.villeName).includes(n);
          item.classList.toggle("hidden", !show);
          if (show) visible++;
        });
        var emptyEl = villeListbox && villeListbox.querySelector(".ville-empty");
        if (emptyEl) emptyEl.classList.toggle("hidden", visible > 0);
      }

      function chooseVille(name) {
        if (villeHidden) villeHidden.value = name;
        if (villeLabel) {
          villeLabel.textContent = name;
          villeLabel.classList.remove("text-slate-400");
          villeLabel.classList.add("text-slate-900");
        }
        closeVille();
        if (villeTrigger) villeTrigger.focus();
      }

      if (villeTrigger) {
        villeTrigger.addEventListener("click", function () {
          villePanel.classList.contains("hidden") ? openVille() : closeVille();
        });
      }
      if (villeSearch) {
        villeSearch.addEventListener("input", function () { filterVilles(villeSearch.value); });
      }
      document.addEventListener("click", function (e) {
        var root = villeTrigger && villeTrigger.closest("[data-city-combobox]");
        if (root && !root.contains(e.target)) closeVille();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") { closePays(); closeVille(); }
      });

      // ---- Charger les villes depuis l'API ----
      function showSpinner(on) {
        if (villeSpinner) villeSpinner.classList.toggle("hidden", !on);
        if (villeChevron) villeChevron.classList.toggle("hidden", on);
      }

      function switchToFreeText(hint) {
        if (villeComboWrap) villeComboWrap.classList.add("hidden");
        // ville-hidden ne doit PAS avoir name= en mode champ libre
        if (villeHidden) { villeHidden.removeAttribute("required"); villeHidden.removeAttribute("name"); }
        if (villeFree) {
          villeFree.classList.remove("hidden");
          villeFree.removeAttribute("disabled");
          villeFree.setAttribute("name", "ville");
        }
        if (villeHint) {
          villeHint.textContent = hint || "Saisissez votre ville.";
          villeHint.classList.remove("hidden");
        }
      }

      function switchToCombobox() {
        if (villeComboWrap) villeComboWrap.classList.remove("hidden");
        if (villeFree) {
          villeFree.classList.add("hidden");
          villeFree.setAttribute("disabled", "disabled");
          villeFree.removeAttribute("name");
        }
        if (villeHidden) {
          villeHidden.setAttribute("required", "required");
          villeHidden.setAttribute("name", "ville");
        }
        if (villeHint) villeHint.classList.remove("hidden");
      }

      function populateCities(cities) {
        if (!villeListbox) return;
        villeListbox.innerHTML = "";
        cities.forEach(function (city) {
          var btn = document.createElement("button");
          btn.type = "button";
          btn.role = "option";
          btn.className = "combobox-option ville-option";
          btn.dataset.villeName = city;
          btn.setAttribute("aria-selected", "false");
          btn.innerHTML = '<span>' + city + '</span><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="combobox-check text-blue-600"><path d="M20 6 9 17l-5-5"/></svg>';
          btn.addEventListener("click", function () { chooseVille(city); });
          villeListbox.appendChild(btn);
        });
        var emptyEl = document.createElement("p");
        emptyEl.className = "combobox-empty hidden";
        emptyEl.textContent = "Aucune ville trouvée. Tape le nom ci-dessus.";
        villeListbox.appendChild(emptyEl);
      }

      // Villes locales pour les pays où l'API est peu fiable
      var LOCAL_CITIES = {
        "Congo (RDC)": ["Bandundu","Beni","Boende","Bukavu","Bumba","Bunia","Butembo","Gbadolite","Gemena","Goma","Ilebo","Kabalo","Kabare","Kalemie","Kamina","Kananga","Kasongo","Kenge","Kikwit","Kindu","Kinshasa","Kipushi","Kisangani","Kolwezi","Kongolo","Likasi","Lisala","Lodja","Luebo","Lubumbashi","Lusambo","Mahagi","Makanza","Manono","Matadi","Mbandaka","Mbuji-Mayi","Mobayi-Mbongo","Moba","Moanda","Muanda","Mwene-Ditu","Rutshuru","Shabunda","Tshela","Tshikapa","Uvira","Watsa","Zongo"]
      };

      function loadCities(countryName) {
        // Villes locales en priorité (instantané)
        if (LOCAL_CITIES[countryName]) {
          if (villeHidden) villeHidden.value = "";
          if (villeLabel) { villeLabel.textContent = "Choisir une ville"; villeLabel.classList.add("text-slate-400"); villeLabel.classList.remove("text-slate-900", "font-medium"); }
          if (villeListbox) villeListbox.innerHTML = "";
          if (villeSearch) villeSearch.value = "";
          populateCities(LOCAL_CITIES[countryName]);
          switchToCombobox();
          if (villeHint) villeHint.textContent = "Ou tape le nom de ta ville.";
          return;
        }

        // Sinon, appel API
        if (villeHidden) villeHidden.value = "";
        if (villeLabel) { villeLabel.textContent = "Choisir une ville"; villeLabel.classList.add("text-slate-400"); villeLabel.classList.remove("text-slate-900", "font-medium"); }
        if (villeListbox) villeListbox.innerHTML = "";
        if (villeSearch) villeSearch.value = "";

        showSpinner(true);
        var frToEn = {
          "Congo": "Republic of the Congo",
          "Allemagne": "Germany", "Autriche": "Austria", "Belgique": "Belgium",
          "Brésil": "Brazil", "Cameroun": "Cameroon", "Chine": "China",
          "Corée du Sud": "South Korea", "Côte d'Ivoire": "Ivory Coast",
          "Danemark": "Denmark", "Égypte": "Egypt", "Émirats arabes unis": "United Arab Emirates",
          "Espagne": "Spain", "États-Unis": "United States", "Finlande": "Finland",
          "France": "France", "Ghana": "Ghana", "Grèce": "Greece",
          "Irlande": "Ireland", "Islande": "Iceland", "Italie": "Italy",
          "Japon": "Japan", "Jordanie": "Jordan", "Luxembourg": "Luxembourg",
          "Maroc": "Morocco", "Mexique": "Mexico", "Nigeria": "Nigeria",
          "Norvège": "Norway", "Nouvelle-Zélande": "New Zealand", "Pays-Bas": "Netherlands",
          "Pérou": "Peru", "Philippines": "Philippines", "Pologne": "Poland",
          "Portugal": "Portugal", "Royaume-Uni": "United Kingdom", "Russie": "Russia",
          "Sénégal": "Senegal", "Suède": "Sweden", "Suisse": "Switzerland",
          "Tchad": "Chad", "Tunisie": "Tunisia", "Turquie": "Turkey",
          "Ukraine": "Ukraine", "Vietnam": "Vietnam", "Algérie": "Algeria",
          "Angola": "Angola", "Bénin": "Benin", "Burkina Faso": "Burkina Faso",
          "Burundi": "Burundi", "Cap-Vert": "Cape Verde", "Centrafrique": "Central African Republic",
          "Comores": "Comoros", "Djibouti": "Djibouti", "Érythrée": "Eritrea",
          "Éthiopie": "Ethiopia", "Gabon": "Gabon", "Gambie": "Gambia",
          "Guinée": "Guinea", "Guinée-Bissau": "Guinea-Bissau", "Guinée équatoriale": "Equatorial Guinea",
          "Kenya": "Kenya", "Lesotho": "Lesotho", "Libéria": "Liberia",
          "Libye": "Libya", "Madagascar": "Madagascar", "Malawi": "Malawi",
          "Mali": "Mali", "Mauritanie": "Mauritania", "Maurice": "Mauritius",
          "Mozambique": "Mozambique", "Namibie": "Namibia", "Niger": "Niger",
          "Ouganda": "Uganda", "Rwanda": "Rwanda", "Sao Tomé-et-Principe": "Sao Tome and Principe",
          "Seychelles": "Seychelles", "Sierra Leone": "Sierra Leone", "Somalie": "Somalia",
          "Soudan": "Sudan", "Soudan du Sud": "South Sudan", "Tanzanie": "Tanzania",
          "Togo": "Togo", "Zambie": "Zambia", "Zimbabwe": "Zimbabwe",
          "Afrique du Sud": "South Africa"
        };
        var apiName = frToEn[countryName] || countryName;

        fetch("https://countriesnow.space/api/v0.1/countries/cities/q?country=" + encodeURIComponent(apiName))
          .then(function (r) { return r.json(); })
          .then(function (data) {
            showSpinner(false);
            if (data.error || !Array.isArray(data.data) || data.data.length === 0) {
              switchToFreeText("Aucune ville trouvée. Saisissez votre ville.");
              return;
            }
            populateCities(data.data.sort());
            switchToCombobox();
            if (villeHint) villeHint.textContent = "Ou tape le nom de ta ville.";
          })
          .catch(function () {
            showSpinner(false);
            switchToFreeText("Saisissez votre ville directement.");
          });
      }

      // ---- Loader sur le bouton submit ----
      var submitBtn = document.getElementById("adhesion-submit");
      var submitLabel = document.getElementById("submit-label");
      var submitSpinnerEl = document.getElementById("submit-spinner");
      var adhesionForm = submitBtn && submitBtn.closest("form");
      if (adhesionForm) {
        adhesionForm.addEventListener("submit", function () {
          if (adhesionForm.checkValidity()) {
            if (submitBtn) submitBtn.setAttribute("disabled", "disabled");
            if (submitLabel) submitLabel.textContent = "Envoi en cours\u2026";
            if (submitSpinnerEl) submitSpinnerEl.classList.remove("hidden");
          }
        });
      }
    })();
  </script>
</BaseLayout>
