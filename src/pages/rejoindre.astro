---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Icon from "../components/Icon.astro";
import Turnstile from "../components/Turnstile.astro";
import faq from "../data/faq.json";

// Rôles groupés — les rôles « créatifs » et « média » déclenchent le champ portfolio
const roleGroups = [
  {
    label: "Création de contenu",
    roles: ["Créateur de contenu", "Graphiste", "Monteur vidéo", "Photographe", "Vidéaste"],
  },
  {
    label: "Média",
    roles: ["Journaliste", "Radio", "TV"],
  },
  {
    label: "Ambiance & terrain",
    roles: ["Ambiance / chants", "Organisation fan zone", "Relais diaspora", "Modération digitale"],
  },
  {
    label: "Partenaires",
    roles: ["Sponsor", "Équipementier", "Imprimeur"],
  },
];

// Rôles pour lesquels on demande réseaux sociaux / portfolio
const creativeRoles = [
  "Créateur de contenu", "Graphiste", "Monteur vidéo", "Photographe", "Vidéaste",
  "Journaliste", "Radio", "TV",
];

// Liste à plat (pour les puces récapitulatives)
const roles = roleGroups.flatMap((g) => g.roles);

const canals = ["WhatsApp", "Email", "Téléphone", "Instagram"];

const disponibilites = [
  "Matchs uniquement",
  "Quelques heures par mois",
  "Chaque semaine",
  "Disponible pour organiser"
];
---
<BaseLayout title="Rejoindre" description="Appel à inscription Bloc Léopards : créateurs de contenu, graphistes, monteurs, photographes et vidéastes.">
  <PageHero title="Rejoindre" subtitle="Engage-toi pour un support positif" image="/media/atelier-1.svg" />
  <section class="mx-auto max-w-5xl px-4 py-16">

    <!-- Bannière campagne -->
    <div class="mb-10 overflow-hidden rounded-[6px] border border-or/30 bg-congo text-white shadow-deep">
      <div class="grid gap-6 p-7 md:grid-cols-[1fr_auto] md:items-center md:p-9">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-or px-4 py-1.5 text-xs font-bold uppercase tracking-[0.22em] text-congo-night">
            <Icon name="send" size={13} />Appel à inscription
          </p>
          <h2 class="mt-4 font-display uppercase leading-[0.95] [font-size:clamp(1.6rem,3.6vw,2.4rem)]">Créateur de contenu, graphiste, monteur, photographe ou vidéaste&nbsp;?</h2>
        </div>
        <a href="#formulaire" class="hidden shrink-0 rounded-full bg-or px-6 py-4 text-center text-[0.78rem] font-bold uppercase tracking-[0.1em] text-congo-night transition-transform hover:-translate-y-0.5 md:inline-block">
          Je m'inscris →
        </a>
      </div>
    </div>

    {Astro.url.searchParams.get("status") === "success" && (
      <div class="mb-6 rounded-[6px] border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">
        Adhésion reçue. Bienvenue dans le Bloc.
      </div>
    )}
    {Astro.url.searchParams.get("status") === "error" && (
      <div class="mb-6 rounded-[6px] border border-red-200 bg-red-50 p-4 text-sm text-red-800">
        Impossible d'enregistrer l'adhésion pour le moment. Vérifie la connexion Neon.
      </div>
    )}
    {Astro.url.searchParams.get("status") === "missing" && (
      <div class="mb-6 rounded-[6px] border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        Merci de remplir les champs obligatoires (*) et d'accepter la charte.
      </div>
    )}
    {Astro.url.searchParams.get("status") === "captcha" && (
      <div class="mb-6 rounded-[6px] border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        Merci de valider le contrôle anti-robot avant d'envoyer le formulaire.
      </div>
    )}

    <div id="formulaire" class="grid gap-8 lg:grid-cols-[1fr_0.72fr]">
      <form name="adhesion" method="POST" action="/api/adhesion" class="grid gap-6 rounded-[6px] border border-slate-200 bg-white p-6 text-sm shadow-deep">
        <input name="_hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
        <input name="_t" type="hidden" id="adhesion-t" />
        <script>document.getElementById('adhesion-t').value = Date.now();</script>
        <div>
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-congo">Adhésion</p>
          <h2 class="mt-2 font-display uppercase leading-[0.95] text-2xl text-congo-night">Dis-nous comment tu veux aider</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">Le formulaire alimente la base membres pour organiser les chants, les fan zones, les relais diaspora et les équipes média.</p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="grid gap-2">
            <span class="font-semibold text-slate-700">Prénom *</span>
            <input name="prenom" required autocomplete="given-name" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15" />
          </label>
          <label class="grid gap-2">
            <span class="font-semibold text-slate-700">Nom *</span>
            <input name="nom" required autocomplete="family-name" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15" />
          </label>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="grid gap-2">
            <span class="font-semibold text-slate-700">Email *</span>
            <input type="email" name="email" required autocomplete="email" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15" />
          </label>
          <label class="grid gap-2">
            <span class="font-semibold text-slate-700">Téléphone</span>
            <input type="tel" name="telephone" autocomplete="tel" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15" />
          </label>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="grid gap-2">
            <span class="font-semibold text-slate-700">Date de naissance</span>
            <input type="date" name="date_naissance" autocomplete="bday" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15" />
          </label>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="grid gap-2">
            <span class="font-semibold text-slate-700">Pays</span>
            <input name="pays" autocomplete="country-name" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15" />
          </label>
          <label class="grid gap-2">
            <span class="font-semibold text-slate-700">Ville *</span>
            <input name="ville" required autocomplete="address-level2" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15" />
          </label>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <label class="grid gap-2">
            <span class="font-semibold text-slate-700">Rôle souhaité *</span>
            <select id="role-select" name="role" required class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15">
              <option value="">Choisir un rôle</option>
              {roleGroups.map((group) => (
                <optgroup label={group.label}>
                  {group.roles.map((role) => (
                    <option value={role} data-creative={creativeRoles.includes(role) ? "1" : "0"}>{role}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </label>
          <label class="grid gap-2">
            <span class="font-semibold text-slate-700">Canal préféré</span>
            <select name="canal" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15">
              <option value="">Choisir</option>
              {canals.map((canal) => <option value={canal}>{canal}</option>)}
            </select>
          </label>
        </div>

        <!-- Réseaux sociaux / portfolio — mis en avant pour les profils créatifs & média -->
        <div id="portfolio-block" class="rounded-[6px] border border-or/40 bg-or/5 p-4">
          <label class="grid gap-2">
            <span class="flex items-center gap-2 font-semibold text-slate-800">
              <Icon name="camera" size={16} class="text-congo" />Réseaux sociaux &amp; exemples de tes travaux
              <span id="portfolio-required" class="hidden rounded-full bg-or px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-congo-night">Recommandé</span>
            </span>
            <textarea id="portfolio-input" name="portfolio" rows="3" placeholder="Instagram, TikTok, YouTube, Behance, Drive… colle tes liens ou @pseudos. Montre-nous ce que tu sais faire !" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15"></textarea>
            <span class="text-xs text-slate-500">Pour les créateurs, graphistes, monteurs, photographes, vidéastes et médias : partage tes liens ou quelques exemples.</span>
          </label>
        </div>

        <fieldset class="rounded-[6px] border border-slate-200 bg-slate-50 p-4">
          <legend class="px-2 text-sm font-semibold text-slate-800">Disponibilité</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {disponibilites.map((item) => (
              <label class="flex items-center gap-3 rounded-[4px] border border-slate-200 bg-white p-3 text-sm text-slate-700">
                <input type="radio" name="disponibilite" value={item} class="h-4 w-4 accent-congo" />
                {item}
              </label>
            ))}
          </div>
        </fieldset>

        <label class="grid gap-2">
          <span class="font-semibold text-slate-700">Motivation</span>
          <textarea name="motivation" rows="5" class="rounded-[4px] border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-congo focus:ring-4 focus:ring-congo/15"></textarea>
        </label>

        <div class="grid gap-3 rounded-[6px] border border-slate-200 bg-slate-50 p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Conditions campagne créateurs</p>
          <label class="flex items-start gap-3 text-sm text-slate-700">
            <input type="checkbox" name="is_adult" class="mt-1 h-4 w-4 accent-congo" />
            <span>Je confirme être âgé·e d'au moins <span class="font-semibold">18 ans</span>.</span>
          </label>
          <label class="flex items-start gap-3 text-sm text-slate-700">
            <input type="checkbox" name="has_passport" class="mt-1 h-4 w-4 accent-congo" />
            <span>Je dispose d'un <span class="font-semibold">passeport valide</span>.</span>
          </label>
        </div>

        <div class="grid gap-3 rounded-[6px] border border-slate-200 bg-slate-50 p-4">
          <label class="flex items-start gap-3 text-sm text-slate-700">
            <input type="checkbox" name="charte" required class="mt-1 h-4 w-4 accent-congo" />
            <span>J'ai lu et j'accepte la <a href="/charte" class="font-semibold text-congo">Charte du Supporter</a>. *</span>
          </label>
          <label class="flex items-start gap-3 text-sm text-slate-700">
            <input type="checkbox" name="newsletter" class="mt-1 h-4 w-4 accent-congo" />
            <span>Je veux recevoir les mobilisations confirmées, fan zones et infos du Bloc.</span>
          </label>
        </div>

        <Turnstile />

        <button type="submit" class="rounded-full bg-congo px-6 py-4 text-[0.8rem] font-bold uppercase tracking-[0.1em] text-white transition-transform hover:-translate-y-0.5">Envoyer ma demande</button>
      </form>

      <aside class="grid content-start gap-5">
        <div class="rounded-[6px] border border-slate-200 bg-congo p-6 text-white shadow-deep">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-or">Parcours</p>
          <h3 class="mt-3 font-display uppercase leading-[0.95] text-2xl">Après l'inscription</h3>
          <ol class="mt-5 grid gap-4 text-sm text-white/85">
            <li><span class="font-semibold text-or">1.</span> On vérifie ta ville et ton rôle.</li>
            <li><span class="font-semibold text-or">2.</span> Tu reçois les infos utiles selon ton canal préféré.</li>
            <li><span class="font-semibold text-or">3.</span> Tu participes aux actions confirmées du Bloc.</li>
          </ol>
        </div>
        <div class="rounded-[6px] border border-slate-200 bg-slate-50 p-6 text-sm text-slate-700">
          <h3 class="font-display uppercase text-lg text-congo-night">Rôles recherchés</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {roles.map((role) => (
              <span class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700">{role}</span>
            ))}
          </div>
        </div>
      </aside>
    </div>

    <div class="mt-10 rounded-[6px] border border-slate-200 bg-slate-50 p-6 text-sm">
      <h3 class="font-display uppercase text-lg text-congo-night">Règles principales</h3>
      <ul class="mt-3 list-disc pl-4 text-slate-600">
        <li>Respect des joueurs, adversaires, arbitres.</li>
        <li>Zéro violence et zéro messages haineux.</li>
        <li>Chants coordonnés et discipline en tribune.</li>
        <li>Engagement digital responsable.</li>
      </ul>
      <a href="/charte" class="mt-4 inline-flex font-semibold text-congo">Lire la charte complète →</a>
    </div>

    <div class="mt-10">
      <h3 class="font-display uppercase text-lg text-congo-night">FAQ</h3>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {faq.map((item) => (
          <div class="rounded-[6px] border border-slate-200 bg-white p-4 text-sm">
            <p class="font-semibold text-slate-900">{item.q}</p>
            <p class="mt-2 text-slate-600">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const select = document.getElementById("role-select");
      const block = document.getElementById("portfolio-block");
      const badge = document.getElementById("portfolio-required");
      const input = document.getElementById("portfolio-input");
      if (!select || !block) return;
      function sync() {
        const opt = select.options[select.selectedIndex];
        const creative = opt && opt.getAttribute("data-creative") === "1";
        block.style.display = "";
        block.style.order = creative ? "-1" : "";
        block.classList.toggle("ring-2", !!creative);
        block.classList.toggle("ring-or/40", !!creative);
        if (badge) badge.classList.toggle("hidden", !creative);
        if (input) input.setAttribute("placeholder", creative
          ? "Colle tes liens : Instagram, TikTok, YouTube, Behance, Drive… Montre-nous ton meilleur travail !"
          : "Instagram, TikTok, YouTube, Behance, Drive… (optionnel)");
      }
      select.addEventListener("change", sync);
      sync();
    })();
  </script>
</BaseLayout>
