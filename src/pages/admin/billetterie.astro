---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { isAdminAuthed } from "../../lib/auth";
if (!isAdminAuthed(Astro.cookies)) return Astro.redirect("/admin/login");
---

<AdminLayout title="Billetterie — Admin Bloc Léopards" section="billetterie">
  <div class="ticket-admin">
    <div class="heading"><div><p class="eyebrow">BILLETTERIE</p><h1>Pré-réservations</h1><p>Suivi local des réservations générées depuis la billetterie.</p></div><a href="/billetterie">Ouvrir la billetterie ↗</a></div>
    <div class="notice">Les réservations affichées ici sont stockées localement dans ce navigateur.</div>
    <div class="table-wrap"><table><thead><tr><th>Dossier</th><th>Nom</th><th>WhatsApp</th><th>Billets</th><th>Date</th><th>Statut</th></tr></thead><tbody id="reservations"><tr><td colspan="6" class="empty">Chargement…</td></tr></tbody></table></div>
  </div>
</AdminLayout>

<script>
  const tbody = document.getElementById('reservations');
  const reservations = JSON.parse(localStorage.getItem('bloc-leopards-reservations') || '[]').reverse();
  if (!reservations.length) tbody.innerHTML = '<tr><td colspan="6" class="empty">Aucune pré-réservation enregistrée sur ce navigateur.</td></tr>';
  else tbody.innerHTML = reservations.map((r) => `<tr><td><strong>${r.id}</strong></td><td>${r.prenom} ${r.nom}</td><td>${r.whatsapp || '—'}</td><td>${r.quantity || 1}</td><td>${new Date(r.createdAt).toLocaleString('fr-FR')}</td><td><span class="status">À retirer</span></td></tr>`).join('');
</script>

<style>
  .ticket-admin { padding: 2rem; color: #f6f8fb; } .heading { display:flex; justify-content:space-between; gap:1rem; align-items:end; margin-bottom:1.25rem; } .eyebrow { margin:0 0 .4rem; color:#f7d618; font-size:.7rem; font-weight:800; letter-spacing:.16em; } h1 { margin:0; font-size:2rem; } .heading p:not(.eyebrow) { color:#98a8bf; } a { padding:.7rem 1rem; border:1px solid rgba(247,214,24,.5); border-radius:999px; color:#f7d618; text-decoration:none; font-weight:700; } .notice { margin-bottom:1rem; padding:.8rem 1rem; border:1px solid rgba(255,255,255,.1); border-radius:.7rem; color:#aebbd0; font-size:.85rem; } .table-wrap { overflow:auto; border:1px solid rgba(255,255,255,.1); border-radius:1rem; background:#101b2f; } table { width:100%; border-collapse:collapse; min-width:680px; } th,td { padding:1rem; border-bottom:1px solid rgba(255,255,255,.08); text-align:left; font-size:.82rem; } th { color:#91a4bf; font-size:.68rem; letter-spacing:.1em; text-transform:uppercase; } td { color:#e8edf5; } .empty { padding:2.5rem; text-align:center; color:#91a4bf; } .status { color:#7ee2ad; } @media (max-width:700px) { .ticket-admin { padding:1rem; } .heading { display:block; } .heading a { display:inline-block; margin-top:1rem; } }
</style>
