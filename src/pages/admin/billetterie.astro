---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { isAdminAuthed } from "../../lib/auth";
import { requireDatabase } from "../../lib/neon";
if (!isAdminAuthed(Astro.cookies)) return Astro.redirect("/admin/login");

const sql = requireDatabase();
const reservations = await sql`
  select reservation_code, first_name, last_name, email, whatsapp, country,
         quantity, total_price_fc, status, created_at
  from billetterie_reservations
  order by created_at desc
`;
const dateFormatter = new Intl.DateTimeFormat("fr-FR", { dateStyle: "short", timeStyle: "short" });
---

<AdminLayout title="Billetterie — Admin Bloc Léopards" section="billetterie">
  <div class="ticket-admin">
    <div class="heading"><div><p class="eyebrow">BILLETTERIE</p><h1>Pré-réservations</h1><p>{reservations.length} réservation{reservations.length > 1 ? "s" : ""} enregistrée{reservations.length > 1 ? "s" : ""} en base.</p></div><a href="/billetterie">Ouvrir la billetterie ↗</a></div>
    <div class="table-wrap"><table><thead><tr><th>Dossier</th><th>Nom</th><th>WhatsApp</th><th>Billets</th><th>Total</th><th>Date</th><th>Statut</th></tr></thead><tbody>{reservations.map((reservation) => <tr><td><strong>{reservation.reservation_code}</strong></td><td>{reservation.first_name} {reservation.last_name}<small>{reservation.email}</small></td><td>{reservation.whatsapp}</td><td>{reservation.quantity}</td><td>{Number(reservation.total_price_fc).toLocaleString("fr-FR")} FC</td><td>{dateFormatter.format(new Date(reservation.created_at))}</td><td><span class="status">{reservation.status === "paid" ? "Payée" : reservation.status === "cancelled" ? "Annulée" : "À retirer"}</span></td></tr>)}{reservations.length === 0 && <tr><td colspan="7" class="empty">Aucune pré-réservation enregistrée en base.</td></tr>}</tbody></table></div>
  </div>
</AdminLayout>

<style>
  .ticket-admin { padding: 2rem; color: #f6f8fb; } .heading { display:flex; justify-content:space-between; gap:1rem; align-items:end; margin-bottom:1.25rem; } .eyebrow { margin:0 0 .4rem; color:#f7d618; font-size:.7rem; font-weight:800; letter-spacing:.16em; } h1 { margin:0; font-size:2rem; } .heading p:not(.eyebrow) { color:#98a8bf; } a { padding:.7rem 1rem; border:1px solid rgba(247,214,24,.5); border-radius:999px; color:#f7d618; text-decoration:none; font-weight:700; } .table-wrap { overflow:auto; border:1px solid rgba(255,255,255,.1); border-radius:1rem; background:#101b2f; } table { width:100%; border-collapse:collapse; min-width:850px; } th,td { padding:1rem; border-bottom:1px solid rgba(255,255,255,.08); text-align:left; font-size:.82rem; } th { color:#91a4bf; font-size:.68rem; letter-spacing:.1em; text-transform:uppercase; } td { color:#e8edf5; } td small { display:block; margin-top:.25rem; color:#91a4bf; } .empty { padding:2.5rem; text-align:center; color:#91a4bf; } .status { color:#7ee2ad; } @media (max-width:700px) { .ticket-admin { padding:1rem; } .heading { display:block; } .heading a { display:inline-block; margin-top:1rem; } }
</style>
