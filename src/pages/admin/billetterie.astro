---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminBilletterieDashboard from "../../components/AdminBilletterieDashboard.tsx";
import { isAdminAuthed, hasPermission } from "../../lib/auth";

if (!isAdminAuthed(Astro.cookies)) return Astro.redirect("/admin/login");
if (!hasPermission(Astro.cookies, "billetterie")) return Astro.redirect("/admin/dashboard");
---

<AdminLayout title="Billetterie — Admin Bloc Léopards" section="billetterie">
  <AdminBilletterieDashboard client:load />
</AdminLayout>
