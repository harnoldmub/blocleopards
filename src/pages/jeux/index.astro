---
import "../../styles/global.css";
import SEO from "../../components/SEO.astro";
import ArenaApp from "../../components/arena/ArenaApp.tsx";

const pageTitle = "L'Arène des Léopards · Jeux officiels | Bloc Léopards";
const pageDescription = "Tirs au but au Stade des Martyrs et shoot au playground de Limete : deux mini-jeux des supporters des Léopards, à jouer seul ou à plusieurs.";
---

<!doctype html>
<html lang="fr" class="h-full bg-[#040a1a]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#040a1a" />
    <SEO title={pageTitle} description={pageDescription} url={`https://blocleopards.com/jeux${"index" === "index" ? "" : "/index"}`} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" as="image" href="/brand/logo-arena.webp" />
  </head>
  <body class="h-[100dvh] overflow-hidden bg-[#040a1a] text-white antialiased">
    <noscript><p style="padding:24px;color:#fff">Les jeux de l'Arène des Léopards nécessitent JavaScript.</p></noscript>
    <ArenaApp client:only="react" initialGame={null} />
  </body>
</html>
