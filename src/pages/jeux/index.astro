---
import "../../styles/global.css";
import SEO from "../../components/SEO.astro";
import ArenaApp from "../../components/arena/ArenaApp.tsx";

import { decodeChallenge } from "../../components/arena/lib/challenge";

// lien de défi : aperçu de partage personnalisé (« X te défie »)
const defi = decodeChallenge(Astro.url.searchParams.get("defi"));
const gameName = defi ? (defi.g === "foot" ? "Tirs au but" : "Shoot à la sirène") : "";
const pageTitle = defi
  ? `${defi.n} te défie${defi.p > 0 ? ` : ${defi.p} points à battre` : ""} · L'Arène des Léopards`
  : "L'Arène des Léopards · Jeux officiels | Bloc Léopards";
const pageDescription = defi
  ? `${gameName}${defi.st > 0 ? `, palier ${defi.st}` : ""} : mêmes tirs, mêmes conditions. Relève le défi et renvoie la revanche sur WhatsApp.`
  : "Tirs au but au Stade des Martyrs et shoot au playground de Limete : deux mini-jeux des supporters des Léopards. Défie tes amis sur WhatsApp.";
---

<!doctype html>
<html lang="fr" class="h-full bg-[#040a1a]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#040a1a" />
    <SEO title={pageTitle} description={pageDescription} url={`https://blocleopards.com/jeux${"index" === "index" ? "" : "/index"}`} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" as="image" href="/brand/logo-arena-2026.webp" />
  </head>
  <body class="h-[100dvh] overflow-hidden bg-[#040a1a] text-white antialiased">
    <noscript><p style="padding:24px;color:#fff">Les jeux de l'Arène des Léopards nécessitent JavaScript.</p></noscript>
    <ArenaApp client:only="react" initialGame={null} />
  </body>
</html>
